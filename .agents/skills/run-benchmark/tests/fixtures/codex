#!/usr/bin/env bash
set -euo pipefail

final=""
while (($#)); do
  if [[ "$1" == --output-last-message ]]; then
    final="$2"
    shift 2
  else
    shift
  fi
done

printf '%s\n' '<!doctype html><title>Fixture</title>' > index.html
printf '%s\n' 'BENCHMARK_COMPLETE' > "$final"
printf '{"type":"thread.started","thread_id":"fixture-%s"}\n' "$$"
printf '%s\n' '{"type":"item.completed","item":{"type":"agent_message","text":"BENCHMARK_COMPLETE"}}'
