{
  "name": "model-benchmarks",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "build": "pnpm --dir benchmark-compare build",
    "check": "pnpm --dir benchmark-compare check",
    "dev": "pnpm --dir benchmark-compare dev",
    "index:transcripts": "node scripts/index-transcripts.mjs",
    "lint": "pnpm --dir benchmark-compare lint",
    "serve": "pnpm --dir benchmark-compare serve",
    "setup:python": "python3 -m venv .venv && .venv/bin/python -m pip install -r requirements-dev.txt",
    "test": "pnpm --dir benchmark-compare test",
    "typecheck": "pnpm --dir benchmark-compare typecheck",
    "validate:skill": ".venv/bin/python /Users/melvynx/.agents/skills/.system/skill-creator/scripts/quick_validate.py .agents/skills/run-benchmark",
    "verify:transcripts": "node scripts/index-transcripts.mjs --check"
  }
}
