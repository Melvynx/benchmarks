{
  "name": "model-benchmarks",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "audit:layout": "node scripts/audit-benchmark-layout.mjs",
    "build": "pnpm build:benchmarks && pnpm build:app",
    "build:app": "pnpm --dir benchmark-compare build",
    "build:benchmarks": "node scripts/build-benchmarks.mjs",
    "check": "pnpm --dir benchmark-compare check",
    "dev": "pnpm --dir benchmark-compare dev",
    "index:prompts": "node scripts/index-prompts.mjs",
    "index:transcripts": "node scripts/index-transcripts.mjs",
    "lint": "pnpm --dir benchmark-compare lint",
    "prestart": "node scripts/build-benchmarks.mjs --check",
    "serve": "pnpm start",
    "start": "pnpm --dir benchmark-compare serve",
    "test": "pnpm --dir benchmark-compare test",
    "typecheck": "pnpm --dir benchmark-compare typecheck",
    "validate:skill": "node scripts/validate-skill.mjs .agents/skills/run-benchmark",
    "verify:model-prompts": "node scripts/verify-model-prompts.mjs",
    "verify:prompts": "node scripts/index-prompts.mjs --check && pnpm verify:model-prompts",
    "verify:transcripts": "node scripts/index-transcripts.mjs --check"
  },
  "devDependencies": {
    "yaml": "^2.9.0"
  }
}
