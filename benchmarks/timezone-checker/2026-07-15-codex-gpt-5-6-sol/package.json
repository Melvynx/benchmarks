  },
  "dependencies": {
    "@vitejs/plugin-react": "5.1.4",
    "vite": "7.3.6",
    "typescript": "5.8.3",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3"
  },
  "packageManager": "pnpm@10.12.1"
}
