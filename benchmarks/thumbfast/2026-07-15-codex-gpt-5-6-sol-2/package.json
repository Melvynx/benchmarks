{
  "name": "thumbfa.st",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bash scripts/vercel-build-preflight.sh && vite build && node scripts/sync-ssr-css-assets.mjs",
    "clean": "pnpm lint && pnpm ts && prettier --write .",
    "dev": "vite dev --port 9155",
    "email": "email dev",
    "format": "prettier --write .",
    "postinstall": "node scripts/postinstall-codegen.mjs",
    "knip": "knip-bun --config knip.json",
    "lint": "eslint . --fix",
    "start-all": "bash scripts/start-all.sh",
    "start": "PORT=${PORT:-9155} node -r dotenv/config .output/server/index.mjs",
    "stripe-webhooks": "echo \"Stripe webhooks are handled by Convex at POST /stripe/webhook. Register https://<deployment>.convex.site/stripe/webhook in Stripe instead of forwarding to the web app.\"",
    "convex:codegen": "pnpm exec convex codegen",
    "convex:dev": "pnpm exec convex dev",
    "convex:deploy": "pnpm exec convex deploy",
    "convex:deploy:vercel": "npx convex deploy --cmd 'npm run build'",
    "dev:services": "concurrently -n stripe -c yellow \"pnpm stripe-webhooks\"",
    "ts": "tsc --noEmit",
    "vercel-build": "npx convex deploy --cmd 'npm run build'",
    "vercel:setup-convex-env": "bash scripts/vercel-convex-env-setup.sh",
    "test": "vitest",
    "test:e2e": "HEADLESS=0 playwright test --ui",
    "test:ci": "vitest run",
    "test:e2e:ci": "HEADLESS=TRUE playwright test",
    "lint:ci": "eslint . --max-warnings 0"
  },
