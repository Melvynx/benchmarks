{
  "compilerOptions": {
    "target": "es2015",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": ["./src/*"],
      "@convex/*": ["./convex/*"],
      "@email/*": ["./emails/*"],
      "@public-site/*": ["./src/public-site/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/vite-env.d.ts",
    "convex/**/*.ts",
    "convex/**/*.tsx",
    "scripts/**/*.ts",
    "__tests__/**/*.ts",
    "__tests__/**/*.tsx",
    "e2e/**/*.ts",
    "emails/**/*.ts",
    "emails/**/*.tsx",
    "server/**/*.ts",
    "test/**/*.ts",
    "test/**/*.tsx",
    "playwright.config.ts",
    "proxy.ts",
    "vite.config.ts"
  ],
  "exclude": [
    "node_modules",
    ".output",
    ".tanstack",
    "src/generated",
    ".claude",
    ".conductor"
  ]
}
