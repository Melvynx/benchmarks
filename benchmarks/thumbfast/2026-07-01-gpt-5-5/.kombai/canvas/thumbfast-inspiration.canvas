      "html": "\n<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/dist/tabler-icons.min.css');\n</style>\n\n<div style=\"background: oklch(0.13 0 0); min-height: 400px; padding: 40px; display: flex; justify-content: center; align-items: flex-start; font-family: 'Inter', sans-serif;\" data-kid=\"1\">\n\n  <div style=\"position: relative; width: 300px;\" data-kid=\"2\">\n\n    \n    <div style=\"\n      position: relative;\n      border-radius: 16px;\n      border: 1px solid oklch(0.628 0.258 29.23 / 0.22);\n      overflow: hidden;\n      cursor: pointer;\n      aspect-ratio: 4/3;\n      box-shadow:\n        0 0 0 1px oklch(0.628 0.258 29.23 / 0.08),\n        0 0 18px -2px oklch(0.628 0.258 29.23 / 0.28),\n        0 0 50px -8px oklch(0.628 0.258 29.23 / 0.18),\n        0 20px 60px -12px oklch(0 0 0 / 0.85),\n        0 8px 24px oklch(0 0 0 / 0.6);\n    \" data-kid=\"3\">\n\n      \n      <img src=\"https://picsum.photos/seed/iphone2024/640/480\" alt=\"Quel iPhone acheter en 2024 ? - Léo Duff\" loading=\"lazy\" decoding=\"async\" style=\"position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top;\" data-kid=\"4\">\n\n      \n      <div style=\"\n        position: absolute; inset: 0; pointer-events: none;\n        background: linear-gradient(\n          to top,\n          oklch(0.10 0.03 29.23 / 0.97) 0%,\n          oklch(0.12 0.01 29.23 / 0.85) 20%,\n          oklch(0.13 0 0 / 0.62) 40%,\n          oklch(0.13 0 0 / 0.18) 65%,\n          transparent 100%\n        );\n      \" data-kid=\"5\"></div>\n\n      \n      <div style=\"\n        position: absolute; inset: 0; pointer-events: none;\n        background: radial-gradient(ellipse at center, transparent 55%, oklch(0 0 0 / 0.35) 100%);\n      \" data-kid=\"6\"></div>\n\n      \n      <div style=\"position: absolute; top: 9px; left: 9px; z-index: