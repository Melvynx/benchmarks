lch(0.65 0 0);\" data-kid=\"14\"></i>\n        <span style=\"font-size: 11px; color: oklch(0.78 0 0); font-weight: 500;\" data-kid=\"15\">3</span>\n      </div>\n\n      \n      <div style=\"position: absolute; inset-x: 0; bottom: 0; z-index: 10; padding: 10px 12px 13px;\" data-kid=\"16\">\n\n        \n        <div style=\"display: inline-flex; margin-bottom: 6px;\" data-kid=\"17\">\n          <span style=\"\n            background: oklch(0.628 0.258 29.23 / 0.18);\n            color: oklch(0.75 0.18 29.23);\n            border: 1px solid oklch(0.628 0.258 29.23 / 0.4);\n            font-size: 10px; font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase;\n            padding: 2px 8px; border-radius: 4px; line-height: 1.5;\n            box-shadow: 0 0 10px oklch(0.628 0.258 29.23 / 0.25);\n          \" data-kid=\"18\">Review</span>\n        </div>\n\n        \n        <div style=\"display: flex; align-items: flex-end; justify-content: space-between; gap: 8px;\" data-kid=\"19\">\n          <div style=\"min-width: 0; flex: 1;\" data-kid=\"20\">\n            <h3 style=\"\n              margin: 0; font-size: 14px; font-weight: 700; color: oklch(0.97 0 0);\n              line-height: 1.35; overflow: hidden;\n              display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;\n              letter-spacing: -0.015em;\n              text-shadow: 0 1px 4px oklch(0 0 0 / 0.6);\n            \" data-kid=\"21\">Quel iPhone acheter en 2024 ? - Léo Duff</h3>\n            <p style=\"margin: 5px 0 0; font-size: 11px; color: oklch(1 0 0 / 0.38); letter-spacing: 0.01em;\" data-kid=\"22\">Added 2 days ago</p>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    \n    <div style=\"\n      position: absolute; top: 46px; right: 8px; z-index: 50;\n      border-radius: 9px; overflow: hidden; width: 160px;\n      background: linear-gradient(to bottom, oklch(0.24 0 0) 0%, oklch(0.21 0 0) 100%);\n      border: 1px solid oklch(0.32 0 0);\n      box