{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/router.tsx",
    "src/routes/**/*.tsx",
    "src/-providers.tsx",
    "convex/**/*.ts",
    "server/**/*.ts",
    "emails/**/*.tsx",
    "scripts/**/*.{ts,mjs}",
    "__tests__/**/*.{ts,tsx}",
    "e2e/**/*.ts",
    "*.config.{js,mjs,ts}",
    "vite.config.ts",
    "vitest.config.mjs",
    "playwright.config.ts"
  ],
  "project": [
    "**/*.{ts,tsx,js,mjs,cjs}",
    "!node_modules/**",
    "!.output/**",
    "!test-results/**",
    "!convex/_generated/**",
    "!convex/betterAuth/_generated/**",
    "!src/routeTree.gen.ts"
  ],
  "ignore": [".claude/**", ".agents/**"],
  "include": [
    "files",
    "dependencies",
    "devDependencies",
    "optionalPeerDependencies",
    "unlisted",
    "binaries",
    "unresolved"
  ],
  "ignoreDependencies": ["tailwindcss", "tailwindcss-animate"],
  "paths": {
    "@/*": ["./src/*"],
    "@email/*": ["./emails/*"],
    "@public-site/*": ["./src/public-site/*"]
  }
}
