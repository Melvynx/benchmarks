{
  "name": "living-garden",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 9341 --strictPort --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 9341 --strictPort --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false"
  },
