{
  "name": "living-garden",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 9382 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 9382 --strictPort",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "tune": "tsx scripts/tune.ts",
    "sweep": "tsx scripts/sweep.ts",
    "verify:ui": "PLAYWRIGHT_BROWSERS_PATH=0 tsx scripts/verify-ui.ts"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.64.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
