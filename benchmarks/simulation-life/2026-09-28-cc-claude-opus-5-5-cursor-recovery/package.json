{
  "name": "living-garden",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 9236 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 9236 --strictPort",
    "typecheck": "tsc --noEmit",
    "sim": "node --experimental-strip-types --no-warnings scripts/headless.ts",
    "verify:sim": "node --experimental-strip-types --no-warnings scripts/verify.ts"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
