{
  "name": "living-garden",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 9348 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 9348 --strictPort",
    "typecheck": "tsc --noEmit",
    "tune": "tsx scripts/tune.ts",
    "sweep": "tsx scripts/sweep.ts",
    "bench": "tsx scripts/bench.ts",
    "perf": "PLAYWRIGHT_BROWSERS_PATH=./.playwright-browsers tsx scripts/perf.ts",
    "verify": "PLAYWRIGHT_BROWSERS_PATH=./.playwright-browsers tsx scripts/verify.ts"
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
