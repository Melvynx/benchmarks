
/* ---------- shot-level helpers ---------- */
function nearTrunksDraw(camX,dk){
  const arr=world.near;
  for(let i=0;i<arr.length;i++){
    const tr=arr[i];
    let x=tr.x-camX;x=((x%2400)+2400)%2400-400;
    if(x<-120||x>W+120)continue;
    trunkV(x,40,H,tr.w*1.15,tr.lean,tr.s>0.5?cmix([46,66,54],[20,28,26],dk):cmix([24,34,30],[16,22,20],dk));
  }
}
function redPick(x,y,s,t,u,bq){
  ctx.save();ctx.translate(x,y);ctx.scale(s,s);
  ctx.fillStyle='rgba(40,50,20,.25)';ctx.beginPath();ctx.ellipse(0,2,24,5,0,0,TAU);ctx.fill();
  ctx.fillStyle='#2c3550';
  ctx.beginPath();ctx.ellipse(2,-10,20,12,0,0,TAU);ctx.fill();
  ctx.fillStyle='#b23327';
  ctx.beginPath();
  ctx.moveTo(-22,-6);ctx.bezierCurveTo(-24,-30,-16,-48,-2,-58);
  ctx.bezierCurveTo(8,-52,16,-34,18,-8);
  ctx.quadraticCurveTo(0,0,-22,-6);ctx.fill();
  ctx.fillStyle='rgba(90,20,16,.5)';
  ctx.beginPath();ctx.moveTo(-22,-6);ctx.bezierCurveTo(-24,-30,-16,-48,-2,-58);ctx.quadraticCurveTo(-13,-34,-13,-9);ctx.closePath();ctx.fill();
  const reach=Math.sin(u*0.004);
  ctx.strokeStyle='#2c3550';ctx.lineWidth=4.2;ctx.lineCap='round';
  ctx.beginPath();ctx.moveTo(8,-40);ctx.quadraticCurveTo(16,-32,20+reach*8,-14-Math.max(0,reach)*10);ctx.stroke();
  ctx.fillStyle='#f6cfa6';ctx.beginPath();ctx.arc(21+reach*8,-13-Math.max(0,reach)*10,2.6,0,TAU);ctx.fill();
  drawBouquet(-16,-30,1.2,bq,t);
  ctx.save();ctx.translate(4,-52);ctx.rotate(0.34);
  const r=10.4;
  ctx.fillStyle='#c03a2c';
  ctx.beginPath();
  ctx.moveTo(-r*1.25,r*0.75);
  ctx.bezierCurveTo(-r*1.7,-r*0.9,-r*0.9,-r*1.9,r*0.35,-r*1.35);
  ctx.bezierCurveTo(r*1.15,-r*0.95,r*1.25,r*0.2,r*0.8,r*0.85);
  ctx.quadraticCurveTo(0,r*1.1,-r*1.25,r*0.75);ctx.fill();
  redFace({x:r*0.3,y:r*0.05,r:r*0.78,mood:1,look:{x:0.4,y:0.8},blink:blinkAt(t,5)});
  ctx.restore();
  drawBasket(-30,-6,1,{full:true});
  ctx.restore();
}
function redOTSFore(){
  // Red's shoulder + hood, dark, bottom-left foreground
  ctx.fillStyle='#571713';
  ctx.beginPath();
  ctx.moveTo(-40,H+40);ctx.lineTo(-40,640);
  ctx.bezierCurveTo(80,560,220,470,300,462);
  ctx.bezierCurveTo(360,458,420,500,430,560);
  ctx.bezierCurveTo(470,640,520,760,540,H+40);
  ctx.closePath();ctx.fill();
  ctx.fillStyle='#6b1d17';
  ctx.beginPath();ctx.moveTo(240,486);ctx.bezierCurveTo(300,420,330,430,352,470);ctx.bezierCurveTo(330,480,280,494,240,486);ctx.fill();
}
function wolfOTSFore(){
  // back of the wolf's head, bottom-right foreground; the notch on his LEFT ear reads on screen-right
  ctx.fillStyle='#242830';
  ctx.beginPath();
  ctx.moveTo(W+40,H+40);ctx.lineTo(W+40,520);
  ctx.bezierCurveTo(1440,430,1330,410,1250,440);
  ctx.bezierCurveTo(1160,480,1120,600,1130,H+40);
  ctx.closePath();ctx.fill();
  ctx.fillStyle='#1c2027';
  ctx.beginPath();ctx.moveTo(1250,452);ctx.lineTo(1282,330);ctx.lineTo(1330,446);ctx.closePath();ctx.fill();
  ctx.beginPath();
  ctx.moveTo(1400,436);ctx.lineTo(1432,318);
  ctx.lineTo(1444,352);ctx.lineTo(1456,332);
  ctx.lineTo(1482,440);ctx.closePath();ctx.fill();
}

/* ---------- the twelve sequences ---------- */
function seq0(u,t){ // The Basket
  const [si,su,sd]=shotOf(u,CUTS[0]);
  if(si===0){
    ctx.save();shotCam({cx:830,cy:560,z:1.05+0.06*eio(su/sd)},t);
    scnKitchen(t);
    // basket on the table
    const lidA=lerp(-1.15,0,eio(rt(su,2200,2800)));
    // mother behind/right of the table
    const jp=eio(rt(su,800,1600));
    const jx=lerp(1000,880,jp),jy=lerp(576,556,jp)-Math.sin(jp*Math.PI)*40;
    const hr=su<1800?{x:jx+8,y:jy-6}:{x:lerp(920,900,eio(rt(su,1800,2200))),y:lerp(560,540,eio(rt(su,1800,2200)))};
    drawMother({x:1150,y:816,s:2.5,t:t,handL:{x:940,y:568},handR:hr});
    drawBasket(860,566,3.2,{full:true});
    // jar travelling to the basket
    if(su<1700){ctx.fillStyle='#8fa06a';ctx.fillRect(jx-12,jy-20,24,26);ctx.fillStyle='#d8c9a2';ctx.fillRect(jx-12,jy-24,24,7);}
    // lid closing
    ctx.save();ctx.translate(826,542);ctx.rotate(lidA);
    ctx.fillStyle='#8a5c2b';ctx.beginPath();ctx.ellipse(34,0,38,9,0,0,TAU);ctx.fill();
    ctx.restore();
    drawRed({x:560,y:838,s:2.1,t:t,face:1,walkAmp:0,walk:0,mood:1,look:{x:1,y:-0.8},bow:false,basket:false,headRot:-0.1});
    ctx.restore();
  }else if(si===1){
    // close-up — the hood is fastened; the red thread becomes a bow
    skyV([[0,'#c9a06a'],[0.5,'#bd8f58'],[1,'#a5764a']]);
    glowDisc(1200,300,360,'rgba(255,232,170,.5)','rgba(255,232,170,0)');
    motes(t,12,{x:800,y:120,w:700,h:600},0.5);
    const p=sat(su/(sd-300));
    hoodCU(760,470,150,{mood:1,blink:blinkAt(t,5),bow:false,look:{x:-0.3,y:0.2}},t);
    // ribbon strands
    const chin={x:794,y:625};
    ctx.strokeStyle='#c8402f';ctx.lineWidth=9;ctx.lineCap='round';
    const e1=eio(sat(p*1.5));
    ctx.beginPath();ctx.moveTo(700,600);
    ctx.quadraticCurveTo(lerp(650,760,e1),lerp(700,640,e1),lerp(620,chin.x-14,e1),lerp(820,chin.y+8,e1));ctx.stroke();
    ctx.beginPath();ctx.moveTo(880,590);
    ctx.quadraticCurveTo(lerp(950,830,e1),lerp(690,650,e1),lerp(990,chin.x+16,e1),lerp(800,chin.y+10,e1));ctx.stroke();
    if(p>0.72){
      const bs=eo(rt(p,0.72,1))*1.0;
      ctx.save();ctx.translate(chin.x,chin.y+6);ctx.scale(bs,bs);
      ctx.fillStyle='#c8402f';
      ctx.beginPath();ctx.ellipse(-26,0,26,14,-0.35,0,TAU);ctx.fill();
      ctx.beginPath();ctx.ellipse(26,0,26,14,0.35,0,TAU);ctx.fill();
      ctx.beginPath();ctx.arc(0,0,9,0,TAU);ctx.fill();
      ctx.fillStyle='#8e2018';
      ctx.beginPath();ctx.moveTo(-6,8);ctx.lineTo(-16,44);ctx.lineTo(-2,42);ctx.closePath();ctx.fill();
      ctx.beginPath();ctx.moveTo(8,8);ctx.lineTo(20,40);ctx.lineTo(6,40);ctx.closePath();ctx.fill();
      ctx.restore();
    }
    // mother's hands, apron cuffs, her own red ribbon at the wrist
    const hp=eio(sat(su/1100));
    const ax=lerp(240,652,hp),ay=lerp(880,634,hp);
    const bx=lerp(420,912,hp),by=lerp(940,640,hp);
    for(let hI=0;hI<2;hI++){
      const hx2=hI?bx:ax,hy2=hI?by:ay;
      ctx.strokeStyle='#7b5a49';ctx.lineWidth=54;ctx.lineCap='round';
      ctx.beginPath();ctx.moveTo(hx2+(hI?260:-260),hy2+300);ctx.lineTo(hx2,hy2+40);ctx.stroke();
      ctx.strokeStyle='#f1e9dc';ctx.lineWidth=58;
      ctx.beginPath();ctx.moveTo(hx2+(hI?150:-150),hy2+188);ctx.lineTo(hx2+(hI?120:-120),hy2+150);ctx.stroke();
      ctx.fillStyle='#efc9a4';
      ctx.beginPath();ctx.ellipse(hx2,hy2+16,26,34,hI?-0.3:0.3,0,TAU);ctx.fill();
      ctx.beginPath();ctx.ellipse(hx2+(hI?-18:18),hy2+30,10,20,hI?0.5:-0.5,0,TAU);ctx.fill();
      if(hI===0){ctx.fillStyle='#c8402f';ctx.fillRect(ax-34,ay+92,48,12);}
    }
    vignette(0.12);
  }else{
    ctx.save();shotCam({cx:1080,cy:560,z:1.42},t);
    scnKitchen(t);
    // the doorway — morning spills in
    ctx.fillStyle='#4c3320';ctx.fillRect(1358,320,158,470);
    ctx.fillStyle='#ffe3a6';ctx.fillRect(1372,334,130,456);
    ctx.fillStyle='#e7edc9';ctx.fillRect(1372,700,130,90);
    lightShaft(1310,420,240,620,880,0.3,true);
    const wp=eio(su/sd);
    const rl=eio(rt(su,1500,2300));
    drawMother({x:770,y:830,s:2.4,t:t,handL:{x:730,y:700},handR:{x:lerp(940,830,rl),y:lerp(680,700,rl)}});
    drawRed({x:lerp(880,1330,wp),y:846,s:2.2,t:t,walk:su/480,mood:1,bow:propsAt(t).bow,basketFull:true});
    ctx.restore();
  }
}
function seq1(u,t){ // The Red Departure
  const [si,su,sd]=shotOf(u,CUTS[1]);
  if(si===0){
    ctx.save();shotCam({cx:lerp(720,860,su/sd),cy:470,z:1.06},t);
    scnVillage(t,{mode:'morn',redP:lerp(0.05,0.3,su/sd),redMood:1});
    ctx.restore();
  }else if(si===1){
    ctx.save();shotCam({cx:800,cy:460,z:1.03,hand:0.2},t);
    skyV([[0,'#f7d29b'],[0.5,'#f6d8a0'],[1,'#e6d3a0']]);
    glowDisc(300,240,180,'rgba(255,244,214,.8)','rgba(255,244,214,0)');
    // parallax layers slide as she walks
    const sc=su;
    ctx.save();ctx.translate(-sc*0.015,0);
    band(560,12,131,'#cdb271');
    ctx.fillStyle='#a3562e';
    for(let i=0;i<4;i++){const hx=200+i*160;ctx.fillRect(hx,522,60,36);ctx.beginPath();ctx.moveTo(hx-6,522);ctx.lineTo(hx+30,494);ctx.lineTo(hx+66,522);ctx.closePath();ctx.fill();}
    ctx.restore();
    ctx.save();ctx.translate(-sc*0.05,0);
    band(640,16,132,'#9aa958');
    for(let i=0;i<9;i++){ctx.fillStyle='#7f9350';ctx.beginPath();ctx.ellipse(((i*260-sc*0.02)%2000)-100,652,60,26,0,0,TAU);ctx.fill();}
    ctx.restore();
    ctx.save();ctx.translate(-((sc*0.12)%400),0);
    band(730,14,133,'#7c9a52');
    ctx.restore();
    ctx.save();ctx.translate(-((sc*0.26)%500),0);
    band(858,10,134,'#5f7f42');
    flowerField(world.meadowFlowers.slice(30,54),t,1.2,4);
    ctx.restore();
    const back=Math.sin(Math.PI*rt(su,1000,1600))*(su<1700?1:0);
    drawRed({x:760,y:820,s:3.6,t:t,walk:su/480,mood:1,headRot:-back*0.45,look:{x:-back*1.4,y:0},bow:true,basketFull:true});
    butterfly(t,1050,620,'#e8e2d2',2.4);
    ctx.restore();
  }else{
    ctx.save();shotCam({cx:800,cy:470,z:1.03},t);
    skyV([[0,'#f2c88f'],[0.45,'#e8c88f'],[1,'#c9c08a']]);
    glowDisc(230,230,170,'rgba(255,240,200,.75)','rgba(255,240,200,0)');
    band(700,16,141,'#93a45a');
    band(760,10,142,'#71904c');
    // the forest wall
    ctx.fillStyle='#2c3b30';
    ctx.beginPath();ctx.moveTo(1060,900);
    for(let x=1060;x<=W+30;x+=44)ctx.lineTo(x,300+vnc(x*0.01,143)*60-(x-1060)*0.16);
    ctx.lineTo(W+30,900);ctx.closePath();ctx.fill();
    for(let i=0;i<world.edge.length;i++){
      const e=world.edge[i];
      trunkV(e.x+40,340,900,e.w,e.lean,e.s>0.5?'#22302a':'#1a2620');
    }
    // its long cold shadow across the meadow
    ctx.fillStyle='rgba(36,48,42,.3)';
    ctx.beginPath();ctx.moveTo(1080,900);ctx.lineTo(620,880);ctx.lineTo(900,760);ctx.lineTo(1160,820);ctx.closePath();ctx.fill();
    ribbonPath([{x:200,y:850},{x:600,y:826},{x:980,y:836},{x:1240,y:820}],40,20,'#dcc79b');
    ctx.strokeStyle='rgba(178,51,39,.4)';ctx.lineWidth=2;
    ctx.beginPath();ctx.moveTo(220,838);ctx.quadraticCurveTo(700,812,1230,810);ctx.stroke();
    const px=lerp(430,930,eio(su/sd));
    drawRed({x:px,y:836,s:1.8,t:t,walk:su/480,mood:0,bow:true,basketFull:true});
    if(su>sd*0.55)birdsFly(t,3,'rgba(30,38,32,.7)',1100,140,1);
    vignette(0.1);
    ctx.restore();
  }
}
function seq2(u,t){ // The Forest Threshold
  const [si,su,sd]=shotOf(u,CUTS[2]);
  if(si===0){
    ctx.save();shotCam({cx:800,cy:460,z:1.04},t);
    scnForest(t,{camX:su*0.03,dark:0.06,dapple:0.13,watchful:true});
    // a branch like a reaching hand
    ctx.strokeStyle='#2a3a30';ctx.lineWidth=11;ctx.lineCap='round';
    for(let i=0;i<5;i++){
      const a=0.5+i*0.17+ (MOTION?vnc(t*0.0007+i,151)*0.03:0);
      ctx.beginPath();ctx.moveTo(640,-12);
      ctx.quadraticCurveTo(640+Math.cos(a)*150,90+Math.sin(a)*70,640+Math.cos(a)*300,40+Math.sin(a)*230);
      ctx.stroke();
    }
    drawRed({x:lerp(260,1290,su/sd),y:826,s:1.62,t:t,walk:su/480,mood:0,bow:true,basketFull:true});
    ctx.restore();
  }else if(si===1){
    ctx.save();shotCam({cx:790,cy:520,z:1.05,hand:0.15},t);
    scnForest(t,{camX:200+su*0.09,dark:0.12,dapple:0.09,narrow:true});
    const up=Math.sin(Math.PI*rt(su,1100,1900));
    // moving branch-shadows over her
    drawRed({x:760,y:840,s:3.4,t:t,walk:su/480,mood:0,headRot:-up*0.24,look:{x:0.3*up,y:-up},bow:true,basketFull:true});
    ctx.fillStyle='rgba(26,36,30,.22)';
    for(let i=0;i<3;i++){
      ctx.save();ctx.translate(400+i*380,860);ctx.rotate(0.5+(MOTION?vnc(t*0.0008+i,152)*0.05:0));
      ctx.fillRect(-40,-820,54,880);ctx.restore();
    }
    // a bright dapple passes across her
    const bx=lerp(200,1400,su/sd);
    glowDisc(bx,600,240,'rgba(255,238,190,.16)','rgba(255,238,190,0)');
    ctx.restore();
  }else{
    ctx.save();shotCam({cx:800,cy:520,z:1.05},t);
    scnForest(t,{camX:520,dark:0.3,dapple:0.04,narrow:true,leaves:4});
    // converging tunnel
    for(let i=0;i<5;i++){
      trunkV(180+i*120,80-i*10,900,90-i*14,-0.02,i%2?'#1d2a22':'#233229');
      trunkV(1420-i*120,80-i*10,900,90-i*14,0.02,i%2?'#1c2921':'#223128');
    }
    const wp=su/sd;
    drawRedBack({x:800,y:lerp(834,772,wp),s:lerp(1.9,1.2,wp),t:t,walk:su/460});
    // two amber points, deep in
    const gp=Math.max(Math.sin(Math.PI*rt(su,1250,1650)),Math.sin(Math.PI*rt(su,1950,2350)));
    if(gp>0.01){
      ctx.globalAlpha=gp*0.9;
      glowDisc(998,556,14,'rgba(255,180,60,.8)','rgba(255,180,60,0)');
      glowDisc(1022,556,14,'rgba(255,180,60,.8)','rgba(255,180,60,0)');
      ctx.globalAlpha=1;
    }
    vignette(0.24);
    ctx.restore();
  }
}
function seq3(u,t){ // The Wolf Appears
  const [si,su,sd]=shotOf(u,CUTS[3]);
  if(si===0){
    ctx.save();shotCam({cx:800,cy:500,z:1.05},t);
    const camX=su*0.06;
    scnForest(t,{camX:camX,dark:0.18,dapple:0.08,skipNear:true});
    // a shape keeps pace behind the trees
    ctx.save();ctx.globalAlpha=0.92;
    drawWolf({x:220+su*0.22,y:786,s:1.75,t:t,face:1,run:0.3,phase:su/420,dark:0.85,glow:0.5,shadow:false});
    ctx.restore();
    nearTrunksDraw(camX,0.18);
    drawRed({x:lerp(380,720,su/sd),y:828,s:1.9,t:t,walk:su/480,mood:0,bow:true,basketFull:true});
    ctx.restore();
  }else if(si===1){
    skyV([[0,'#3d5244'],[0.5,'#46604e'],[1,'#324438']]);
    for(let i=0;i<6;i++){ctx.fillStyle=i%2?'rgba(30,44,36,.8)':'rgba(38,54,44,.8)';ctx.beginPath();ctx.ellipse(180+i*280,380+(i%3)*160,180,320,0.1,0,TAU);ctx.fill();}
    dapples(t,0.06,0.6);
    const lookX=lerp(-0.6,1.2,eio(rt(su,700,1300)));
    const br=1+Math.sin(t*0.005)*0.006;
    ctx.save();ctx.translate(760,470);ctx.scale(br,br);ctx.translate(-760,-470);
    hoodCU(760,470,150,{mood:-1,look:{x:lookX,y:0.1},blink:blinkAt(t,5)},t);
    ctx.restore();
    vignette(0.16);
  }else if(si===2){
    ctx.save();shotCam({cx:820,cy:520,z:1.06},t);
    scnForest(t,{camX:520,dark:0.22,dapple:0.05,path:false});
    glowDisc(830,660,240,'rgba(255,236,180,.2)','rgba(255,236,180,0)');
    trunkV(1210,0,H,160,0.02,'#18241d');
    const wx=lerp(1180,880,eio(sat(su/1800)));
    const dk=sat((wx-880)/300)*0.9;
    const sit=eio(rt(su,1800,2400));
    const bow=Math.sin(Math.PI*rt(su,2400,3000))*0.14;
    drawWolf({x:wx,y:812,s:2.05,t:t,face:-1,run:su<1800?0.2:0,phase:su/430,dark:dk,sit:sit,pitch:bow,lid:0.25,glow:0.5+0.5*(1-dk)});
    ctx.restore();
  }else if(si===3){
    ctx.save();shotCam({cx:820,cy:520,z:1.05+0.05*(su/sd)},t);
    scnForest(t,{camX:560,dark:0.24,dapple:0.05});
    const talk=(t>=35200&&t<=37950)?(0.06+0.05*Math.sin(su*0.02)):0;
    drawWolf({x:1040,y:812,s:2.35,t:t,face:-1,sit:1,phase:0,dark:0.08,grin:talk,lid:0.3,pitch:0.03});
    ctx.restore();
    redOTSFore();
    vignette(0.14);
  }else{
    ctx.save();shotCam({cx:760,cy:520,z:1.04},t);
    scnForest(t,{camX:480,dark:0.12,dapple:0.1});
    const nod=Math.sin(Math.PI*rt(su,500,900))*0.14;
    drawRed({x:620,y:816,s:1.95,t:t,walkAmp:0,walk:0,mood:-1,headRot:nod,look:{x:1,y:0.1},bow:true,basketFull:true});
    ctx.restore();
    wolfOTSFore();
    vignette(0.14);
  }
}
function seq4(u,t){ // The Question
  const [si,su,sd]=shotOf(u,CUTS[4]);
  if(si===0){
    ctx.save();shotCam({cx:790,cy:520,z:1.05},t);
    scnForest(t,{camX:610,dark:0.15,dapple:0.1});
    // through a gap: the hill with the three old oaks
    glowDisc(1300,300,110,'rgba(240,235,190,.75)','rgba(240,235,190,0)');
    ctx.fillStyle='#8b8f62';ctx.beginPath();ctx.ellipse(1300,340,100,34,0,0,TAU);ctx.fill();
    for(let i=0;i<3;i++){
      ctx.fillStyle='#4c5a42';
      ctx.fillRect(1262+i*34,296,5,38);
      ctx.beginPath();ctx.arc(1264+i*34,290,16,0,TAU);ctx.fill();
    }
    const pt=eio(rt(su,500,1200));
    drawRed({x:440,y:822,s:2.15,t:t,walkAmp:0,walk:0,mood:0,point:pt,look:{x:1,y:-0.2},bow:true});
    drawBasket(400,780,1.9,{full:true});
    drawWolf({x:1150,y:826,s:2.05,t:t,face:-1,sit:1,dark:0.1,lid:0.25,pitch:0.06+0.04*Math.sin(su*0.0012)});
    ctx.restore();
  }else if(si===1){
    ctx.save();shotCam({cx:800,cy:450,z:1+0.1*(su/sd)},t);
    skyV([[0,'#31443a'],[0.5,'#3a5044'],[1,'#26362e']]);
    dapples(t,0.05,0.5);
    drawBasket(500,620,7,{full:true});
    ctx.save();ctx.translate(1120,300);ctx.scale(-5,5);
    wolfHead({x:0,y:0,s:1,pitch:0.26,lid:0.35,glow:0.8,notch:'far',px:lerp(0,-2.2,eio(rt(su,1500,2200)))});
    ctx.restore();
    vignette(0.2);
    ctx.restore();
  }else if(si===2){
    ctx.save();shotCam({cx:760,cy:520,z:1.04},t);
    scnForest(t,{camX:660,dark:0.18,dapple:0.05});
    const sha=0.1+0.4*eio(rt(su,400,1300));
    lightShaft(240,120,180,460,860,sha,true);
    for(let i=0;i<14;i++){
      const F=world.clearFlowers[i];
      flowerHead(120+((F.x*0.15)%220),700+((F.y*0.3)%120),7,F.k,true);
    }
    butterfly(t,240,640,'#e8e2d2',0.4);
    butterfly(t,330,600,'#e9c766',2.1);
    const turn=eio(rt(su,540,1260));
    drawRed({x:700,y:830,s:2.2,t:t,walkAmp:0,walk:0,mood:0,headRot:-0.42*turn,look:{x:-1.3*turn,y:0},bow:true,basketFull:true});
    const sweep=lerp(0.12,-0.14,eio(rt(su,300,1100)));
    drawWolf({x:1270,y:866,s:2.7,t:t,face:-1,sit:1,dark:0.15,pitch:sweep,lid:0.3});
    ctx.restore();
  }else{
    // push into the amber eye — it will become the sun
    skyV([[0,'#22312a'],[1,'#141f1a']]);
    const zp=eio(su/sd);
    const s=lerp(4,10,zp);
    ctx.save();ctx.translate(800+14*s,430+9*s);ctx.scale(-s,s);
    wolfHead({x:0,y:0,s:1,pitch:0,lid:0.3+zp*0.25,glow:1,notch:'far'});
    ctx.restore();
    const ir=eo(rt(su,1000,1700));
    if(ir>0){
      const r=lerp(90,230,ir);
      glowDisc(800,430,r*1.7,'rgba(255,190,80,'+(0.5*ir)+')','rgba(255,190,80,0)');
      const g=ctx.createRadialGradient(800,430,r*0.1,800,430,r);
      g.addColorStop(0,'#ffd98e');g.addColorStop(0.55,'#f5a92c');g.addColorStop(1,'#b06a14');
      ctx.fillStyle=g;ctx.globalAlpha=ir;
      ctx.beginPath();ctx.arc(800,430,r,0,TAU);ctx.fill();ctx.globalAlpha=1;
      ctx.fillStyle='rgba(30,16,4,'+ir+')';
      ctx.beginPath();ctx.ellipse(800,430,lerp(34,13,ir),r*0.62,0,0,TAU);ctx.fill();
      ctx.fillStyle='rgba(20,30,24,'+(0.9*ir)+')';
      ctx.beginPath();ctx.moveTo(800-r*1.3,430-r*1.1);ctx.quadraticCurveTo(800,430-r*(1.34-ir*0.42),800+r*1.3,430-r*1.1);ctx.lineTo(800+r*1.3,430-r*2.2);ctx.lineTo(800-r*1.3,430-r*2.2);ctx.closePath();ctx.fill();
      ctx.beginPath();ctx.moveTo(800-r*1.3,430+r*1.1);ctx.quadraticCurveTo(800,430+r*(1.34-ir*0.4),800+r*1.3,430+r*1.1);ctx.lineTo(800+r*1.3,430+r*2.2);ctx.lineTo(800-r*1.3,430+r*2.2);ctx.closePath();ctx.fill();
    }
    vignette(0.3);
  }
}
function seq5(u,t){ // The Race — parallel editing, accelerating
  const [si,su,sd]=shotOf(u,CUTS[5]);
  const bq=0.15+0.85*(u/10000);
  if(si%2===0){ // Red, bright clearing
    if(si===0){
      const zp=eio(su/1400);
      const z=lerp(3.38,1,sat(zp));
      ctx.save();shotCam({cx:800,cy:lerp(430,450,sat(zp)),z:z},t);
      scnClearing(t);
      redPick(700,800,2.6,t,su,bq);
      ctx.restore();
    }else if(si===2){
      ctx.save();shotCam({cx:lerp(740,800,su/sd),cy:560,z:1.3},t);
      scnClearing(t);
      redPick(700,790,2.6,t,su,bq);
      ctx.restore();
    }else if(si===4){
      ctx.save();shotCam({cx:700,cy:620,z:1.85,hand:0.1},t);
      scnClearing(t);
      redPick(690,780,2.6,t,su,bq);
      ctx.strokeStyle='rgba(178,51,39,.85)';ctx.lineWidth=2.4;
      ctx.beginPath();ctx.moveTo(905,700);
      ctx.quadraticCurveTo(918,680+vnc(t*0.004,161)*8,935,690+vnc(t*0.004,162)*10);ctx.stroke();
    }else if(si===6){
      skyV([[0,'#f2e8a8'],[1,'#c2cf7e']]);
      glowDisc(800,300,420,'rgba(255,246,210,.5)','rgba(255,246,210,0)');
      const snapP=eio(rt(su,240,420));
      ctx.strokeStyle='#54763c';ctx.lineWidth=10;
      for(let i=0;i<3;i++){
        const fx2=560+i*230,tilt=(i===1?snapP*0.9:0);
        ctx.save();ctx.translate(fx2,860);ctx.rotate(-tilt);
        ctx.beginPath();ctx.moveTo(0,0);ctx.quadraticCurveTo(20,-160,10,-300);ctx.stroke();
        flowerHead(10,-300,42,i+1,true);
        ctx.restore();
      }
      ctx.strokeStyle='#2c3550';ctx.lineWidth=34;ctx.lineCap='round';
      ctx.beginPath();ctx.moveTo(1400,900);ctx.lineTo(lerp(1160,860,eio(su/sd)),lerp(700,560,eio(su/sd)));ctx.stroke();
      ctx.fillStyle='#f6cfa6';
      ctx.beginPath();ctx.ellipse(lerp(1150,850,eio(su/sd)),lerp(690,550,eio(su/sd)),30,38,0.5,0,TAU);ctx.fill();
      for(let i=0;i<4;i++){
        const pp=(su*0.001+i*0.3)%1;
        ctx.fillStyle='rgba(232,226,210,'+(1-pp)+')';
        ctx.beginPath();ctx.ellipse(700+i*140+pp*60,300+pp*380,9,4,pp*4,0,TAU);ctx.fill();
      }
    }else{
      skyV([[0,'#f7eab2'],[1,'#cdd88a']]);
      glowDisc(400,260,300,'rgba(255,246,210,.6)','rgba(255,246,210,0)');
      hoodCU(760,480,165,{mood:1,look:{x:-0.3,y:0.4},blink:blinkAt(t,5)},t);
      for(let i=0;i<5;i++){
        const pp=(su*0.0012+i*0.22)%1;
        ctx.fillStyle='rgba(255,250,235,'+(0.9*(1-pp))+')';
        ctx.beginPath();ctx.ellipse(300+i*260+pp*80,120+pp*560,10,4.4,pp*5,0,TAU);ctx.fill();
      }
    }
  }else{ // the wolf's shortcut, dark
    const variant=si===1?0:si===3?1:si===5?2:si===7?3:0;
    ctx.save();shotCam({cx:800,cy:470,z:1.05,rot:si===5?0.05:0,hand:0.25},t);
    scnShortcut(t,variant,su*(1.3+si*0.12));
    if(si===1){
      drawWolf({x:740,y:800,s:2.3,t:t,face:1,run:1,phase:su/360,glow:0.9});
      ctx.strokeStyle='rgba(150,180,200,.2)';ctx.lineWidth=6;
      for(let i=0;i<4;i++){ctx.beginPath();ctx.moveTo(600-i*90,730+i*24);ctx.lineTo(760-i*90,736+i*24);ctx.stroke();}
    }else if(si===3){
      const jp=su/sd;
      drawWolf({x:lerp(380,1150,jp),y:800-Math.sin(Math.PI*jp)*170,s:2.25,t:t,face:1,run:1,phase:0.22,glow:0.9,shadow:false});
    }else if(si===5){
      ctx.save();ctx.translate(780,760);ctx.rotate(0.14);
      drawWolf({x:0,y:0,s:2.4,t:t,face:1,run:1,phase:su/340,glow:0.9,shadow:false});
      ctx.restore();
    }else if(si===7){
      ctx.save();ctx.translate(lerp(140,1420,su/sd),700);ctx.scale(1.5,1);
      drawWolf({x:0,y:0,s:3.6,t:t,face:1,run:1,phase:su/300,glow:1,shadow:false});
      ctx.restore();
      ctx.fillStyle='rgba(10,16,20,.85)';
      band(820,30,163,'rgba(10,16,20,.9)');
    }else{ // si===9 — the crest, the cottage in sight
      ctx.fillStyle='#0c141b';
      ctx.beginPath();ctx.moveTo(0,900);ctx.lineTo(0,760);ctx.quadraticCurveTo(700,640,1600,780);ctx.lineTo(1600,900);ctx.closePath();ctx.fill();
      glowDisc(1290,700,120,'rgba(214,196,150,.3)','rgba(214,196,150,0)');
      ctx.fillStyle='#221d16';ctx.fillRect(1258,700,64,34);
      ctx.beginPath();ctx.moveTo(1250,700);ctx.lineTo(1290,674);ctx.lineTo(1330,700);ctx.closePath();ctx.fill();
      for(let i=0;i<3;i++){ctx.fillStyle='#1a2018';ctx.beginPath();ctx.arc(1230+i*56,664,20,0,TAU);ctx.fill();}
      drawWolf({x:700,y:730,s:2.2,t:t,face:1,run:0.5,phase:su/380,dark:0.7,glow:1,headLow:0.5,shadow:false});
    }
    ctx.restore();
    vignette(0.2);
  }
}
