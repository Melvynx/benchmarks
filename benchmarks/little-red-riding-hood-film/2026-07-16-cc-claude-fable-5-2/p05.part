
function knockAnim(su,t0){
  let paw=0,shake=0;
  for(let i=0;i<KNOCK.length;i++){
    const d=su-(t0+KNOCK[i]);
    if(d>-140&&d<0)paw=Math.max(paw,1-(-d/140));
    else if(d>=0&&d<130)paw=Math.max(paw,1-d/130);
    if(d>=0&&d<110)shake=Math.max(shake,1-d/110);
  }
  return{paw:paw,shake:shake};
}
function seq6(u,t){ // At Grandmother's Door
  const [si,su,sd]=shotOf(u,CUTS[6]);
  if(si===0){
    ctx.save();shotCam({cx:800,cy:520,z:1.05},t);
    scnCottageExt(t,{smoke:0.25});
    const wp=eio(su/sd);
    drawWolf({x:lerp(60,730,wp),y:858,s:1.8,t:t,face:1,run:lerp(0.7,0.15,wp),phase:su/400,headLow:0.4,glow:0.8});
    if(su>700&&su<1700){
      const cp=rt(su,700,1700);
      ctx.strokeStyle='rgba(30,34,30,.85)';ctx.lineWidth=3;ctx.lineCap='round';
      const bx2=1060-cp*260,by2=430-eo(cp)*180+ei(cp)*120;
      ctx.beginPath();ctx.moveTo(bx2-10,by2);ctx.quadraticCurveTo(bx2,by2-8+Math.sin(t*0.03)*5,bx2+10,by2);ctx.stroke();
    }
    ctx.restore();
  }else if(si===1){
    const K=knockAnim(su,300);
    ctx.save();shotCam({cx:850,cy:640,z:2.25,hand:0.12},t);
    ctx.save();ctx.translate(K.shake*3*MOTION,0);
    scnCottageExt(t,{smoke:0.25});
    ctx.restore();
    const slip=eio(rt(su,2100,2500));
    drawWolf({x:698+slip*80,y:864,s:1.7,t:t,face:1,sit:1-slip,phase:0,headLow:0.2,lid:0.2,glow:0.9,
      headOut:K.paw*4});
    if(K.paw>0.02){
      ctx.strokeStyle='#454b57';ctx.lineWidth=11;ctx.lineCap='round';
      ctx.beginPath();ctx.moveTo(740,830);
      ctx.quadraticCurveTo(766,800-K.paw*26,788,796-K.paw*30);ctx.stroke();
    }
    ctx.globalAlpha=slip;ctx.fillStyle='rgba(10,9,8,.65)';
    if(slip>0)ctx.fillRect(800,716,86*propsAt(t).door*0.55+8,104);
    ctx.globalAlpha=1;
    vignette(0.18);
    ctx.restore();
  }else{
    ctx.save();shotCam({cx:780,cy:540,z:1.06},t);
    scnCottageInt(t,{dim:0.32,doorLight:0.45,nightView:false});
    // his shadow crosses the room — the danger, told sideways
    const sp=eio(sat(su/2600));
    const shx=lerp(340,1060,sp);
    ctx.save();ctx.globalAlpha=0.38;
    ctx.translate(shx,850);ctx.transform(1,0,-0.55,1,0,0);ctx.scale(1.35,1.5);
    drawWolf({x:0,y:0,s:2,t:t,face:1,run:0.15,phase:su/560,dark:1,glow:0,shadow:false,
      pitch:su>2000&&su<2900?0.3:0,headLow:su>2000&&su<2900?0.6:0.1});
    ctx.restore();
    // spectacles catch the last light
    const gl=Math.sin(Math.PI*rt(su,3300,3700));
    if(gl>0.01){
      ctx.strokeStyle='rgba(255,240,200,'+(gl*0.9)+')';ctx.lineWidth=2;
      ctx.beginPath();ctx.moveTo(914,590);ctx.lineTo(938,610);ctx.moveTo(938,590);ctx.lineTo(914,610);ctx.stroke();
    }
    vignette(0.26);
    ctx.restore();
  }
}
function seq7(u,t){ // The Disguise — cross-cut
  const [si,su,sd]=shotOf(u,CUTS[7]);
  if(si===0){
    ctx.save();shotCam({cx:1100,cy:620,z:1.65},t);
    scnCottageInt(t,{dim:0.34});
    const slip=lerp(0.6,0,eio(rt(su,600,1700)));
    drawWolf({x:1010,y:852,s:2.25,t:t,face:-1,sit:1,phase:0,lid:0.2,glow:0.8,
      cap:su>500,capSlip:slip,pitch:-0.06});
    if(su<1900){
      ctx.strokeStyle='#454b57';ctx.lineWidth=12;ctx.lineCap='round';
      const tug=Math.sin(su*0.006)*8;
      ctx.beginPath();ctx.moveTo(980,790);ctx.quadraticCurveTo(940,720,912+tug*0.4,652+tug);ctx.stroke();
    }
    vignette(0.2);
    ctx.restore();
  }else if(si===1){
    ctx.save();shotCam({cx:790,cy:500,z:1.04},t);
    skyV([[0,'#8fa671'],[0.5,'#9db479'],[1,'#6d8a58']]);
    dapples(t,0.12,0.8);
    for(let i=0;i<8;i++){
      const bx3=((i*230-su*0.06)%1900+1900)%1900-150;
      trunkV(bx3,60,900,26,vnc(i,171)*0.04,'#e4ded0');
      ctx.fillStyle='#4a4438';
      for(let j2=0;j2<5;j2++)ctx.fillRect(bx3-9,140+j2*130+vnc(i+j2,172)*40,10,7);
    }
    band(800,14,173,'#5c7648');
    glowDisc(1430,700,90,'rgba(230,220,180,.4)','rgba(230,220,180,0)');
    ctx.fillStyle='#2f2a20';ctx.fillRect(1404,690,56,30);
    ctx.beginPath();ctx.moveTo(1396,690);ctx.lineTo(1432,668);ctx.lineTo(1468,690);ctx.closePath();ctx.fill();
    drawRed({x:760,y:838,s:3,t:t,walk:su/470,mood:1,bouquet:0.95,bow:true,basketFull:true});
    ctx.restore();
  }else if(si===2){
    ctx.save();shotCam({cx:800,cy:470,z:1.05},t);
    skyV([[0,'#5a5e64'],[0.6,'#63666a'],[1,'#4c4e54']]);
    ctx.fillStyle='#efe6d2';ctx.beginPath();ctx.ellipse(1180,660,300,150,-0.06,0,TAU);ctx.fill();
    ctx.save();ctx.translate(880,480);ctx.scale(-5,5);
    wolfHead({x:0,y:0,s:1,pitch:0.05,lid:0.4,glow:0.7,notch:'far',cap:true,capSlip:0.1,
      specs:su>400,t:t});
    ctx.restore();
    if(su<900){
      const pr=eio(su/900);
      ctx.fillStyle='#454b57';
      ctx.beginPath();ctx.ellipse(lerp(760,830,pr),lerp(760,560,pr),40,26,0.6,0,TAU);ctx.fill();
    }
    const qy=lerp(760,640,eio(rt(su,300,1300)));
    quiltPat(140,qy,1320,900-qy,52);
    if(su>1400){
      const rp2=eio(rt(su,1400,1750));
      ctx.strokeStyle='#454b57';ctx.lineWidth=26;ctx.lineCap='round';
      ctx.beginPath();ctx.moveTo(1080,620);ctx.quadraticCurveTo(1200,540,lerp(1200,1420,rp2),lerp(560,380,rp2));ctx.stroke();
    }
    vignette(0.2);
    ctx.restore();
  }else if(si===3){
    ctx.save();shotCam({cx:800,cy:540,z:1.14},t);
    scnCottageExt(t,{smoke:0.15});
    trunkV(120,-40,H,220,-0.02,'#141d17');
    trunkV(1480,-40,H,240,0.02,'#121a15');
    const pause=1-Math.sin(Math.PI*rt(su,600,1100))*0.9;
    drawRed({x:lerp(260,560,eio(su/sd)),y:864,s:2.05,t:t,walk:su/500,walkAmp:pause,
      mood:0,bouquet:0.95,bow:true,basketFull:true,headRot:(1-pause)*0.12});
    vignette(0.14);
    ctx.restore();
  }else{
    ctx.save();shotCam({cx:1020,cy:560,z:1.04+0.07*(su/sd)},t);
    scnCottageInt(t,{dim:0.4,motes:true,nightView:true});
    quiltPat(1010,616,330,66,30);
    ctx.save();ctx.translate(1318,600);ctx.scale(-2.1,2.1);
    wolfHead({x:0,y:0,s:1,pitch:0.1,lid:0.4,glow:1,notch:'far',cap:true,specs:true,t:t});
    ctx.restore();
    vignette(0.26);
    ctx.restore();
  }
}
function seq8(u,t){ // Red Arrives
  const [si,su,sd]=shotOf(u,CUTS[8]);
  if(si===0){
    const K=knockAnim(su,800);
    ctx.save();shotCam({cx:840,cy:630,z:2.05,hand:0.1},t);
    ctx.save();ctx.translate(K.shake*2.4*MOTION,0);
    scnCottageExt(t,{smoke:0.12});
    ctx.restore();
    const step=eio(rt(su,1900,2500));
    drawRed({x:706+step*70,y:868,s:1.75,t:t,walk:su<1900?0:su/480,walkAmp:step,mood:-1,
      headRot:0.1-step*0.1,look:{x:1,y:0},bow:true,basketFull:true,point:K.paw*0.9});
    vignette(0.2);
    ctx.restore();
  }else if(si===1){
    ctx.save();shotCam({cx:640,cy:540,z:1.07},t);
    scnCottageInt(t,{dim:0.36,doorLight:0.85,motes:true});
    const wp=eio(sat(su/2000));
    const rx=lerp(250,470,wp);
    ctx.save();ctx.globalAlpha=0.3;
    ctx.translate(rx+30,856);ctx.transform(1,0,-1.5,0.34,0,0);
    drawRedBack({x:0,y:0,s:2.4,t:t,walk:0});
    ctx.restore();
    const bend=Math.sin(Math.PI*rt(su,1800,2500))*0.3;
    drawRed({x:rx,y:854,s:2.4,t:t,walk:su<2000?su/520:0,walkAmp:su<2000?1:0,mood:-1,
      headRot:bend,look:{x:0.6,y:0.4},bow:true,basket:su<1800,basketFull:true});
    vignette(0.2);
    ctx.restore();
  }else if(si===2){
    ctx.save();shotCam({cx:lerp(520,1220,eio(su/sd)),cy:660,z:1.95,hand:0.1},t);
    scnCottageInt(t,{dim:0.42,motes:true});
    vignette(0.24);
    ctx.restore();
  }else{
    ctx.save();shotCam({cx:lerp(900,1070,eio(su/sd)),cy:590,z:lerp(1.22,1.5,eio(su/sd)),hand:0.4},t);
    scnCottageInt(t,{dim:0.44,nightView:true});
    lightShaft(700,560,120,420,900,0.12,false);
    const reach=eio(rt(su,1400,1900));
    drawRedBack({x:lerp(780,952,eio(su/sd)),y:852,s:2.5,t:t,walk:su/760,walkAmp:0.55});
    if(reach>0.01){
      ctx.strokeStyle='#2c3550';ctx.lineWidth=10;ctx.lineCap='round';
      ctx.beginPath();ctx.moveTo(lerp(780,952,eio(su/sd))+18,742);
      ctx.lineTo(lerp(780,952,eio(su/sd))+18+reach*70,742-reach*60);ctx.stroke();
      ctx.fillStyle='#f6cfa6';ctx.beginPath();ctx.arc(lerp(780,952,eio(su/sd))+20+reach*70,740-reach*62,6,0,TAU);ctx.fill();
    }
    vignette(0.3);
    ctx.restore();
  }
}
function seq9(u,t){ // What Big… — closer and closer
  const [si,su,sd]=shotOf(u,CUTS[9]);
  const talkW=(o)=>0.08+0.06*Math.sin(su*0.02);
  if(si===0){
    ctx.save();shotCam({cx:1040,cy:610,z:1.42,hand:0.08},t);
    scnCottageInt(t,{dim:0.45,nightView:true});
    quiltPat(1020,620,320,62,28);
    ctx.save();ctx.translate(1310,602);ctx.scale(-2,2);
    wolfHead({x:0,y:0,s:1,pitch:0.1,lid:0.4,glow:1,notch:'far',cap:true,specs:true,t:t});
    ctx.restore();
    drawRed({x:850,y:856,s:2.5,t:t,walkAmp:0,walk:0,mood:-1,look:{x:1,y:-0.5},bow:true,basket:false});
    vignette(0.3);
    ctx.restore();
  }else if(si===1){
    skyV([[0,'#43464e'],[0.6,'#4c4d52'],[1,'#36373c']]);
    ctx.fillStyle='#e6dcc6';ctx.beginPath();ctx.ellipse(1150,700,420,190,-0.05,0,TAU);ctx.fill();
    ctx.save();ctx.translate(880,480);ctx.scale(-5.4,5.4);
    wolfHead({x:0,y:0,s:1,pitch:0.06,lid:0.42,glow:1,notch:'far',cap:true,specs:true,
      grin:(t>=86350&&t<=88050)?talkW():0,t:t});
    ctx.restore();
    quiltPat(60,720,1480,180,64);
    vignette(0.3);
  }else if(si===2){
    skyV([[0,'#3e4149'],[1,'#2e3036']]);
    hoodCU(760,480,150,{mood:-1,look:{x:0.9,y:lerp(-0.2,-0.9,eio(rt(su,600,1200)))},blink:blinkAt(t,5)},t);
    vignette(0.3);
  }else if(si===3){
    skyV([[0,'#3a3d44'],[1,'#2b2d32']]);
    // the nightcap slips — the notched left ear stands up and listens
    ctx.fillStyle='#ece2cc';
    ctx.beginPath();ctx.moveTo(-40,940);ctx.quadraticCurveTo(420,380,980,560);ctx.quadraticCurveTo(1240,660,1300,940);ctx.closePath();ctx.fill();
    ctx.strokeStyle='#cbbfa4';ctx.lineWidth=8;
    ctx.beginPath();ctx.moveTo(60,880);ctx.quadraticCurveTo(500,520,960,600);ctx.stroke();
    const pop=eio(sat(su/700));
    const swv=Math.sin(su*0.008)*0.1*MOTION;
    ctx.save();ctx.translate(950,lerp(560,320,pop));ctx.rotate(-0.12+swv);
    ctx.fillStyle='#454b57';
    ctx.beginPath();
    ctx.moveTo(-90,240);ctx.lineTo(-24,-160);
    ctx.lineTo(8,-62);ctx.lineTo(44,-118);
    ctx.lineTo(120,240);ctx.closePath();ctx.fill();
    ctx.fillStyle='#2e3138';
    ctx.beginPath();ctx.moveTo(-48,200);ctx.lineTo(-8,-90);ctx.lineTo(52,200);ctx.closePath();ctx.fill();
    ctx.restore();
    glowDisc(210,800,120,'rgba(255,180,60,.3)','rgba(255,180,60,0)');
    vignette(0.32);
  }else if(si===4){
    skyV([[0,'#35373d'],[1,'#232429']]);
    const back=su*0.014*MOTION;
    ctx.save();ctx.translate(back*0.4,0);
    hoodCU(760+back,470,192,{mood:su>800?-2:-1,look:{x:1,y:0},blink:blinkAt(t,5)},t);
    ctx.restore();
    vignette(0.34);
  }else{
    skyV([[0,'#26272c'],[1,'#17181c']]);
    const gp=eio(sat(su/1500));
    ctx.save();ctx.translate(1060,430);ctx.scale(-8,8);
    wolfHead({x:0,y:0,s:1,pitch:0.04,lid:lerp(0.4,0,gp),glow:1,notch:'far',
      cap:true,capSlip:lerp(0.3,1.1,gp),grin:lerp(0.25,1,gp),t:t});
    ctx.restore();
    const fl3=eo(rt(su,1500,1800));
    if(fl3>0)glowDisc(948,358,180*fl3,'rgba(255,170,50,'+(0.5*fl3)+')','rgba(255,170,50,0)');
    ctx.fillStyle='rgba(8,8,12,'+(gp*0.28)+')';ctx.fillRect(0,0,W,H);
    vignette(0.36);
  }
}
function seq10(u,t){ // The Rescue
  const [si,su,sd]=shotOf(u,CUTS[10]);
  if(si===0){
    ctx.save();shotCam({cx:800,cy:580,z:1.14,hand:0.45},t);
    scnCottageInt(t,{dim:0.42,nightView:true});
    if(su<420){
      ctx.save();ctx.translate(lerp(1160,880,su/420),lerp(650,760,su/420));ctx.rotate(-su*0.002);
      quiltPat(-120,-40,240,80,26);ctx.restore();
    }
    const lp=eio(sat(su/700));
    const wx2=lerp(1150,740,lp),wy2=800-Math.sin(Math.PI*lp)*150;
    drawWolf({x:wx2,y:wy2,s:2.3,t:t,face:-1,run:su<700?1:0,phase:0.2,grin:0.9,hackles:true,
      crouch:su>700?1:0.3,glow:1,shadow:su>=700});
    ctx.strokeStyle='rgba(120,130,150,.2)';ctx.lineWidth=7;
    for(let i=0;i<3;i++){ctx.beginPath();ctx.moveTo(wx2+140+i*40,wy2-90+i*30);ctx.lineTo(wx2+260+i*40,wy2-104+i*30);ctx.stroke();}
    if(su<900){
      drawRed({x:lerp(700,478,eio(su/900)),y:848,s:2.2,t:t,face:-1,walk:su/230,mood:-2,
        look:{x:1,y:0},bow:true,basket:false});
    }else{
      drawRed({x:470,y:846,s:2.2,t:t,face:-1,walkAmp:0,walk:0,mood:-2,headRot:-0.15,look:{x:1,y:-0.3},bow:true,basket:false});
    }
    vignette(0.3);
    ctx.restore();
  }else if(si===1){
    ctx.save();shotCam({cx:790,cy:530,z:1.06},t);
    scnForest(t,{camX:300,dark:0.2,dapple:0.05});
    const go=su>520;
    drawWoodsman({x:go?lerp(680,1150,eio(rt(su,520,1200))):680,y:846,s:2.3,t:t,face:1,
      walk:su/300,walkAmp:go?1:0,axeAng:-0.5});
    ctx.restore();
  }else if(si===2){
    ctx.save();shotCam({cx:700,cy:560,z:1.16,hand:0.2},t);
    scnCottageInt(t,{dim:0.38,doorLight:0.95,motes:true});
    lightShaft(430,330,340,900,900,0.3,false);
    // the woodsman fills the doorway — an outline of ochre and axe
    ctx.save();ctx.translate(248,850);
    ctx.globalAlpha=0.92;
    drawWoodsman({x:0,y:0,s:2.75,t:t,face:1,walkAmp:0,axeAng:-1.25});
    ctx.fillStyle='rgba(18,22,30,.5)';
    ctx.fillRect(-90,-320,180,330);
    ctx.restore();
    drawWolf({x:870,y:806,s:2.2,t:t,face:-1,crouch:1,grin:0.7,hackles:true,glow:1,tailDown:1});
    drawRed({x:470,y:842,s:2.15,t:t,face:1,walkAmp:0,walk:0,mood:-2,look:{x:-1,y:0},bow:true,basket:false});
    vignette(0.26);
    ctx.restore();
  }else if(si===3){
    ctx.save();shotCam({cx:740,cy:540,z:1.1,hand:0.15},t);
    scnCottageInt(t,{dim:0.34,doorLight:0.8});
    const stride=eio(sat(su/800));
    drawWoodsman({x:lerp(340,620,stride),y:852,s:2.5,t:t,face:1,walk:su/380,walkAmp:1-stride,
      axeAng:lerp(-1.25,0,eio(rt(su,600,1100)))});
    const flee=eio(rt(su,800,1400));
    const post=rt(su,1400,2000);
    if(su<1400){
      drawWolf({x:lerp(880,660,flee*0.2),y:810,s:2.15,t:t,face:-1,crouch:1,grin:lerp(0.7,0.2,flee),
        tailDown:1,glow:1,headLow:flee*0.5});
    }else{
      const jx2=lerp(820,566,post),jy2=lerp(780,320,eo(post));
      drawWolf({x:jx2,y:jy2,s:lerp(2.1,1.1,post),t:t,face:-1,run:1,phase:su/300,glow:0.8,shadow:false,dark:post*0.5});
    }
    if(su>=2000){
      const away=rt(su,2000,2000+ (sd-2000));
      ctx.fillStyle='rgba(16,22,28,'+(0.9-away*0.6)+')';
      ctx.save();ctx.translate(556-away*60,286-away*20);ctx.scale(1-away*0.55,1-away*0.55);
      ctx.beginPath();ctx.ellipse(0,0,34,12,-0.15,0,TAU);ctx.fill();
      ctx.restore();
    }
    drawRed({x:460,y:844,s:2.1,t:t,face:1,walkAmp:0,walk:0,mood:-2,look:{x:1,y:-0.4},bow:true,basket:false});
    vignette(0.24);
    ctx.restore();
  }else{
    ctx.save();shotCam({cx:1120,cy:600,z:1.42},t);
    const warm=eio(su/sd)*0.16;
    scnCottageInt(t,{dim:lerp(0.34,0.2,su/sd),nightView:true});
    const gp2=eio(rt(su,200,900));
    drawGran({x:lerp(1452,1330,gp2),y:854,s:2.3,t:t,face:-1,specs:t>=102900,quilt:false,
      arms:eio(rt(su,1800,2300))});
    const rx2=su<900?lerp(700,880,eio(su/900)):su<1400?880:lerp(880,1220,eio(rt(su,1400,1800)));
    const bend2=Math.sin(Math.PI*rt(su,900,1400))*0.4;
    drawRed({x:rx2,y:850,s:2.2,t:t,face:1,walk:su/300,walkAmp:(su<900||((su>1400)&&su<1800))?0.9:0,
      mood:1,headRot:bend2,look:{x:0.8,y:bend2},bow:true,basket:false});
    drawWoodsman({x:430,y:856,s:2.2,t:t,face:-1,walkAmp:0,axeAng:0.2});
    ctx.fillStyle='rgba(255,190,130,'+warm+')';ctx.fillRect(0,0,W,H);
    vignette(0.22);
    ctx.restore();
  }
}
function seq11(u,t){ // The Path Home — the departure shot, transformed
  const [si,su,sd]=shotOf(u,CUTS[11]);
  if(si===0){
    ctx.save();shotCam({cx:740,cy:590,z:1.13},t);
    scnCottageExt(t,{dawn:true,winLit:true,smoke:0.8});
    drawGran({x:840,y:862,s:1.95,t:t,face:-1,specs:true,quilt:true,arms:0.2});
    drawWoodsman({x:920,y:868,s:2.05,t:t,face:-1,walkAmp:0,axeAng:0.12});
    const wavp=Math.sin(Math.PI*rt(su,1750,2400));
    const walking=su<1750||su>2400;
    drawRed({x:lerp(700,300,eio(su/sd)),y:872,s:1.72,t:t,face:walking?-1:1,
      walk:su/500,walkAmp:walking?1:0,mood:1,point:wavp,look:{x:walking?0:1,y:-0.2},
      bow:true,basketFull:false});
    ctx.restore();
