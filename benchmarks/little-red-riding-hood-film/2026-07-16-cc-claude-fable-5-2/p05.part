function describe(k,u,t){
  const cuts=CUTS[k],so=shotOf(u,cuts);
  const meta=(SHOTMETA[k]&&SHOTMETA[k][so[0]])||{sc:'',loc:'',ch:[]};
  const P=propsAt(t);
  return{
    shot:so[0],shotTime:Math.round(so[1]),shotProgress:+(so[1]/so[2]).toFixed(4),
    scale:meta.sc,location:meta.loc,characters:meta.ch,
    light:lightLabel(t),
    props:{door:+P.door.toFixed(3),wardrobe:+P.wardrobe.toFixed(3),cup:P.cup,quilt:P.quilt,
      specs:P.specs,cap:P.cap,chair:P.chair,basket:P.basket,windowBroken:P.winBroken,
      windowCurtain:+P.winCurtain.toFixed(3),bedCurtain:+P.bedCurtain.toFixed(3),hoodBow:P.bow}
  };
}
