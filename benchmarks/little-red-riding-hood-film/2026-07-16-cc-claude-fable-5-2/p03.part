}
function cottageCols(dawn){
  return dawn?{trunk:'#6b5340',leafA:'#a98a68',leafB:'#8f7256',plaster:'#e9cdb2',roof:'#7a5a48',beam:'#5d4331'}
    :{trunk:'#4a4438',leafA:'#5a6b52',leafB:'#485a46',plaster:'#cfc4ac',roof:'#665244',beam:'#4c3b2c'};
}
function scnCottageExt(t,o){
  o=o||{};
  const dawn=!!o.dawn,C=cottageCols(dawn);
  if(dawn)skyV([[0,'#e79f96'],[0.4,'#f3c3a0'],[0.75,'#f8e0b8'],[1,'#dbc39e']]);
  else skyV([[0,'#5f7263'],[0.5,'#71836d'],[1,'#4c5c50']]);
  if(dawn){glowDisc(1220,270,260,'rgba(255,212,160,.8)','rgba(255,212,160,0)');
    ctx.fillStyle='#ffe0b6';ctx.beginPath();ctx.arc(1220,270,46,0,TAU);ctx.fill();}
  for(let i=0;i<6;i++)firSil(140+i*280,560,1.5,dawn?'#7c6152':'#33453a');
  band(700,14,66,dawn?'#a68a68':'#55684f');
  // the three old oaks
  oakDraw(560,760,1.15,world.oaks[0],C,t);
  oakDraw(1010,742,1.3,world.oaks[1],C,t);
  oakDraw(1400,758,1.1,world.oaks[2],C,t);
  band(790,10,67,dawn?'#8f7454':'#48583f');
  // path in from the left
  ribbonPath([{x:-20,y:872},{x:300,y:850},{x:620,y:842},{x:880,y:820}],54,26,dawn?'#d9b98c':'#a9976e');
  // cottage
  const P=propsAt(t);
  ctx.save();ctx.translate(950,820);
  ctx.fillStyle='#7a7468';ctx.fillRect(-210,-120,430,120);
  ctx.fillStyle=C.plaster;ctx.fillRect(-200,-250,410,140);
  ctx.fillStyle=C.beam;
  ctx.fillRect(-200,-256,410,10);ctx.fillRect(-200,-118,410,8);
  ctx.fillRect(-40,-250,10,140);ctx.fillRect(120,-250,10,140);
  ctx.fillStyle=C.roof;
  ctx.beginPath();ctx.moveTo(-240,-244);ctx.lineTo(5,-380);ctx.lineTo(250,-244);ctx.closePath();ctx.fill();
  ctx.fillStyle='#8a8073';ctx.fillRect(96,-372,34,80);
  smoke(113,-376,t,1,o.smoke==null?0.35:o.smoke);
  // door (same door state the interior uses)
  ctx.fillStyle='#241d16';ctx.fillRect(-150,-104,86,104);
  ctx.save();ctx.translate(-150,0);
  ctx.transform(1-P.door*0.55,0,0,1,0,0);
  ctx.fillStyle=dawn?'#8a5f36':'#6d4a2c';ctx.fillRect(0,-104,86,104);
  ctx.strokeStyle='rgba(40,26,14,.6)';ctx.lineWidth=3;
  for(let i=1;i<4;i++){ctx.beginPath();ctx.moveTo(i*21,-102);ctx.lineTo(i*21,-3);ctx.stroke();}
  ctx.fillStyle='#c9b98e';ctx.beginPath();ctx.arc(74,-52,4,0,TAU);ctx.fill();
  ctx.restore();
  if(P.door>0.15&&dawn){ctx.fillStyle='rgba(255,200,120,.5)';ctx.fillRect(-150+86*(1-P.door*0.55),-104,86*P.door*0.55,104);}
  // front window
  ctx.fillStyle=C.beam;ctx.fillRect(20,-96,88,70);
  ctx.fillStyle=o.winLit?'#ffcf7e':(dawn?'#c8a984':'#2c3640');
  ctx.fillRect(26,-90,76,58);
  ctx.strokeStyle=C.beam;ctx.lineWidth=5;
  ctx.beginPath();ctx.moveTo(64,-90);ctx.lineTo(64,-32);ctx.moveTo(26,-61);ctx.lineTo(102,-61);ctx.stroke();
  ctx.restore();
  if(!dawn){ctx.fillStyle='rgba(52,70,88,.2)';ctx.fillRect(0,0,W,H);}
  leavesFall(t,4,dawn?'rgba(190,150,110,.5)':'rgba(60,76,60,.55)',68);
}
function scnCottageInt(t,o){
  o=o||{};
