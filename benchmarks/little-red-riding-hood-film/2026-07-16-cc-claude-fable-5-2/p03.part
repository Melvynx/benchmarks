  ctx.fillStyle='#6f5433';ctx.fillRect(-190,-64,446,74);
  ctx.fillStyle='#d9cdb4';ctx.beginPath();ctx.moveTo(-180,-64);ctx.quadraticCurveTo(30,-96,246,-70);ctx.lineTo(246,-30);ctx.lineTo(-180,-30);ctx.closePath();ctx.fill();
  ctx.fillStyle='#efe6d2';ctx.beginPath();ctx.ellipse(196,-84,44,20,-0.12,0,TAU);ctx.fill();
  if(P.quilt==='bed'){quiltPat(-176,-78,400,54,26);}
