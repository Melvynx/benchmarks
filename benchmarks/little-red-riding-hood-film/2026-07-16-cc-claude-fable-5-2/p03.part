    ctx.globalAlpha=0.25+bright*0.5;
    ctx.fillRect(-4,-314,138*Math.min(1,dd*1.2),308);
    ctx.globalAlpha=1;
  }
  ctx.save();ctx.translate(-6,0);ctx.transform(1-dd*0.8,0,-0.12*dd,1,0,0);
  ctx.fillStyle='#5d452a';ctx.fillRect(0,-316,140,316);
  ctx.strokeStyle='rgba(38,26,14,.55)';ctx.lineWidth=4;
  for(let i=1;i<4;i++){ctx.beginPath();ctx.moveTo(i*35,-310);ctx.lineTo(i*35,-6);ctx.stroke();}
  ctx.fillStyle='#c9b98e';ctx.beginPath();ctx.arc(126,-150,6,0,TAU);ctx.fill();
  ctx.restore();
  ctx.restore();
  if(P.door>0.2){
    lightShaft(420,340,300*P.door,760*P.door,900,(o.doorLight==null?0.22:o.doorLight*0.5),!!o.dawnDoor);
  }
