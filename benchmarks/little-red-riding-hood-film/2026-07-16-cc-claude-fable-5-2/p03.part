    ctx.fillStyle='#8b849a';ctx.beginPath();ctx.ellipse(1420,816,26,10,0.3,0,TAU);ctx.fill();
  }
  // wardrobe (far right)
  ctx.save();ctx.translate(1500,760);
  ctx.fillStyle='#4f3a22';ctx.fillRect(-64,-330,150,330);
  ctx.fillStyle='#3a2a16';ctx.fillRect(-56,-318,64,306);
  const wd=P.wardrobe;
  if(wd>0.03){ctx.fillStyle='#171310';ctx.fillRect(-56+64*(1-wd),-318,64*wd,306);}
