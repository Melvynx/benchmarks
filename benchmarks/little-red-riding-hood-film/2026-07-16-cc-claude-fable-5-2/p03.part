  const dim=sat((o.dim==null?0.35:o.dim)+P.winCurtain*0.3);
  // walls / floor
  skyV([[0,'#8f9296'],[0.55,'#9b9a92'],[1,'#7e7a6d']]);
  ctx.fillStyle='#6d5638';ctx.fillRect(0,640,W,H-640);
  ctx.strokeStyle='rgba(50,38,24,.4)';ctx.lineWidth=3;
