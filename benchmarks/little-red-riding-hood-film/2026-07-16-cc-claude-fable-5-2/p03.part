    for(let i=0;i<=6;i++)ctx.lineTo(-92+i*(184*cu/6),-96+((i%2)?8:0));
    ctx.lineTo(-92+184*cu,94);
    for(let i=6;i>=0;i--)ctx.lineTo(-92+i*(184*cu/6),94-((i%2)?6:0));
    ctx.closePath();ctx.fill();
  }
  ctx.restore();
