    ctx.save();ctx.translate(-80,-84);ctx.rotate(-0.5);ctx.strokeRect(0,0,74,80);ctx.restore();
    ctx.save();ctx.translate(80,-60);ctx.rotate(0.4);ctx.strokeRect(-70,0,70,76);ctx.restore();
  }else{
