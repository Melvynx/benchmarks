
/* ---------- environment pieces ---------- */
function trunkV(x,yTop,yBot,w,lean,c){
  ctx.fillStyle=c;ctx.beginPath();
  ctx.moveTo(x-w/2,yBot);
  ctx.bezierCurveTo(x-w*0.42+lean*30,lerp(yBot,yTop,0.4),x-w*0.3+lean*70,lerp(yBot,yTop,0.8),x-w*0.24+lean*100,yTop);
  ctx.lineTo(x+w*0.24+lean*100,yTop);
  ctx.bezierCurveTo(x+w*0.3+lean*70,lerp(yBot,yTop,0.8),x+w*0.42+lean*30,lerp(yBot,yTop,0.4),x+w/2,yBot);
  ctx.closePath();ctx.fill();
}
function oakDraw(x,y,s,o,cols,t){
  ctx.save();ctx.translate(x,y);ctx.scale(s,s);ctx.rotate(o.lean*0.3);
  ctx.fillStyle=cols.trunk;
  ctx.beginPath();
  ctx.moveTo(-26,0);ctx.bezierCurveTo(-20,-70,-14,-120,-6+o.lean*40,-190);
  ctx.lineTo(10+o.lean*40,-190);ctx.bezierCurveTo(16,-120,22,-70,28,0);
  ctx.closePath();ctx.fill();
  ctx.strokeStyle=cols.trunk;ctx.lineWidth=12;ctx.lineCap='round';
  for(let i=0;i<o.limbs.length;i++){
    const L=o.limbs[i];
    ctx.beginPath();ctx.moveTo(2,-120-i*24);
    ctx.quadraticCurveTo(Math.cos(L.a)*L.l*0.5,-140-i*24+Math.sin(L.a)*L.l*0.5,Math.cos(L.a)*L.l,-150-i*24+Math.sin(L.a)*L.l*0.6);
    ctx.stroke();
  }
  for(let i=0;i<o.blobs.length;i++){
    const b=o.blobs[i];
    const swx=MOTION?vnc(t*0.0006+i*1.7,60)*6:0;
    ctx.fillStyle=b.sh>0.5?cols.leafA:cols.leafB;
    ctx.beginPath();ctx.ellipse(b.dx+swx,b.dy-40,b.r,b.r*0.72,0.2,0,TAU);ctx.fill();
  }
  ctx.restore();
}
function firSil(x,y,s,c){
  ctx.fillStyle=c;
  for(let i=0;i<3;i++){
    const w=42*s*(1-i*0.22),hh=52*s*(1-i*0.12),yy=y-i*38*s;
    ctx.beginPath();ctx.moveTo(x-w,yy);ctx.lineTo(x,yy-hh);ctx.lineTo(x+w,yy);ctx.closePath();ctx.fill();
  }
  ctx.fillRect(x-4*s,y-2,8*s,26*s);
}
function smoke(x,y,t,s,a){
  for(let i=0;i<4;i++){
    const p=((t*0.00006+i*0.25)%1);
    const sx=x+vnc(p*6+i,71)*22*s*(0.4+p);
    const sy=y-p*90*s;
    ctx.fillStyle='rgba(232,226,214,'+(a*(1-p)*0.5)+')';
    ctx.beginPath();ctx.arc(sx,sy,(5+p*16)*s,0,TAU);ctx.fill();
  }
}
function birdsFly(t,n,tint,x0,y0,dir){
  ctx.strokeStyle=tint;ctx.lineWidth=2.4;ctx.lineCap='round';
  for(let i=0;i<n;i++){
    const b=world.birds[i%world.birds.length];
    const p=(t*b.v*0.014+i*0.13)%1.3;
    const bx=x0+dir*p*1700,by=y0+b.y*0.4+vnc(p*4+i,81)*30;
    if(bx<-40||bx>W+40)continue;
    const w=Math.sin(t*0.02+b.ph)*6;
    ctx.beginPath();ctx.moveTo(bx-8,by-w*0.4);ctx.quadraticCurveTo(bx,by+w,bx+8,by-w*0.4);ctx.stroke();
  }
}
function leavesFall(t,n,tint,salt){
  if(!MOTION)n=Math.min(n,4);
  ctx.fillStyle=tint;
  for(let i=0;i<n;i++){
    const spd=0.02+h32i(i,salt)*0.02;
    const lx=h32i(i,salt+1)*W+vnc(t*0.0006+i,salt+2)*60;
    const ly=((t*spd+h32i(i,salt+3)*900)%(H+80))-40;
    ctx.save();ctx.translate(lx,ly);ctx.rotate(t*0.002+i);
    ctx.beginPath();ctx.ellipse(0,0,5,2.4,0,0,TAU);ctx.fill();
    ctx.restore();
  }
}
function motes(t,n,box,a){
  ctx.fillStyle='rgba(255,240,205,'+a+')';
  for(let i=0;i<n;i++){
    const mx=box.x+h32i(i,91)*box.w+vnc(t*0.0004+i,92)*18;
    const my=box.y+((h32i(i,93)*box.h+t*0.008*(0.3+h32i(i,94)))%box.h);
    const tw=0.4+0.6*vn(t*0.003+i,95);
    ctx.globalAlpha=a*tw;
    ctx.beginPath();ctx.arc(mx,my,1.6,0,TAU);ctx.fill();
  }
  ctx.globalAlpha=1;
}
function flowerHead(x,y,r,k,glow){
  const cols=['#d8483a','#e9c766','#e8e2d2','#c987c1'];
  if(glow){glowDisc(x,y,r*2.4,'rgba(255,236,180,.25)','rgba(255,236,180,0)');}
  ctx.fillStyle=cols[k%4];
  for(let i=0;i<5;i++){
    const a=i/5*TAU-0.3;
    ctx.beginPath();ctx.ellipse(x+Math.cos(a)*r*0.62,y+Math.sin(a)*r*0.62,r*0.46,r*0.3,a,0,TAU);ctx.fill();
  }
  ctx.fillStyle='#a8642a';ctx.beginPath();ctx.arc(x,y,r*0.3,0,TAU);ctx.fill();
}
function flowerField(arr,t,scale,swayA){
  for(let i=0;i<arr.length;i++){
    const F=arr[i];
    const sw=MOTION?Math.sin(t*0.0016+F.ph)*swayA:0;
    const hh=F.h*scale;
    ctx.strokeStyle='#54763c';ctx.lineWidth=1.6*scale;
    ctx.beginPath();ctx.moveTo(F.x,F.y);ctx.quadraticCurveTo(F.x+sw*0.5,F.y-hh*0.6,F.x+sw,F.y-hh);ctx.stroke();
    flowerHead(F.x+sw,F.y-hh,4.6*scale*(0.8+ (F.k%3)*0.2),F.k,false);
  }
}
function butterfly(t,x0,y0,c,ph){
  const bx=x0+vnc(t*0.0009+ph,101)*90,by=y0+vnc(t*0.0011+ph,102)*60;
  const fl2=Math.sin(t*0.03+ph)*0.9;
  ctx.fillStyle=c;
  ctx.save();ctx.translate(bx,by);
  ctx.beginPath();ctx.ellipse(-4,0,5,2.6+2.4*Math.abs(fl2),0.6*fl2,0,TAU);ctx.fill();
  ctx.beginPath();ctx.ellipse(4,0,5,2.6+2.4*Math.abs(fl2),-0.6*fl2,0,TAU);ctx.fill();
  ctx.restore();
}
function dapples(t,alpha,drift){
  for(let i=0;i<world.dapples.length;i++){
    const d=world.dapples[i];
    const dx=MOTION?vnc(t*0.0005+d.ph,111)*40*drift:0;
    const g=ctx.createRadialGradient(d.x+dx,d.y,0,d.x+dx,d.y,d.rx);
    g.addColorStop(0,'rgba(255,238,190,'+alpha+')');g.addColorStop(1,'rgba(255,238,190,0)');
    ctx.fillStyle=g;
    ctx.beginPath();ctx.ellipse(d.x+dx,d.y,d.rx,d.ry,0,0,TAU);ctx.fill();
  }
}
function lightShaft(x,yTop,wTop,wBot,yBot,a,warm){
  const g=ctx.createLinearGradient(x,yTop,x,yBot);
  const c=warm?'255,226,160':'214,228,244';
  g.addColorStop(0,'rgba('+c+','+a+')');g.addColorStop(1,'rgba('+c+',0)');
  ctx.fillStyle=g;
  ctx.beginPath();ctx.moveTo(x-wTop/2,yTop);ctx.lineTo(x+wTop/2,yTop);ctx.lineTo(x+wBot/2,yBot);ctx.lineTo(x-wBot/2,yBot);ctx.closePath();ctx.fill();
}
function quiltPat(x,y,w,h,cell){
  ctx.save();
  ctx.beginPath();ctx.rect(x,y,w,h);ctx.clip();
  ctx.fillStyle='#e9e1cd';ctx.fillRect(x,y,w,h);
  ctx.strokeStyle='#cbbfa4';ctx.lineWidth=1;
  for(let gx=x;gx<=x+w;gx+=cell){ctx.beginPath();ctx.moveTo(gx,y);ctx.lineTo(gx,y+h);ctx.stroke();}
  for(let gy=y;gy<=y+h;gy+=cell){ctx.beginPath();ctx.moveTo(x,gy);ctx.lineTo(x+w,gy);ctx.stroke();}
  let row=0;
  for(let gy=y;gy<y+h;gy+=cell,row++){
    let col=0;
    for(let gx=x;gx<x+w;gx+=cell,col++){
      const cxp=gx+cell/2,cyp=gy+cell/2;
      if((row+col)%2===0){
        ctx.strokeStyle='#7d9169';ctx.lineWidth=1.2;
        ctx.beginPath();ctx.moveTo(cxp,cyp+cell*0.24);ctx.lineTo(cxp,cyp-cell*0.22);ctx.stroke();
        ctx.fillStyle='#7d9169';
        ctx.beginPath();ctx.ellipse(cxp-cell*0.12,cyp-cell*0.05,cell*0.1,cell*0.16,0.6,0,TAU);ctx.fill();
        ctx.beginPath();ctx.ellipse(cxp+cell*0.12,cyp-cell*0.05,cell*0.1,cell*0.16,-0.6,0,TAU);ctx.fill();
      }else{
        ctx.fillStyle='#b3573f';
        ctx.beginPath();ctx.arc(cxp,cyp,cell*0.09,0,TAU);ctx.fill();
        ctx.beginPath();ctx.arc(cxp-cell*0.14,cyp+cell*0.1,cell*0.07,0,TAU);ctx.fill();
        ctx.beginPath();ctx.arc(cxp+cell*0.14,cyp+cell*0.1,cell*0.07,0,TAU);ctx.fill();
      }
    }
  }
  // the red thread runs through the quilt border
  ctx.strokeStyle='rgba(178,51,39,.8)';ctx.lineWidth=1.6;ctx.setLineDash([6,5]);
  ctx.strokeRect(x+4,y+4,w-8,h-8);ctx.setLineDash([]);
  ctx.restore();
}

/* ---------- prop continuity (single source of truth) ---------- */
function propsAt(t){
  const P={};
  P.door = t<61600?0
    : t<63000?lerp(0,0.5,eio(rt(t,61600,63000)))
    : t<63600?lerp(0.5,0.35,rt(t,63000,63600))
    : t<76600?0.35
    : t<77600?lerp(0.35,0.75,eio(rt(t,76600,77600)))
    : t<97600?0.75
    : t<97900?lerp(0.75,1,eo(rt(t,97600,97900)))
    : 1;
  P.wardrobe = t<62150?0.12
    : t<62300?lerp(0.12,0,rt(t,62150,62300))
    : t<101800?0
    : t<102400?lerp(0,0.9,eio(rt(t,101800,102400)))
    : 0.9;
  P.cup = t<64000?'upright':'tipped';
  P.quilt = t<64600?'bed' : t<66300?'slip' : t<95400?'wolf' : t<104000?'floor' : 'gran';
  P.winCurtain = t<71600?0 : t<72200?lerp(0,0.7,rt(t,71600,72200)) : t<100900?0.7 : 0.2;
  P.bedCurtain = t<70000?0 : t<70600?lerp(0,0.55,rt(t,70000,70600)) : t<84200?0.55 : 0;
  P.specs = t<69600?'stand' : t<95600?'wolf' : t<102900?'floor' : 'gran';
  P.cap = t<66600?'none' : t<95300?'wolf' : 'floor';
  P.chair = t<95900?'up':'fallen';
  P.basket = t<79300?'red' : t<104000?'table' : 'red';
  P.winBroken = t>=101000;
  P.shawlFloor = t>=63900;
  P.bow = t>=4500;
  return P;
}
function lightLabel(t){
  return t<18000?'warm village morning':t<27000?'threshold gold':t<47000?'uncertain forest'
    :t<57000?'split light — clearing and shadow':t<84000?'cold cottage':t<95000?'closing shadow'
    :t<104000?'breaking open':'changed dawn';
}

/* ---------- composite scene painters ---------- */
const PATH_PTS=[{x:170,y:690},{x:420,y:660},{x:760,y:692},{x:1120,y:642},{x:1460,y:668}];
function scnVillage(t,o){
  // shared by The Red Departure (morning) and The Path Home (dawn) — the visual echo
  const dawn=o.mode==='dawn';
  if(dawn)skyV([[0,'#e8a9a2'],[0.35,'#f2c4a4'],[0.62,'#f9e2bb'],[1,'#e8cfa8']]);
  else skyV([[0,'#f6d29b'],[0.4,'#f5c887'],[0.68,'#f7e0ae'],[1,'#ecd9a8']]);
  const sunX=dawn?1180:330,sunY=dawn?300:250;
  glowDisc(sunX,sunY,dawn?210:190,dawn?'rgba(255,214,170,.85)':'rgba(255,244,214,.9)','rgba(255,244,214,0)');
  ctx.fillStyle=dawn?'#ffe6c8':'#fff6dd';ctx.beginPath();ctx.arc(sunX,sunY,dawn?52:44,0,TAU);ctx.fill();
  band(560,10,31,dawn?'#caa27c':'#d9c07c');
  band(600,16,32,dawn?'#b98f6b':'#c2b16c');
  // village on its hill, left
  ctx.save();ctx.translate(0,dawn?8:0);
  ctx.fillStyle=dawn?'#8f6b55':'#a08a5a';
  ctx.beginPath();ctx.moveTo(-20,700);ctx.quadraticCurveTo(240,560,540,660);ctx.lineTo(540,720);ctx.lineTo(-20,720);ctx.closePath();ctx.fill();
  for(let i=0;i<world.houses.length;i++){
    const hse=world.houses[i];
    const hx=hse.x*0.85+40,hy=636-i%3*16;
    ctx.fillStyle=dawn?'#6b5344':'#e8dcc0';
    ctx.fillRect(hx,hy-hse.h*0.7,hse.w*0.7,hse.h*0.7);
    ctx.fillStyle=dawn?'#54413a':'#a3562e';
    ctx.beginPath();ctx.moveTo(hx-4,hy-hse.h*0.7);ctx.lineTo(hx+hse.w*0.35,hy-hse.h*0.7-hse.w*0.3);ctx.lineTo(hx+hse.w*0.7+4,hy-hse.h*0.7);ctx.closePath();ctx.fill();
    if(dawn){ctx.fillStyle='#ffcf7e';ctx.fillRect(hx+hse.w*0.22,hy-hse.h*0.42,7,9);}
    if(hse.ro>0.5)smoke(hx+hse.w*0.35,hy-hse.h*0.7-hse.w*0.3,t,0.6,dawn?0.5:0.4);
  }
  ctx.restore();
  // fields
  band(660,14,33,dawn?'#a8825f':'#a8a95d');
  band(700,18,34,dawn?'#8f7a52':'#7c9a52');
  // forest wall right
  ctx.fillStyle=dawn?'#6b5a52':'#3f5442';
  ctx.beginPath();ctx.moveTo(1180,720);
  for(let x=1180;x<=W+30;x+=52)ctx.lineTo(x,520+vnc(x*0.01,35)*40-((x-1180)*0.12));
  ctx.lineTo(W+30,720);ctx.closePath();ctx.fill();
  for(let i=0;i<5;i++)firSil(1260+i*80,640,1.1+ (i%2)*0.3,dawn?'#5c4c46':'#33452f');
  if(!dawn){
    ctx.fillStyle='rgba(38,48,40,.28)';
    ctx.beginPath();ctx.moveTo(1180,720);ctx.lineTo(980,700);ctx.lineTo(1140,660);ctx.lineTo(1300,690);ctx.closePath();ctx.fill();
  }
  band(760,10,36,dawn?'#7d6a4a':'#6f8d4a');
  // the path — and the red thread that lives along its edge
  const pp=[];for(let i=0;i<=24;i++)pp.push(pathPt(PATH_PTS,i/24));
  ribbonPath(pp,26,46,dawn?'#e8c9a0':'#e3cfa2');
  ctx.save();ctx.globalAlpha=dawn?0.85:0.4;
  ctx.strokeStyle='#b23327';ctx.lineWidth=dawn?3:2;ctx.lineCap='round';
  ctx.beginPath();
  for(let i=0;i<=24;i++){const q=pathPt(PATH_PTS,i/24);if(i===0)ctx.moveTo(q.x,q.y-14);else ctx.lineTo(q.x+vnc(i*0.6,37)*4,q.y-14+vnc(i,38)*3);}
  ctx.stroke();ctx.restore();
  flowerField(world.meadowFlowers.slice(0,26),t,0.7,3);
  birdsFly(t,dawn?4:3,dawn?'rgba(90,60,50,.6)':'rgba(70,60,40,.55)',dawn?W:0,150,dawn?-1:1);
  // Red on the path
  const rp=pathPt(PATH_PTS,o.redP);
  drawRed({x:rp.x,y:rp.y,s:0.62,t:t,face:o.redFace==null?1:o.redFace,walk:t/960,mood:o.redMood==null?1:o.redMood,
    basketFull:!dawn,bow:propsAt(t).bow});
  if(dawn){ctx.fillStyle='rgba(255,196,150,.14)';ctx.fillRect(0,0,W,H);}
}
function scnForest(t,o){
  o=o||{};
  const dk=o.dark||0,camX=o.camX||0;
  skyV([[0,cmix([116,142,108],[42,58,52],dk)],[0.5,cmix([139,158,112],[52,70,58],dk)],[1,cmix([94,118,84],[36,50,44],dk)]]);
  ctx.fillStyle=cmix([58,80,62],[24,34,30],dk);
  ctx.beginPath();ctx.moveTo(0,0);ctx.lineTo(W,0);ctx.lineTo(W,150);
  for(let x=W;x>=0;x-=64)ctx.lineTo(x,150+vnc(x*0.008,41)*70);
  ctx.lineTo(0,140);ctx.closePath();ctx.fill();
  const layers=[[world.far,0.22,[86,110,88],[40,54,48],220,0.55],[world.mid,0.5,[66,90,72],[32,44,38],140,0.8],[world.near,1,[46,66,54],[24,34,30],40,1.15]];
  for(let li=0;li<layers.length;li++){
    if(o.skipNear&&li===2)continue;
    const Lr=layers[li],arr=Lr[0],par=Lr[1];
    const colA=cmix(Lr[2],[20,28,26],dk),top=Lr[4];
    for(let i=0;i<arr.length;i++){
      const tr=arr[i];
      let x=tr.x-camX*par;
      x=((x%2400)+2400)%2400-400;
      if(x<-120||x>W+120)continue;
      trunkV(x,top,H-40+li*20,tr.w*Lr[5],tr.lean,tr.s>0.5?colA:cmix(Lr[3],[16,22,20],dk));
      if(o.watchful&&li===1&&i%4===0){
        ctx.fillStyle='rgba(24,30,26,.8)';
        ctx.beginPath();ctx.ellipse(x-4,330,3.4,5.4,0.2,0,TAU);ctx.fill();
        ctx.beginPath();ctx.ellipse(x+6,326,3.4,5.4,-0.2,0,TAU);ctx.fill();
      }
    }
  }
  ctx.fillStyle=cmix([70,92,66],[30,42,36],dk);
  ctx.beginPath();ctx.moveTo(0,H);ctx.lineTo(0,760);
  for(let x=0;x<=W;x+=80)ctx.lineTo(x,760+vnc(x*0.006+camX*0.001,42)*24);
  ctx.lineTo(W,H);ctx.closePath();ctx.fill();
  if(o.path!==false){
    const pw=o.narrow?[36,14]:[52,30];
    ribbonPath([{x:-20,y:830},{x:400,y:812},{x:800,y:824},{x:1200,y:806},{x:1620,y:818}],pw[0],pw[1],cmix([196,172,128],[74,66,52],dk));
  }
  if(o.dapple)dapples(t,o.dapple,1);
  leavesFall(t,o.leaves==null?6:o.leaves,cmixA([164,150,88],[70,66,44],dk,0.7),51);
}
function scnClearing(t){
  skyV([[0,'#ffe9ad'],[0.45,'#f4e29b'],[1,'#c8d288']]);
  glowDisc(800,430,320,'rgba(255,240,196,.9)','rgba(255,240,196,0)');
  ctx.fillStyle='#ffdf8e';ctx.beginPath();ctx.arc(800,430,68,0,TAU);ctx.fill();
  ctx.fillStyle='rgba(255,252,235,.85)';ctx.beginPath();ctx.arc(800,430,46,0,TAU);ctx.fill();
  for(let i=0;i<7;i++){
    const x=90+i*240+vnc(i,55)*60;
    trunkV(x,160,700,16+ (i%3)*8,vnc(i,56)*0.06,'#cabf7a');
    ctx.fillStyle=i%2?'#dfd98e':'#cfd07e';
    ctx.beginPath();ctx.ellipse(x,190,90,70,0,0,TAU);ctx.fill();
  }
  band(690,16,57,'#b7c86e');
  band(740,12,58,'#9db85f');
  flowerField(world.clearFlowers,t,1,4);
  butterfly(t,700,560,'#e8e2d2',1.2);
  butterfly(t,950,600,'#e9c766',3.7);
}
function scnShortcut(t,variant,u){
  skyV([[0,'#22303c'],[0.5,'#1b2833'],[1,'#101922']]);
  const scroll=u*(0.9+variant*0.25);
  ctx.fillStyle='#16222c';
  for(let i=0;i<8;i++){
    const x=((i*260-scroll*0.5)%2000+2000)%2000-200;
    firSil(x,660,1.5,'#131d26');
  }
  for(let i=0;i<10;i++){
    const x=((i*210-scroll)%2100+2100)%2100-250;
    trunkV(x,60,H,26+(i%3)*14,vnc(i,61)*0.05,i%2?'#0e161d':'#122029');
  }
  band(770,20,62,'#0c141b');
  if(variant===1){
    ctx.fillStyle='#0a1218';ctx.beginPath();ctx.moveTo(500,900);ctx.lineTo(640,770);ctx.lineTo(960,770);ctx.lineTo(1100,900);ctx.closePath();ctx.fill();
    ctx.fillStyle='rgba(150,190,210,.25)';ctx.beginPath();ctx.ellipse(800,850,180,20,0,0,TAU);ctx.fill();
  }
  if(variant>=2){
    ctx.strokeStyle='#0b141a';ctx.lineWidth=18;
    for(let i=0;i<5;i++){
      const x=((i*400-scroll*1.4)%2200+2200)%2200-300;
      ctx.beginPath();ctx.moveTo(x,900);ctx.quadraticCurveTo(x+90,790,x+220,820);ctx.stroke();
    }
  }
  // brambles whipping past in the foreground
  ctx.strokeStyle='rgba(8,13,17,.9)';ctx.lineWidth=10;
  for(let i=0;i<world.brambles.length;i++){
    const B=world.brambles[i];
    const x=((B.x-scroll*1.9)%2300+2300)%2300-350;
    if(x<-200||x>W+200)continue;
    ctx.beginPath();ctx.arc(x,B.y,B.r,B.a,B.a+2.2);ctx.stroke();
  }
  // cold rim streaks
  ctx.strokeStyle='rgba(160,190,210,.14)';ctx.lineWidth=3;
  for(let i=0;i<7;i++){
    const y=140+i*100+vnc(i,63)*40;
    const x=((i*330-scroll*2.6)%2400+2400)%2400-400;
    ctx.beginPath();ctx.moveTo(x,y);ctx.lineTo(x+260,y+14);ctx.stroke();
  }
}
function scnKitchen(t){
