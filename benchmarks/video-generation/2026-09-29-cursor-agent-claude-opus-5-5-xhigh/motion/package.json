{
  "name": "lumail-launch",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts LumailLaunch out/video-silent.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p --color-space=bt709 --concurrency=8",
    "sfx": "node audio/sfx.mjs",
    "mix": "bash audio/mix.sh",
    "mux": "ffmpeg -v error -y -i out/video-silent.mp4 -i audio/mix.wav -map 0:v:0 -map 1:a:0 -c:v copy -c:a aac -b:a 256k -ar 48000 -t 45 -movflags +faststart ../video.mp4",
    "build": "pnpm run render && pnpm run sfx && pnpm run mix && pnpm run mux",
    "still": "remotion still src/index.ts LumailLaunch"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.529",
    "@remotion/cli": "^4.0.529",
    "@remotion/google-fonts": "^4.0.529",
    "@remotion/renderer": "4.0.529",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.529"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
