g" width="1em" height="1em" fill="currentColor" viewBox="0 0 256 256" aria-hidden="true" class="size-3.5 shrink-0"><path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm0,192a88,88,0,1,1,88-88A88.1,88.1,0,0,1,128,216Zm16-40a8,8,0,0,1-8,8,16,16,0,0,1-16-16V128a8,8,0,0,1,0-16,16,16,0,0,1,16,16v40A8,8,0,0,1,144,176ZM112,84a12,12,0,1,1,12,12A12,12,0,0,1,112,84Z"></path></svg><span class="sr-only">Custom domains for capture pages and hosted content.</span></span></span></div><div class="shrink-0 text-right text-sm text-foreground font-medium"><span class="tabular-nums">1</span></div></div><div class="border-border flex items-center justify-between gap-4 border-b px-4 py-3.5 last:border-b-0"><div class="text-muted-foreground min-w-0 text-sm font-normal"><span class="inline-flex items-start gap-1.5 text-left"><span>Workflows</span><span class="text-muted-foreground mt-0.5 inline-flex" title="Automation graphs you can publish."><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" viewBox="0 0 256 256" aria-hidden="true" class="size-3.5 shrink-0"><path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm0,192a88,88,0,1,1,88-88A88.1,88.1,0,0,1,128,216Zm16-40a8,8,0,0,1-8,8,16,16,0,0,1-16-16V128a8,8,0,0,1,0-16,16,16,0,0,1,16,16v40A8,8,0,0,1,144,176ZM112,84a12,12,0,1,1,12,12A12,12,0,0,1,112,84Z"></path></svg><span class="sr-only">Automation graphs you can publish.</span></span></span></div><div class="shrink-0 text-right text-sm text-foreground font-medium"><span class="tabular-nums">Unlimited</span></div></div><div class="border-border flex items-center justify-between gap-4 border-b px-4 py-3.5 last:border-b-0"><div class="text-muted-foreground min-w-0 text-sm font-normal"><span class="inline-flex items-start gap-1.5 text-left"><span>Team members</span><span class="text-muted-foreground mt-0.5 inline-flex" title="Maximum number of organization members"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="c