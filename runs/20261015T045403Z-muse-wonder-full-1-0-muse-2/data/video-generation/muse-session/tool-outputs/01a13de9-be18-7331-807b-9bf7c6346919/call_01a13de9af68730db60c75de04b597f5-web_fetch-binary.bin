.th-tag { color: var(--th-tag); }
.th-type { color: var(--th-type); }
.th-variable { color: var(--th-variable); }
.th-line { display: inline-block; min-width: 100%; width: max-content; }
.th-code--line-numbers, .tm-code--line-numbers code { counter-reset: th-line; }
.th-code--line-numbers, .tm-code--line-numbers .th-line::before {
  display: inline-block;
  width: 2.5em;
  padding-right: 1em;
  color: var(--th-comment);
  content: attr(data-line);
  text-align: right;
  user-select: none;
}

.th-line--highlighted {
  background: color-mix(in srgb, var(--th-token) 10%, transparent);
}

a.heading-anchor {
  margin-left: 0.4em;
  font-weight: 500;
  text-decoration: none;
  opacity: 0;
}

:is(h1, h2, h3, h4, h5, h6):hover > a.heading-anchor,
a.heading-anchor:focus-visible {
  opacity: 1;
}
