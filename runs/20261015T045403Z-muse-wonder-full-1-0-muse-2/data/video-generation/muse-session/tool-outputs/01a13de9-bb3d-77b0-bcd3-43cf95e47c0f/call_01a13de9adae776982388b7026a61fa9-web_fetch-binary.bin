  opacity: 1;
}
</style><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:ital,wght@0,100..900;1,100..900&amp;family=Geist+Mono:ital,wght@0,100..900;1,100..900&amp;family=Instrument+Serif:ital@0;1&amp;family=Inter:ital,wght@0,100..900;1,100..900&amp;family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&amp;family=Caveat:wght@500;600&amp;display=swap"/></head><body class="bg-background h-full font-sans antialiased public-root-shell-fonts" style="--font-sans:&quot;Geist&quot;, ui-sans-serif, system-ui, sans-serif;--font-mono:&quot;Geist Mono&quot;, ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, &quot;Liberation Mono&quot;, &quot;Courier New&quot;, monospace;--font-elegant:&quot;Instrument Serif&quot;, ui-serif, Georgia, &quot;Times New Roman&quot;, serif;--font-display:&quot;Inter&quot;, ui-sans-serif, system-ui, sans-serif;--font-brand:&quot;Plus Jakarta Sans&quot;, ui-sans-serif, system-ui, sans-serif;--font-hand:&quot;Caveat&quot;, &quot;Segoe Print&quot;, &quot;Bradley Hand&quot;, cursive"><!--$--><!--/$--><!--$--><!--$--><div class="marketing bg-background text-foreground selection:bg-primary/15 relative min-h-screen overflow-x-clip font-sans antialiased"><a href="#main" class="bg-primary text-primary-foreground fixed top-3 left-3 z-[60] -translate-y-20 rounded-full px-4 py-2 text-sm font-medium transition-transform focus:translate-y-0 motion-reduce:transition-none">Skip to content</a><div aria-hidden="true" class="pointer-events-none fixed inset-x-0 top-0 z-[60] hidden h-screen xl:block"><div class="relative mx-auto h-full w-full max-w-[1190px]"><span class="border-foreground/10 absolute inset-y-0 -left-10 w-10 border-x" style="background-image:repeating-linear-gradient(-45deg, color-mix(in oklab, var(--foreground) 8%, transparent) 0px, color-mix(in oklab, var(--foreground) 8%, transparent) 1px, transparent 1px, transparent 8px)"></span><span class="border-foreground/10 absolute inset-y-0 -right-10 w-10 border-x" style="background-image:repeating-linear-gradient(-45deg, color-mix(in oklab, var(--foreground) 8%, transparent) 0px, color-mix(in oklab, var(--foreground) 8%, transparent) 1px, transparent 1px, transparent 8px)"></span></div></div><div class="bg-background relative mx-auto min-h-screen w-full max-w-[1190px]"><header class="pointer-events-none fixed inset-x-0 top-0 z-50"><div class="marketing-nav-frost pointer-events-auto relative z-10 mx-auto w-full max-w-[1190px]"><nav class="flex h-14 w-full items-center gap-4 px-6 py-4 lg:px-10"><a aria-label="Lumail" href="/" class="inline-flex items-center rounded-md focus-visible:ring-2 focus-visible:outline-none text-foreground focus-visible:ring-ring md:min-h-8"><span class="lumail-lockup inline-flex items-center" style="height:22px;gap:6.285714285714286px"><svg width="22" height="22" viewBox="0 0 91 91" fill="none" xmlns="http://www.w3.org/2000/svg" shape-rendering="geometricPrecision" aria-hidden="true" class="block shrink-0"><image href="/images/lumail-logo-light-128.webp" width="91" height="91" class="dark:hidden"></image><image href="/images/lumail-logo-dark-128.webp" width="91" height="91" class="hidden dark:block"></image></svg><span class="lumail-wordmark" style="font-size:16px">Lumail</span></span></a><div class="hidden items-center gap-0.5 md:flex"><a href="/#product" class="rounded-md px-3 py-1.5 text-sm transition-colors focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none text-muted-foreground hover:bg-secondary hover:text-foreground">Product</a><div class="relative flex items-center rounded-md transition-colors hover:bg-secondary"><a href="/agents" class="focus-visible:ring-ring rounded-md py-1.5 pr-1 pl-3 text-sm transition-colors focus-visible:ring-2 focus-visible:outline-none text-muted-foreground hover:text-foreground">Agents</a><button type="button" aria-label="Show every agent surface" aria-expanded="false" class="focus-visible:ring-ring flex items-center self-stretch rounded-md pr-2 pl-1 text-sm transition-colors focus-visible:ring-2 focus-visible:outline-none text-muted-foreground hover:text-foreground"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" viewBox="0 0 256 256" aria-hidden="true" class="size-3 transition-transform duration-200 motion-reduce:transition-none"><path d="M213.66,101.66l-80,80a8,8,0,0,1-11.32,0l-80-80A8,8,0,0,1,53.66,90.34L128,164.69l74.34-74.35a8,8,0,0,1,11.32,11.32Z"></path></svg></button></div><a href="/pricing" class="rounded-md px-3 py-1.5 text-sm transition-colors focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none text-muted-foreground hover:bg-secondary hover:text-foreground">Pricing</a><a href="/docs" class="rounded-md px-3 py-1.5 text-sm transition-colors focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none text-muted-foreground hover:bg-secondary hover:text-foreground">Docs</a><a href="/changelog" class="rounded-md px-3 py-1.5 text-sm transition-colors focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none text-muted-foreground hover:bg-secondary hover:text-foreground">Changelog</a></div><div class="ml-auto flex items-center gap-2"><div class="hidden sm:block"><button type="button" tabindex="0" id="base-ui-_R_tjkmd6_" role="combobox" aria-expanded="false" aria-haspopup="listbox" data-slot="select-trigger" data-size="default" aria-label="Language" class="border-input focus-visible:border-ring focus-visible:ring-ring/50 aria-invalid:border-destructive aria-invalid:ring-destructive/20 data-placeholder:text-muted-foreground dark:bg-input/30 dark:hover:bg-input/50 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 flex w-fit items-center justify-between gap-1.5 rounded-lg border py-2 pr-2 pl-2.5 text-sm whitespace-nowrap transition-colors outline-none select-none focus-visible:ring-3 disabled:cursor-not-allowed disabled:opacity-50 aria-invalid:ring-3 data-[size=default]:h-8 data-[size=sm]:h-7 data-[size=sm]:rounded-[min(var(--radius-md),10px)] *:data-[slot=select-value]:line-clamp-1 *:data-[slot=select-value]:flex *:data-[slot=select-value]:items-center *:data-[slot=select-value]:gap-1.5 [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 [&amp;_svg:not([class*=&#x27;size-&#x27;])]:size-4 bg-background"><span data-slot="select-value" class="flex flex-1 text-left">English</span><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" viewBox="0 0 256 256" class="text-muted-foreground pointer-events-none size-4" aria-hidden="true">▼<path d="M213.66,101.66l-80,80a8,8,0,0,1-11.32,0l-80-80A8,8,0,0,1,53.66,90.34L128,164.69l74.34-74.35a8,8,0,0,1,11.32,11.32Z"></path></svg></button><input id="base-ui-_R_tjkmd6_-hidden-input" style="clip-path:inset(50%);overflow:hidden;white-space:nowrap;border:0;padding:0;width:1px;height:1px;margin:-1px;position:fixed;top:0;left:0" tabindex="-1" aria-hidden="true" value="en"/></div><a href="/auth/signin" class="text-muted-foreground hover:text-foreground focus-visible:ring-ring hidden h-8 items-center rounded-md px-3 text-sm transition-colors focus-visible:ring-2 focus-visible:outline-none md:inline-flex">Log in</a><a href="/start" class="bg-primary text-primary-foreground focus-visible:ring-ring inline-flex min-h-9 items-center rounded-full px-4 text-sm font-medium whitespace-nowrap transition-[opacity,transform] hover:opacity-90 focus-visible:ring-2 focus-visible:outline-none active:scale-[0.96] motion-reduce:active:scale-100 md:min-h-8">Sign up</a><button type="button" aria-label="Open menu" aria-expanded="false" aria-controls="marketing-mobile-menu" class="text-muted-foreground hover:text-foreground focus-visible:ring-ring relative flex size-[44px] items-center justify-center rounded-md transition-colors focus-visible:ring-2 focus-visible:outline-none md:hidden"><span aria-hidden="true" class="absolute h-px w-4 bg-current transition-transform duration-200 motion-reduce:transition-none -translate-y-1"></span><span aria-hidden="true" class="absolute h-px w-4 bg-current transition-transform duration-200 motion-reduce:transition-none translate-y-1"></span></button></div></nav></div></header><div class="relative"><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"AboutPage","url":"https://lumail.io/about","name":"About Lumail","mainEntity":{"@id":"https://lumail.io/#organization"}},{"@type":"Organization","@id":"https://lumail.io/#organization","name":"Lumail","legalName":"Codelynx, LLC","url":"https://lumail.io","email":"contact@lumail.io","logo":{"@type":"ImageObject","url":"https://lumail.io/brand/lumail-mark.png","width":512,"height":512},"description":"Lumail is an email marketing platform that sends newsletters, automated sequences and transactional email from one domain, for creators, newsletter writers and SaaS founders.","address":{"@type":"PostalAddress","streetAddress":"8 The Green STE B","addressLocality":"Dover","addressRegion":"DE","postalCode":"19901","addressCountry":"US"},"founder":{"@type":"Person","name":"Melvyn Malherbe","jobTitle":"Founder","url":"https://melvynx.com","image":"https://melvynx.com/images/me/twitter-en.jpg","sameAs":["https://melvynx.com","https://twitter.com/melvyn_me"]}},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://lumail.io"},{"@type":"ListItem","position":2,"name":"About","item":"https://lumail.io/about"}]}]}</script><main id="main" tabindex="-1" class="flex-1"><section class="relative pt-32 pb-10 sm:pt-36 sm:pb-16"><div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[radial-gradient(70%_50%_at_50%_45%,var(--marketing-wash),transparent_68%)]"></div><div class="relative"><div class="mx-auto w-full max-w-2xl px-6 flex flex-col items-center pt-4 pb-16 text-center sm:pt-6 sm:pb-20"><p class="bg-marketing-lime text-foreground inline-flex w-fit items-center gap-2 rounded-full px-3 py-1 text-xs font-medium"><span aria-hidden="true" class="bg-foreground size-1.5 shrink-0 rounded-full"></span>Company</p><h1 class="font-display text-foreground text-[1.75rem] leading-[1.15] tracking-[-0.03em] text-balance mt-5 max-w-[22ch] sm:text-[3rem] sm:leading-[1.08]">About Lumail</h1><p class="text-muted-foreground text-base leading-relaxed text-pretty mt-4 max-w-[58ch]">Lumail is an email marketing platform that sends newsletters, automated sequences and transactional email from one domain, for creators, newsletter writers and SaaS founders.</p><dl class="border-border bg-border mt-10 grid w-full grid-cols-2 gap-px overflow-hidden rounded-xl border text-left sm:grid-cols-4"><div class="bg-card flex flex-col-reverse gap-1 p-4"><dt class="text-muted-foreground text-xs leading-snug">emails a month on the free plan</dt><dd class="font-display text-foreground text-2xl tracking-[-0.02em] tabular-nums">3,000</dd></div><div class="bg-card flex flex-col-reverse gap-1 p-4"><dt class="text-muted-foreground text-xs leading-snug">a month for 40,000 emails</dt><dd class="font-display text-foreground text-2xl tracking-[-0.02em] tabular-nums">$20</dd></div><div class="bg-card flex flex-col-reverse gap-1 p-4"><dt class="text-muted-foreground text-xs leading-snug">MCP tools for AI agents</dt><dd class="font-display text-foreground text-2xl tracking-[-0.02em] tabular-nums">139</dd></div><div class="bg-card flex flex-col-reverse gap-1 p-4"><dt class="text-muted-foreground text-xs leading-snug">platforms you can migrate from</dt><dd class="font-display text-foreground text-2xl tracking-[-0.02em] tabular-nums">11</dd></div></dl></div></div></section><div class="mx-auto w-full max-w-[1190px] px-6 lg:px-10 flex flex-col gap-24 pb-20 sm:gap-32 sm:pb-28"><section id="what-lumail-does" aria-labelledby="what-lumail-does-title" class="grid scroll-mt-24 gap-8 lg:grid-cols-[minmax(0,20rem)_1fr] lg:gap-16"><div class="flex flex-col gap-4 lg:sticky lg:top-28 lg:self-start"><h2 id="what-lumail-does-title" class="font-display text-foreground text-[1.75rem] leading-[1.15] tracking-[-0.03em] text-balance sm:text-[2.25rem]">What Lumail does</h2></div><div><div class="flex max-w-[62ch] flex-col gap-5"><p class="text-foreground text-lg leading-relaxed text-pretty sm:text-xl">You bring your list, your domain and what you want to say. Lumail imports the list from your current tool, authenticates your domain, and gives you one place to write campaigns, run automated sequences and send transactional email.</p><p class="text-muted-foreground text-base leading-relaxed text-pretty">You write in an editor that looks like the inbox, or ask your AI agent to do it. You get every campaign&#x27;s opens, clicks and unsubscribes, and a bill based on the emails you actually send.</p></div></div></section><section id="what-makes-lumail-different" aria-labelledby="what-makes-lumail-different-title" class="grid scroll-mt-24 gap-8 lg:grid-cols-[minmax(0,20rem)_1fr] lg:gap-16"><div class="flex flex-col gap-4 lg:sticky lg:top-28 lg:self-start"><h2 id="what-makes-lumail-different-title" class="font-display text-foreground text-[1.75rem] leading-[1.15] tracking-[-0.03em] text-balance sm:text-[2.25rem]">What makes Lumail different</h2><p class="text-muted-foreground text-base leading-relaxed text-pretty">Five differences you can check. Competitor prices were checked on <!-- -->August 17, 2026<!-- --> and each comparison links to its sources.</p></div><div><ol class="flex flex-col gap-3"><li><div data-mock-tone="light" class="overflow-hidden rounded-xl border border-border bg-card grid gap-4 p-6 sm:grid-cols-[2.5rem_1fr] sm:p-7"><span class="font-display text-muted-foreground text-2xl leading-none tabular-nums">01</span><div class="flex flex-col gap-2"><h3 class="text-foreground text-base font-medium">You pay for emails sent, not subscribers stored</h3><p class="text-muted-foreground text-[15px] leading-relaxed text-pretty">Every plan has unlimited subscribers. The free plan sends<!-- --> <!-- -->3,000<!-- --> emails a month, and Creator is $<!-- -->20<!-- --> a month for<!-- --> <!-- -->40,000<!-- --> emails. Mailchimp prices paid plans by contact tier, and its free plan stops at 250 contacts and 500 sends a month.</p><a href="/compare/mailchimp" class="group hover:text-foreground focus-visible:ring-ring inline-flex min-h-11 items-center gap-1.5 text-sm transition-colors focus-visible:ring-2 focus-visible:outline-none sm:min-h-9 text-foreground w-fit">Lumail vs Mailchimp<span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5 motion-reduce:transition-none">→</span></a></div></div></li><li><div data-mock-tone="light" class="overflow-hidden rounded-xl border border-border bg-card grid gap-4 p-6 sm:grid-cols-[2.5rem_1fr] sm:p-7"><span class="font-display text-muted-foreground text-2xl leading-none tabular-nums">02</span><div class="flex flex-col gap-2"><h3 class="text-foreground text-base font-medium">Your AI agent can run it</h3><p class="text-muted-foreground text-[15px] leading-relaxed text-pretty">139<!-- --> MCP tools let Claude Code, Codex, ChatGPT or our CLI import contacts, draft campaigns, build workflows and read analytics. beehiiv keeps automations for its Scale plan, from $43 a month billed annually.</p><a href="/compare/beehiiv" class="group hover:text-foreground focus-visible:ring-ring inline-flex min-h-11 items-center gap-1.5 text-sm transition-colors focus-visible:ring-2 focus-visible:outline-none sm:min-h-9 text-foreground w-fit">Lumail vs beehiiv<span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5 motion-reduce:transition-none">→</span></a></div></div></li><li><div data-mock-tone="light" class="overflow-hidden rounded-xl border border-border bg-card grid gap-4 p-6 sm:grid-cols-[2.5rem_1fr] sm:p-7"><span class="font-display text-muted-foreground text-2xl leading-none tabular-nums">03</span><div class="flex flex-col gap-2"><h3 class="text-foreground text-base font-medium">Newsletters and transactional email on one domain</h3><p class="text-muted-foreground text-[15px] leading-relaxed text-pretty">Login codes and receipts leave through the domain your newsletter already warmed up, on a priority lane of 40 emails per second that a campaign cannot delay. MailerLite sends transactional email through a separate product, MailerSend.</p><a href="/compare/mailerlite" class="group hover:text-foreground focus-visible:ring-ring inline-flex min-h-11 items-center gap-1.5 text-sm transition-colors focus-visible:ring-2 focus-visible:outline-none sm:min-h-9 text-foreground w-fit">Lumail vs MailerLite<span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5 motion-reduce:transition-none">→</span></a></div></div></li><li><div data-mock-tone="light" class="overflow-hidden rounded-xl border border-border bg-card grid gap-4 p-6 sm:grid-cols-[2.5rem_1fr] sm:p-7"><span class="font-display text-muted-foreground text-2xl leading-none tabular-nums">04</span><div class="flex flex-col gap-2"><h3 class="text-foreground text-base font-medium">Automations on the free plan</h3><p class="text-muted-foreground text-[15px] leading-relaxed text-pretty">Workflows are unlimited on every plan, free included: welcome sequences, launches and follow-ups, with enrolment, timing and exits handled for you. Brevo starts multi-step workflows on its Standard plan, from $18 a month.</p><a href="/compare/brevo" class="group hover:text-foreground focus-visible:ring-ring inline-flex min-h-11 items-center gap-1.5 text-sm transition-colors focus-visible:ring-2 focus-visible:outline-none sm:min-h-9 text-foreground w-fit">Lumail vs Brevo<span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5 motion-reduce:transition-none">→</span></a></div></div></li><li><div data-mock-tone="light" class="overflow-hidden rounded-xl border border-border bg-card grid gap-4 p-6 sm:grid-cols-[2.5rem_1fr] sm:p-7"><span class="font-display text-muted-foreground text-2xl leading-none tabular-nums">05</span><div class="flex flex-col gap-2"><h3 class="text-foreground text-base font-medium">Moving in takes one prompt</h3><p class="text-muted-foreground text-[15px] leading-relaxed text-pretty">Paste one migration prompt into your AI agent and it moves contacts, tags and workflows from <!-- -->11<!-- --> platforms, including<!-- --> <!-- -->Mailchimp, Kit, Brevo, Systeme.io, beehiiv<!-- --> <!-- -->and Substack. Most lists are ready in under 10 minutes.</p><a href="/migrate" class="group hover:text-foreground focus-visible:ring-ring inline-flex min-h-11 items-center gap-1.5 text-sm transition-colors focus-visible:ring-2 focus-visible:outline-none sm:min-h-9 text-foreground w-fit">See the migration prompt<span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5 motion-reduce:transition-none">→</span></a></div></div></li></ol></div></section><section id="who-uses-lumail" aria-labelledby="who-uses-lumail-title" class="grid scroll-mt-24 gap-8 lg:grid-cols-[minmax(0,20rem)_1fr] lg:gap-16"><div class="flex flex-col gap-4 lg:sticky lg:top-28 lg:self-start"><h2 id="who-uses-lumail-title" class="font-display text-foreground text-[1.75rem] leading-[1.15] tracking-[-0.03em] text-balance sm:text-[2.25rem]">Who uses Lumail</h2><p class="text-muted-foreground text-base leading-relaxed text-pretty">Read how they set it up in our<!-- --> <a href="/customers" class="text-foreground decoration-border hover:decoration-foreground underline underline-offset-4 transition-colors">customer stories</a>.</p></div><div><ul class="grid gap-3 sm:grid-cols-2"><li><div data-mock-tone="light" class="overflow-hidden rounded-xl border border-border bg-card flex h-full flex-col gap-3 p-6"><h3 class="text-foreground text-base font-medium">Course creators and educators</h3><p class="text-muted-foreground flex-1 text-sm leading-relaxed text-pretty">Grow a newsletter from their content and sell launches with sequences that run on their own.</p><a href="/solutions/content-creators" class="group text-muted-foreground hover:text-foreground focus-visible:ring-ring inline-flex min-h-11 items-center gap-1.5 text-sm transition-colors focus-visible:ring-2 focus-visible:outline-none sm:min-h-9 w-fit">Lumail for creators<span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5 motion-reduce:transition-none">→</span></a></div></li><li><div data-mock-tone="light" class="overflow-hidden rounded-xl border border-border bg-card flex h-full flex-col gap-3 p-6"><h3 class="text-foreground text-base font-medium">Independent newsletter writers</h3><p class="text-muted-foreground flex-1 text-sm leading-relaxed text-pretty">Send a weekly issue from their own domain, with no bill that grows every time the list does.</p><a href="/solutions/newsletters" class="group text-muted-foreground hover:text-foreground focus-visible:ring-ring inline-flex min-h-11 items-center gap-1.5 text-sm transition-colors focus-visible:ring-2 focus-visible:outline-none sm:min-h-9 w-fit">Lumail for newsletters<span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5 motion-reduce:transition-none">→</span></a></div></li><li><div data-mock-tone="light" class="overflow-hidden rounded-xl border border-border bg-card flex h-full flex-col gap-3 p-6"><h3 class="text-foreground text-base font-medium">SaaS founders</h3><p class="text-muted-foreground flex-1 text-sm leading-relaxed text-pretty">Run onboarding, product updates, login codes and receipts from one account. One founder runs four products in two languages on Lumail.</p><a href="/solutions/saas" class="group text-muted-foreground hover:text-foreground focus-visible:ring-ring inline-flex min-h-11 items-center gap-1.5 text-sm transition-colors focus-visible:ring-2 focus-visible:outline-none sm:min-h-9 w-fit">Lumail for SaaS<span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5 motion-reduce:transition-none">→</span></a></div></li><li><div data-mock-tone="light" class="overflow-hidden rounded-xl border border-border bg-card flex h-full flex-col gap-3 p-6"><h3 class="text-foreground text-base font-medium">Developers and AI-first operators</h3><p class="text-muted-foreground flex-1 text-sm leading-relaxed text-pretty">Manage lists, campaigns and workflows from Claude Code, Codex, ChatGPT or the terminal instead of a dashboard.</p><a href="/agents" class="group text-muted-foreground hover:text-foreground focus-visible:ring-ring inline-flex min-h-11 items-center gap-1.5 text-sm transition-colors focus-visible:ring-2 focus-visible:outline-none sm:min-h-9 w-fit">Lumail for agents<span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5 motion-reduce:transition-none">→</span></a></div></li></ul></div></section><section id="team" aria-labelledby="team-title" class="grid scroll-mt-24 gap-8 lg:grid-cols-[minmax(0,20rem)_1fr] lg:gap-16"><div class="flex flex-col gap-4 lg:sticky lg:top-28 lg:self-start"><h2 id="team-title" class="font-display text-foreground text-[1.75rem] leading-[1.15] tracking-[-0.03em] text-balance sm:text-[2.25rem]">The team behind Lumail</h2></div><div><div data-mock-tone="light" class="rounded-xl border border-border bg-card overflow-hidden"><div class="flex flex-col gap-5 p-6 sm:p-8"><div class="flex items-center gap-4"><img src="/images/melvyn-portrait.png" alt="Melvyn Malherbe, founder of Lumail" class="size-16 shrink-0 rounded-full object-cover" width="1000" height="1000" loading="lazy" decoding="async"/><div class="flex flex-col gap-1"><h3 class="text-foreground text-lg font-medium">Melvyn Malherbe</h3><p class="text-muted-foreground text-sm">Founder<!-- -->, <!-- -->Lumail.io</p></div></div><div class="flex flex-col gap-3"><p class="text-muted-foreground text-[15px] leading-relaxed text-pretty">Since 2022, Melvyn has sold courses on coding and building SaaS apps, and has sent more than 3 million emails to his own audience. Every email platform he tried was too complex, too limiting, or not designed for creators, and none of them fit a developer&#x27;s workflow.</p><p class="text-muted-foreground text-[15px] leading-relaxed text-pretty">He wanted to run his newsletter from the terminal instead of clicking through dashboards, so he built Lumail.</p></div><div class="flex flex-wrap gap-x-5 gap-y-1"><a href="https://melvynx.com" target="_blank" rel="noreferrer me" class="text-muted-foreground hover:text-foreground inline-flex min-h-11 items-center text-sm transition-colors sm:min-h-9">melvynx.com ↗</a><a href="https://twitter.com/melvyn_me" target="_blank" rel="noreferrer me" class="text-muted-foreground hover:text-foreground inline-flex min-h-11 items-center text-sm transition-colors sm:min-h-9">@melvyn_me on X ↗</a></div><p class="border-border text-muted-foreground border-t pt-4 text-xs leading-relaxed">Lumail is operated by <!-- -->Codelynx, LLC<!-- -->,<!-- --> <!-- -->8 The Green STE B, Dover Delaware 19901, United States<!-- -->. Email is sent through Amazon SES and account data is stored in Frankfurt.<!-- --> <a href="/cdn-cgi/l/email-protection#4f2c20213b2e2c3b0f233a222e2623612620" class="text-foreground decoration-border hover:decoration-foreground underline underline-offset-4 transition-colors"><span class="__cf_email__" data-cfemail="583b37362c393b2c18342d35393134763137">[email&#160;protected]</span></a> · <a href="/brand" class="text-foreground decoration-border hover:decoration-foreground underline underline-offset-4 transition-colors">Press and brand assets</a></p></div></div><ul class="mt-4 grid gap-4 sm:grid-cols-2"><li><div data-mock-tone="light" class="overflow-hidden rounded-xl border border-border bg-card flex h-full items-center gap-4 p-5"><img src="/images/team/developer.png" alt="" class="size-12 shrink-0 rounded-full object-cover" width="512" height="512" loading="lazy" decoding="async"/><div class="flex flex-col gap-0.5"><h3 class="text-foreground text-sm font-medium">Lucas</h3><p class="text-muted-foreground text-sm">Developer</p></div></div></li><li><div data-mock-tone="light" class="overflow-hidden rounded-xl border border-border bg-card flex h-full items-center gap-4 p-5"><img src="/images/team/support.png" alt="" class="size-12 shrink-0 rounded-full object-cover" width="512" height="512" loading="lazy" decoding="async"/><div class="flex flex-col gap-0.5"><h3 class="text-foreground text-sm font-medium">Inès</h3><p class="text-muted-foreground text-sm">Customer support</p></div></div></li><li><div data-mock-tone="light" class="overflow-hidden rounded-xl border border-border bg-card flex h-full items-center gap-4 p-5"><img src="/images/team/design.png" alt="" class="size-12 shrink-0 rounded-full object-cover" width="512" height="512" loading="lazy" decoding="async"/><div class="flex flex-col gap-0.5"><h3 class="text-foreground text-sm font-medium">Clara</h3><p class="text-muted-foreground text-sm">Design</p></div></div></li><li><div data-mock-tone="light" class="overflow-hidden rounded-xl border border-border bg-card flex h-full items-center gap-4 p-5"><img src="/images/team/marketing.png" alt="" class="size-12 shrink-0 rounded-full object-cover" width="512" height="512" loading="lazy" decoding="async"/><div class="flex flex-col gap-0.5"><h3 class="text-foreground text-sm font-medium">Hugo</h3><p class="text-muted-foreground text-sm">Marketing and content</p></div></div></li></ul></div></section><div data-mock-tone="light" class="overflow-hidden rounded-xl border border-border flex flex-col items-start gap-6 bg-[var(--marketing-wash)] p-8 sm:flex-row sm:items-center sm:justify-between sm:p-10"><div class="flex max-w-xl flex-col gap-2"><h2 class="font-display text-foreground text-[1.75rem] leading-[1.15] tracking-[-0.03em] text-balance sm:text-[1.875rem]">Our research</h2><p class="text-muted-foreground text-pretty text-sm sm:text-base">How long new accounts take to send their first campaign, when campaigns go out, and the industry benchmarks we trust, each with its sources.</p></div><div class="flex flex-wrap items-center gap-3"><a href="/email-marketing-statistics" class="inline-flex min-h-11 items-center justify-center rounded-full px-5 text-sm font-medium transition-[color,background-color,transform] focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none active:scale-[0.97] motion-reduce:active:scale-100 sm:min-h-10 bg-primary text-primary-foreground hover:opacity-90">Read our email marketing statistics</a></div></div></div></main></div><footer class="border-border bg-muted border-t py-12 sm:py-16"><div class="mx-auto w-full max-w-[1190px] px-6 lg:px-10"><div class="grid gap-12 md:grid-cols-[1fr_2.2fr] lg:grid-cols-[minmax(0,15rem)_1fr]"><div class="flex flex-col gap-3"><span class="inline-flex items-center text-foreground"><span class="lumail-lockup inline-flex items-center" style="height:22px;gap:6.285714285714286px"><svg width="22" height="22" viewBox="0 0 91 91" fill="none" xmlns="http://www.w3.org/2000/svg" shape-rendering="geometricPrecision" aria-hidden="true" class="block shrink-0"><image href="/images/lumail-logo-light-128.webp" width="91" height="91" class="dark:hidden"></image><image href="/images/lumail-logo-dark-128.webp" width="91" height="91" class="hidden dark:block"></image></svg><span class="lumail-wordmark" style="font-size:16px">Lumail</span></span></span><p class="text-muted-foreground max-w-[220px] text-sm leading-relaxed">Email for people who write, ship and sell. Campaigns, sequences and transactional, one domain.</p><nav aria-label="Social links" class="flex flex-wrap gap-x-4"><a href="https://github.com/Melvynx/lumail-opensource" target="_blank" rel="noreferrer me" class="text-muted-foreground hover:text-foreground focus-visible:ring-ring inline-flex min-h-11 items-center rounded-sm text-sm transition-colors focus-visible:ring-2 focus-visible:outline-none sm:min-h-9">GitHub</a><a href="https://twitter.com/melvyn_me" target="_blank" rel="noreferrer me" class="text-muted-foreground hover:text-foreground focus-visible:ring-ring inline-flex min