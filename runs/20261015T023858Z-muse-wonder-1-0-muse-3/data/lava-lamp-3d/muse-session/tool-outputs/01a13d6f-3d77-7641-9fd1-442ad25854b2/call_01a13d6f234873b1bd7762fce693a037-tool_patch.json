{"files":[{"path":"/private/var/folders/7z/5mtgxwxx4zs9ppgzm942gbmh0000gn/T/workspace.2tGH9n/app/index.html","hunks":[{"oldStart":453,"oldLines":6,"newStart":453,"newLines":117,"lines":["   waxUniforms.uTime.value = state.time;","   waxUniforms.uHeat.value = 0.12 + state.heatLevel*0.95;"," }","+","+/* ---------- post: bloom + grain/vignette (ACES via renderer) ---------- */","+const composer = new EffectComposer(renderer);","+composer.addPass(new RenderPass(scene, camera));","+const bloom = new UnrealBloomPass(new THREE.Vector2(innerWidth, innerHeight), 0.85, 0.55, 0.62);","+composer.addPass(bloom);","+const gradePass = new ShaderPass({","+  uniforms:{ tDiffuse:{value:null}, uTime:{value:0}, uAspect:{value:innerWidth/innerHeight} },","+  vertexShader:`varying vec2 vUv; void main(){ vUv=uv; gl_Position=projectionMatrix*modelViewMatrix*vec4(position,1.0); }`,","+  fragmentShader:`","+    varying vec2 vUv; uniform sampler2D tDiffuse; uniform float uTime; uniform float uAspect;","+    float hash(vec2 p){ return fract(sin(dot(p, vec2(127.1,311.7)))*43758.5453); }","+    void main(){","+      vec4 c = texture2D(tDiffuse, vUv);","+      vec2 d = vUv - 0.5; d.x *= uAspect;","+      float vig = smoothstep(0.95, 0.35, length(d)*1.15);","+      c.rgb *= mix(0.72, 1.0, vig);","+      float g = (hash(vUv*vec2(1920.0,1080.0)+fract(uTime)*7.0)-0.5)*0.028;","+      c.rgb += g;","+      gl_FragColor = c;","+    }`","+});","+composer.addPass(gradePass);","+composer.addPass(new OutputPass());","+","+/* ---------- controls wiring ---------- */","+const $=id=>document.getElementById(id);","+const presetsEl=$('presets');","+PRESETS.forEach((p,i)=>{","+  const b=document.createElement('button'); b.className='preset'+(i===0?' active':''); b.title=p.name;","+  b.innerHTML=`<i style=\"background:linear-gradient(135deg,#${p.wax.getHexString()} 0 55%,#${p.liquid.getHexString()} 55% 100%)\"></i><b>${p.name}</b>`;","+  b.addEventListener('click',()=>applyPreset(i)); presetsEl.appendChild(b);","+});","+function applyPreset(i){","+  presetIdx=i; const p=PRESETS[i];","+  waxUniforms.uWaxColor.value.copy(p.wax); waxUniforms.uBulbColor.value.copy(p.bulb);","+  liquidMat.color.copy(p.liquid); bulbLight.color.copy(p.bulb); spill.color.copy(p.bulb);","+  bulbMat.emissive.copy(p.bulb);","+  document.querySelectorAll('.preset').forEach((el,j)=>el.classList.toggle('active', j===i));","+}","+$('power').addEventListener('change',e=>{","+  state.power=e.target.checked; $('powerLabel').textContent=state.power?'On':'Off';","+  if(state.power){ state.warmup=0; } // wax must warm before first blob rises","+  switchBtn.material.emissiveIntensity = state.power?0.7:0.02;","+});","+$('heat').addEventListener('input',e=>{ state.heat=parseFloat(e.target.value); $('heatOut').textContent=state.heat.toFixed(2)+'\\u00D7'; });","+$('waxAmt').addEventListener('input',e=>{ state.waxAmt=parseFloat(e.target.value); $('waxOut').textContent=Math.round(state.waxAmt*100)+'%'; });","+$('room').addEventListener('input',e=>{ state.room=parseFloat(e.target.value); $('roomOut').textContent=Math.round(state.room*100)+'%'; });","+$('slow').addEventListener('change',e=>{ state.slow=e.target.checked; });","+$('orbit').addEventListener('change',e=>{ controls.autoRotate=e.target.checked; });","+applyPreset(0);","+","+/* ---------- flicker from wax occluding the bulb ---------- */","+function bulbOcclusion(){","+  let occ=0;","+  for(const b of blobs){ if(!b.active) continue;","+    const dx=b.pos.x, dz=b.pos.z, dy=b.pos.y-1.15;","+    const d=Math.sqrt(dx*dx+dz*dz+dy*dy*0.6);","+    occ += Math.exp(-d*d*3.5) * b.r*1.4;","+  }","+  return THREE.MathUtils.clamp(occ,0,0.55);","+}","+","+/* ---------- adaptive quality ---------- */","+let fpsAcc=0, fpsN=0, fpsTimer=0;","+function adaptQuality(dt){","+  fpsAcc+=dt; fpsN++; fpsTimer+=dt;","+  if(fpsTimer>2.5){","+    const avg=fpsN/Math.max(fpsAcc,1e-3);","+    if(avg<42 && waxUniforms.uSteps.value>34){ waxUniforms.uSteps.value-=8; renderer.setPixelRatio(Math.max(1.0, renderer.getPixelRatio()-0.15)); composer.setPixelRatio(renderer.getPixelRatio()); }","+    else if(avg>57 && waxUniforms.uSteps.value<52){ waxUniforms.uSteps.value+=4; }","+    fpsAcc=0; fpsN=0; fpsTimer=0;","+  }","+}","+","+/* ---------- main loop (fixed-timestep wax) ---------- */","+const clock=new THREE.Clock();","+let accumulator=0; const FIXED=1/60;","+function animate(){","+  requestAnimationFrame(animate);","+  const rawDt=Math.min(clock.getDelta(), 0.05);","+  const timeScale=state.slow?0.22:1.0;","+  const dt=rawDt*timeScale;","+  accumulator+=dt;","+  let guard=0;","+  while(accumulator>=FIXED && guard<4){ stepWax(FIXED); accumulator-=FIXED; guard++; }","+  if(guard>=4) accumulator=0;","+  syncWaxUniforms();","+  // bulb + room respond to power, heat and wax occlusion (flicker/shift)","+  const occ=bulbOcclusion();","+  const flick=1 - occ*0.55 + Math.sin(state.time*13.7)*0.012*state.heatLevel + Math.sin(state.time*7.3+1.7)*0.01*state.heatLevel;","+  const bulbI=(2.0+16*state.heatLevel)*flick;","+  bulbLight.intensity=bulbI; spill.intensity=(0.5+5.0*state.heatLevel)*flick;","+  bulbMat.emissiveIntensity=0.08+3.1*state.heatLevel*flick;","+  bloom.strength=0.25+0.62*state.heatLevel;","+  const rm=state.room;","+  roomLight.intensity=rm*1.1; rimLight.intensity=0.06+rm*0.5; ambient.intensity=0.12+rm*0.85;","+  scene.environmentIntensity=0.10+rm*0.55;","+  gradePass.uniforms.uTime.value=performance.now()*0.001;","+  controls.update();","+  adaptQuality(rawDt);","+  composer.render();","+}","+animate();","+","+addEventListener('resize',()=>{","+  camera.aspect=innerWidth/innerHeight; camera.updateProjectionMatrix();","+  renderer.setSize(innerWidth,innerHeight); composer.setSize(innerWidth,innerHeight);","+  gradePass.uniforms.uAspect.value=innerWidth/innerHeight;","+});","+"," </script>"," </body>"," </html>"]}]}]}