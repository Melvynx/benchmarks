{"files":[{"path":"/private/var/folders/7z/5mtgxwxx4zs9ppgzm942gbmh0000gn/T/workspace.2tGH9n/app/index.html","hunks":[{"oldStart":319,"oldLines":6,"newStart":319,"newLines":140,"lines":["     }","   }"," }","+","+/* ---------- raymarched merging wax (smooth-union SDF) ---------- */","+const blobPosArr=[]; const blobMetaArr=[];","+for(let i=0;i<MAX_BLOBS;i++){ blobPosArr.push(new THREE.Vector4(0,-10,0,0.001)); blobMetaArr.push(new THREE.Vector3(1,0.5,i*3.7)); }","+const waxUniforms = {","+  uBlobs:{ value: blobPosArr },","+  uMeta:{ value: blobMetaArr },","+  uWaxColor:{ value: PRESETS[0].wax.clone() },","+  uBulbColor:{ value: PRESETS[0].bulb.clone() },","+  uTime:{ value:0 },","+  uHeat:{ value:1 },","+  uSteps:{ value:52 },","+};","+const waxVert = /* glsl */`","+  varying vec3 vWorld;","+  void main(){ vec4 wp = modelMatrix * vec4(position,1.0); vWorld = wp.xyz; gl_Position = projectionMatrix * viewMatrix * wp; }","+`;","+const waxFrag = /* glsl */`","+  precision highp float;","+  varying vec3 vWorld;","+  uniform vec4 uBlobs[${MAX_BLOBS}];","+  uniform vec3 uMeta[${MAX_BLOBS}];","+  uniform vec3 uWaxColor; uniform vec3 uBulbColor; uniform float uTime; uniform float uHeat; uniform int uSteps;","+  float vesselR(float y){","+    float t = clamp((y-0.92)/2.10, 0.0, 1.0);","+    float r = mix(0.68, 0.315, pow(t, 0.92));","+    if(t>0.86){ float u=(t-0.86)/0.14; r*=sqrt(max(0.18, 1.0-u*u*0.72)); }","+    if(t<0.04){ float u=t/0.04; r*=0.82+0.18*u; }","+    return r;","+  }","+  float smin(float a, float b, float k){","+    float h = clamp(0.5+0.5*(b-a)/k, 0.0, 1.0);","+    return mix(b, a, h) - k*h*(1.0-h);","+  }","+  float sdEllipsoid(vec3 p, vec3 r){","+    float k0 = length(p/r); float k1 = length(p/(r*r));","+    return k0*(k0-1.0)/max(k1, 1e-4);","+  }","+  float mapWax(vec3 p, out float outTemp){","+    float d = 1e5; float tempAcc = 0.0; float wAcc = 0.0;","+    for(int i=0;i<${MAX_BLOBS};i++){","+      vec4 B = uBlobs[i]; if(B.w < 0.002) continue;","+      vec3 meta = uMeta[i];","+      vec3 q = p - B.xyz;","+      q.x += sin(q.y*6.0 + uTime*1.4 + meta.z)*0.014;","+      q.z += cos(q.y*5.0 + uTime*1.1 + meta.z*1.7)*0.014;","+      vec3 radii = vec3(B.w*0.94, B.w*meta.x, B.w*0.94);","+      float db = sdEllipsoid(q, radii);","+      float nd = smin(d, db, 0.22);","+      float w = exp(-max(db,0.0)*6.0);","+      tempAcc += meta.y * w; wAcc += w;","+      d = nd;","+    }","+    outTemp = wAcc>0.001 ? tempAcc/wAcc : 0.4;","+    // intersect with vessel interior so wax never clips the glass","+    float radial = length(p.xz);","+    float vessel = max(radial - vesselR(p.y), max(0.90 - p.y, p.y - 3.04));","+    d = max(d, vessel + 0.015);","+    return d;","+  }","+  float mapWax(vec3 p){ float t; return mapWax(p,t); }","+  vec3 calcNormal(vec3 p){","+    float e=0.009; vec2 k=vec2(1.0,-1.0);","+    return normalize( k.xyy*mapWax(p+k.xyy*e) + k.yyx*mapWax(p+k.yyx*e) + k.yxy*mapWax(p+k.yxy*e) + k.xxx*mapWax(p+k.xxx*e) );","+  }","+  vec2 boxHit(vec3 ro, vec3 rd, vec3 c, vec3 h){","+    vec3 m=1.0/rd; vec3 n=m*(ro-c); vec3 k=abs(m)*h;","+    vec3 t1=-n-k; vec3 t2=-n+k;","+    return vec2(max(max(t1.x,t1.y),t1.z), min(min(t2.x,t2.y),t2.z));","+  }","+  void main(){","+    vec3 ro = cameraPosition;","+    vec3 rd = normalize(vWorld - ro);","+    vec3 bc = vec3(0.0, 1.97, 0.0); vec3 bh = vec3(0.80, 1.14, 0.80);","+    vec2 tt = boxHit(ro, rd, bc, bh);","+    if(tt.x > tt.y || tt.y < 0.0) discard;","+    float tNear = max(tt.x, 0.0); float tFar = tt.y;","+    float t = tNear; float hitT = -1.0; float hitTemp = 0.5;","+    // sphere-tracing with bounded steps","+    for(int i=0;i<72;i++){","+      if(i>=uSteps) break;","+      vec3 p = ro + rd*t;","+      float tmp; float d = mapWax(p, tmp);","+      if(d < 0.0012){ hitT=t; hitTemp=tmp; break; }","+      t += clamp(d*0.82, 0.008, 0.09);","+      if(t > tFar) break;","+    }","+    if(hitT < 0.0) discard;","+    vec3 P = ro + rd*hitT;","+    vec3 N = calcNormal(P);","+    vec3 V = normalize(ro - P);","+    vec3 bulbPos = vec3(0.0, 1.10, 0.0);","+    vec3 Lvec = bulbPos - P; float Ldist = length(Lvec); vec3 L = Lvec/max(Ldist,1e-3);","+    // thickness toward bulb (few taps) for subsurface look","+    float thick = 0.0;","+    for(int i=1;i<=5;i++){ vec3 sp = P + L*(float(i)*0.07); if(mapWax(sp) < 0.0) thick += 0.07; }","+    float wrapDiff = clamp((dot(N,L)+0.65)/1.65, 0.0, 1.0);","+    float fres = pow(1.0 - max(dot(N,V),0.0), 3.0);","+    float sss = pow(clamp(dot(V,-L)*0.5+0.5, 0.0, 1.0), 3.0) * exp(-thick*2.6);","+    float bulbGlow = exp(-Ldist*1.15) * (0.55+0.75*hitTemp) * uHeat;","+    vec3 deep = uWaxColor * 0.42;","+    vec3 thin = mix(uWaxColor, vec3(1.0,0.92,0.78), 0.35) * 1.25;","+    vec3 col = mix(deep, thin, clamp(hitTemp*0.55 + sss*0.7 + bulbGlow*0.45, 0.0, 1.0));","+    col *= 0.28 + wrapDiff*0.95;","+    col += uBulbColor * sss * 1.35 * uHeat;","+    col += uWaxColor * bulbGlow * 0.85;","+    col += vec3(1.0,0.96,0.9) * pow(max(dot(reflect(-L,N),V),0.0), 42.0) * 0.55;","+    col = mix(col, col*vec3(0.72,0.62,0.68)+uWaxColor*0.10, fres*0.55); // saturated rim in shadow","+    col += uWaxColor * fres * 0.12 * uHeat;","+    // soft fade at vessel silhouette to hide raymarch edge","+    float alpha = 1.0;","+    gl_FragColor = vec4(col, alpha);","+    // write depth so glass / props composite correctly","+    vec4 clip = projectionMatrix * viewMatrix * vec4(P,1.0);","+    float ndcDepth = clip.z/clip.w;","+    gl_FragDepthEXT = (ndcDepth*0.5+0.5);","+  }","+`;","+const waxMat = new THREE.ShaderMaterial({","+  uniforms: waxUniforms, vertexShader: waxVert, fragmentShader: waxFrag,","+  extensions:{ derivatives:true, fragDepth:true },","+  transparent:false, depthWrite:true, depthTest:true, side:THREE.BackSide,","+});","+const waxBox = new THREE.Mesh(new THREE.BoxGeometry(1.60,2.28,1.60), waxMat);","+waxBox.position.set(0,1.97,0); waxBox.renderOrder=4; waxBox.frustumCulled=false;","+scene.add(waxBox);","+function syncWaxUniforms(){","+  for(let i=0;i<MAX_BLOBS;i++){ const b=blobs[i];","+    if(b.active){ blobPosArr[i].set(b.pos.x,b.pos.y,b.pos.z,b.r); blobMetaArr[i].set(b.stretch,b.temp,b.seed); }","+    else blobPosArr[i].set(0,-10,0,0.0001);","+  }","+  waxUniforms.uTime.value = state.time;","+  waxUniforms.uHeat.value = 0.12 + state.heatLevel*0.95;","+}"," </script>"," </body>"," </html>"]}]}]}