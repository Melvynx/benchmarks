{"files":[{"path":"/private/var/folders/7z/5mtgxwxx4zs9ppgzm942gbmh0000gn/T/workspace.2tGH9n/app/index.html","hunks":[{"oldStart":1,"oldLines":0,"newStart":1,"newLines":124,"lines":["+<!DOCTYPE html>","+<html lang=\"en\">","+<head>","+<meta charset=\"utf-8\">","+<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">","+<title>muse-wonder-1.0</title>","+<style>","+  *{margin:0;padding:0;box-sizing:border-box}","+  html,body{width:100%;height:100%;overflow:hidden;background:#070608;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,sans-serif;color:#f3ece6}","+  #app{position:fixed;inset:0}","+  canvas{display:block}","+  .brand{position:fixed;top:18px;left:20px;z-index:10;pointer-events:none}","+  .brand h1{font-size:13px;letter-spacing:.22em;font-weight:600;text-transform:uppercase;color:rgba(255,235,210,.92)}","+  .brand p{font-size:11px;letter-spacing:.08em;color:rgba(255,235,210,.45);margin-top:4px}","+  .hint{position:fixed;right:18px;top:18px;z-index:10;font-size:11px;letter-spacing:.06em;color:rgba(255,240,220,.5);background:rgba(10,8,10,.45);border:1px solid rgba(255,255,255,.08);padding:7px 10px;border-radius:999px;backdrop-filter:blur(10px);pointer-events:none}","+  .panel{position:fixed;left:18px;bottom:18px;z-index:20;width:272px;background:rgba(14,11,14,.72);border:1px solid rgba(255,255,255,.1);border-radius:18px;padding:14px 14px 12px;backdrop-filter:blur(16px) saturate(1.2);box-shadow:0 18px 50px rgba(0,0,0,.55)}","+  .panel-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px}","+  .panel-head span{font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:rgba(255,240,220,.75);font-weight:700}","+  .power{display:flex;align-items:center;gap:8px;cursor:pointer;user-select:none}","+  .power input{display:none}","+  .track{width:44px;height:24px;border-radius:999px;background:#2b2328;border:1px solid rgba(255,255,255,.14);position:relative;transition:.25s;flex:none}","+  .track:after{content:\"\";position:absolute;top:2px;left:2px;width:18px;height:18px;border-radius:50%;background:#8a7f7a;transition:.25s}","+  .power input:checked + .track{background:#ff3b1f;border-color:#ff7a3c;box-shadow:0 0 18px rgba(255,80,30,.55)}","+  .power input:checked + .track:after{left:22px;background:#fff2d8}","+  .power em{font-style:normal;font-size:12px;color:#ffe9c9}","+  .presets{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;margin:10px 0 12px}","+  .preset{height:34px;border-radius:10px;border:1px solid rgba(255,255,255,.14);cursor:pointer;position:relative;overflow:hidden;padding:0}","+  .preset.active{outline:2px solid #fff3d6;outline-offset:1px}","+  .preset i{position:absolute;inset:0}","+  .preset b{position:absolute;left:0;right:0;bottom:3px;font-size:8px;letter-spacing:.04em;color:#fff;text-shadow:0 1px 6px rgba(0,0,0,.8);font-weight:700;text-transform:uppercase}","+  .row{margin:9px 0}","+  .row label{display:flex;justify-content:space-between;font-size:11px;letter-spacing:.05em;color:rgba(255,238,215,.78);margin-bottom:5px}","+  .row label output{color:#ffd9a0;font-variant-numeric:tabular-nums}","+  input[type=range]{width:100%;appearance:none;height:4px;border-radius:99px;background:linear-gradient(90deg,#ff5a2a,#ffb03a);outline:none}","+  input[type=range]::-webkit-slider-thumb{appearance:none;width:15px;height:15px;border-radius:50%;background:#fff3d6;border:2px solid #ff6a2a;box-shadow:0 2px 10px rgba(0,0,0,.5);cursor:pointer}","+  .checks{display:flex;gap:12px;margin-top:10px;flex-wrap:wrap}","+  .checks label{font-size:11px;color:rgba(255,240,220,.8);display:flex;gap:6px;align-items:center;cursor:pointer}","+  .checks input{accent-color:#ff5a2a}","+  @media(max-width:640px){.panel{width:calc(100vw - 24px);left:12px;bottom:12px}.hint{display:none}.brand{left:14px;top:12px}}","+</style>","+<script type=\"importmap\">","+{\"imports\":{\"three\":\"https://unpkg.com/three@0.160.0/build/three.module.js\",\"three/addons/\":\"https://unpkg.com/three@0.160.0/examples/jsm/\"}}","+</script>","+</head>","+<body>","+<div id=\"app\"></div>","+<div class=\"brand\"><h1>muse-wonder-1.0</h1><p>photoreal lava lamp &mdash; drag to orbit</p></div>","+<div class=\"hint\">Scroll to zoom &middot; Drag to orbit &middot; Right-drag to pan</div>","+","+<div class=\"panel\" id=\"panel\">","+  <div class=\"panel-head\"><span>Lava Lamp</span>","+    <label class=\"power\"><input type=\"checkbox\" id=\"power\" checked><span class=\"track\"></span><em id=\"powerLabel\">On</em></label>","+  </div>","+  <div class=\"presets\" id=\"presets\"></div>","+  <div class=\"row\"><label>Heat / flow <output id=\"heatOut\">1.00&times;</output></label><input type=\"range\" id=\"heat\" min=\"0.3\" max=\"2.2\" step=\"0.01\" value=\"1\"></div>","+  <div class=\"row\"><label>Wax amount <output id=\"waxOut\">100%</output></label><input type=\"range\" id=\"waxAmt\" min=\"0.55\" max=\"1.6\" step=\"0.01\" value=\"1\"></div>","+  <div class=\"row\"><label>Room light <output id=\"roomOut\">35%</output></label><input type=\"range\" id=\"room\" min=\"0\" max=\"1\" step=\"0.01\" value=\"0.35\"></div>","+  <div class=\"checks\">","+    <label><input type=\"checkbox\" id=\"slow\"> Slow motion</label>","+    <label><input type=\"checkbox\" id=\"orbit\"> Auto-orbit</label>","+  </div>","+</div>","+","+<script type=\"module\">","+import * as THREE from 'three';","+import { OrbitControls } from 'three/addons/controls/OrbitControls.js';","+import { RoomEnvironment } from 'three/addons/environments/RoomEnvironment.js';","+import { EffectComposer } from 'three/addons/postprocessing/EffectComposer.js';","+import { RenderPass } from 'three/addons/postprocessing/RenderPass.js';","+import { UnrealBloomPass } from 'three/addons/postprocessing/UnrealBloomPass.js';","+import { ShaderPass } from 'three/addons/postprocessing/ShaderPass.js';","+import { OutputPass } from 'three/addons/postprocessing/OutputPass.js';","+","+/* ---------- renderer / scene / camera ---------- */","+const container = document.getElementById('app');","+const renderer = new THREE.WebGLRenderer({ antialias:true, powerPreference:'high-performance' });","+renderer.setPixelRatio(Math.min(devicePixelRatio, 1.6));","+renderer.setSize(innerWidth, innerHeight);","+renderer.shadowMap.enabled = true;","+renderer.shadowMap.type = THREE.PCFSoftShadowMap;","+renderer.toneMapping = THREE.ACESFilmicToneMapping;","+renderer.toneMappingExposure = 1.12;","+renderer.outputColorSpace = THREE.SRGBColorSpace;","+container.appendChild(renderer.domElement);","+","+const scene = new THREE.Scene();","+scene.background = new THREE.Color(0x0a080a);","+scene.fog = new THREE.FogExp2(0x0a080a, 0.045);","+","+const camera = new THREE.PerspectiveCamera(42, innerWidth/innerHeight, 0.1, 100);","+camera.position.set(3.6, 2.6, 4.6);","+","+const controls = new OrbitControls(camera, renderer.domElement);","+controls.target.set(0, 1.65, 0);","+controls.enableDamping = true; controls.dampingFactor = 0.06;","+controls.minDistance = 2.1; controls.maxDistance = 9;","+controls.maxPolarAngle = Math.PI * 0.55; controls.minPolarAngle = 0.12;","+controls.autoRotateSpeed = 0.8;","+","+const pmrem = new THREE.PMREMGenerator(renderer);","+scene.environment = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;","+scene.environmentIntensity = 0.35;","+","+/* ---------- procedural textures ---------- */","+function canvasTex(size, draw, repeat){","+  const c=document.createElement('canvas'); c.width=c.height=size;","+  draw(c.getContext('2d'), size);","+  const t=new THREE.CanvasTexture(c);","+  t.wrapS=t.wrapT=THREE.RepeatWrapping; if(repeat) t.repeat.set(repeat[0],repeat[1]);","+  t.colorSpace=THREE.SRGBColorSpace; t.anisotropy=8; return t;","+}","+const woodTex = canvasTex(512,(g,s)=>{","+  g.fillStyle='#4a3220'; g.fillRect(0,0,s,s);","+  for(let y=0;y<s;y+=3){ const v=Math.sin(y*0.11)*14+Math.sin(y*0.023+2)*20; g.fillStyle=`rgb(${74+v},${50+v*0.6},${30+v*0.35})`; g.fillRect(0,y,s,3); }","+  for(let i=0;i<70;i++){ g.strokeStyle=`rgba(30,18,8,${0.05+Math.random()*0.12})`; g.lineWidth=1+Math.random()*2; g.beginPath(); const y=Math.random()*s; g.moveTo(0,y); g.bezierCurveTo(s*0.3,y+8*(Math.random()-0.5),s*0.7,y+8*(Math.random()-0.5),s,y); g.stroke(); }","+  for(let i=0;i<8;i++){ const x=Math.random()*s,y=Math.random()*s; g.strokeStyle='rgba(25,14,6,.35)'; g.beginPath(); g.ellipse(x,y,10+Math.random()*18,5+Math.random()*7,0,0,7); g.stroke(); }","+},[3,3]);","+const woodRough = canvasTex(512,(g,s)=>{ g.fillStyle='#8a8a8a'; g.fillRect(0,0,s,s); for(let i=0;i<4000;i++){ g.fillStyle=`rgba(${100+Math.random()*80|0},${100+Math.random()*80|0},${100+Math.random()*80|0},.25)`; g.fillRect(Math.random()*s,Math.random()*s,2,8);} },[3,3]);","+woodRough.colorSpace=THREE.NoColorSpace;","+const brushTex = canvasTex(512,(g,s)=>{ g.fillStyle='#7f7f7f'; g.fillRect(0,0,s,s); for(let i=0;i<2600;i++){ const y=Math.random()*s; g.fillStyle=`rgba(${140+Math.random()*90|0},${140+Math.random()*90|0},${140+Math.random()*90|0},.35)`; g.fillRect(0,y,s,1);} },[4,1]);","+brushTex.colorSpace=THREE.NoColorSpace;","+</script>","+</body>","+</html>"]}]}]}