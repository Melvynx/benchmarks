{"files":[{"path":"/private/tmp/verify-tz.mjs","hunks":[{"oldStart":1,"oldLines":0,"newStart":1,"newLines":21,"lines":["+// Independent check replicating spec math with Intl directly","+function offset(tz, date=new Date()){","+  const parts=new Intl.DateTimeFormat('en-US',{timeZone:tz,year:'numeric',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit',second:'2-digit',hourCycle:'h23'}).formatToParts(date)","+  const m={}; for(const p of parts) if(p.type!=='literal') m[p.type]=parseInt(p.value)","+  return Math.round((Date.UTC(m.year,m.month-1,m.day,m.hour,m.minute,m.second)-Math.floor(date.getTime()/1000)*1000)/60000)","+}","+function awake(localMins,wake=7,sleep=23){ const mins=((localMins%1440)+1440)%1440; if(wake===sleep) return true; const s=wake*60,e=sleep*60; return s<e? mins>=s&&mins<e : mins>=s||mins<e }","+const cities={SF:'America/Los_Angeles',Denpasar:'Asia/Makassar',Geneva:'Europe/Zurich',Mumbai:'Asia/Kolkata',Kathmandu:'Asia/Kathmandu'}","+for(const [n,tz] of Object.entries(cities)) console.log(n, offset(tz))","+const ref=offset(cities.SF)","+const den=offset(cities.Denpasar), gen=offset(cities.Geneva)","+const meeting=[]","+for(let h=0;h<24;h++){","+  const a=awake(h*60), b=awake(h*60+(den-ref)), c=awake(h*60+(gen-ref))","+  if(a&&b&&c) meeting.push(h)","+}","+console.log('meetingOverlap (SF ref, 7-23):', meeting)","+console.log('expected contains fractional check Mumbai offset should be 330, Kathmandu 345')","+if(offset(cities.Mumbai)!==330) throw new Error('Mumbai offset wrong')","+if(offset(cities.Kathmandu)!==345) throw new Error('Kathmandu offset wrong')","+console.log('TZ MATH OK')"]}]}]}