{"files":[{"path":"/private/var/folders/7z/5mtgxwxx4zs9ppgzm942gbmh0000gn/T/workspace.dorAZ6/app/src/App.jsx","hunks":[{"oldStart":1,"oldLines":0,"newStart":1,"newLines":154,"lines":["+import { useEffect, useRef, useState, useCallback } from 'react'","+","+function mulberry32(a){return function(){a|=0;a=a+0x6D2B79F5|0;let t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296}}","+const clamp=(v,a,b)=>Math.max(a,Math.min(b,v))","+const dist=(a,b)=>Math.hypot(a.x-b.x,a.y-b.y)","+","+const DEFAULTS={fruitGrowth:1.0,fruitLimit:6,fruitDelay:4,blueEnergyUse:1.0,blueSpeed:34,blueVision:95,blueCopy:78,blueEatTime:1.1,redEnergyUse:1.0,redSpeed:37,redVision:105,redContact:18,redCopy:80,redPause:1.4,startTrees:9,startBlue:14,startRed:6,worldSize:100,seed:7,simSpeed:1}","+const PRESETS={","+  balanced:{...DEFAULTS,label:'Balanced Garden'},","+  fruitRich:{...DEFAULTS,fruitGrowth:2.6,fruitLimit:9,fruitDelay:1.2,startTrees:12,startBlue:16,startRed:6,seed:11,label:'Fruit-Rich Garden'},","+  redHeavy:{...DEFAULTS,startRed:15,startBlue:16,redContact:22,redVision:125,redSpeed:40,fruitGrowth:1.2,seed:21,label:'Red-Heavy Garden'},","+  fragile:{...DEFAULTS,fruitGrowth:0.65,fruitLimit:4,fruitDelay:6,blueCopy:86,redCopy:86,startBlue:10,startRed:5,startTrees:7,seed:33,label:'Fragile Balance'},","+  lowFruit:{...DEFAULTS,fruitGrowth:0.32,fruitLimit:3,fruitDelay:9,startTrees:6,startBlue:10,startRed:4,seed:44,label:'Low-Fruit Garden'},","+}","+let NEXT_ID=1","+function makeBlob(type,x,y,rng,parent){","+  return {id:NEXT_ID++,type,x,y,vx:(rng()-0.5)*10,vy:(rng()-0.5)*10,heading:rng()*Math.PI*2,","+    energy:parent?42+rng()*8:52+rng()*22,age:0,state:type==='blue'?'seek fruit':'wander',stateTimer:0,targetTree:null,targetId:null,","+    reproCooldown:parent?5:2+rng()*3,invuln:0,contactCooldown:0,wanderTimer:rng()*2,blink:1+rng()*3,blinkPhase:0,bounce:rng()*Math.PI*2,","+    speedFactor:parent?clamp(parent.speedFactor+(rng()-0.5)*0.14,0.78,1.32):0.88+rng()*0.28,","+    visionFactor:parent?clamp(parent.visionFactor+(rng()-0.5)*0.14,0.78,1.32):0.88+rng()*0.28,","+    generation:parent?parent.generation+1:1,parentId:parent?parent.id:null,eaten:0,contacts:0,sx:0,sy:0}","+}","+function createSim(p){","+  NEXT_ID=1","+  const rng=mulberry32(p.seed*1000+17)","+  const R=p.worldSize","+  const trees=[]","+  for(let i=0;i<p.startTrees;i++){","+    const a=rng()*Math.PI*2, rr=Math.sqrt(rng())*(R*0.78)","+    trees.push({id:i+1,x:Math.cos(a)*rr,y:Math.sin(a)*rr,fruit:2+Math.floor(rng()*Math.min(4,p.fruitLimit)),delay:0,phase:rng()*Math.PI*2,slots:Array.from({length:12},(_,k)=>{const aa=k/12*Math.PI*2+ rng()*0.4;return{dx:Math.cos(aa)*(10+rng()*9),dy:Math.sin(aa)*(7+rng()*6)-6}})})","+  }","+  const blobs=[]","+  const spawn=(type,n)=>{for(let i=0;i<n;i++){const a=rng()*Math.PI*2,rr=Math.sqrt(rng())*(R*0.75);blobs.push(makeBlob(type,Math.cos(a)*rr,Math.sin(a)*rr,rng,null))}}","+  spawn('blue',p.startBlue); spawn('red',p.startRed)","+  return {time:0,trees,blobs,particles:[],rng,history:[],histTimer:0,births:0,deaths:0,eatenTotal:0,contactsTotal:0,rot:0.4}","+}","+","+function stepSim(sim,p,dt){","+  sim.time+=dt","+  // fruit regrowth: slow return after delay, capped by limit -> levels out","+  for(const t of sim.trees){","+    if(t.delay>0){t.delay-=dt}","+    else if(t.fruit<p.fruitLimit){t.fruit=Math.min(p.fruitLimit,t.fruit+0.20*p.fruitGrowth*dt)}","+  }","+  const blues=sim.blobs.filter(b=>b.type==='blue'), reds=sim.blobs.filter(b=>b.type==='red')","+  const R=p.worldSize","+  const toAdd=[]","+  for(const b of sim.blobs){","+    b.age+=dt; b.bounce+=dt*6; b.blink-=dt; if(b.blink<-0.12)b.blink=2+sim.rng()*3.5","+    b.reproCooldown=Math.max(0,b.reproCooldown-dt); b.invuln=Math.max(0,b.invuln-dt); b.contactCooldown=Math.max(0,b.contactCooldown-dt)","+    const isBlue=b.type==='blue'","+    const eUse=isBlue?p.blueEnergyUse:p.redEnergyUse","+    const baseSpeed=(isBlue?p.blueSpeed:p.redSpeed)*b.speedFactor","+    const vision=(isBlue?p.blueVision:p.redVision)*b.visionFactor","+    let desiredX=0,desiredY=0,moving=false","+","+    if(b.state==='eat'||b.state==='pause'){","+      b.stateTimer-=dt","+      b.energy-=0.85*eUse*dt // waiting uses a little energy","+      if(b.stateTimer<=0){","+        if(b.state==='eat'&&b.targetTree){","+          const t=sim.trees.find(x=>x.id===b.targetTree)","+          if(t&&t.fruit>=1){t.fruit-=1;t.delay=p.fruitDelay;b.energy=clamp(b.energy+32,0,100);b.eaten++;sim.eatenTotal++;burst(sim,b.x,b.y,'#7ac74f')}","+          b.state='seek fruit'","+        }else{b.state=isBlue?'seek fruit':'chase blue'}","+        b.targetTree=null","+      }","+    }else{","+      // --- sensing ---","+      let fleeX=0,fleeY=0,threat=null","+      if(isBlue){","+        for(const r of reds){const d=dist(b,r);if(d<vision*0.95&&(!threat||d<dist(b,threat)))threat=r}","+        if(threat){const d=Math.max(8,dist(b,threat));fleeX=(b.x-threat.x)/d;fleeY=(b.y-threat.y)/d;b.state='flee red'}","+      }","+      // separation / avoid crowded areas","+      let sepX=0,sepY=0,crowd=0","+      for(const o of sim.blobs){if(o===b)continue;const d=dist(b,o);if(d<24&&d>0.01){sepX+=(b.x-o.x)/d*(24-d)*0.06;sepY+=(b.y-o.y)/d*(24-d)*0.06;if(o.type===b.type)crowd++}}","+","+      let target=null","+      if(isBlue&&!threat){","+        let best=1e9","+        for(const t of sim.trees){if(t.fruit<1)continue;const d=dist(b,t);const effVision=b.energy<35?vision*1.35:vision;if(d<effVision&&d<best){best=d;target=t}}","+        if(target){","+          b.state='seek fruit';b.targetTree=target.id","+          if(best<17){b.state='eat';b.stateTimer=p.blueEatTime;burst(sim,b.x,b.y,'#b7e39a');continue}","+          desiredX=(target.x-b.x)/best;desiredY=(target.y-b.y)/best;moving=true","+        }else{b.state='wander'}","+      }","+      if(!isBlue){","+        let best=1e9,prey=null","+        for(const bl of blues){const d=dist(b,bl);if(d<vision&&d<best){best=d;prey=bl}}","+        if(prey){","+          b.state='chase blue';b.targetId=prey.id","+          desiredX=(prey.x-b.x)/Math.max(1,best);desiredY=(prey.y-b.y)/Math.max(1,best);moving=true","+          if(best<19&&prey.invuln<=0&&b.contactCooldown<=0){","+            // gentle contact: red gains, blue loses, both pause/flee - cooldown prevents instant repeat","+            prey.energy-=p.redContact*0.85; prey.invuln=2.4; prey.state='flee red'","+            prey.vx+=(prey.x-b.x)*2.2; prey.vy+=(prey.y-b.y)*2.2","+            b.energy=clamp(b.energy+p.redContact*1.35,0,100); b.contacts++; sim.contactsTotal++","+            b.state='pause'; b.stateTimer=p.redPause; b.contactCooldown=p.redPause+1.8","+            burst(sim,(b.x+prey.x)/2,(b.y+prey.y)/2,'#f6a08c'); continue","+          }","+        }else b.state='wander'","+      }","+      if(threat){desiredX=fleeX*1.5;desiredY=fleeY*1.5;moving=true}","+      if(!moving){","+        b.wanderTimer-=dt","+        if(b.wanderTimer<=0){b.wanderTimer=1+sim.rng()*2.2;b.heading+=(sim.rng()-0.5)*1.8}","+        desiredX=Math.cos(b.heading);desiredY=Math.sin(b.heading)","+        // gentle drift toward centre / trees when wandering so blues eventually find food","+        if(isBlue&&sim.rng()<0.02){const t=sim.trees[Math.floor(sim.rng()*sim.trees.length)];if(t){desiredX=(t.x-b.x)/Math.max(20,dist(b,t));desiredY=(t.y-b.y)/Math.max(20,dist(b,t))}}","+        moving=true","+      }","+      desiredX+=sepX;desiredY+=sepY","+      // stay in round world","+      const dc=Math.hypot(b.x,b.y)","+      if(dc>R*0.82){desiredX+=( -b.x/dc)*1.6;desiredY+=( -b.y/dc)*1.6}","+      const dl=Math.hypot(desiredX,desiredY)||1","+      const sp= b.state==='flee red'?baseSpeed*1.25:baseSpeed","+      b.vx+=(desiredX/dl*sp-b.vx)*Math.min(1,dt*4)","+      b.vy+=(desiredY/dl*sp-b.vy)*Math.min(1,dt*4)","+      b.x+=b.vx*dt; b.y+=b.vy*dt","+      if(Math.hypot(b.x,b.y)>R-8){const a=Math.atan2(b.y,b.x);b.x=Math.cos(a)*(R-8);b.y=Math.sin(a)*(R-8)}","+      b.heading=Math.atan2(b.vy,b.vx)","+      b.energy-=(moving?2.35:0.85)*eUse*(0.75+b.speedFactor*0.35)*dt // moving uses energy","+    }","+    // reproduction costs stored energy -> cannot grow for free","+    const thresh=isBlue?p.blueCopy:p.redCopy","+    if(b.energy>=thresh&&b.reproCooldown<=0&&sim.blobs.length+toAdd.length<110){","+      const cost=thresh*0.58; b.energy-=cost; b.reproCooldown=4","+      const child=makeBlob(b.type,b.x+(sim.rng()-0.5)*14,b.y+(sim.rng()-0.5)*14,sim.rng,b)","+      child.energy=cost*0.88; toAdd.push(child); sim.births++; burst(sim,b.x,b.y,isBlue?'#7db8ff':'#ff9a8a')","+    }","+  }","+  sim.blobs.push(...toAdd)","+  const before=sim.blobs.length","+  sim.blobs=sim.blobs.filter(b=>{if(b.energy<=0){burst(sim,b.x,b.y,'#d8d8c8');return false}return true})","+  sim.deaths+=before-sim.blobs.length","+  for(const pt of sim.particles){pt.x+=pt.vx*dt;pt.y+=pt.vy*dt;pt.life-=dt}","+  sim.particles=sim.particles.filter(pt=>pt.life>0)","+  sim.histTimer-=dt","+  if(sim.histTimer<=0){","+    sim.histTimer=0.6","+    const bl=sim.blobs.filter(b=>b.type==='blue'), rd=sim.blobs.filter(b=>b.type==='red')","+    const avg=a=>a.length?a.reduce((s,x)=>s+x,0)/a.length:0","+    sim.history.push({t:+sim.time.toFixed(1),fruit:Math.round(sim.trees.reduce((s,t)=>s+t.fruit,0)),blue:bl.length,red:rd.length,","+      bSpeed:+avg(bl.map(b=>b.speedFactor)).toFixed(3),bVision:+avg(bl.map(b=>b.visionFactor)).toFixed(3),","+      rSpeed:+avg(rd.map(b=>b.speedFactor)).toFixed(3),rVision:+avg(rd.map(b=>b.visionFactor)).toFixed(3),","+      bEnergy:+avg(bl.map(b=>b.energy)).toFixed(1),rEnergy:+avg(rd.map(b=>b.energy)).toFixed(1)})","+    if(sim.history.length>900)sim.history.shift()","+  }","+}","+function burst(sim,x,y,color){for(let i=0;i<7;i++){const a=Math.random()*Math.PI*2;sim.particles.push({x,y,vx:Math.cos(a)*(8+Math.random()*18),vy:Math.sin(a)*(8+Math.random()*18)-6,life:0.55,color})}}"]}]}]}