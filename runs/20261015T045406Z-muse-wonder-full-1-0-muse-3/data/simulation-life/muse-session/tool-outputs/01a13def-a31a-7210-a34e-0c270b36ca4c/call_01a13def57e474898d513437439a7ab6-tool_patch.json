{"files":[{"path":"/private/var/folders/7z/5mtgxwxx4zs9ppgzm942gbmh0000gn/T/workspace.rjJVGQ/app/src/style.css","hunks":[{"oldStart":1,"oldLines":0,"newStart":1,"newLines":99,"lines":["+* { box-sizing: border-box; }","+body {","+  margin: 0;","+  font-family: ui-rounded, \"SF Pro Rounded\", \"Hiragino Maru Gothic ProN\", system-ui, sans-serif;","+  background: #15231a;","+  color: #22301f;","+  -webkit-font-smoothing: antialiased;","+}","+.topbar {","+  display: flex; flex-wrap: wrap; gap: 12px 20px; align-items: center;","+  padding: 12px 20px; background: #1e3424; color: #eef6e6;","+  border-bottom: 3px solid #0d1710;","+}","+.topbar h1 { font-size: 20px; margin: 0; font-weight: 800; letter-spacing: .2px; }","+.transport { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }","+.btn {","+  border: 2px solid #0d1710; background: #fff6df; color: #22301f;","+  font: inherit; font-weight: 700; font-size: 14px;","+  padding: 7px 14px; border-radius: 999px; cursor: pointer;","+  box-shadow: 0 2px 0 #0d1710;","+}","+.btn:active { transform: translateY(2px); box-shadow: none; }","+.btn.primary { background: #ffd94d; }","+.speed { display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 700; }","+.speed input { accent-color: #ffd94d; width: 110px; }","+.stats { margin-left: auto; display: flex; gap: 14px; font-size: 14px; flex-wrap: wrap; }","+.stat b { font-size: 16px; }","+.stat.fruit { color: #a8e063; } .stat.blue { color: #7ec8f7; }","+.stat.red { color: #ff9d94; } .stat.time { color: #eef6e6; }","+","+.layout {","+  display: grid; grid-template-columns: minmax(0, 1fr) 348px;","+  gap: 16px; padding: 16px; max-width: 1560px; margin: 0 auto; align-items: start;","+}","+@media (max-width: 980px) { .layout { grid-template-columns: 1fr; } }","+","+.stage-wrap {","+  position: relative; border-radius: 24px; overflow: hidden;","+  background: linear-gradient(180deg, #bfe7f5 0%, #dff3d8 55%, #cdeec0 100%);","+  border: 3px solid #0d1710; box-shadow: 0 10px 30px rgba(0,0,0,.35);","+}","+#world { display: block; width: 100%; height: min(62vh, 640px); cursor: grab; touch-action: none; }","+#world:active { cursor: grabbing; }","+.hint {","+  position: absolute; left: 12px; bottom: 10px; font-size: 12px; font-weight: 600;","+  background: rgba(255,255,255,.85); padding: 5px 10px; border-radius: 999px; color: #43563a;","+}","+.inspector {","+  position: absolute; top: 12px; right: 12px; width: 232px;","+  background: rgba(255,250,238,.96); border: 2px solid #22301f; border-radius: 16px;","+  padding: 12px 14px; font-size: 13px; box-shadow: 0 6px 18px rgba(0,0,0,.25);","+}","+.inspector.hidden { display: none; }","+.inspector h3 { margin: 0 0 6px; font-size: 15px; }","+.inspector .row { display: flex; justify-content: space-between; padding: 2px 0; }","+.inspector .bar { height: 10px; background: #e6ddc4; border-radius: 99px; overflow: hidden; margin: 4px 0 8px; border: 1px solid #c9bd97; }","+.inspector .bar i { display: block; height: 100%; background: #7ac74f; }","+.inspector button { float: right; border: none; background: none; font-size: 16px; cursor: pointer; }","+","+.chart-card {","+  margin-top: 16px; background: #fffaf0; border: 2px solid #22301f; border-radius: 20px;","+  padding: 14px 16px; box-shadow: 0 6px 20px rgba(0,0,0,.25);","+}","+.chart-card h2 { margin: 0 0 8px; font-size: 16px; }","+.chart-card canvas { width: 100%; display: block; }","+.chart-head { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; }","+.legend { display: flex; gap: 12px; font-size: 12px; font-weight: 700; }","+.lg::before { content: \"● \"; }","+.lg.fruit { color: #5da23a; } .lg.blue { color: #2f8fd0; } .lg.red { color: #e05348; }","+.summary { margin: 10px 0 0; font-size: 14.5px; line-height: 1.5; color: #3d5230; font-weight: 600; }","+.chart-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }","+@media (max-width: 760px) { .chart-row { grid-template-columns: 1fr; } }","+.chart-card.small { margin-top: 16px; }","+.caption { font-size: 12.5px; color: #6a7d5c; margin: 8px 0 0; }","+","+.panel {","+  background: #fffaf0; border: 2px solid #22301f; border-radius: 20px;","+  padding: 16px; box-shadow: 0 6px 20px rgba(0,0,0,.25);","+  max-height: calc(100vh - 110px); overflow-y: auto; position: sticky; top: 16px;","+}","+.panel h2 { font-size: 15px; margin: 14px 0 8px; }","+.panel h2:first-child { margin-top: 0; }","+.presets { display: flex; flex-wrap: wrap; gap: 7px; }","+.preset {","+  border: 2px solid #22301f; border-radius: 999px; background: #eaf5d8;","+  font: inherit; font-size: 12.5px; font-weight: 700; padding: 6px 11px; cursor: pointer;","+}","+.preset:hover { background: #ffd94d; }","+.preset.active { background: #ffd94d; }","+.group { margin-top: 14px; border-top: 2px dashed #ddd3ae; padding-top: 10px; }","+.group h3 { margin: 0 0 8px; font-size: 13.5px; }","+.ctl { display: grid; grid-template-columns: 1fr 52px; gap: 2px 8px; align-items: center; margin-bottom: 8px; }","+.ctl label { font-size: 12.5px; font-weight: 600; color: #44543a; grid-column: 1 / -1; display: flex; justify-content: space-between; }","+.ctl label output { font-weight: 800; color: #22301f; }","+.ctl input[type=range] { width: 100%; accent-color: #5da23a; grid-column: 1 / -1; margin: 0; }","+.ctl input[type=number] { width: 100%; font: inherit; padding: 4px 6px; border: 1.5px solid #b8ac7e; border-radius: 8px; background: #fff; grid-column: 1 / -1; }","+.note { font-size: 12px; color: #6a7d5c; line-height: 1.5; }","+.how { font-size: 13px; line-height: 1.55; padding-left: 18px; color: #3d5230; }","+.blue-t { color: #2f8fd0; } .red-t { color: #e05348; }"]}]}]}