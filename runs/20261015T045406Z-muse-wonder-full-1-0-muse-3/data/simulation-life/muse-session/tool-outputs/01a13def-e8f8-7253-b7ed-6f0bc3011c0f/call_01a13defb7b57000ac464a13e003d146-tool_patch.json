{"files":[{"path":"/private/var/folders/7z/5mtgxwxx4zs9ppgzm942gbmh0000gn/T/workspace.rjJVGQ/app/src/main.js","hunks":[{"oldStart":1,"oldLines":0,"newStart":1,"newLines":115,"lines":["+import { createWorld, stepWorld, counts, DEFAULTS, MAX_ENERGY } from './sim.js';","+","+const $ = (id) => document.getElementById(id);","+","+const PRESETS = {","+  'Balanced garden': {},","+  'Fruit-rich garden': { fruitGrowth: 1.35, fruitLimit: 10, fruitDelay: 1.2, startTrees: 18, startBlue: 28, startRed: 6, redCopy: 92 },","+  'Red-heavy garden': { startRed: 20, startBlue: 34, redContact: 22 },","+  'Fragile balance': { fruitGrowth: 0.45, fruitLimit: 5, redContact: 23, redSpeed: 42, startBlue: 30, startRed: 9 },","+  'Low-fruit garden': { fruitGrowth: 0.22, fruitLimit: 3, fruitDelay: 4, startTrees: 8, startBlue: 22, startRed: 5 },","+};","+","+const GROUPS = [","+  ['Garden & fruit', [","+    ['fruitGrowth', 'Fruit growth speed', 0.05, 2.5, 0.05],","+    ['fruitLimit', 'Fruit per tree (limit)', 1, 14, 1],","+    ['fruitDelay', 'Fruit return delay (s)', 0, 12, 0.5],","+    ['startTrees', 'Starting fruit trees ↺', 3, 30, 1],","+  ]],","+  ['Blue blobs', [","+    ['blueEnergyUse', 'Energy use', 0.4, 4, 0.1],","+    ['blueSpeed', 'Speed', 10, 70, 1],","+    ['blueVision', 'Vision range', 30, 220, 2],","+    ['blueCopy', 'Copy threshold (energy)', 50, 108, 1],","+    ['blueEatTime', 'Eating time (s)', 0.2, 3.5, 0.1],","+    ['startBlue', 'Starting blue blobs ↺', 0, 90, 1],","+  ]],","+  ['Red blobs', [","+    ['redEnergyUse', 'Energy use', 0.4, 4.5, 0.1],","+    ['redSpeed', 'Speed', 10, 75, 1],","+    ['redVision', 'Vision range', 30, 240, 2],","+    ['redContact', 'Contact strength', 4, 45, 1],","+    ['redCopy', 'Copy threshold (energy)', 50, 108, 1],","+    ['redPause', 'Pause after contact (s)', 0.1, 4, 0.1],","+    ['startRed', 'Starting red blobs ↺', 0, 60, 1],","+  ]],","+  ['World', [","+    ['worldSize', 'World size ↺', 90, 230, 5],","+    ['simSpeed', 'Simulation speed', 0.25, 4, 0.25],","+  ]],","+];","+","+let params = { ...DEFAULTS };","+let world = createWorld(params);","+let playing = true;","+let rotation = 0.6, rotVel = 0;","+let selectedId = null;","+let particles = [];","+let history = [];","+let histTimer = 0;","+let activePreset = 'Balanced garden';","+","+// ---------- controls UI ----------","+const ctlInputs = {};","+function buildControls() {","+  const host = $('controls');","+  host.innerHTML = '';","+  for (const [gname, items] of GROUPS) {","+    const g = document.createElement('div'); g.className = 'group';","+    g.innerHTML = `<h3>${gname}</h3>`;","+    for (const [key, label, min, max, step] of items) {","+      const div = document.createElement('div'); div.className = 'ctl';","+      div.innerHTML = `<label>${label}<output id=\"out-${key}\"></output></label>","+        <input type=\"range\" id=\"ctl-${key}\" min=\"${min}\" max=\"${max}\" step=\"${step}\" value=\"${params[key]}\">`;","+      g.appendChild(div);","+      const input = div.querySelector('input');","+      ctlInputs[key] = input;","+      input.addEventListener('input', () => {","+        params[key] = parseFloat(input.value);","+        world.p[key] = params[key];","+        syncOutputs();","+        if (key === 'simSpeed') { $('ctl-simSpeed-top').value = input.value; $('speed-val').textContent = `${params.simSpeed}×`; }","+      });","+    }","+    host.appendChild(g);","+  }","+  const seedDiv = document.createElement('div'); seedDiv.className = 'ctl';","+  seedDiv.innerHTML = `<label>Random seed ↺<output></output></label>","+    <input type=\"number\" id=\"ctl-seed\" value=\"${params.seed}\" step=\"1\">`;","+  host.lastElementChild.appendChild(seedDiv);","+  seedDiv.querySelector('input').addEventListener('change', (e) => {","+    params.seed = parseInt(e.target.value || '0', 10) >>> 0;","+  });","+  ctlInputs.seed = seedDiv.querySelector('input');","+  syncOutputs();","+}","+function syncOutputs() {","+  for (const key of Object.keys(ctlInputs)) {","+    const out = $(`out-${key}`);","+    if (out) out.textContent = params[key];","+    if (ctlInputs[key] && document.activeElement !== ctlInputs[key]) ctlInputs[key].value = params[key];","+  }","+}","+","+function buildPresets() {","+  const host = $('presets'); host.innerHTML = '';","+  for (const name of Object.keys(PRESETS)) {","+    const b = document.createElement('button');","+    b.className = 'preset' + (name === activePreset ? ' active' : '');","+    b.textContent = name;","+    b.onclick = () => {","+      activePreset = name;","+      params = { ...DEFAULTS, ...PRESETS[name], seed: params.seed, simSpeed: params.simSpeed };","+      buildControls(); buildPresets(); resetWorld();","+    };","+    host.appendChild(b);","+  }","+}","+","+function resetWorld() {","+  world = createWorld(params);","+  history = []; particles = []; selectedId = null; histTimer = 0;","+  record(); updateStats(); updateSummary();","+  $('inspector').classList.add('hidden');","+}"]}]}]}