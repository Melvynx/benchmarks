{"files":[{"path":"/private/tmp/test-sim.mjs","hunks":[{"oldStart":1,"oldLines":0,"newStart":1,"newLines":26,"lines":["+import { createWorld, stepWorld, counts, DEFAULTS } from '/private/var/folders/7z/5mtgxwxx4zs9ppgzm942gbmh0000gn/T/workspace.rjJVGQ/app/src/sim.js';","+","+function run(name, overrides, seconds = 300) {","+  const w = createWorld({ ...DEFAULTS, ...overrides });","+  const dt = 1 / 30;","+  const hist = [];","+  for (let t = 0; t < seconds; t += dt) {","+    stepWorld(w, dt); w.events.length = 0;","+    if (Math.round(t / dt) % 30 === 0) hist.push(counts(w));","+  }","+  const blues = hist.map(h => h.blue), reds = hist.map(h => h.red);","+  const peaks = arr => arr.filter((v,i)=> i>0&&i<arr.length-1&&v>=arr[i-1]&&v>arr[i+1]).length;","+  console.log(name, {","+    blueMax: Math.max(...blues), blueEnd: blues.at(-1), bluePeaks: peaks(blues),","+    redMax: Math.max(...reds), redEnd: reds.at(-1), redPeaks: peaks(reds),","+    fruitEnd: hist.at(-1).fruit, births: w.births, deaths: w.deaths,","+  });","+  console.log('  blue:', blues.filter((_,i)=>i%10===0).join(','));","+  console.log('  red :', reds.filter((_,i)=>i%10===0).join(','));","+  console.log('  fruit:', hist.filter((_,i)=>i%10===0).map(h=>h.fruit).join(','));","+}","+run('balanced', {});","+run('fruit-rich', { fruitGrowth: 1.4, fruitLimit: 10, startTrees: 18 });","+run('low-fruit', { fruitGrowth: 0.22, fruitLimit: 3, startTrees: 8 });","+run('red-heavy', { startRed: 22, startBlue: 30 });","+run('fragile', { fruitGrowth: 0.4, redContact: 26, redSpeed: 44 });"]}]}]}