{"files":[{"path":"/private/var/folders/7z/5mtgxwxx4zs9ppgzm942gbmh0000gn/T/workspace.EMKV4o/app/index.html","hunks":[{"oldStart":178,"oldLines":3,"newStart":178,"newLines":101,"lines":[" const rim=new THREE.DirectionalLight(0xbfd0ff,0.35); rim.position.set(-4,5,-3); scene.add(rim);"," const poolLight=new THREE.SpotLight(0xff9a3d,0,9,0.9,1,1.6); poolLight.position.set(0,1.2,0); poolLight.target.position.set(0,0,2.5); scene.add(poolLight,poolLight.target);"," ","+// ---- wax: heat-driven blob agents + MarchingCubes merging surface ----","+const waxMat=new THREE.MeshPhysicalMaterial({color:0xff2200,roughness:0.34,metalness:0,transmission:0.18,thickness:1.1,ior:1.42,emissive:0xff1800,emissiveIntensity:0.55,clearcoat:0.35,clearcoatRoughness:0.45,envMapIntensity:0.45,sheen:0.4,sheenColor:new THREE.Color(0xff6a33)});","+waxMat.onBeforeCompile=(sh)=>{","+  sh.uniforms.uPower={value:1}; waxMat.userData.shader=sh;","+  sh.fragmentShader=sh.fragmentShader.replace('#include <emissivemap_fragment>',","+  `#include <emissivemap_fragment>","+   // fake SSS: thin / low areas near bulb glow warmer","+   float sss = smoothstep(2.6,1.1,vWorldPosition.y) * uPowerF;","+   totalEmissiveRadiance += diffuseColor.rgb * sss * 0.85;`);","+  sh.fragmentShader='uniform float uPowerF;\\nvarying vec3 vWorldPosition;\\n'+sh.fragmentShader;","+  sh.vertexShader='varying vec3 vWorldPosition;\\n'+sh.vertexShader.replace('#include <worldpos_vertex>','#include <worldpos_vertex>\\n vWorldPosition=(modelMatrix*vec4(transformed,1.0)).xyz;');","+  sh.uniforms.uPowerF={value:1}; waxMat.userData.uPowerF=sh.uniforms.uPowerF;","+};","+const MC_W=1.14, MC_H=2.72, MC_Y0=GLASS_Y0+0.06;","+const wax=new MarchingCubes(56,waxMat,false,false,12000);","+wax.isolation=72;","+wax.scale.set(MC_W,MC_H,MC_W);","+wax.position.set(0,MC_Y0+MC_H/2,0);","+wax.castShadow=false; wax.receiveShadow=false; wax.renderOrder=3;","+scene.add(wax);","+","+const N_BLOBS=26;","+const blobs=[];","+function rand(a,b){ return a+Math.random()*(b-a); }","+for(let i=0;i<N_BLOBS;i++){","+  const t=Math.pow(Math.random(),1.6); // more near bottom initially, already running","+  blobs.push({ y: MC_Y0+0.12 + t*(MC_H-0.35), angle: rand(0,Math.PI*2), radial: rand(0,0.16), vy: rand(-0.02,0.05), temp: rand(0.25,0.95), r: rand(0.13,0.30), phase: rand(0,Math.PI*2), seed: rand(0.7,1.3), wob: rand(0.6,1.4) });","+}","+let powerOn=true, powerLevel=1, heat=1, waxAmount=1, warmup=1; // warmup 1 = already hot on load","+let simTime=0;","+function stepWax(dt){","+  simTime+=dt;","+  const target=powerOn?1:0;","+  // warmup is slow on power-on, cooling slower","+  if(powerOn) warmup=Math.min(1,warmup+dt*0.14); else warmup=Math.max(0,warmup-dt*0.08);","+  powerLevel += (target-powerLevel)*Math.min(1,dt*1.8);","+  for(const b of blobs){","+    const tNorm=(b.y-MC_Y0)/MC_H;","+    const heatHere = powerLevel * warmup * Math.exp(-tNorm*2.2) * heat; // strongest at bulb","+    const coolHere = Math.max(0,tNorm-0.55)*0.55 + 0.04;","+    if(powerOn) b.temp += (heatHere*0.55 - coolHere*0.28)*dt*b.seed;","+    else b.temp -= dt*0.10*(0.4+b.temp);","+    b.temp=THREE.MathUtils.clamp(b.temp,-0.2,1.15);","+    // buoyancy: warm rises, cold sinks, with drag & terminal velocity","+    const buoy=(b.temp-0.42)*0.55*heat;","+    b.vy += buoy*dt;","+    b.vy *= Math.exp(-dt*1.15); // drag","+    b.vy=THREE.MathUtils.clamp(b.vy,-0.22,0.34);","+    if(!powerOn) b.vy += (-0.06-b.vy)*dt*0.8;","+    b.y += b.vy*dt*60*0.016*1.0;","+    // gentle convection drift + wobble-driven radial wander","+    b.angle += dt*0.12*Math.sin(simTime*0.3*b.wob+b.phase);","+    b.radial += Math.sin(simTime*0.45*b.wob+b.phase*2)*dt*0.012;","+    // bounds following taper","+    const rMax=Math.max(0.03, radiusAt(THREE.MathUtils.clamp(tNorm,0,1))*0.88 - b.r*0.55);","+    b.radial=THREE.MathUtils.clamp(b.radial,0,Math.max(0,rMax-0.02));","+    const yMin=MC_Y0+b.r*0.45, yMax=MC_Y0+MC_H-b.r*0.55;","+    if(b.y<yMin){ b.y=yMin; b.vy=Math.abs(b.vy)*0.25; b.temp=Math.max(b.temp,powerOn?0.55*b.seed: b.temp); }","+    if(b.y>yMax){ b.y=yMax; b.vy=-Math.abs(b.vy)*0.25; b.temp=Math.min(b.temp,0.25); }","+    // recycle: a cooled blob that reaches bottom reheats; a hot blob reaching top cools (handled by temp fields)","+  }","+}","+function updateWaxField(){","+  wax.reset();","+  const active=Math.max(3,Math.round(N_BLOBS*Math.min(waxAmount,1.35)));","+  const subtract=11;","+  const add=(wx,wy,wz,r,strengthScale=1)=>{","+    const bx=0.5+wx/MC_W, by=(wy-MC_Y0)/MC_H, bz=0.5+wz/MC_W;","+    if(by<0.02||by>0.98) return;","+    const rn=r/MC_H;","+    const strength=THREE.MathUtils.clamp(2.6*rn*rn*140,0.08,1.15)*strengthScale; // tuned for isolation 72","+    wax.addBall(bx,by,bz,strength,subtract);","+  };","+  // warm pool at bottom: flattened cluster feeding blobs","+  const poolR=0.44*Math.sqrt(Math.min(waxAmount,1.5));","+  const poolLift=0.5+0.5*Math.sin(simTime*0.7)*0.08 + warmup*0.12;","+  for(let i=0;i<7;i++){ const a=i/7*Math.PI*2+0.4; const rr=(i===0?0:poolR*0.55); add(Math.cos(a)*rr, MC_Y0+0.10+Math.sin(simTime*0.9+i)*0.008, Math.sin(a)*rr, 0.20, 1.05*poolLift); }","+  add(0,MC_Y0+0.13,0,0.26,1.1*poolLift);","+  for(let i=0;i<active;i++){","+    const b=blobs[i];","+    const wobX=Math.sin(simTime*1.3*b.wob+b.phase)*0.018;","+    const wobZ=Math.cos(simTime*1.1*b.wob+b.phase*1.7)*0.018;","+    const wx=Math.cos(b.angle)*b.radial+wobX, wz=Math.sin(b.angle)*b.radial+wobZ;","+    const stretch=THREE.MathUtils.clamp(Math.abs(b.vy)*2.4,0,0.65);","+    const r=b.r*(0.85+0.25*b.temp)*(waxAmount>1? Math.sqrt(Math.min(waxAmount,1.45)):1);","+    add(wx,b.y,wz,r,1);","+    if(stretch>0.12){ // elongated neck when moving fast","+      const dir=Math.sign(b.vy)||1;","+      add(wx,b.y+dir*r*0.55,wz,r*0.72,0.85);","+      add(wx,b.y-dir*r*0.42,wz,r*0.62,0.7);","+      // occasional pinch-off droplet","+      if(Math.sin(simTime*0.23+b.phase*3)>0.86) add(wx*0.92,b.y+dir*r*1.15,wz*0.92,r*0.38,0.8);","+    }","+  }","+  wax.update();","+}","+","+"]}]}]}