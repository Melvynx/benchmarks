{"files":[{"path":"/private/var/folders/7z/5mtgxwxx4zs9ppgzm942gbmh0000gn/T/workspace.EMKV4o/app/index.html","hunks":[{"oldStart":1,"oldLines":0,"newStart":1,"newLines":52,"lines":["+<!DOCTYPE html>","+<html lang=\"en\">","+<head>","+<meta charset=\"utf-8\">","+<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">","+<title>muse-wonder-1.0</title>","+<style>","+*{box-sizing:border-box}html,body{margin:0;height:100%;overflow:hidden;background:#070507;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,sans-serif;color:#f5efe8}","+#app{position:fixed;inset:0}canvas{display:block}","+.brand{position:fixed;top:20px;left:22px;z-index:10;pointer-events:none}","+.brand h1{font-size:15px;letter-spacing:.22em;font-weight:600;margin:0;text-transform:lowercase;color:rgba(255,244,230,.92);text-shadow:0 2px 18px rgba(0,0,0,.7)}","+.brand p{margin:6px 0 0;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:rgba(255,244,230,.45)}","+.hint{position:fixed;left:22px;bottom:20px;z-index:10;font-size:11px;letter-spacing:.08em;color:rgba(255,244,230,.48);pointer-events:none;text-shadow:0 1px 8px #000}","+.panel{position:fixed;right:18px;bottom:18px;z-index:20;width:288px;padding:16px 16px 14px;border-radius:18px;background:linear-gradient(160deg,rgba(20,16,20,.72),rgba(10,8,12,.62));backdrop-filter:blur(16px) saturate(1.2);-webkit-backdrop-filter:blur(16px);border:1px solid rgba(255,255,255,.10);box-shadow:0 18px 50px rgba(0,0,0,.55)}","+.panel .row{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:10px 0}","+.panel label{font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:rgba(255,244,230,.72)}","+.panel input[type=range]{-webkit-appearance:none;appearance:none;width:150px;height:4px;border-radius:99px;background:rgba(255,255,255,.18);outline:none}","+.panel input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:16px;height:16px;border-radius:50%;background:#ffd9a0;border:2px solid rgba(0,0,0,.35);box-shadow:0 0 12px rgba(255,180,90,.7);cursor:pointer}","+.swatches{display:flex;gap:8px;flex-wrap:wrap;margin:6px 0 2px}","+.swatch{width:34px;height:34px;border-radius:50%;border:2px solid rgba(255,255,255,.18);cursor:pointer;padding:0;position:relative;box-shadow:inset 0 0 0 3px rgba(0,0,0,.18)}","+.swatch.active{border-color:#fff;transform:scale(1.08)}","+.switch{position:relative;width:48px;height:26px;flex:0 0 auto}","+.switch input{opacity:0;width:100%;height:100%;position:absolute;margin:0;cursor:pointer;z-index:2}","+.knob{position:absolute;inset:0;border-radius:99px;background:rgba(255,255,255,.16);transition:.25s;border:1px solid rgba(255,255,255,.14)}","+.knob:after{content:\"\";position:absolute;top:3px;left:3px;width:18px;height:18px;border-radius:50%;background:#ddd;transition:.25s}","+.switch input:checked + .knob{background:rgba(255,166,66,.85);box-shadow:0 0 16px rgba(255,150,50,.55)}","+.switch input:checked + .knob:after{left:25px;background:#fff7e8}","+.small{font-size:11px;color:rgba(255,244,230,.55)}","+.divider{height:1px;background:rgba(255,255,255,.09);margin:12px 0}","+@media(max-width:640px){.panel{left:12px;right:12px;width:auto;bottom:12px}.hint{display:none}.brand{top:14px;left:14px}}","+</style>","+<script type=\"importmap\">","+{\"imports\":{\"three\":\"https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js\",\"three/addons/\":\"https://cdn.jsdelivr.net/npm/three@0.160.0/examples/jsm/\"}}","+</script>","+</head>","+<body>","+<div id=\"app\"></div>","+<div class=\"brand\"><h1>muse-wonder-1.0</h1><p>lava lamp &mdash; night study</p></div>","+<div class=\"hint\">Drag to orbit &middot; Scroll to zoom &middot; Click the cord switch</div>","+","+<aside class=\"panel\" aria-label=\"Lamp controls\">","+  <div class=\"row\" style=\"margin-top:0\"><label for=\"power\">Power</label><span class=\"switch\"><input id=\"power\" type=\"checkbox\" checked><span class=\"knob\"></span></span></div>","+  <div class=\"divider\"></div>","+  <label>Colour</label>","+  <div class=\"swatches\" id=\"swatches\"></div>","+  <div class=\"row\"><label for=\"heat\">Heat</label><input id=\"heat\" type=\"range\" min=\"0.4\" max=\"2\" step=\"0.01\" value=\"1\"></div>","+  <div class=\"row\"><label for=\"waxAmt\">Wax amount</label><input id=\"waxAmt\" type=\"range\" min=\"0.35\" max=\"1.6\" step=\"0.01\" value=\"1\"></div>","+  <div class=\"row\"><label for=\"room\">Room light</label><input id=\"room\" type=\"range\" min=\"0\" max=\"1.6\" step=\"0.01\" value=\"0.55\"></div>","+  <div class=\"divider\"></div>","+  <div class=\"row\"><label for=\"slow\">Slow motion</label><span class=\"switch\"><input id=\"slow\" type=\"checkbox\"><span class=\"knob\"></span></span></div>","+  <div class=\"row\" style=\"margin-bottom:0\"><label for=\"orbit\">Auto-orbit</label><span class=\"switch\"><input id=\"orbit\" type=\"checkbox\"><span class=\"knob\"></span></span></div>","+</aside>"]}]}]}