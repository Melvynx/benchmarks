{"files":[{"path":"/private/var/folders/7z/5mtgxwxx4zs9ppgzm942gbmh0000gn/T/workspace.BgIIQO/app/index.html","hunks":[{"oldStart":1,"oldLines":0,"newStart":1,"newLines":102,"lines":["+<!DOCTYPE html>","+<html lang=\"en\">","+<head>","+<meta charset=\"UTF-8\" />","+<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />","+<title>muse-wonder-full-1.0</title>","+<link rel=\"stylesheet\" href=\"/src/style.css\" />","+</head>","+<body>","+<header class=\"topbar\">","+  <div class=\"title-block\">","+    <h1>muse-wonder-full-1.0</h1>","+    <p class=\"subtitle\">A living garden — fruit trees, blue blobs &amp; red blobs in a tiny tabletop world. Tune the rules, press play, watch the waves.</p>","+  </div>","+  <div class=\"stats-strip\" id=\"statsStrip\">","+    <div class=\"stat\"><span class=\"dot fruit-dot\"></span><b id=\"statFruit\">0</b><small>fruit</small></div>","+    <div class=\"stat\"><span class=\"dot blue-dot\"></span><b id=\"statBlue\">0</b><small>blue blobs</small></div>","+    <div class=\"stat\"><span class=\"dot red-dot\"></span><b id=\"statRed\">0</b><small>red blobs</small></div>","+    <div class=\"stat\"><b id=\"statTime\">0s</b><small>garden time</small></div>","+    <div class=\"stat\"><b id=\"statGen\">0</b><small>births</small></div>","+  </div>","+</header>","+","+<main class=\"layout\">","+  <section class=\"world-panel\">","+    <div class=\"world-wrap\">","+      <canvas id=\"world\" width=\"720\" height=\"640\"></canvas>","+      <div class=\"world-hud\">","+        <span>Drag to rotate · Click a blob to inspect</span>","+        <span id=\"hudState\">Paused</span>","+      </div>","+    </div>","+    <div class=\"transport\">","+      <button id=\"btnPlay\" class=\"primary\">▶ Play</button>","+      <button id=\"btnPause\">⏸ Pause</button>","+      <button id=\"btnStep\">⏭ Step</button>","+      <button id=\"btnReset\">↺ Reset</button>","+      <button id=\"btnRandom\">🎲 Randomize</button>","+      <label class=\"speed-label\">Speed <input id=\"simSpeed\" type=\"range\" min=\"0.25\" max=\"5\" step=\"0.25\" value=\"1\"><span id=\"simSpeedVal\">1×</span></label>","+    </div>","+    <div class=\"inspector\" id=\"inspector\">","+      <h3>Blob inspector</h3>","+      <p class=\"muted\" id=\"inspectorEmpty\">Click any blue or red blob in the garden to see its energy, age, action and traits.</p>","+      <div id=\"inspectorBody\" hidden>","+        <div class=\"insp-head\"><span id=\"inspSwatch\" class=\"swatch\"></span><b id=\"inspName\">Blue blob #1</b><span id=\"inspAction\" class=\"pill\">wandering</span></div>","+        <div class=\"energy-bar\"><div id=\"inspEnergyFill\"></div></div>","+        <dl class=\"insp-grid\">","+          <div><dt>Energy</dt><dd id=\"inspEnergy\">—</dd></div>","+          <div><dt>Age</dt><dd id=\"inspAge\">—</dd></div>","+          <div><dt>Speed trait</dt><dd id=\"inspSpeed\">—</dd></div>","+          <div><dt>Sense range</dt><dd id=\"inspVision\">—</dd></div>","+          <div><dt>Pause left</dt><dd id=\"inspPause\">—</dd></div>","+          <div><dt>Generation</dt><dd id=\"inspGen\">—</dd></div>","+          <div><dt>Children</dt><dd id=\"inspKids\">—</dd></div>","+          <div><dt>Metabolism</dt><dd id=\"inspMeta\">—</dd></div>","+        </dl>","+      </div>","+    </div>","+  </section>","+","+  <aside class=\"side\">","+    <section class=\"card\">","+      <h2>Presets</h2>","+      <div class=\"preset-row\" id=\"presetRow\">","+        <button data-preset=\"balanced\" class=\"preset active\">🌱 Balanced garden</button>","+        <button data-preset=\"fruitRich\" class=\"preset\">🍏 Fruit-rich</button>","+        <button data-preset=\"redHeavy\" class=\"preset\">🔴 Red-heavy</button>","+        <button data-preset=\"fragile\" class=\"preset\">🫧 Fragile balance</button>","+        <button data-preset=\"lowFruit\" class=\"preset\">🏜 Low-fruit</button>","+      </div>","+      <p class=\"muted\" id=\"presetDesc\">Gentle waves: fruit feeds blue, blue feeds red, too many reds starve themselves.</p>","+    </section>","+","+    <section class=\"card controls\">","+      <h2>Tune the living toy</h2>","+      <div id=\"controlsHost\"></div>","+    </section>","+  </aside>","+","+  <section class=\"charts\">","+    <div class=\"card chart-main\">","+      <div class=\"chart-head\"><h2>Population story</h2><div class=\"legend\"><span><i class=\"lg fruit\"></i>Fruit</span><span><i class=\"lg blue\"></i>Blue</span><span><i class=\"lg red\"></i>Red</span></div></div>","+      <canvas id=\"historyChart\" width=\"900\" height=\"240\"></canvas>","+      <p class=\"muted small\">Each line is scaled to its own peak so all three stay readable. Values are recorded live from the simulation — nothing is faked.</p>","+    </div>","+    <div class=\"card\">","+      <h2>Blue vs red — phase plot</h2>","+      <canvas id=\"phaseChart\" width=\"320\" height=\"240\"></canvas>","+      <p class=\"muted small\">Loops mean the two groups chase each other in waves.</p>","+    </div>","+    <div class=\"card summary-card\">","+      <h2>Run summary</h2>","+      <p id=\"summaryText\" class=\"summary\">Press play and let the garden run — a story will appear here.</p>","+      <canvas id=\"traitChart\" width=\"320\" height=\"110\"></canvas>","+      <p class=\"muted small\">Average inherited traits over time (blue speed ×, red speed ×). Children inherit traits with small mutations.</p>","+      <ul id=\"summaryFacts\" class=\"facts\"></ul>","+    </div>","+  </section>","+</main>","+<script type=\"module\" src=\"/src/main.js\"></script>","+</body>","+</html>"]}]}]}