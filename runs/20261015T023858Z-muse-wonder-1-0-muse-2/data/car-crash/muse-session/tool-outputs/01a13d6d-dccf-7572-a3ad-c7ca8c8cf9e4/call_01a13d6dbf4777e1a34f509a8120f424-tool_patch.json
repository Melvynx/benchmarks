{"files":[{"path":"/private/var/folders/7z/5mtgxwxx4zs9ppgzm942gbmh0000gn/T/workspace.bmv51W/app/index.html","hunks":[{"oldStart":1,"oldLines":0,"newStart":1,"newLines":82,"lines":["+<!DOCTYPE html>","+<html lang=\"en\">","+<head>","+<meta charset=\"UTF-8\">","+<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">","+<title>Muse Code powered by muse-wonder-1.0</title>","+<style>","+*{box-sizing:border-box;margin:0;padding:0}","+html,body{width:100%;height:100%;overflow:hidden;background:#0f172a;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;color:#e2e8f0}","+#app{position:fixed;inset:0}","+canvas{display:block;width:100%;height:100%}","+.topbar{position:absolute;left:16px;top:14px;right:16px;display:flex;justify-content:space-between;align-items:flex-start;pointer-events:none;gap:12px}","+.brand{pointer-events:auto;background:rgba(15,23,42,.82);backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,.12);border-radius:16px;padding:12px 16px;box-shadow:0 10px 30px rgba(0,0,0,.35)}","+.brand h1{font-size:18px;letter-spacing:.2px;line-height:1}","+.brand p{font-size:11px;color:#94a3b8;margin-top:6px;letter-spacing:.08em;text-transform:uppercase}","+.badge{background:#f59e0b;color:#111827;font-weight:800;border-radius:999px;padding:2px 7px;font-size:10px;vertical-align:middle;margin-left:6px}","+.telemetry{pointer-events:auto;display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end}","+.stat{background:rgba(15,23,42,.82);backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,.12);border-radius:14px;padding:9px 12px;min-width:92px}","+.stat b{display:block;font-size:18px;line-height:1;color:#fff}","+.stat span{font-size:10px;letter-spacing:.09em;text-transform:uppercase;color:#94a3b8}","+.panel{position:absolute;left:16px;top:108px;width:292px;background:rgba(15,23,42,.88);backdrop-filter:blur(12px);border:1px solid rgba(255,255,255,.13);border-radius:18px;padding:16px;box-shadow:0 18px 40px rgba(0,0,0,.4)}"