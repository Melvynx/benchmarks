id=\"c\"></canvas>","+<div class=\"topbar\">","+  <div class=\"brand\"><h1>Muse Code powered by muse-wonder-1.0 <span class=\"badge\">CRASH LAB</span></h1><p>2D Rigid-Body Crash Experiment &bull; 80 px / m</p></div>","+  <div class=\"telemetry\">","+    <div class=\"stat\"><b id=\"tSpeed\">0.0</b><span>Car m/s</span></div>","+    <div class=\"stat\"><b id=\"tTime\">0.00</b><span>Elapsed s</span></div>","+    <div class=\"stat\"><b id=\"tMoving\">0</b><span>Moving bricks</span></div>","+    <div class=\"stat\"><b id=\"tKE\">0</b><span>Car KE kJ</span></div>","+  </div>","+</div>","+","+<aside class=\"panel\">","+  <h2>Settings</h2>","+  <p class=\"sub\">Defaults are the mandatory baseline. Press <b style=\"color:#fff\">Test</b> to reset with current settings and launch.</p>","+","+  <div class=\"row\"><div class=\"row-head\"><label>Car speed</label><output id=\"oSpeed\">22 m/s</output></div>","+  <input id=\"inSpeed\" type=\"range\" min=\"5\" max=\"45\" step=\"1\" value=\"22\"><div class=\"scale\"><span>5</span><span>45 m/s</span></div></div>","+","+  <div class=\"row\"><div class=\"row-head\"><label>Wall columns</label><output id=\"oCols\">12 bricks</output></div>","+  <input id=\"inCols\" type=\"range\" min=\"4\" max=\"24\" step=\"1\" value=\"12\"><div class=\"scale\"><span>4</span><span>24</span></div></div>","+","+  <div class=\"row\"><div class=\"row-head\"><label>Wall rows</label><output id=\"oRows\">8 bricks</output></div>","+  <input id=\"inRows\" type=\"range\" min=\"3\" max=\"16\" step=\"1\" value=\"8\"><div class=\"scale\"><span>3</span><span>16</span></div></div>","+","+  <div class=\"row\"><div class=\"row-head\"><label>Wall depth layers</label><output id=\"oLayers\">2 layers</output></div>","+  <input id=\"inLayers\" type=\"range\" min=\"1\" max=\"5\" step=\"1\" value=\"2\"><div class=\"scale\"><span>1</span><span>5 layers</span></div></div>","+","+  <div class=\"row\"><div class=\"row-head\"><label>Brick mass</label><output id=\"oMass\">2.5 kg</output></div>","+  <input id=\"inMass\" type=\"range\" min=\"0.5\" max=\"12\" step=\"0.5\" value=\"2.5\"><div class=\"scale\"><span>0.5</span><span>12 kg</span></div></div>","+","+  <div class=\"btns\"><button id=\"testBtn\">&#9654; TEST</button><button id=\"resetBtn\">&#8635; Reset</button></div>","+  <div id=\"status\" class=\"status\">READY — wall standing</div>","+  <p class=\"hint\"><b>Fixed physics:</b> gravity 9.81 m/s&sup2; &bull; brick 0.50&times;0.24 m &bull; friction &mu; 0.72 &bull; restitution 0.18 &bull; car 1,250 kg, 4.2&times;1.45 m &bull; ground &mu; 0.85. Same settings &rarr; same outcome (no physics randomness).</p>","+  <div class=\"legend\"><span class=\"chip\">192 bricks @ default</span><span class=\"chip\">120 Hz solver</span><span class=\"chip\">Impulse + friction</span></div>","+</aside>","+</div>"]}]}]}