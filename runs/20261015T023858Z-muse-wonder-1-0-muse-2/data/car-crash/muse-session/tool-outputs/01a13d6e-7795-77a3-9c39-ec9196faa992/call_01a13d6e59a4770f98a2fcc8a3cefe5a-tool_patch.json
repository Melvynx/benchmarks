{"files":[{"path":"/private/var/folders/7z/5mtgxwxx4zs9ppgzm942gbmh0000gn/T/workspace.bmv51W/app/index.html","hunks":[{"oldStart":80,"oldLines":3,"newStart":80,"newLines":127,"lines":["   <div class=\"legend\"><span class=\"chip\">192 bricks @ default</span><span class=\"chip\">120 Hz solver</span><span class=\"chip\">Impulse + friction</span></div>"," </aside>"," </div>","+<script>","+(function(){","+\"use strict\";","+const canvas=document.getElementById('c'),ctx=canvas.getContext('2d');","+const SCALE=80,GRAV=9.81,BRICK_W=0.50,BRICK_H=0.24,BRICK_FRIC=0.72,REST=0.18,CAR_MASS=1250,CAR_W=4.2;","+const GROUND_FRIC=0.85;","+let W=0,H=0;","+function resize(){const d=Math.min(devicePixelRatio||1,2);W=innerWidth;H=innerHeight;canvas.width=W*d;canvas.height=H*d;ctx.setTransform(d,0,0,d,0,0);}","+addEventListener('resize',resize);resize();","+const $=id=>document.getElementById(id);","+const settings={speed:22,cols:12,rows:8,layers:2,mass:2.5};","+let bricks=[],car=null,particles=[],skids=[],state='ready',elapsed=0,shake=0,impactDone=false,seed=12345,wheelRot=0,carTilt=0,prevCarVx=0;","+function rnd(){seed=(seed*1664525+1013904223)>>>0;return seed/4294967296;}","+function buildScene(running){","+  seed=987654321;bricks=[];particles=[];skids=[];elapsed=0;shake=0;impactDone=false;wheelRot=0;carTilt=0;","+  const wallX=16.0;","+  for(let layer=0;layer<settings.layers;layer++)for(let r=0;r<settings.rows;r++){","+    const stagger=(r%2)?0.27:0;","+    for(let c=0;c<settings.cols;c++){","+      const m=settings.mass;","+      bricks.push({x:wallX+c*BRICK_W+stagger+layer*0.14+BRICK_W/2,y:BRICK_H/2+r*(BRICK_H+0.002),vx:0,vy:0,a:0,av:0,w:BRICK_W,h:BRICK_H,m,invM:1/m,I:m*(BRICK_W*BRICK_W+BRICK_H*BRICK_H)/12,layer});","+    }","+  }","+  car={x:3.2,y:0.62,vx:running?settings.speed:0,vy:0,a:0,av:0,w:CAR_W,h:1.05,m:CAR_MASS,invM:1/CAR_MASS,I:CAR_MASS*20,isCar:true};","+  prevCarVx=car.vx; state=running?'running':'ready';","+  $('status').textContent=running?('TEST RUNNING — '+settings.speed+' m/s'):'READY — wall standing';","+  $('status').className='status';","+  document.querySelector('.chip').textContent=bricks.length+' bricks @ current';","+}","+function bind(id,out,key,fmt){const el=$(id);el.addEventListener('input',()=>{settings[key]=parseFloat(el.value);$(out).textContent=fmt(settings[key]);buildScene(false);});}","+bind('inSpeed','oSpeed','speed',v=>v.toFixed(0)+' m/s');","+bind('inCols','oCols','cols',v=>v.toFixed(0)+' bricks');","+bind('inRows','oRows','rows',v=>v.toFixed(0)+' bricks');","+bind('inLayers','oLayers','layers',v=>v.toFixed(0)+' layers');","+bind('inMass','oMass','mass',v=>v.toFixed(1)+' kg');","+buildScene(false);","+$('testBtn').onclick=()=>buildScene(true);","+$('resetBtn').onclick=()=>buildScene(false);","+addEventListener('keydown',e=>{if(e.code==='Space'){e.preventDefault();buildScene(true);}if(e.key==='r'||e.key==='R')buildScene(false);});","+function corners(b){const c=Math.cos(b.a),s=Math.sin(b.a),hw=b.w/2,hh=b.h/2;return[[-hw,-hh],[hw,-hh],[hw,hh],[-hw,hh]].map(p=>({x:b.x+p[0]*c-p[1]*s,y:b.y+p[0]*s+p[1]*c}));}","+function collide(a,b){","+  const axes=[];for(const bdy of[a,b]){const c=Math.cos(bdy.a),s=Math.sin(bdy.a);axes.push({x:c,y:s},{x:-s,y:c});}","+  const pa=corners(a),pb=corners(b);let best={pen:1e9,nx:1,ny:0};","+  for(const ax of axes){let a0=1e9,a1=-1e9,b0=1e9,b1=-1e9;for(const p of pa){const d=p.x*ax.x+p.y*ax.y;if(d<a0)a0=d;if(d>a1)a1=d;}for(const p of pb){const d=p.x*ax.x+p.y*ax.y;if(d<b0)b0=d;if(d>b1)b1=d;}","+    const pen=Math.min(a1,b1)-Math.max(a0,b0);if(pen<=0)return null;","+    if(pen<best.pen){let nx=ax.x,ny=ax.y;if((b.x-a.x)*nx+(b.y-a.y)*ny<0){nx=-nx;ny=-ny;}best={pen,nx,ny};}}","+  let cb=pb[0],bd=1e9;for(const p of pb){const d=p.x*best.nx+p.y*best.ny;if(d<bd){bd=d;cb=p;}}","+  let ca=pa[0],ad=-1e9;for(const p of pa){const d=p.x*best.nx+p.y*best.ny;if(d>ad){ad=d;ca=p;}}","+  return{...best,px:(cb.x+ca.x)/2,py:(cb.y+ca.y)/2};","+}","+function impulse(b,ix,iy,px,py){b.vx+=ix*b.invM;b.vy+=iy*b.invM;if(!b.isCar)b.av+=( (px-b.x)*iy-(py-b.y)*ix)/b.I;}","+function velAt(b,px,py){return{x:b.vx-b.av*(py-b.y),y:b.vy+b.av*(px-b.x)};}","+function resolvePair(a,b,col){","+  const total=a.invM+b.invM,corr=Math.max(col.pen-0.001,0)*0.6/total;","+  a.x-=col.nx*corr*a.invM;a.y-=col.ny*corr*a.invM;b.x+=col.nx*corr*b.invM;b.y+=col.ny*corr*b.invM;","+  const va=velAt(a,col.px,col.py),vb=velAt(b,col.px,col.py),rvx=vb.x-va.x,rvy=vb.y-va.y,vn=rvx*col.nx+rvy*col.ny;","+  if(vn>=0)return;","+  const ra={x:col.px-a.x,y:col.py-a.y},rb={x:col.px-b.x,y:col.py-b.y};","+  const raCn=ra.x*col.ny-ra.y*col.nx,rbCn=rb.x*col.ny-rb.y*col.nx;","+  const kn=a.invM+b.invM+raCn*raCn/a.I+rbCn*rbCn/b.I;","+  const e=vn<-1?REST:0,j=-(1+e)*vn/kn;","+  impulse(a,-j*col.nx,-j*col.ny,col.px,col.py);impulse(b,j*col.nx,j*col.ny,col.px,col.py);","+  const va2=velAt(a,col.px,col.py),vb2=velAt(b,col.px,col.py),tx=-col.ny,ty=col.nx,vt=(vb2.x-va2.x)*tx+(vb2.y-va2.y)*ty;","+  const kt=a.invM+b.invM+Math.pow(ra.x*ty-ra.y*tx,2)/a.I+Math.pow(rb.x*ty-rb.y*tx,2)/b.I;","+  let jt=-vt/kt;const mf=BRICK_FRIC*Math.abs(j);jt=Math.max(-mf,Math.min(mf,jt));","+  impulse(a,-jt*tx,-jt*ty,col.px,col.py);impulse(b,jt*tx,jt*ty,col.px,col.py);","+  const sp=-vn;","+  if(sp>2&&(a.isCar||b.isCar)&&!impactDone){impactDone=true;shake=Math.min(13,4+sp*0.4);spawnDust(col.px,col.py,28);$('status').textContent='IMPACT — momentum transfer';$('status').className='status hit';}","+  else if(sp>4)spawnDust(col.px,col.py,2);","+}","+function ground(b){","+  for(const p of corners(b)){","+    if(p.y>=0)continue;","+    b.y+=(-p.y)*0.85;","+    const v=velAt(b,p.x,p.y);","+    if(v.y<0){","+      const kn=b.invM+Math.pow(p.x-b.x,2)/b.I;","+      let j=-(1+(v.y<-1?REST*0.5:0))*v.y/kn;if(j<0)j=0;","+      impulse(b,0,j,p.x,p.y);","+      const v2=velAt(b,p.x,p.y),kt=b.invM+Math.pow(p.y-b.y,2)/b.I;","+      let jt=-v2.x/kt;const mf=GROUND_FRIC*j;jt=Math.max(-mf,Math.min(mf,jt));impulse(b,jt,0,p.x,p.y);","+    }","+  }","+}","+function spawnDust(x,y,n){for(let i=0;i<n;i++){const a=rnd()*6.283,sp=0.4+rnd()*3;particles.push({x,y:y+0.08,vx:Math.cos(a)*sp,vy:Math.abs(Math.sin(a))*sp*0.6+0.4,life:0.5+rnd()*0.8,t:0,r:0.04+rnd()*0.13});}if(particles.length>360)particles.splice(0,particles.length-360);}","+function step(dt){","+  if(state!=='running')return;","+  elapsed+=dt;prevCarVx=car.vx;","+  car.vx-=car.vx*0.015*dt;","+  if(Math.abs(car.vx)>3) {skids.push({x:car.x-1.4});if(skids.length>500)skids.shift();}","+  wheelRot+=car.vx/0.34*dt;","+  for(const b of bricks)b.vy-=GRAV*dt;","+  car.x+=car.vx*dt;","+  for(const b of bricks){b.x+=b.vx*dt;b.y+=b.vy*dt;b.a+=b.av*dt;b.av*=(1-1.4*dt);b.vx*=(1-0.04*dt);}","+  for(let it=0;it<4;it++){","+    for(const b of bricks)ground(b);","+    for(const b of bricks){","+      if(Math.abs(b.x-car.x)>CAR_W/2+b.w+0.1||Math.abs(b.y-car.y)>1.3)continue;","+      const col=collide(car,b);if(col)resolvePair(car,b,col);","+    }","+    // broadphase by sorted x: check neighbours within window using simple grid","+    const map=new Map(),cell=0.55;","+    bricks.forEach((b,i)=>{const k=Math.floor(b.x/cell)+':'+Math.floor(b.y/cell);(map.get(k)||map.set(k,[]).get(k)).push(i);});","+    const seen=new Set();","+    bricks.forEach((b,i)=>{","+      const cx=Math.floor(b.x/cell),cy=Math.floor(b.y/cell);","+      for(let gx=cx-1;gx<=cx+1;gx++)for(let gy=cy-1;gy<=cy+1;gy++){","+        const arr=map.get(gx+':'+gy);if(!arr)continue;","+        for(const j of arr){if(j<=i)continue;const key=i+'-'+j;if(seen.has(key))continue;seen.add(key);const o=bricks[j];","+          if(Math.abs(o.x-b.x)>0.7||Math.abs(o.y-b.y)>0.6)continue;const col=collide(b,o);if(col)resolvePair(b,o,col);}","+      }","+    });","+    car.y=0.62;car.vy=0;car.av=0;car.a=0;","+    for(const b of bricks){if(b.x<0.25){b.x=0.25;b.vx=Math.abs(b.vx)*0.2;}if(b.y< b.h*0.35 && Math.abs(b.vy)<0.2)b.vy=0;}","+  }","+  const decel=(prevCarVx-car.vx)/Math.max(dt,0.001);","+  carTilt+=((Math.max(-0.05,Math.min(0.07,decel*0.0006)))-carTilt)*0.1;","+  for(const p of particles){p.t+=dt;p.x+=p.vx*dt;p.y+=p.vy*dt;p.vy-=2.2*dt;}","+  particles=particles.filter(p=>p.t<p.life);shake*=0.88;","+  let moving=0;for(const b of bricks)if(Math.hypot(b.vx,b.vy)>0.2||Math.abs(b.av)>0.3)moving++;","+  if(elapsed>1.2&&moving===0&&Math.abs(car.vx)<0.08){state='settled';$('status').textContent='SETTLED — press Test to run again';$('status').className='status';}","+  if(car.x>36){car.x=36;car.vx=0;}","+}","+"]}]}]}