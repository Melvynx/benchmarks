{"files":[{"path":"/private/tmp/tz-verify.js","hunks":[{"oldStart":1,"oldLines":0,"newStart":1,"newLines":79,"lines":["+const page = await browser.getPage(\"tz-check\");","+await page.setViewportSize({ width: 1280, height: 900 });","+await page.goto(\"http://localhost:9300/\");","+await page.evaluate(() => localStorage.clear());","+await page.reload();","+await page.waitForSelector(\".desktop-grid\");","+","+const snap = async (label) => {","+  const d = await page.evaluate(() => ({","+    title: document.title,","+    h1: document.querySelector(\"h1\")?.textContent,","+    rows: [...document.querySelectorAll(\"[data-city-row]\")].map(r => r.getAttribute(\"data-city-row\")),","+    cells: document.querySelectorAll(\".desktop-grid .cell\").length,","+    overlapCells: document.querySelectorAll('.desktop-grid .cell[data-state=\"overlap\"]').length,","+    summary: document.querySelector(\".summary\")?.textContent?.replace(/\\s+/g, \" \").trim(),","+    hint: document.querySelector(\".hint\")?.textContent,","+    refBadge: document.querySelector(\".desktop-grid .ref-badge\")?.textContent,","+    offsets: [...document.querySelectorAll(\".desktop-grid .city-offset\")].map(e => e.textContent),","+    desktopVisible: getComputedStyle(document.querySelector(\".desktop-grid\")).display !== \"none\",","+    mobileVisible: getComputedStyle(document.querySelector(\".mobile-grid\")).display !== \"none\",","+    firstRowCells: [...document.querySelectorAll('[data-city-row=\"san-francisco\"] .cell, [data-city-row] .cell')].slice(0, 24).map(c => c.textContent),","+    stored: localStorage.getItem(\"timezone-overlap-v1\"),","+  }));","+  console.log(label, JSON.stringify(d));","+};","+","+await snap(\"DEFAULT:\");","+","+// Base mode","+await page.click('button:has-text(\"Base Mode\")');","+await snap(\"BASE:\");","+","+// back to meeting, change wake hour to 9","+await page.click('button:has-text(\"Meeting Mode\")');","+await page.selectOption('select[aria-label=\"Wake-up hour\"]', \"9\");","+await snap(\"WAKE9:\");","+","+// 24h format","+await page.click('.fmt-btn:has-text(\"24h\")');","+await snap(\"FMT24:\");","+await page.click('.fmt-btn:has-text(\"12h\")');","+","+// Add Mumbai (fractional offset) via search by country","+await page.fill(\"#city-search\", \"India\");","+await page.waitForSelector(\".picker-item\");","+await page.click('.picker-item:has-text(\"Mumbai\")');","+await snap(\"ADDED_MUMBAI:\");","+","+// Duplicate prevention: Mumbai should no longer be in picker","+await page.fill(\"#city-search\", \"Mumbai\");","+const dup = await page.evaluate(() => document.querySelector(\".picker-list\")?.textContent);","+console.log(\"DUP_CHECK:\", JSON.stringify(dup));","+await page.fill(\"#city-search\", \"\");","+","+// Promote Geneva to reference","+await page.click('[data-city-row=\"geneva\"] .city-name');","+await snap(\"PROMOTED_GENEVA:\");","+","+// Remove Denpasar","+await page.click('button[aria-label=\"Remove Denpasar\"] >> nth=0');","+await snap(\"REMOVED_DENPASAR:\");","+","+// Persistence: reload and check restored","+await page.reload();","+await page.waitForSelector(\".desktop-grid\");","+await snap(\"AFTER_RELOAD:\");","+","+// Mobile layout","+await page.setViewportSize({ width: 390, height: 800 });","+const mob = await page.evaluate(() => ({","+  desktopVisible: getComputedStyle(document.querySelector(\".desktop-grid\")).display !== \"none\",","+  mobileVisible: getComputedStyle(document.querySelector(\".mobile-grid\")).display !== \"none\",","+  mobileCells: document.querySelectorAll(\".mobile-grid .cell\").length,","+}));","+console.log(\"MOBILE:\", JSON.stringify(mob));","+","+await page.setViewportSize({ width: 1280, height: 900 });","+const shot = await saveScreenshot(await page.screenshot(), \"tz-desktop.png\");","+console.log(\"SCREENSHOT:\", shot);"]}]}]}