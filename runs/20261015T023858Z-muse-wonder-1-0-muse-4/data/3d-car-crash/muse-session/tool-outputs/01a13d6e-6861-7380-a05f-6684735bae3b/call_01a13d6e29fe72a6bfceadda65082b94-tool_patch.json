{"files":[{"path":"/private/var/folders/7z/5mtgxwxx4zs9ppgzm942gbmh0000gn/T/workspace.s5QBup/app/index.html","hunks":[{"oldStart":146,"oldLines":6,"newStart":146,"newLines":203,"lines":["  // distant simple horizon blocks","  for(let i=0;i<8;i++){ const h=2+((i*37)%5); const b=addMesh(new THREE.BoxGeometry(4,h,3),new THREE.MeshStandardMaterial({color:0x8fa3b0,roughness:0.9}),null,false); b.position.set(-25+i*8,h/2-0.1,-24); }"," }","+function L(a,b,thr){const j=lock(a,b,thr); j.d0=a.position.distanceTo(b.position); return j;}","+function breakJoint(j){ if(j.broken)return; j.broken=true; try{world.removeConstraint(j.c);}catch(e){} }","+function breakJointsOf(body,minImp){ joints.forEach(j=>{ if(j.a===body||j.b===body) breakJoint(j); }); }","+","+function buildWall(){","+ bricks=[]; const cols=Math.max(1,Math.round(S.wallCols)), rows=Math.max(1,Math.round(S.wallRows)), depth=Math.max(1,Math.round(S.wallDepth));","+ const gap=0.02, totalW=cols*(S.brickW+gap);","+ for(let d=0;d<depth;d++) for(let r=0;r<rows;r++) for(let c=0;c<cols;c++){","+   const stagger=(r%2)? (S.brickW+gap)/2:0;","+   const z=-totalW/2 + c*(S.brickW+gap)+S.brickW/2 + stagger - (stagger? (S.brickW+gap)/2:0);","+   const x=wallX + (d-(depth-1)/2)*(S.brickD+0.015);","+   const y=S.brickH/2 + r*(S.brickH+0.018)+0.01;","+   const b=boxBody(S.brickMass,S.brickW,S.brickH,S.brickD,x,y,z,matBrick,{ld:0.01,ad:0.15});","+   b.__tag='brick'; bricks.push(b);","+   const idx=(d*rows*cols+r*cols+c);","+   const m=addMesh(new THREE.BoxGeometry(S.brickW,S.brickH,S.brickD),brickMats[idx%6],b);","+ }","+}","+","+function buildCar(){","+ carParts={}; const list=[];","+ const sx=S.carLength/4.2, sz=S.carWidth/1.8, sy=S.carHeight/1.45, M=S.carMass;","+ const startX=-S.trackLength/2+5, cy=0;","+ const mk=(name,mass,geo,mat,x,y,z,shapeFn)=>{","+   let b;","+   if(shapeFn){ b=shapeFn(mass,x,y,z); } else {","+     // infer box size from geo parameters is fragile; pass sizes explicitly via userData on geo","+     b=boxBody(mass,geo.__sx,geo.__sy,geo.__sz,x,y,z,matCar,{ld:0.005,ad:0.12});","+   }","+   b.__tag='car'; const m=addMesh(geo,mat,b); carParts[name]=b; list.push(b); return b;","+ };","+ const boxGeo=(x,y,z)=>{const g=new THREE.BoxGeometry(x,y,z); g.__sx=x; g.__sy=y; g.__sz=z; return g;};","+ const chassis=mk('chassis',M*0.38,boxGeo(2.3*sx,0.52*sy,1.66*sz),MAT.paint,startX-0.35*sx,0.58*sy,0);","+ const cabin=mk('cabin',M*0.16,boxGeo(1.85*sx,0.52*sy,1.55*sz),MAT.paint,startX-0.45*sx,1.08*sy,0);","+ const front=mk('front',M*0.15,boxGeo(1.55*sx,0.5*sy,1.62*sz),MAT.paint,startX+1.38*sx,0.60*sy,0);","+ const hood=mk('hood',M*0.024,boxGeo(1.25*sx,0.07*sy,1.5*sz),MAT.paint,startX+1.38*sx,0.90*sy,0);","+ const trunk=mk('trunk',M*0.016,boxGeo(0.85*sx,0.07*sy,1.5*sz),MAT.paint,startX-1.55*sx,0.90*sy,0);","+ const bf=mk('bumperF',M*0.024,boxGeo(0.22*sx,0.28*sy,1.7*sz),MAT.dark,startX+2.22*sx,0.48*sy,0);","+ const bb=mk('bumperB',M*0.024,boxGeo(0.22*sx,0.28*sy,1.7*sz),MAT.dark,startX-1.95*sx,0.48*sy,0);","+ L(chassis,cabin,0.60); L(chassis,front,0.38); L(front,hood,0.16); L(chassis,hood,0.22);","+ L(chassis,trunk,0.22); L(front,bf,0.18); L(chassis,bb,0.24); L(cabin,front,0.45);","+ // doors","+ const doors=[];","+ [['doorFL',0.38,1],['doorFR',0.38,-1],['doorRL',-0.78,1],['doorRR',-0.78,-1]].forEach(([n,ox,side])=>{","+   const d=mk(n,M*0.02,boxGeo(0.95*sx,0.58*sy,0.06),MAT.paint,startX+ox*sx,0.82*sy,side*(S.carWidth/2-0.02));","+   doors.push(d); L(chassis,d,0.26); L(cabin,d,0.30);","+ });","+ // glass: windshield shards (4), rear (2), side panes (4) — each its own body","+ const glassBodies=[];","+ for(let i=0;i<4;i++){ const z=(-0.57+i*0.38)*sz; const g=mk('ws'+i,M*0.003,boxGeo(0.05,0.48*sy,0.34*sz),MAT.glass,startX+0.52*sx,1.10*sy,z); glassBodies.push(g); L(cabin,g,0.10); }","+ for(let i=0;i<2;i++){ const g=mk('rw'+i,M*0.003,boxGeo(0.05,0.44*sy,0.62*sz),MAT.glass,startX-1.42*sx,1.10*sy,(i?0.35:-0.35)*sz); glassBodies.push(g); L(cabin,g,0.12); }","+ doors.forEach((d,i)=>{ const g=mk('sg'+i,M*0.0025,boxGeo(0.72*sx,0.36*sy,0.03),MAT.glass,d.position.x,1.12*sy,d.position.z*1.01); glassBodies.push(g); L(d,g,0.10); L(cabin,g,0.14); });","+ // headlights on front clip (visual children synced via an extra mesh list handled by front mesh? attach as separate visual-only meshes following front body)","+ // wheels","+ const wheels=[];","+ const wheelGeo=new THREE.CylinderGeometry(0.34*sy,0.34*sy,0.24*sz,20); wheelGeo.rotateX(Math.PI/2);","+ [[1.35,1],[1.35,-1],[-1.35,1],[-1.35,-1]].forEach(([ox,side],i)=>{","+   const b=new CANNON.Body({mass:M*0.028,material:matCar,shape:new CANNON.Sphere(0.34*sy),position:new CANNON.Vec3(startX+ox*sx,0.34*sy,side*(S.carWidth/2-0.05)),linearDamping:0.01,angularDamping:0.25,allowSleep:false});","+   b.__tag='car'; world.addBody(b); bodies.push(b); carParts['wheel'+i]=b; list.push(b); wheels.push(b);","+   const m=addMesh(wheelGeo,MAT.tire,b);","+   const rim=new THREE.Mesh(new THREE.CylinderGeometry(0.19*sy,0.19*sy,0.25*sz,12).rotateX(Math.PI/2),MAT.rim); rim.castShadow=true; m.add(rim);","+   L(chassis,b,0.34); if(ox>0) L(front,b,0.34);","+ });","+ // headlights + grille as meshes parented to front mesh","+ const fm=front.__mesh;","+ [-0.55,0.55].forEach(z=>{ const h=new THREE.Mesh(new THREE.BoxGeometry(0.06,0.12,0.42),MAT.light); h.position.set(0.79*sx,-0.08,z*sz); fm.add(h); });","+ const grille=new THREE.Mesh(new THREE.BoxGeometry(0.05,0.16,0.8),MAT.dark); grille.position.set(0.79*sx,-0.22,0); fm.add(grille);","+ // cabin roof visual is cabin body itself; store list","+ carParts.__list=list; carParts.__glass=glassBodies; carParts.__wheels=wheels;","+ // impact detection","+ [front,chassis,bf].forEach(b=>{","+   b.addEventListener('collide',e=>{","+     const other=e.body; if(!other||other.__tag!=='brick') return;","+     const v=e.contact.getImpactVelocityAlongNormal();","+     if(Math.abs(v)>2.5 && !impacted){","+       impacted=true; impactSpeedRecorded=Math.abs(driveSpeed||v);","+       document.getElementById('hudImpact').textContent=impactSpeedRecorded.toFixed(1)+' m/s';","+       shake=Math.min(0.5,Math.abs(v)*0.02); spawnDust(front.position);","+       // severe hit tears front attachments; distance checks handle the rest progressively","+       if(Math.abs(v)>5){ breakJointsOf(hood,0); breakJointsOf(bf,0); glassBodies.slice(0,4).forEach(g=>breakJointsOf(g,0)); }","+     } else if(Math.abs(v)>4){ shake=Math.max(shake,0.15); }","+   });","+ });","+ return list;","+}","+","+function spawnDust(pos){","+ if(dust){scene.remove(dust); }","+ const N=260, arr=new Float32Array(N*3); dustVel=[];","+ const r=mulberry32(999);","+ for(let i=0;i<N;i++){ arr[i*3]=pos.x+(r()-0.5)*1.2; arr[i*3+1]=0.3+r()*1.4; arr[i*3+2]=(r()-0.5)*2.2; dustVel.push([(r()-0.2)*4,r()*3.5,(r()-0.5)*5]); }","+ const g=new THREE.BufferGeometry(); g.setAttribute('position',new THREE.BufferAttribute(arr,3));","+ dust=new THREE.Points(g,new THREE.PointsMaterial({color:0xcbb89a,size:0.14,transparent:true,opacity:0.75,depthWrite:false}));","+ scene.add(dust);","+ // sparks","+ const M=60, a2=new Float32Array(M*3); for(let i=0;i<M;i++){a2[i*3]=pos.x+0.8;a2[i*3+1]=0.6;a2[i*3+2]=(r()-0.5)*1.5;}","+ const g2=new THREE.BufferGeometry(); g2.setAttribute('position',new THREE.BufferAttribute(a2,3));","+ sparks=new THREE.Points(g2,new THREE.PointsMaterial({color:0xffc44d,size:0.07,transparent:true,opacity:0.95,depthWrite:false})); scene.add(sparks);","+}","+","+function clearWorld(){","+ meshes.forEach(m=>{scene.remove(m); if(m.geometry&&m.geometry.dispose)m.geometry.dispose();});","+ meshes=[]; bodies=[]; joints=[]; bricks=[]; dust=null; sparks=null;","+ if(world){ world.bodies.slice().forEach(b=>world.removeBody(b)); }","+}","+function reset(){","+ clearWorld();","+ S={...S}; // keep current settings","+ wallX=S.trackLength/2-6; trackLen=S.trackLength;","+ world=new CANNON.World({gravity:new CANNON.Vec3(0,-S.gravity,0)});","+ world.broadphase=new CANNON.SAPBroadphase(world); world.allowSleep=true;","+ world.solver.iterations=12; world.defaultContactMaterial.friction=S.groundFriction;","+ matGround=new CANNON.Material('ground'); matBrick=new CANNON.Material('brick'); matCar=new CANNON.Material('car');","+ world.addContactMaterial(new CANNON.ContactMaterial(matGround,matBrick,{friction:S.groundFriction,restitution:0.05}));","+ world.addContactMaterial(new CANNON.ContactMaterial(matGround,matCar,{friction:S.groundFriction,restitution:0.05}));","+ world.addContactMaterial(new CANNON.ContactMaterial(matBrick,matBrick,{friction:S.brickFriction,restitution:S.brickRestitution}));","+ world.addContactMaterial(new CANNON.ContactMaterial(matBrick,matCar,{friction:S.brickFriction,restitution:S.brickRestitution}));","+ world.addContactMaterial(new CANNON.ContactMaterial(matCar,matCar,{friction:0.4,restitution:0.08}));","+ const ground=new CANNON.Body({mass:0,material:matGround,shape:new CANNON.Plane()});","+ ground.quaternion.setFromEuler(-Math.PI/2,0,0); world.addBody(ground);","+ // low side rails physics to keep debris on track area loosely (far outside visual track, at shoulders)","+ buildEnvironment(); buildCar(); buildWall();","+ impacted=false; impactSpeedRecorded=null; driveSpeed=0; elapsed=0;","+ document.getElementById('hudImpact').textContent='—';","+ document.getElementById('hudBodies').textContent=String(world.bodies.length);","+ document.getElementById('status').textContent=paused?'Paused':'Running';","+ // sun shadow follows track centre","+ sun.target.position.set(4,0,0); scene.add(sun.target);","+}","+","+// settings UI","+const FIELDS=[['speed','Impact speed (m/s)'],['carMass','Car mass (kg)'],['carLength','Car length (m)'],['carWidth','Car width (m)'],['carHeight','Car height (m)'],['wallCols','Wall columns'],['wallRows','Wall rows'],['wallDepth','Wall depth'],['brickMass','Brick mass (kg)'],['brickW','Brick width (m)'],['brickH','Brick height (m)'],['brickD','Brick depth (m)'],['gravity','Gravity (m/s²)'],['brickFriction','Brick friction'],['brickRestitution','Brick restitution'],['groundFriction','Ground friction'],['trackLength','Track length (m)']];","+const fieldsEl=document.getElementById('fields');","+FIELDS.forEach(([k,label])=>{ const l=document.createElement('label'); l.textContent=label; const inp=document.createElement('input'); inp.type='number'; inp.step='any'; inp.id='f_'+k; inp.value=S[k]; fieldsEl.appendChild(l); fieldsEl.appendChild(inp); });","+function readSettings(){ FIELDS.forEach(([k])=>{ const v=parseFloat(document.getElementById('f_'+k).value); if(Number.isFinite(v)&&v>0) S[k]=v; }); S.wallCols=Math.max(1,Math.round(S.wallCols)); S.wallRows=Math.max(1,Math.round(S.wallRows)); S.wallDepth=Math.max(1,Math.round(S.wallDepth)); }","+function writeSettings(){ FIELDS.forEach(([k])=>document.getElementById('f_'+k).value=S[k]); }","+","+document.getElementById('applyBtn').onclick=()=>{readSettings(); reset();};","+document.getElementById('resetBtn').onclick=()=>{S={...DEFAULTS}; writeSettings(); reset();};","+document.getElementById('replayBtn').onclick=()=>{readSettings(); reset();};","+document.getElementById('settingsBtn').onclick=()=>document.getElementById('panel').classList.toggle('open');","+const playBtn=document.getElementById('playBtn');","+function setPaused(p){ paused=p; playBtn.textContent=paused?'▶ Play':'⏸ Pause'; document.getElementById('status').textContent=paused?'Paused':(impacted?'Wreck settling':'Running'); }","+playBtn.onclick=()=>setPaused(!paused);","+addEventListener('keydown',e=>{ if(e.code==='Space' && !(document.activeElement&&document.activeElement.tagName==='INPUT')){ e.preventDefault(); setPaused(!paused);} });","+document.querySelectorAll('.spd').forEach(b=>b.onclick=()=>{ simSpeed=parseFloat(b.dataset.s); document.querySelectorAll('.spd').forEach(x=>x.classList.toggle('active',x===b)); });","+document.querySelectorAll('.view').forEach(b=>b.onclick=()=>{ viewMode=b.dataset.v; document.querySelectorAll('.view').forEach(x=>x.classList.toggle('active',x===b)); controls.enabled=(viewMode==='orbit'); if(viewMode==='orbit'){ controls.target.set(wallX-2,1,0);} });","+","+const STEP=1/120; let acc=0, last=performance.now();","+const camPos=new THREE.Vector3(-2,4.5,11), camTgt=new THREE.Vector3(10,1,0);","+function stepPhysics(){","+ elapsed+=STEP;","+ if(!impacted){","+   driveSpeed=Math.min(S.speed, driveSpeed+14*STEP);","+   const list=carParts.__list||[];","+   list.forEach(b=>{ b.velocity.x=driveSpeed; b.velocity.z*=0.2; if(b.velocity.y<-2)b.velocity.y=-2; b.angularVelocity.scale(0.6,b.angularVelocity); });","+ } ","+ world.step(STEP);","+ // breakable joints by stretch","+ for(const j of joints){ if(!j.broken && j.a.position.distanceTo(j.b.position) > j.d0 + j.threshold) breakJoint(j); }","+ // dust drift","+ if(dust){ const p=dust.geometry.attributes.position; for(let i=0;i<dustVel.length;i++){ p.array[i*3]+=dustVel[i][0]*STEP; p.array[i*3+1]+=dustVel[i][1]*STEP; p.array[i*3+2]+=dustVel[i][2]*STEP; dustVel[i][1]-=1.2*STEP; } p.needsUpdate=true; dust.material.opacity=Math.max(0,dust.material.opacity-STEP*0.25); }","+ if(sparks){ sparks.material.opacity=Math.max(0,sparks.material.opacity-STEP*1.4); }","+}","+function animate(now){","+ requestAnimationFrame(animate);","+ const dtReal=Math.min(0.05,(now-last)/1000); last=now;","+ if(!paused){ acc+=dtReal*simSpeed; let n=0; while(acc>=STEP&&n<12){ stepPhysics(); acc-=STEP; n++; } if(n>=12) acc=0; }","+ // sync","+ for(const b of bodies){ const m=b.__mesh; if(m){ m.position.copy(b.position); m.quaternion.copy(b.quaternion);} }","+ const car=carParts.chassis, cx=car?car.position.x:0;","+ if(car) document.getElementById('hudSpeed').textContent=Math.hypot(car.velocity.x,car.velocity.z).toFixed(1)+' m/s';","+ if(impacted) document.getElementById('status').textContent=paused?'Paused':'Wreck settling';","+ // cameras","+ let desiredP, desiredT;","+ if(viewMode==='follow'){ desiredP=new THREE.Vector3(cx-8.5,3.4,5.5); desiredT=new THREE.Vector3(cx+5,0.9,0); }","+ else if(viewMode==='top'){ desiredP=new THREE.Vector3((cx+wallX)/2,26,0.01); desiredT=new THREE.Vector3((cx+wallX)/2,0,0); }","+ else if(viewMode==='orbit'){ controls.update(); }","+ else { // impact cinematic: wide three-quarter, then tightens on wall after approach","+   const t=THREE.MathUtils.clamp((cx-(-S.trackLength/2+5))/Math.max(1,(wallX-(-S.trackLength/2+5))),0,1);","+   desiredP=new THREE.Vector3(wallX-11+ t*2,4.2,11.5-t*2.5); desiredT=new THREE.Vector3(THREE.MathUtils.lerp(cx+3,wallX-1,t*0.6),1.0,0);","+ }","+ if(viewMode!=='orbit'){","+   camPos.lerp(desiredP, viewMode==='follow'?0.08:0.045); camTgt.lerp(desiredT,0.07);","+   if(shake>0){ camPos.x+=(mulberry32((now*0.1)|0)()-0.5)*shake; camPos.y+=(mulberry32(((now*0.1)|0)+7)()-0.5)*shake; shake*=0.88; if(shake<0.005)shake=0; }","+   camera.position.copy(camPos); camera.lookAt(camTgt);","+ }","+ renderer.render(scene,camera);","+}","+addEventListener('resize',()=>{ camera.aspect=innerWidth/innerHeight; camera.updateProjectionMatrix(); renderer.setSize(innerWidth,innerHeight); });","+","+writeSettings();","+reset();","+setPaused(false);","+// init camera to impact framing","+camPos.set(wallX-11,4.2,11.5); camera.position.copy(camPos);","+requestAnimationFrame(animate);"," </script>"," </body>"," </html>"]}]}]}