{"files":[{"path":"/private/var/folders/7z/5mtgxwxx4zs9ppgzm942gbmh0000gn/T/workspace.s5QBup/app/index.html","hunks":[{"oldStart":1,"oldLines":0,"newStart":1,"newLines":151,"lines":["+<!DOCTYPE html>","+<html lang=\"en\">","+<head>","+<meta charset=\"utf-8\"/>","+<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"/>","+<title>muse-wonder-1.0</title>","+<style>","+*{box-sizing:border-box}html,body{margin:0;height:100%;overflow:hidden;background:#0b0f14;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;color:#eef2f5}","+#app{position:fixed;inset:0}canvas{display:block}","+#brand{position:fixed;left:14px;top:12px;z-index:20;font-weight:800;letter-spacing:.02em;font-size:15px;text-shadow:0 2px 10px rgba(0,0,0,.6);pointer-events:none}","+#bar{position:fixed;left:50%;transform:translateX(-50%);bottom:14px;z-index:30;display:flex;gap:8px;align-items:center;flex-wrap:wrap;justify-content:center;background:rgba(10,14,18,.82);backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,.14);border-radius:14px;padding:8px 10px;max-width:min(1060px,96vw)}","+button,select{appearance:none;border:1px solid rgba(255,255,255,.16);background:#1b242e;color:#eef2f5;border-radius:9px;padding:7px 10px;font-size:12.5px;cursor:pointer}button:hover{background:#263241}button.active{background:#e8b33d;color:#151515;border-color:#e8b33d;font-weight:700}","+.sep{width:1px;height:22px;background:rgba(255,255,255,.16)}","+#hud{position:fixed;right:14px;top:12px;z-index:20;background:rgba(10,14,18,.72);border:1px solid rgba(255,255,255,.12);border-radius:10px;padding:8px 10px;font-size:12px;line-height:1.5;min-width:150px;backdrop-filter:blur(8px)}","+#hud b{color:#ffd166}","+#panel{position:fixed;right:14px;top:92px;z-index:25;width:300px;max-height:calc(100vh - 190px);overflow:auto;background:rgba(10,14,18,.92);border:1px solid rgba(255,255,255,.14);border-radius:14px;padding:12px;display:none;backdrop-filter:blur(12px)}","+#panel.open{display:block}#panel h3{margin:2px 0 10px;font-size:13px;letter-spacing:.04em;text-transform:uppercase;color:#ffd166}","+.grid{display:grid;grid-template-columns:1fr 86px;gap:7px 10px;align-items:center;font-size:12px}","+.grid input{width:86px;background:#0f161d;border:1px solid rgba(255,255,255,.16);color:#fff;border-radius:7px;padding:6px 7px;font-size:12px}","+.row{display:flex;gap:8px;margin-top:12px}.row button{flex:1}","+.note{font-size:11px;color:#aeb9c2;line-height:1.45;margin-top:9px}","+@media(max-width:700px){#hud{display:none}#panel{left:10px;right:10px;width:auto}}","+</style>","+<script type=\"importmap\">","+{\"imports\":{\"three\":\"https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js\",\"three/addons/\":\"https://cdn.jsdelivr.net/npm/three@0.160.0/examples/jsm/\",\"cannon-es\":\"https://cdn.jsdelivr.net/npm/cannon-es@0.20.0/dist/cannon-es.js\"}}","+</script>","+</head>","+<body>","+<div id=\"app\"></div>","+<div id=\"brand\">muse-wonder-1.0</div>","+<div id=\"hud\"><div>Status: <b id=\"status\">Running</b></div><div>Speed: <b id=\"hudSpeed\">0.0 m/s</b></div><div>Impact: <b id=\"hudImpact\">—</b></div><div>Bodies: <b id=\"hudBodies\">0</b></div></div>","+","+<div id=\"panel\">","+<h3>Experiment Settings</h3>","+<div class=\"grid\" id=\"fields\"></div>","+<div class=\"row\"><button id=\"applyBtn\">Apply &amp; Replay</button><button id=\"resetBtn\">Defaults</button></div>","+<p class=\"note\">Apply rebuilds the car and wall from these values. Speed, gravity and friction take effect on the next run.</p>","+</div>","+","+<div id=\"bar\">","+<button id=\"playBtn\">⏸ Pause</button>","+<button id=\"replayBtn\">↻ Replay</button>","+<span class=\"sep\"></span>","+<button class=\"spd\" data-s=\"0.25\">0.25×</button><button class=\"spd\" data-s=\"0.5\">0.5×</button><button class=\"spd active\" data-s=\"1\">1×</button><button class=\"spd\" data-s=\"2\">2×</button>","+<span class=\"sep\"></span>","+<button class=\"view active\" data-v=\"impact\">Impact</button><button class=\"view\" data-v=\"follow\">Follow</button><button class=\"view\" data-v=\"top\">Top</button><button class=\"view\" data-v=\"orbit\">Orbit</button>","+<span class=\"sep\"></span>","+<button id=\"settingsBtn\">Settings</button>","+</div>","+","+<script type=\"module\">","+import * as THREE from 'three';","+import { OrbitControls } from 'three/addons/controls/OrbitControls.js';","+import { RoomEnvironment } from 'three/addons/environments/RoomEnvironment.js';","+import * as CANNON from 'cannon-es';","+","+const DEFAULTS={speed:22,carMass:1250,carLength:4.2,carWidth:1.8,carHeight:1.45,wallCols:12,wallRows:8,wallDepth:2,brickMass:2.5,brickW:0.50,brickH:0.24,brickD:0.20,gravity:9.81,brickFriction:0.72,brickRestitution:0.18,groundFriction:0.85,trackLength:40};","+let S={...DEFAULTS};","+let simSpeed=1, paused=false, viewMode='impact', impacted=false, impactSpeedRecorded=null, driveSpeed=0, elapsed=0;","+","+// seeded RNG only for visuals","+function mulberry32(a){return function(){a|=0;a=a+0x6D2B79F5|0;let t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296}}","+const rng=mulberry32(1337);","+","+// renderer / scene","+const renderer=new THREE.WebGLRenderer({antialias:true,powerPreference:'high-performance'});","+renderer.setPixelRatio(Math.min(devicePixelRatio,2));","+renderer.setSize(innerWidth,innerHeight);","+renderer.shadowMap.enabled=true; renderer.shadowMap.type=THREE.PCFSoftShadowMap;","+renderer.toneMapping=THREE.ACESFilmicToneMapping; renderer.toneMappingExposure=1.05;","+renderer.outputColorSpace=THREE.SRGBColorSpace;","+document.getElementById('app').appendChild(renderer.domElement);","+","+const scene=new THREE.Scene();","+scene.background=new THREE.Color(0x87b5d9);","+scene.fog=new THREE.Fog(0x9fc2dd,45,110);","+const pmrem=new THREE.PMREMGenerator(renderer);","+scene.environment=pmrem.fromScene(new RoomEnvironment(),0.04).texture;","+","+const camera=new THREE.PerspectiveCamera(55,innerWidth/innerHeight,0.1,300);","+camera.position.set(-2,4.5,11);","+const controls=new OrbitControls(camera,renderer.domElement);","+controls.enableDamping=true; controls.enabled=false; controls.target.set(10,1,0); controls.maxPolarAngle=Math.PI*0.495;","+","+const sun=new THREE.DirectionalLight(0xfff2d6,3.2);","+sun.position.set(-8,18,10); sun.castShadow=true;","+sun.shadow.mapSize.set(2048,2048);","+sun.shadow.camera.left=-28; sun.shadow.camera.right=28; sun.shadow.camera.top=22; sun.shadow.camera.bottom=-18;","+sun.shadow.camera.near=2; sun.shadow.camera.far=60; sun.shadow.bias=-0.0004; sun.shadow.normalBias=0.02;","+scene.add(sun); scene.add(new THREE.HemisphereLight(0xbfd9ff,0x3a4a35,0.55));","+","+// materials (shared)","+const MAT={","+ asphalt:new THREE.MeshStandardMaterial({color:0x2b2f33,roughness:0.94,metalness:0}),","+ grass:new THREE.MeshStandardMaterial({color:0x4a7c3a,roughness:1}),","+ curbR:new THREE.MeshStandardMaterial({color:0xd33a2c,roughness:0.7}),","+ curbW:new THREE.MeshStandardMaterial({color:0xe8e8e8,roughness:0.7}),","+ white:new THREE.MeshStandardMaterial({color:0xf2f2f2,roughness:0.6}),","+ yellow:new THREE.MeshStandardMaterial({color:0xf5c542,roughness:0.6}),","+ paint:new THREE.MeshPhysicalMaterial({color:0xc1272d,metalness:0.65,roughness:0.32,clearcoat:1,clearcoatRoughness:0.12,envMapIntensity:1.2}),","+ dark:new THREE.MeshStandardMaterial({color:0x17191c,roughness:0.85,metalness:0.2}),","+ tire:new THREE.MeshStandardMaterial({color:0x111111,roughness:0.95}),","+ rim:new THREE.MeshStandardMaterial({color:0xc9ced4,roughness:0.25,metalness:0.9}),","+ glass:new THREE.MeshPhysicalMaterial({color:0x9fd4e8,metalness:0,roughness:0.05,transmission:0.65,transparent:true,opacity:0.55,envMapIntensity:1.5,side:THREE.DoubleSide}),","+ light:new THREE.MeshStandardMaterial({color:0xfff6c9,emissive:0xffedb0,emissiveIntensity:2,roughness:0.3}),","+ barrier:new THREE.MeshStandardMaterial({color:0xd8dde2,roughness:0.5,metalness:0.35}),","+ pole:new THREE.MeshStandardMaterial({color:0x333a40,roughness:0.5,metalness:0.6}),","+};","+const brickMats=[]; for(let i=0;i<6;i++){const r=mulberry32(40+i); brickMats.push(new THREE.MeshStandardMaterial({color:new THREE.Color().setHSL(0.05+r()*0.03,0.55,0.32+r()*0.12),roughness:0.92,metalness:0}));}","+","+// physics world (rebuilt per run for materials)","+let world, bodies=[], meshes=[], joints=[], carParts={}, bricks=[], wallX=13, trackLen=40, dust, dustVel=[], sparks, shake=0;","+let matGround, matBrick, matCar;","+","+function boxBody(mass,sx,sy,sz,x,y,z,mat,opts={}){","+ const b=new CANNON.Body({mass,material:mat,shape:new CANNON.Box(new CANNON.Vec3(sx/2,sy/2,sz/2)),position:new CANNON.Vec3(x,y,z),linearDamping:opts.ld??0.01,angularDamping:opts.ad??0.08,allowSleep:true,sleepSpeedLimit:0.25,sleepTimeLimit:0.7});","+ world.addBody(b); bodies.push(b); return b;","+}","+function addMesh(geo,mat,body,cast=true){","+ const m=new THREE.Mesh(geo,mat); m.castShadow=cast; m.receiveShadow=true; scene.add(m); meshes.push(m);","+ if(body){body.__mesh=m; m.userData.body=body;} return m;","+}","+function lock(a,b,threshold,maxForce=8e5){","+ const c=new CANNON.LockConstraint(a,b,{maxForce}); world.addConstraint(c);","+ const j={c,a,b,threshold,broken:false,","+   aA:a.pointToLocalFrame(new CANNON.Vec3(b.position.x,b.position.y,b.position.z)),","+   };","+ joints.push(j); return j;","+}","+// anchor distance check uses body positions offset stored at creation via local anchors of a<->b COM distance","+function jointDist(j){ return j.a.position.distanceTo(j.b.position); }","+","+function buildEnvironment(){","+ // static visuals only (merged-ish: shared mats, few meshes); physics ground is one plane","+ const L=S.trackLength, W=7;","+ const asphalt=addMesh(new THREE.BoxGeometry(L,0.1,W),MAT.asphalt,null,false); asphalt.position.set(0,-0.05,0); asphalt.receiveShadow=true;","+ const grassL=addMesh(new THREE.BoxGeometry(L+30,0.08,30),MAT.grass,null,false); grassL.position.set(0,-0.09,22.5);","+ const grassR=grassL.clone(); grassR.position.z=-22.5; scene.add(grassR); meshes.push(grassR);","+ // lane markings","+ for(let x=-L/2+2;x<L/2-1;x+=3){ const d=addMesh(new THREE.BoxGeometry(1.6,0.012,0.14),MAT.white,null,false); d.position.set(x,0.006,0); }","+ const start=addMesh(new THREE.BoxGeometry(0.35,0.012,W-0.6),MAT.yellow,null,false); start.position.set(-L/2+3,0.006,0);","+ // curbs","+ for(let side of [-1,1]) for(let x=-L/2;x<L/2;x+=2){ const c=addMesh(new THREE.BoxGeometry(1.95,0.14,0.45),((Math.round(x/2)%2===0)?MAT.curbR:MAT.curbW),null); c.position.set(x+1,0.07,side*(W/2+0.22)); }","+ // barriers + lights","+ for(let i=0;i<5;i++){ const x=-L/2+4+i*9; for(let side of [-1,1]){ const b=addMesh(new THREE.BoxGeometry(3.2,0.55,0.25),MAT.barrier,null); b.position.set(x,0.45,side*(W/2+1.1)); const p=addMesh(new THREE.CylinderGeometry(0.05,0.05,3.4,8),MAT.pole,null); p.position.set(x+3.5,1.7,side*(W/2+1.0)); const lamp=addMesh(new THREE.BoxGeometry(0.5,0.12,0.22),MAT.light,null,false); lamp.position.set(x+3.5,3.4,side*(W/2+1.0)); } }","+ // distant simple horizon blocks","+ for(let i=0;i<8;i++){ const h=2+((i*37)%5); const b=addMesh(new THREE.BoxGeometry(4,h,3),new THREE.MeshStandardMaterial({color:0x8fa3b0,roughness:0.9}),null,false); b.position.set(-25+i*8,h/2-0.1,-24); }","+}","+</script>","+</body>","+</html>"]}]}]}