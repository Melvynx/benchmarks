{"files":[{"path":"/private/var/folders/7z/5mtgxwxx4zs9ppgzm942gbmh0000gn/T/workspace.FM2oXN/app/src/components/SettingsPanel.tsx","hunks":[{"oldStart":1,"oldLines":0,"newStart":1,"newLines":52,"lines":["+import { formatHour, type TimeFormat } from '../lib/time'","+","+interface Props {","+  wake: number","+  sleep: number","+  format: TimeFormat","+  onWake: (v: number) => void","+  onSleep: (v: number) => void","+  onFormat: (v: TimeFormat) => void","+}","+","+const HOURS = Array.from({ length: 24 }, (_, i) => i)","+","+export default function SettingsPanel({ wake, sleep, format, onWake, onSleep, onFormat }: Props) {","+  return (","+    <section className=\"panel settings\" aria-label=\"Availability settings\">","+      <div className=\"panel-head\">","+        <h2>Availability</h2>","+        <p>Your awake window, applied to every city. Overnight ranges work too — try wake 10pm, sleep 6am.</p>","+      </div>","+      <div className=\"settings-grid\">","+        <label className=\"field\">","+          <span>Wake-up hour</span>","+          <select aria-label=\"Wake-up hour\" value={wake} onChange={(e) => onWake(Number(e.target.value))}>","+            {HOURS.map((h) => (","+              <option key={h} value={h}>{formatHour(h, format)} ({h})</option>","+            ))}","+          </select>","+        </label>","+        <label className=\"field\">","+          <span>Sleep hour</span>","+          <select aria-label=\"Sleep hour\" value={sleep} onChange={(e) => onSleep(Number(e.target.value))}>","+            {HOURS.map((h) => (","+              <option key={h} value={h}>{formatHour(h, format)} ({h})</option>","+            ))}","+          </select>","+        </label>","+        <div className=\"field\">","+          <span>Time format</span>","+          <div className=\"seg\" role=\"group\" aria-label=\"Time format\">","+            <button type=\"button\" className={format === '12h' ? 'seg-btn active' : 'seg-btn'} aria-pressed={format === '12h'} onClick={() => onFormat('12h')}>12h</button>","+            <button type=\"button\" className={format === '24h' ? 'seg-btn active' : 'seg-btn'} aria-pressed={format === '24h'} onClick={() => onFormat('24h')}>24h</button>","+          </div>","+        </div>","+        <p className=\"awake-readout\" aria-live=\"polite\">","+          Awake <strong>{formatHour(wake, format)} — {formatHour(sleep, format)}</strong>","+          {wake > sleep ? ' (overnight)' : wake === sleep ? ' (all day)' : ''}","+        </p>","+      </div>","+    </section>","+  )","+}"]}]}]}