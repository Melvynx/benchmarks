{"files":[{"path":"/private/var/folders/7z/5mtgxwxx4zs9ppgzm942gbmh0000gn/T/workspace.FM2oXN/app/src/components/MobileGrid.tsx","hunks":[{"oldStart":1,"oldLines":0,"newStart":1,"newLines":60,"lines":["+import type { EnrichedCity } from '../lib/grid'","+import { cellClass, cellStateLabel } from '../lib/grid'","+import { formatHour, type TimeFormat } from '../lib/time'","+","+interface Props {","+  cities: EnrichedCity[]","+  format: TimeFormat","+  nowHour: number | null","+  onPromote: (id: string) => void","+  onRemove: (id: string) => void","+}","+","+export default function MobileGrid({ cities, format, nowHour, onPromote, onRemove }: Props) {","+  const hours = Array.from({ length: 24 }, (_, i) => i)","+  return (","+    <div className=\"grid-wrap mobile-grid\" data-layout=\"mobile\">","+      <table className=\"tz-table-vertical\" aria-label=\"Timezone overlap grid\">","+        <thead>","+          <tr>","+            <th scope=\"col\" className=\"hour-col\">Ref hour</th>","+            {cities.map(({ city, offsetLabel, currentTime, isRef }) => (","+              <th key={city.id} scope=\"col\" className={isRef ? 'mobile-city-head ref-col' : 'mobile-city-head'} data-city={city.name}>","+                <button type=\"button\" className=\"city-name\" onClick={() => onPromote(city.id)} title={isRef ? 'Reference city' : `Make ${city.name} the reference city`} aria-label={isRef ? `${city.name}, reference city` : `Make ${city.name} the reference city`}>","+                  {city.name}","+                </button>","+                {isRef && <span className=\"ref-badge\">REF</span>}","+                <span className=\"city-sub\">{city.country}</span>","+                <span className=\"city-meta\">{offsetLabel}</span>","+                <span className=\"city-meta\">{currentTime}</span>","+                <button type=\"button\" className=\"remove-btn\" onClick={() => onRemove(city.id)} aria-label={`Remove ${city.name}`} title={`Remove ${city.name}`}>×</button>","+              </th>","+            ))}","+          </tr>","+        </thead>","+        <tbody>","+          {hours.map((h) => (","+            <tr key={h} className={h === nowHour ? 'hour-row now-row' : 'hour-row'}>","+              <th scope=\"row\" className=\"mobile-hour\">{formatHour(h, format)}{h === nowHour ? ' ●' : ''}</th>","+              {cities.map(({ city, cells }) => {","+                const cell = cells[h]","+                return (","+                  <td","+                    key={city.id}","+                    className={cellClass(cell)}","+                    data-state={cellStateLabel(cell)}","+                    data-hour={h}","+                    data-city={city.name}","+                    title={`${city.name}: ${cell.label} — ${cellStateLabel(cell)}`}","+                  >","+                    {cell.label}","+                  </td>","+                )","+              })}","+            </tr>","+          ))}","+        </tbody>","+      </table>","+    </div>","+  )","+}"]}]}]}