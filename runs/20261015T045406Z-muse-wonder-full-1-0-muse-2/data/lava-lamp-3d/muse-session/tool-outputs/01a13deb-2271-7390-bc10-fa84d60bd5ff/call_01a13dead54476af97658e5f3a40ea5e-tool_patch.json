{"files":[{"path":"/private/var/folders/7z/5mtgxwxx4zs9ppgzm942gbmh0000gn/T/workspace.TL4FBa/app/index.html","hunks":[{"oldStart":1,"oldLines":0,"newStart":1,"newLines":127,"lines":["+<!DOCTYPE html>","+<html lang=\"en\">","+<head>","+<meta charset=\"utf-8\">","+<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">","+<title>muse-wonder-full-1.0</title>","+<style>","+  *{margin:0;padding:0;box-sizing:border-box}","+  html,body{height:100%;overflow:hidden;background:#070605;color:#f3ead9;","+    font-family:ui-sans-serif,system-ui,-apple-system,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif}","+  #app{position:fixed;inset:0}","+  canvas{display:block}","+  .brand{position:fixed;top:18px;left:22px;z-index:10;font-size:13px;font-weight:600;","+    letter-spacing:.22em;text-transform:lowercase;color:rgba(243,234,217,.92);","+    text-shadow:0 1px 12px rgba(0,0,0,.8);pointer-events:none;user-select:none}","+  .hint{position:fixed;left:22px;bottom:18px;z-index:10;font-size:11px;letter-spacing:.08em;","+    color:rgba(243,234,217,.42);pointer-events:none;user-select:none}","+  .panel{position:fixed;right:18px;bottom:18px;z-index:20;width:258px;padding:16px 16px 14px;","+    background:rgba(14,11,9,.62);border:1px solid rgba(255,235,200,.14);border-radius:16px;","+    backdrop-filter:blur(14px) saturate(1.2);-webkit-backdrop-filter:blur(14px) saturate(1.2);","+    box-shadow:0 18px 50px rgba(0,0,0,.55)}","+  .row{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:10px 0}","+  .row:first-child{margin-top:0}.row:last-child{margin-bottom:0}","+  .lbl{font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:rgba(243,234,217,.72);white-space:nowrap}","+  .val{font-size:11px;color:rgba(243,234,217,.5);min-width:30px;text-align:right;font-variant-numeric:tabular-nums}","+  input[type=range]{-webkit-appearance:none;appearance:none;flex:1;height:4px;border-radius:99px;","+    background:linear-gradient(90deg,rgba(255,150,60,.85