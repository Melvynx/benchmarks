stprocessing/EffectComposer.js';","+import { RenderPass } from 'three/addons/postprocessing/RenderPass.js';","+import { UnrealBloomPass } from 'three/addons/postprocessing/UnrealBloomPass.js';","+import { ShaderPass } from 'three/addons/postprocessing/ShaderPass.js';","+import { OutputPass } from 'three/addons/postprocessing/OutputPass.js';","+","+/* ================= core ================= */","+const app = document.getElementById('app');","+const renderer = new THREE.WebGLRenderer({ antialias:true, powerPreference:'high-performance' });","+renderer.setPixelRatio(Math.min(devicePixelRatio, 2));","+renderer.setSize(innerWidth, innerHeight);","+renderer.shadowMap.enabled = true;","+renderer.shadowMap.type = THREE.PCFSoftShadowMap;","+renderer.toneMapping = THREE.ACESFilmicToneMapping;","+renderer.toneMappingExposure = 1.12;","+app.appendChild(renderer.domElement);","+","+const scene = new THREE.Scene();","+scene.background = new THREE.Color(0x090706);","+scene.fog = new THREE.FogExp2(0x090706, 0.028);","+","+const camera = new THREE.PerspectiveCamera(42, innerWidth/innerHeight, 0.1, 60);","+camera.position.set(3.4, 2.5, 4.6);","+","+const controls = new OrbitControls(camera, renderer.domElement);","+controls.target.set(0, 1.78, 0);","+controls.enableDamping = true; controls.dampingFactor = 0.06;","+controls.minDistance = 2.1; controls.maxDistance = 9.5;","+controls.maxPolarAngle = Math.PI * 0.56; controls.minPolarAngle = Math.PI * 0.12;","+controls.autoRotateSpeed = 0.7; controls.enablePan = false;","+","+const pmrem = new THREE.PMREMGenerator(renderer);","+scene.environment = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;","+scene.environmentIntensity = 0.22;","+","+/* lamp geometry constants — shared by JS sim, meshes and GLSL */","+const IB = 1.04, IT = 3.14;                       // glass interior bottom / top (y)","+function vesselR(y){","+  const t = THREE.MathUtils.clamp((y-IB)/(IT-IB), 0, 1);","+  let r = (0.60*(1-t) + 0.295*t) + 0.05*Math.sin(t*Math.PI)*(1-t*0.6);","+  if (t > 0.93) r *= Math.sqrt(Math.max(0.05, 1 - Math.pow((t-0.93)/0.07, 2)*0.85));","+  return r;","+}"]}]}]}