{"files":[{"path":"/private/var/folders/7z/5mtgxwxx4zs9ppgzm942gbmh0000gn/T/workspace.TL4FBa/app/index.html","hunks":[{"oldStart":524,"oldLines":16,"newStart":524,"newLines":16,"lines":["     float bulbGlow = exp(-bulbDist*1.15) * uPower * uFlicker;","     float thick = thicknessToLight(p, L);","     float thin = exp(-thick*7.0);","-    vec3 base = mix(uWaxDeep, uWaxMid, clamp(temp*0.85 + bulbGlow*0.35, 0.0, 1.0));","+    vec3 base = mix(uWaxDeep, uWaxMid, clamp(temp*0.55 + bulbGlow*0.16, 0.0, 1.0));","     float wrap = clamp((dot(N,L)+0.65)/1.65, 0.0, 1.0);","     float att = 1.0/(1.0 + bulbDist*bulbDist*0.55);","-    vec3 col = base * (0.055 + wrap*att*1.5*(0.25+uPower));","+    vec3 col = base * (0.05 + wrap*att*1.05*(0.25+uPower));","     /* subsurface: light shining through thin wax toward the camera */","     float sss = pow(clamp(dot(V, -L)*0.5+0.5, 0.0, 1.0), 3.0) * thin;","-    col += uWaxHot * (sss*1.5 + bulbGlow*0.85) * (0.3 + temp*0.9) * uPower;","-    col += uWaxMid * bulbGlow * 0.55;","+    col += uWaxHot * (sss*0.85 + bulbGlow*0.32) * (0.3 + temp*0.9) * uPower;","+    col += uWaxMid * bulbGlow * 0.2;","     /* cool wax reads darker and more saturated */","-    col *= mix(0.55, 1.12, temp*0.7 + uPower*0.3);","+    col *= mix(0.42, 1.0, temp*0.7 + uPower*0.3);","     float fres = pow(1.0 - max(dot(N,V),0.0), 3.0);","     col += uLiquid * fres * 0.16 + vec3(1.0,0.93,0.8)*fres*0.05;","     vec3 H = normalize(L+V);"]}]}]}