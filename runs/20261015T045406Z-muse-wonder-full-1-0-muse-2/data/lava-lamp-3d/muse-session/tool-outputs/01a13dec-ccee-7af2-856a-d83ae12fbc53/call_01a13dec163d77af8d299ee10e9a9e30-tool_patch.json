{"files":[{"path":"/private/var/folders/7z/5mtgxwxx4zs9ppgzm942gbmh0000gn/T/workspace.TL4FBa/app/index.html","hunks":[{"oldStart":326,"oldLines":4,"newStart":326,"newLines":254,"lines":[" baseSwitch.position.set(0.34, 0.34, 0.58); baseSwitch.rotation.x = 0.5; baseSwitch.castShadow=true;"," lamp.add(baseSwitch);"," ","+/* ================= wax simulation (heat model, fixed step) ================= */","+const POOL_N = 4, BLOB_N = 24, MAXB = POOL_N + BLOB_N;","+const state = {","+  powerOn:true, power:1, warmup:0.85, heat:1.1, waxAmt:1.0, room:0.55,","+  slowmo:false, spawnT:0.4, time:0, flicker:1 };","+const blobs = [];","+for(let i=0;i<BLOB_N;i++) blobs.push({","+  active:false, pos:new THREE.Vector3(0,-10,0), vel:new THREE.Vector3(),","+  r:0.15, temp:0.2, stretch:1, phase:Math.random()*Math.PI*2,","+  wob:0.6+Math.random()*1.1, merging:0, born:0 });","+/* pre-warm a lively set so the lamp is already flowing on first load */","+function seedInitial(){","+  const seeds = [[-0.12,1.55,0.08,0.24,0.8],[0.14,2.05,-0.1,0.19,0.62],[0.0,2.5,0.12,0.16,0.4],","+                 [-0.08,2.85,-0.05,0.14,0.25],[0.18,1.32,-0.14,0.2,0.9],[-0.2,2.25,0.16,0.12,0.5],","+                 [0.06,1.85,0.2,0.13,0.7]];","+  seeds.forEach((s,i)=>{ const b=blobs[i]; b.active=true; b.pos.set(s[0],s[1],s[2]);","+    b.r=s[3]; b.temp=s[4]; b.vel.set(0,(s[4]-0.5)*0.12,0); b.born=-5; });","+}","+seedInitial();","+const poolDefs = [[0,0,0.5],[-0.27,0.1,0.35],[0.28,-0.08,0.35],[0.02,0.26,0.3]];","+function activeVolume(){ let v=0; for(const b of blobs) if(b.active) v+=b.r*b.r*b.r; return v; }","+","+function spawnBlob(){","+  const b = blobs.find(x=>!x.active); if(!b) return;","+  const maxActive = Math.round(6 + state.waxAmt*9);","+  if (blobs.filter(x=>x.active).length >= maxActive) return;","+  const a = Math.random()*Math.PI*2, rad = Math.random()*0.22;","+  b.active = true; b.merging = 0;","+  b.r = (0.11 + Math.random()*0.13) * (0.75 + state.waxAmt*0.3);","+  b.pos.set(Math.cos(a)*rad, IB + 0.1 + b.r*0.4, Math.sin(a)*rad);","+  b.vel.set(0, 0.015, 0); b.temp = 0.82 + Math.random()*0.15;","+  b.phase = Math.random()*Math.PI*2; b.born = state.time;","+}","+function stepWax(dt){","+  state.time += dt;","+  /* warm-up / cool-down of the whole vessel */","+  const warmTarget = state.powerOn ? 1 : 0;","+  state.warmup += (warmTarget - state.warmup) * dt * (state.powerOn ? 0.22 : 0.07);","+  state.power  += ((state.powerOn?1:0) - state.power) * dt * 1.6;","+  const heatOn = state.warmup * state.heat;","+","+  /* feed new blobs from the pool once warm */","+  state.spawnT -= dt;","+  if (state.spawnT <= 0){","+    state.spawnT = (1.4 + Math.random()*2.6) / Math.max(0.25, state.heat);","+    if (state.warmup > 0.55) spawnBlob();","+  }","+  for (const b of blobs){","+    if (!b.active) continue;","+    if (b.merging > 0){ /* sinking blob dissolving back into the pool */","+      b.merging += dt*2.2; b.r *= Math.max(0, 1 - dt*1.8);","+      b.pos.y -= dt*0.08;","+      if (b.merging >= 1 || b.r < 0.03){ b.active=false; b.pos.y=-10; }","+      continue;","+    }","+    const tH = THREE.MathUtils.clamp((b.pos.y-IB)/(IT-IB), 0, 1);","+    /* environment temperature: hot at the bulb, cold at the cap */","+    const envT = (0.97*(1-tH) + 0.1*tH) * heatOn + 0.04;","+    const rate = tH < 0.25 ? 0.55 : (tH > 0.8 ? 0.32 : 0.13);","+    b.temp += (envT - b.temp) * Math.min(1, rate*dt*2.2);","+    b.temp = THREE.MathUtils.clamp(b.temp, 0, 1);","+","+    /* buoyancy: warm wax expands and rises, cool wax sinks */","+    const buoy = (b.temp - 0.52) * 0.55 * (0.6 + state.heat*0.45);","+    b.vel.y += buoy * dt;","+    /* gentle convective wobble */","+    b.vel.x += Math.sin(state.time*b.wob + b.phase) * 0.02 * dt * (0.4+b.temp);","+    b.vel.z += Math.cos(state.time*b.wob*0.83 + b.phase*1.7) * 0.02 * dt * (0.4+b.temp);","+    /* viscous drag — bigger blobs keep more momentum */","+    const drag = Math.exp(-dt * (1.15 / Math.max(0.5, b.r*4)));","+    b.vel.multiplyScalar(drag);","+    b.vel.y = THREE.MathUtils.clamp(b.vel.y, -0.22, 0.3);","+    b.pos.addScaledVector(b.vel, dt);","+","+    /* stretch along travel; cool falling blobs look dense and round */","+    const targetStretch = b.vel.y > 0.01","+      ? 1 + Math.min(0.75, b.vel.y*2.4) + Math.sin(state.time*2.1+b.phase)*0.05","+      : 0.88 + Math.min(0.25, -b.vel.y*0.8);","+    b.stretch += (targetStretch - b.stretch) * Math.min(1, dt*3);","+","+    /* confinement inside the tapered glass */","+    const stretchR = b.r * Math.max(1, b.stretch);","+    const yMin = IB + b.r*0.55, yMax = IT - stretchR - 0.03;","+    if (b.pos.y > yMax){ b.pos.y = yMax; b.vel.y = Math.min(b.vel.y, 0); }","+    if (b.pos.y < yMin){","+      b.pos.y = yMin;","+      if (b.vel.y < 0 && state.time - b.born > 2.5 && b.temp < 0.72) b.merging = 0.001;","+      b.vel.y = Math.max(b.vel.y, 0);","+    }","+    const wallR = vesselR(b.pos.y) - b.r*0.92 - 0.015;","+    const radial = Math.hypot(b.pos.x, b.pos.z);","+    if (radial > wallR && radial > 1e-5){","+      const s = Math.max(0, wallR)/radial; b.pos.x*=s; b.pos.z*=s;","+      b.vel.x *= 0.4; b.vel.z *= 0.4;","+    }","+    /* pinch-off: a fast, large riser sheds a droplet */","+    if (b.r > 0.21 && b.vel.y > 0.1 && Math.random() < dt*0.1){","+      const c = blobs.find(x=>!x.active);","+      if (c){ const cr = b.r*0.38;","+        c.active=true; c.merging=0; c.r=cr; c.temp=b.temp; c.born=state.time;","+        c.pos.copy(b.pos); c.pos.y -= b.r*b.stretch*0.9;","+        c.vel.copy(b.vel).multiplyScalar(0.55);","+        b.r = Math.cbrt(Math.max(0.001, b.r**3 - cr**3)); }","+    }","+  }","+  /* physical merging of strongly overlapping blobs (volume conserved) */","+  for(let i=0;i<blobs.length;i++){ const a=blobs[i]; if(!a.active||a.merging) continue;","+    for(let j=i+1;j<blobs.length;j++){ const b=blobs[j]; if(!b.active||b.merging) continue;","+      if (a.pos.distanceToSquared(b.pos) < Math.pow((a.r+b.r)*0.5, 2)){","+        const big = a.r>=b.r ? a : b, small = big===a ? b : a;","+        const v = big.r**3 + small.r**3;","+        big.pos.lerp(small.pos, small.r**3/v); big.vel.lerp(small.vel, 0.4);","+        big.temp = (big.temp*big.r**3 + small.temp*small.r**3)/v;","+        big.r = Math.min(0.3, Math.cbrt(v));","+        small.active=false; small.pos.y=-10;","+      }","+    }","+  }","+  /* bulb flicker from wax passing over it */","+  let occ = 0;","+  for(const b of blobs) if(b.active && b.pos.y < IB+0.55) occ += b.r*1.6;","+  const targetFlick = THREE.MathUtils.clamp(1.06 - occ*0.35, 0.68, 1.08)","+    + Math.sin(state.time*13.7)*0.012 + Math.sin(state.time*3.1)*0.02;","+  state.flicker += (targetFlick - state.flicker) * Math.min(1, dt*5);","+}","+","+/* ================= wax raymarched SDF ================= */","+const waxUniforms = {","+  uBalls:{ value:Array.from({length:MAXB},()=>new THREE.Vector4(0,-10,0,0.001)) },","+  uMeta:{ value:Array.from({length:MAXB},()=>new THREE.Vector4(1,0.5,0,0)) },","+  uTime:{ value:0 }, uPower:{ value:1 }, uFlicker:{ value:1 }, uSteps:{ value:88 },","+  uWaxDeep:{ value:new THREE.Color(0x8f0d04) }, uWaxMid:{ value:new THREE.Color(0xff2a12) },","+  uWaxHot:{ value:new THREE.Color(0xffa03c) }, uLiquid:{ value:new THREE.Color(0xffcf3f) },","+  uBulbPos:{ value:new THREE.Vector3(0,1.12,0) },","+  uBoxMin:{ value:new THREE.Vector3(-0.72, IB-0.06, -0.72) },","+  uBoxMax:{ value:new THREE.Vector3( 0.72, IT+0.08,  0.72) } };","+const waxVert = /* glsl */`","+  varying vec3 vWorld;","+  void main(){ vec4 wp = modelMatrix * vec4(position,1.0); vWorld = wp.xyz;","+    gl_Position = projectionMatrix * viewMatrix * wp; }`;","+const waxFrag = /* glsl */`","+  precision highp float;","+  varying vec3 vWorld;","+  uniform vec4 uBalls[${MAXB}]; uniform vec4 uMeta[${MAXB}];","+  uniform float uTime, uPower, uFlicker, uSteps;","+  uniform vec3 uWaxDeep, uWaxMid, uWaxHot, uLiquid, uBulbPos, uBoxMin, uBoxMax;","+  const float IB = ${IB.toFixed(3)}; const float IT = ${IT.toFixed(3)};","+  float vesselR(float y){ float t = clamp((y-IB)/(IT-IB), 0.0, 1.0);","+    float r = (0.60*(1.0-t) + 0.295*t) + 0.05*sin(t*3.14159)*(1.0-t*0.6);","+    if (t > 0.93) r *= sqrt(max(0.05, 1.0 - pow((t-0.93)/0.07, 2.0)*0.85));","+    return r; }","+  float smin(float a, float b, float k){ float h = clamp(0.5+0.5*(b-a)/k, 0.0, 1.0);","+    return mix(b, a, h) - k*h*(1.0-h); }","+  float ballSDF(vec3 p, int i){","+    vec3 c = uBalls[i].xyz; float r = uBalls[i].w;","+    float st = uMeta[i].x; float ph = uMeta[i].z;","+    vec3 q = (p - c) / vec3(1.0, st, 1.0);","+    float d = (length(q) - r) * min(1.0, st);","+    d += sin(p.y*16.0 - uTime*1.7 + ph) * cos(p.x*13.0 + ph) * 0.0035;","+    return d; }","+  float mapWax(vec3 p){","+    float d = 1e5;","+    for(int i=0;i<${MAXB};i++){ if(uBalls[i].w < 0.004) continue; d = smin(d, ballSDF(p,i), 0.16); }","+    float wall = length(p.xz) - (vesselR(p.y) - 0.012);","+    float capB = (IB + 0.008) - p.y; float capT = p.y - (IT - 0.015);","+    return max(d, max(wall, max(capB, capT))); }","+  float tempAt(vec3 p){ float sum=0.0, wsum=0.0;","+    for(int i=0;i<${MAXB};i++){ if(uBalls[i].w < 0.004) continue;","+      float dist = length(p - uBalls[i].xyz);","+      float w = exp(-dist*7.0) * uBalls[i].w; sum += uMeta[i].y * w; wsum += w; }","+    return wsum > 0.0 ? sum/wsum : 0.3; }","+  vec3 calcNormal(vec3 p){ float e = 0.0038;","+    vec2 k = vec2(1.0,-1.0);","+    return normalize(k.xyy*mapWax(p+k.xyy*e) + k.yyx*mapWax(p+k.yyx*e)","+                   + k.yxy*mapWax(p+k.yxy*e) + k.xxx*mapWax(p+k.xxx*e)); }","+  vec2 boxHit(vec3 ro, vec3 rd){","+    vec3 t0 = (uBoxMin-ro)/rd, t1 = (uBoxMax-ro)/rd;","+    vec3 tsm = min(t0,t1), tbg = max(t0,t1);","+    return vec2(max(max(tsm.x,tsm.y),tsm.z), min(min(tbg.x,tbg.y),tbg.z)); }","+  float thicknessToLight(vec3 p, vec3 ld){ float th=0.0; float t=0.03;","+    for(int i=0;i<6;i++){ float d = mapWax(p + ld*t); th += clamp(-d, 0.0, 0.12); t += 0.05; }","+    return th; }","+  void main(){","+    vec3 ro = cameraPosition; vec3 rd = normalize(vWorld - ro);","+    vec2 bt = boxHit(ro, rd); float t = max(bt.x, 0.0); float tEnd = bt.y;","+    if (tEnd <= t) discard;","+    float d = 1e5; vec3 p = ro + rd*t; bool hit = false;","+    for(int i=0;i<140;i++){ if(float(i) >= uSteps) break;","+      p = ro + rd*t; d = mapWax(p);","+      if (d < 0.0016){ hit = true; break; }","+      t += max(d*0.62, 0.0022); if (t > tEnd) break; }","+    if (!hit) discard;","+    vec3 N = calcNormal(p); vec3 V = -rd;","+    vec3 toBulb = uBulbPos - p; float bulbDist = length(toBulb); vec3 L = toBulb/bulbDist;","+    float temp = tempAt(p);","+    float bulbGlow = exp(-bulbDist*1.15) * uPower * uFlicker;","+    float thick = thicknessToLight(p, L);","+    float thin = exp(-thick*7.0);","+    vec3 base = mix(uWaxDeep, uWaxMid, clamp(temp*0.85 + bulbGlow*0.35, 0.0, 1.0));","+    float wrap = clamp((dot(N,L)+0.65)/1.65, 0.0, 1.0);","+    float att = 1.0/(1.0 + bulbDist*bulbDist*0.55);","+    vec3 col = base * (0.055 + wrap*att*1.5*(0.25+uPower));","+    /* subsurface: light shining through thin wax toward the camera */","+    float sss = pow(clamp(dot(V, -L)*0.5+0.5, 0.0, 1.0), 3.0) * thin;","+    col += uWaxHot * (sss*1.5 + bulbGlow*0.85) * (0.3 + temp*0.9) * uPower;","+    col += uWaxMid * bulbGlow * 0.55;","+    /* cool wax reads darker and more saturated */","+    col *= mix(0.55, 1.12, temp*0.7 + uPower*0.3);","+    float fres = pow(1.0 - max(dot(N,V),0.0), 3.0);","+    col += uLiquid * fres * 0.16 + vec3(1.0,0.93,0.8)*fres*0.05;","+    vec3 H = normalize(L+V);","+    col += vec3(1.0,0.9,0.75) * pow(max(dot(N,H),0.0), 70.0) * 0.55 * (0.2+uPower*att);","+    /* faint room key light so the form reads with the lamp off */","+    vec3 L2 = normalize(vec3(-0.5,0.8,-0.3));","+    col += base * max(dot(N,L2),0.0) * 0.05;","+    /* haze of tinted liquid in front of the wax */","+    float liqPath = clamp((t - bt.x)*0.22, 0.0, 0.35);","+    col = mix(col, uLiquid*0.32*(0.3+uPower*0.7), liqPath*0.45);","+    gl_FragColor = vec4(col, 1.0);","+  }`;","+const waxMat = new THREE.ShaderMaterial({","+  uniforms:waxUniforms, vertexShader:waxVert, fragmentShader:waxFrag,","+  side:THREE.FrontSide, depthWrite:false, depthTest:true });","+const waxProxy = new THREE.Mesh(new THREE.BoxGeometry(1.44, (IT-IB)+0.14, 1.44), waxMat);","+waxProxy.position.y = (IB+IT)/2 + 0.01; waxProxy.renderOrder = 10; waxProxy.frustumCulled = false;","+lamp.add(waxProxy);","+","+function pushWaxUniforms(){","+  const balls = waxUniforms.uBalls.value, meta = waxUniforms.uMeta.value;","+  const totalVol = 0.42 * state.waxAmt;","+  const poolVol = Math.max(0.06, totalVol - activeVolume());","+  const poolScale = THREE.MathUtils.clamp(Math.cbrt(poolVol/0.42), 0.5, 1.3);","+  const poolTemp = 0.25 + state.warmup*0.65;","+  poolDefs.forEach((pd,i)=>{","+    const breathe = 1 + Math.sin(state.time*0.7 + i*1.7)*0.02*state.warmup;","+    balls[i].set(pd[0], IB + 0.045 + Math.sin(state.time*0.45+i)*0.004, pd[1], pd[2]*poolScale*breathe);","+    meta[i].set(0.48, poolTemp, i*1.7, 0);","+  });","+  blobs.forEach((b,j)=>{","+    const i = POOL_N + j;","+    if (b.active){ balls[i].set(b.pos.x, b.pos.y, b.pos.z, Math.max(0.001,b.r));","+      meta[i].set(b.stretch, b.temp, b.phase, 0); }","+    else { balls[i].set(0,-10,0,0.001); meta[i].set(1,0,0,0); }","+  });","+  waxUniforms.uTime.value = state.time;","+  waxUniforms.uPower.value = state.power;","+  waxUniforms.uFlicker.value = state.flicker;","+}","+","+"," "]}]}]}