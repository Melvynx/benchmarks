oughness:0.9 }));","+pot.position.set(2.15,0.2,-1.75); pot.castShadow=pot.receiveShadow=true; scene.add(pot);","+const leafMat = new THREE.MeshStandardMaterial({ color:0x1e3d24, roughness:0.85 });","+for(let i=0;i<7;i++){","+  const leaf = new THREE.Mesh(new THREE.SphereGeometry(0.16+Math.random()*0.12, 10, 8), leafMat);","+  leaf.scale.set(1, 0.55+Math.random()*0.4, 1);","+  leaf.position.set(2.15+(Math.random()-0.5)*0.55, 0.55+Math.random()*0.45, -1.75+(Math.random()-0.5)*0.55);","+  leaf.castShadow=true; scene.add(leaf);","+}","+box(0.05,1.5,1.1, 0x191410, -3.4,0.75,-2.2, 0.3, 0.7); // picture frame leaning hint","+"]}]}]}