{"files":[{"path":"/private/var/folders/7z/5mtgxwxx4zs9ppgzm942gbmh0000gn/T/workspace.TL4FBa/app/index.html","hunks":[{"oldStart":125,"oldLines":3,"newStart":125,"newLines":106,"lines":["   if (t > 0.93) r *= Math.sqrt(Math.max(0.05, 1 - Math.pow((t-0.93)/0.07, 2)*0.85));","   return r;"," }","+","+/* ================= procedural textures ================= */","+function canvasTex(w, h, draw, rx=1, ry=1){","+  const c = document.createElement('canvas'); c.width=w; c.height=h;","+  draw(c.getContext('2d'), w, h);","+  const t = new THREE.CanvasTexture(c);","+  t.wrapS = t.wrapT = THREE.RepeatWrapping; t.repeat.set(rx, ry);","+  t.colorSpace = THREE.SRGBColorSpace; t.anisotropy = 8; return t;","+}","+const woodTex = canvasTex(1024, 512, (g,w,h)=>{","+  g.fillStyle='#4a3220'; g.fillRect(0,0,w,h);","+  const rows=4, rh=h/rows;","+  for(let r=0;r<rows;r++){","+    const base=58+Math.random()*22;","+    g.fillStyle=`rgb(${base+28},${base*0.72|0},${base*0.42|0})`; g.fillRect(0,r*rh,w,rh);","+    for(let i=0;i<240;i++){ // grain","+      const y=r*rh+Math.random()*rh, len=40+Math.random()*300, x=Math.random()*w;","+      g.strokeStyle=`rgba(${20+Math.random()*40|0},${12+Math.random()*22|0},6,${0.08+Math.random()*0.22})`;","+      g.lineWidth=0.6+Math.random()*1.6; g.beginPath(); g.moveTo(x,y);","+      g.bezierCurveTo(x+len*0.3,y+ (Math.random()*4-2), x+len*0.7,y+(Math.random()*4-2), x+len,y); g.stroke();","+    }","+    for(let k=0;k<2;k++){ // knots","+      const x=Math.random()*w, y=r*rh+rh*(0.25+Math.random()*0.5);","+      const gr=g.createRadialGradient(x,y,1,x,y,14+Math.random()*10);","+      gr.addColorStop(0,'rgba(25,12,4,.85)'); gr.addColorStop(1,'rgba(25,12,4,0)');","+      g.fillStyle=gr; g.beginPath(); g.arc(x,y,24,0,7); g.fill();","+    }","+    g.fillStyle='rgba(0,0,0,.55)'; g.fillRect(0,r*rh,w,2);","+  }","+}, 2, 1);","+const woodRough = canvasTex(512,256,(g,w,h)=>{","+  g.fillStyle='#8a8a8a'; g.fillRect(0,0,w,h);","+  for(let i=0;i<5000;i++){ g.fillStyle=`rgba(${90+Math.random()*90|0},0,0,0)`;","+    g.fillStyle=`rgba(${90+Math.random()*90|0},${90+Math.random()*90|0},${90+Math.random()*90|0},.25)`;","+    g.fillRect(Math.random()*w,Math.random()*h,8+Math.random()*30,1); }","+},2,1); woodRough.colorSpace = THREE.NoColorSpace;","+const brushedTex = canvasTex(512,512,(g,w,h)=>{","+  g.fillStyle='#7d7d7d'; g.fillRect(0,0,w,h);","+  for(let i=0;i<9000;i++){ const v=95+Math.random()*80|0;","+    g.strokeStyle=`rgba(${v},${v},${v},.35)`; g.lineWidth=1;","+    const y=Math.random()*h; g.beginPath(); g.moveTo(0,y); g.lineTo(w,y+(Math.random()*2-1)); g.stroke(); }","+},3,1); brushedTex.colorSpace = THREE.NoColorSpace;","+const wallTex = canvasTex(512,512,(g,w,h)=>{","+  g.fillStyle='#2b2622'; g.fillRect(0,0,w,h);","+  for(let i=0;i<14000;i++){ const v=28+Math.random()*26|0;","+    g.fillStyle=`rgba(${v+12},${v+6},${v},.5)`; g.fillRect(Math.random()*w,Math.random()*h,2,2); }","+},3,2);","+","+/* ================= room ================= */","+const hemi = new THREE.HemisphereLight(0x35405a, 0x1a120c, 0.35); scene.add(hemi);","+const moon = new THREE.DirectionalLight(0x8fa8d8, 0.5);","+moon.position.set(-5, 6, -3); moon.castShadow = true;","+moon.shadow.mapSize.set(1024,1024); moon.shadow.bias = -0.0004;","+moon.shadow.camera.left=-6; moon.shadow.camera.right=6; moon.shadow.camera.top=6; moon.shadow.camera.bottom=-6;","+scene.add(moon);","+","+const table = new THREE.Mesh(","+  new THREE.BoxGeometry(14, 0.22, 9),","+  new THREE.MeshStandardMaterial({ map:woodTex, roughnessMap:woodRough, roughness:0.75, metalness:0.02 }));","+table.position.y = -0.11; table.receiveShadow = true; scene.add(table);","+","+const floor = new THREE.Mesh(new THREE.PlaneGeometry(40,40),","+  new THREE.MeshStandardMaterial({ color:0x17120e, roughness:0.95 }));","+floor.rotation.x = -Math.PI/2; floor.position.y = -2.4; floor.receiveShadow = true; scene.add(floor);","+const legMat = new THREE.MeshStandardMaterial({ color:0x241a11, roughness:0.85 });","+for 