{"files":[{"path":"/private/var/folders/7z/5mtgxwxx4zs9ppgzm942gbmh0000gn/T/workspace.TL4FBa/app/index.html","hunks":[{"oldStart":575,"oldLines":5,"newStart":575,"newLines":156,"lines":["   waxUniforms.uFlicker.value = state.flicker;"," }"," ","+/* ================= colour presets ================= */","+const PRESETS = [","+  { name:'Classic',  wax:0xff2a12, waxDeep:0x8f0d04, waxHot:0xffa03c, liquid:0xffcf3f, atten:0xffb520, light:0xffa63d },","+  { name:'Violet',   wax:0xff3fd4, waxDeep:0x7a0f63, waxHot:0xff9de2, liquid:0x3b2bff, atten:0x2a1bd0, light:0xb06bff },","+  { name:'Lagoon',   wax:0x00e0a8, waxDeep:0x046653, waxHot:0x8affdd, liquid:0x1b52e0, atten:0x123f9e, light:0x4fc8ff },","+  { name:'Ember',    wax:0xff7a00, waxDeep:0x8a3800, waxHot:0xffd23c, liquid:0x0fa08c, atten:0x067a68, light:0xff9a3d },","+  { name:'Acid',     wax:0xaee81f, waxDeep:0x4f6e05, waxHot:0xe8ffb0, liquid:0x7a1fd0, atten:0x55149a, light:0xc8ff6b },","+];","+const colourTargets = {","+  waxDeep:new THREE.Color(), waxMid:new THREE.Color(), waxHot:new THREE.Color(),","+  liquid:new THREE.Color(), atten:new THREE.Color(), light:new THREE.Color() };","+function applyPreset(i, instant=false){","+  const p = PRESETS[i];","+  colourTargets.waxDeep.set(p.waxDeep); colourTargets.waxMid.set(p.wax);","+  colourTargets.waxHot.set(p.waxHot); colourTargets.liquid.set(p.liquid);","+  colourTargets.atten.set(p.atten); colourTargets.light.set(p.light);","+  if (instant) lerpColours(1);","+  document.querySelectorAll('.preset').forEach((el,j)=>el.classList.toggle('active', j===i));","+}","+function lerpColours(k){","+  waxUniforms.uWaxDeep.value.lerp(colourTargets.waxDeep, k);","+  waxUniforms.uWaxMid.value.lerp(colourTargets.waxMid, k);","+  waxUniforms.uWaxHot.value.lerp(colourTargets.waxHot, k);","+  waxUniforms.uLiquid.value.lerp(colourTargets.liquid, k);","+  liquidMat.color.lerp(colourTargets.liquid, k);","+  liquidMat.attenuationColor.lerp(colourTargets.atten, k);","+  bulbLight.color.lerp(colourTargets.light, k);","+  spill.color.copy(bulbLight.color);","+  coreGlow.material.color.lerp(colourTargets.light, k);","+  haloGlow.material.color.lerp(colourTargets.light, k);","+  bulbMat.emissive.lerp(colourTargets.light, k);","+}","+const presetsEl = document.getElementById('presets');","+PRESETS.forEach((p,i)=>{","+  const b = document.createElement('button');","+  b.className = 'preset'; b.title = p.name; b.setAttribute('aria-label', p.name);","+  const wax = '#'+p.wax.toString(16).padStart(6,'0'), liq = '#'+p.liquid.toString(16).padStart(6,'0');","+  b.style.background = `radial-gradient(circle at 38% 62%, ${wax} 0 34%, ${liq} 38% 100%)`;","+  b.addEventListener('click', ()=>applyPreset(i));","+  presetsEl.appendChild(b);","+});","+applyPreset(0, true);","+","+/* ================= controls ================= */","+const $ = id => document.getElementById(id);","+function bindSlider(id, out, fn){","+  const el = $(id), o = $(out);","+  const upd = ()=>{ const v = +el.value; o.textContent = v+'%'; fn(v/100); };","+  el.addEventListener('input', upd); upd();","+}","+bindSlider('heat','heatV', v=>state.heat = v);","+bindSlider('waxAmt','waxV', v=>state.waxAmt = v);","+bindSlider('room','roomV', v=>state.room = v);","+function setPower(on){","+  state.powerOn = on; $('power').checked = on;","+  swToggle.rotation.x = on ? -0.4 : 0.4;","+  baseSwitch.rotation.x = on ? 0.5 : 0.95;","+  if (on) state.spawnT = Math.max(state.spawnT, 1.2); /* warm-up before first blob */","+}","+$('power').addEventListener('change', e=>setPower(e.target.checked));","+$('slowmo').addEventListener('change', e=>state.slowmo = e.target.checked);","+$('autorot').addEventListener('change', e=>controls.autoRotate = e.target.checked);","+","+/* clicking the physical switch on the base toggles power */","+const ray = new THREE.Raycaster(), ptr = new THREE.Vector2();","+let downX=0, downY=0;","+renderer.domElement.addEventListener('pointerdown', e=>{ downX=e.clientX; downY=e.clientY; });","+renderer.domElement.addEventListener('pointerup', e=>{","+  if (Math.hypot(e.clientX-downX, e.clientY-downY) > 6) return;","+  ptr.set((e.clientX/innerWidth)*2-1, -(e.clientY/innerHeight)*2+1);","+  ray.setFromCamera(ptr, camera);","+  if (ray.intersectObjects([baseSwitch, swBody, swToggle], false).length) setPower(!state.powerOn);","+});","+","+/* ================= post-processing ================= */","+const composer = new EffectComposer(renderer);","+composer.addPass(new RenderPass(scene, camera));","+const bloom = new UnrealBloomPass(new THREE.Vector2(innerWidth, innerHeight), 0.65, 0.55, 0.72);","+composer.addPass(bloom);","+composer.addPass(new OutputPass());","+const gradePass = new ShaderPass({","+  uniforms:{ tDiffuse:{value:null}, uTime:{value:0} },","+  vertexShader:`varying vec2 vUv; void main(){ vUv=uv; gl_Position=projectionMatrix*modelViewMatrix*vec4(position,1.0); }`,","+  fragmentShader:`","+    varying vec2 vUv; uniform sampler2D tDiffuse; uniform float uTime;","+    float hash(vec2 p){ return fract(sin(dot(p, vec2(127.1,311.7)))*43758.5453); }","+    void main(){","+      vec4 c = texture2D(tDiffuse, vUv);","+      float d = distance(vUv, vec2(0.5,0.46));","+      c.rgb *= smoothstep(0.95, 0.42, d)*0.32 + 0.68;","+      c.rgb += (hash(vUv*vec2(1920.0,1080.0) + fract(uTime)*7.0) - 0.5) * 0.022;","+      gl_FragColor = c; }`","+});","+composer.addPass(gradePass);","+","+addEventListener('resize', ()=>{","+  camera.aspect = innerWidth/innerHeight; camera.updateProjectionMatrix();","+  renderer.setSize(innerWidth, innerHeight); composer.setSize(innerWidth, innerHeight);","+});","+","+/* ================= main loop (fixed-step wax, adaptive quality) ================= */","+const clock = new THREE.Clock();","+let acc = 0, frameEMA = 16, qualityT = 0;","+const FIXED = 1/60;","+function animate(){","+  requestAnimationFrame(animate);","+  const rawDt = Math.min(clock.getDelta(), 0.1);","+  frameEMA = frameEMA*0.95 + rawDt*1000*0.05;","+  qualityT += rawDt;","+  if (qualityT > 2.5){","+    qualityT = 0;","+    if (frameEMA > 24 && waxUniforms.uSteps.value > 56){","+      waxUniforms.uSteps.value -= 12; renderer.setPixelRatio(Math.min(devicePixelRatio, 1.35));","+      composer.setSize(innerWidth, innerHeight);","+    } else if (frameEMA < 13 && waxUniforms.uSteps.value < 88){","+      waxUniforms.uSteps.value += 8;","+    }","+  }","+  const speed = state.slowmo ? 0.32 : 1.0;","+  acc += rawDt * speed;","+  let n = 0;","+  while (acc >= FIXED && n < 5){ stepWax(FIXED); acc -= FIXED; n++; }","+  if (n === 5) acc = 0;","+  pushWaxUniforms();","+  lerpColours(1 - Math.exp(-rawDt*3.5));","+","+  /* lamp-driven lighting, flickering as wax crosses the bulb */","+  const p = state.power, f = state.flicker;","+  bulbLight.intensity = 23 * p * f;","+  spill.intensity = 15 * p * f;","+  bulbMat.emissiveIntensity = 6 * p * f + 0.02;","+  coreGlow.material.opacity = 0.55 * p * f;","+  haloGlow.material.opacity = 0.13 * p * (0.85 + 0.15*f);","+  coreGlow.scale.setScalar(1.5 * (0.92 + 0.1*f));","+  bloom.strength = 0.15 + 0.55 * p;","+","+  /* room light level */","+  hemi.intensity = 0.06 + state.room*0.55;","+  moon.intensity = 0.08 + state.room*0.85;","+  scene.environmentIntensity = 0.04 + state.room*0.4;","+  renderer.toneMappingExposure = 1.0 + state.room*0.22;","+","+  gradePass.uniforms.uTime.value += rawDt;","+  controls.update();","+  composer.render();","+}","+animate();","+</script>","+</body>","+</html>","+"," "," "]}]}]}