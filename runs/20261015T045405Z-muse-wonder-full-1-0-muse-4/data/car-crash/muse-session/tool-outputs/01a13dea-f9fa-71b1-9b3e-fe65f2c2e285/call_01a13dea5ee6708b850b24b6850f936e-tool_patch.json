{"files":[{"path":"/private/var/folders/7z/5mtgxwxx4zs9ppgzm942gbmh0000gn/T/workspace.sk3GiV/app/index.html","hunks":[{"oldStart":1,"oldLines":0,"newStart":1,"newLines":258,"lines":["+<!DOCTYPE html>","+<html lang=\"en\">","+<head>","+<meta charset=\"utf-8\">","+<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">","+<title>muse-wonder-full-1.0</title>","+<style>","+  :root{","+    --bg:#14171c; --panel:#1c2027; --panel2:#232833; --line:#333b49;","+    --ink:#e8ecf2; --dim:#9aa6b8; --accent:#e8a13a; --accent-ink:#1a1408;","+    --good:#57c785; --mono:ui-monospace,\"SF Mono\",Menlo,Consolas,monospace;","+    --sans:-apple-system,\"Helvetica Neue\",Helvetica,\"Segoe UI\",sans-serif;","+  }","+  *{box-sizing:border-box}","+  html,body{height:100%}","+  body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--sans);","+    display:flex;flex-direction:column;overflow:hidden}","+  header{display:flex;align-items:center;gap:14px;padding:10px 16px;","+    background:var(--panel);border-bottom:1px solid var(--line);flex:0 0 auto;flex-wrap:wrap}","+  header h1{font-size:17px;font-weight:700;letter-spacing:.2px;margin:0;font-family:var(--mono)}","+  header .sub{font-size:12px;color:var(--dim)}","+  header .spacer{flex:1}","+  button{font-family:var(--sans);font-size:14px;cursor:pointer;border:1px solid var(--line);","+    background:var(--panel2);color:var(--ink);border-radius:6px;padding:8px 16px}","+  button:hover{border-color:#4a5568}","+  button:active{transform:translateY(1px)}","+  #testBtn{background:var(--accent);color:var(--accent-ink);border-color:#b97e24;","+    font-weight:700;font-size:15px;padding:9px 26px;letter-spacing:.4px}","+  #testBtn:hover{background:#f0ae4c}","+  #statusPill{font-family:var(--mono);font-size:12px;padding:5px 10px;border:1px solid var(--line);","+    border-radius:999px;color:var(--dim);background:#171b21;min-width:104px;text-align:center}","+  #statusPill.running{color:var(--accent);border-color:#6b5324}","+  #statusPill.done{color:var(--good);border-color:#2c5c40}","+  main{flex:1;display:flex;min-height:0}","+  #stage{flex:1;position:relative;min-width:0;background:#0e1116}","+  canvas{display:block;position:absolute;inset:0;width:100%;height:100%}","+  #hud{position:absolute;left:12px;top:10px;font-family:var(--mono);font-size:12.5px;","+    background:rgba(16,19,24,.82);border:1px solid var(--line);border-radius:6px;","+    padding:8px 12px;line-height:1.65;pointer-events:none;min-width:218px}","+  #hud b{color:#fff;font-weight:600}","+  #hud .k{color:var(--dim);display:inline-block;width:118px}","+  #verdict{position:absolute;left:50%;top:14px;transform:translateX(-50%);","+    font-family:var(--mono);font-size:13px;background:rgba(16,19,24,.88);","+    border:1px solid #2c5c40;color:var(--good);border-radius:6px;padding:7px 14px;","+    display:none;pointer-events:none;white-space:nowrap}","+  aside{width:302px;flex:0 0 302px;background:var(--panel);border-left:1px solid var(--line);","+    overflow-y:auto;padding:14px 16px 20px}","+  aside h2{font-size:13px;font-weight:700;margin:2px 0 4px;letter-spacing:.3px}","+  aside p.note{font-size:12px;color:var(--dim);line-height:1.5;margin:0 0 12px}","+  .ctl{margin:0 0 14px;padding:10px 11px 9px;background:var(--panel2);border:1px solid var(--line);border-radius:6px}","+  .ctl .row{display:flex;justify-content:space-between;align-items:baseline;gap:8px}","+  .ctl label{font-size:12.5px;font-weight:600}","+  .ctl .unit{color:var(--dim);font-size:11.5px;font-weight:400}","+  .ctl output{font-family:var(--mono);font-size:13px;color:var(--accent);white-space:nowrap}","+  .ctl input[type=range]{width:100%;margin:9px 0 5px;accent-color:var(--accent);height:20px}","+  .ctl .range{display:flex;justify-content:space-between;font-family:var(--mono);font-size:10.5px;color:var(--dim)}","+  .ctl input[type=number]{width:74px;background:#171b21;color:var(--ink);border:1px solid var(--line);","+    border-radius:4px;font-family:var(--mono);font-size:12.5px;padding:4px 6px}","+  .fixed{font-family:var(--mono);font-size:11.5px;color:var(--dim);line-height:1.8;","+    border-top:1px solid var(--line);padding-top:10px;margin-top:4px}","+  .fixed b{color:var(--ink);font-weight:600}","+  .btnrow{display:flex;gap:8px;margin:2px 0 14px}","+  .btnrow button{flex:1}","+  @media (max-width:860px){","+    body{overflow:auto} main{flex-direction:column}","+    #stage{min-height:52vh} aside{width:auto;flex:none;border-left:none;border-top:1px solid var(--line)}","+  }","+</style>","+</head>","+<body>","+<header>","+  <h1>muse-wonder-full-1.0</h1>","+  <span class=\"sub\">2D rigid-body crash experiment &mdash; car vs. freestanding brick wall</span>","+  <span class=\"spacer\"></span>","+  <span id=\"statusPill\">READY</span>","+  <button id=\"resetBtn\" type=\"button\">Reset</button>","+  <button id=\"testBtn\" type=\"button\">Test &#9654;</button>","+</header>","+<main>","+  <section id=\"stage\">","+    <canvas id=\"cv\"></canvas>","+    <div id=\"hud\">","+      <div><span class=\"k\">car speed</span><b id=\"hudSpeed\">0.0 m/s</b></div>","+      <div><span class=\"k\">elapsed</span><b id=\"hudTime\">0.00 s</b></div>","+      <div><span class=\"k\">moving bricks</span><b id=\"hudMoving\">0 / 0</b></div>","+      <div><span class=\"k\">car momentum</span><b id=\"hudMom\">0 kg&middot;m/s</b></div>","+      <div><span class=\"k\">peak impact</span><b id=\"hudPeak\">0 kN</b></div>","+    </div>","+    <div id=\"verdict\"></div>","+  </section>","+  <aside>","+    <h2>Settings</h2>","+    <p class=\"note\">Changing a setting rebuilds the scene with that value only. Press <b>Test</b> to reset and launch; the same settings always produce the same result.</p>","+    <div class=\"btnrow\">","+      <button id=\"defaultsBtn\" type=\"button\">Restore defaults</button>","+      <button id=\"slowBtn\" type=\"button\" aria-pressed=\"false\">Slow motion</button>","+    </div>","+    <div id=\"controls\"></div>","+    <div class=\"fixed\" id=\"fixedParams\"></div>","+  </aside>","+</main>","+<script>","+\"use strict\";","+/* ============================================================","+   Configuration — mandatory baseline defaults","+   ============================================================ */","+const DEFAULTS = {","+  carSpeed: 22,        // m/s","+  wallCols: 12,        // bricks across","+  wallRows: 8,         // bricks tall","+  wallLayers: 2,       // depth layers","+  brickMass: 2.5       // kg per brick","+};","+const FIXED = {","+  brickW: 0.50, brickH: 0.24,          // m","+  gravity: 9.81,                        // m/s^2","+  brickFriction: 0.72,","+  brickRestitution: 0.18,","+  carMass: 1250,                        // kg","+  carW: 4.2, carH: 1.45,                // m","+  groundFriction: 0.85,","+  scale: 80                             // px per meter (max render scale)","+};","+const RANGES = {","+  carSpeed:   {min:5,  max:45, step:0.5, label:\"Car speed\",        unit:\"m/s\", fmt:v=>v.toFixed(1)},","+  wallCols:   {min:4,  max:24, step:1,   label:\"Wall columns\",     unit:\"bricks wide\", fmt:v=>String(v|0)},","+  wallRows:   {min:3,  max:16, step:1,   label:\"Wall rows\",        unit:\"bricks tall\", fmt:v=>String(v|0)},","+  wallLayers: {min:1,  max:5,  step:1,   label:\"Wall depth layers\",unit:\"layers thick\", fmt:v=>String(v|0)},","+  brickMass:  {min:0.5,max:12, step:0.1, label:\"Brick mass\",       unit:\"kg / brick\", fmt:v=>v.toFixed(1)}","+};","+const settings = Object.assign({}, DEFAULTS);","+","+/* Deterministic visual-only RNG (never feeds physics initial conditions). */","+function mulberry32(seed){ return function(){ seed|=0; seed=(seed+0x6D2B79F5)|0;","+  let t=Math.imul(seed^(seed>>>15),1|seed); t=(t+Math.imul(t^(t>>>7),61|t))^t;","+  return ((t^(t>>>14))>>>0)/4294967296; }; }","+let fxRng = mulberry32(1234567);","+const clamp=(v,a,b)=>v<a?a:(v>b?b:v);","+","+/* ============================================================","+   Rigid-body physics — impulse solver, SAT narrowphase","+   Units: meters, kilograms, seconds. Ground is the plane y=0.","+   ============================================================ */","+let bodies=[], car=null, bricks=[];","+let simTime=0, state=\"ready\", slowMo=false;","+let impactPeakN=0, carCrush=0, carHasHit=false, settleTimer=0, shake=0;","+let particles=[], skidMarks=[], wheelAngle=0;","+const WALL_X=14.5, CAR_START_X=3.4;","+","+function makeBody(x,y,w,h,mass,fric,rest,type){","+  const I = mass*(w*w+h*h)/12;","+  return {x,y,vx:0,vy:0,a:0,w:0,hw:w/2,hh:h/2,mass,invM:mass>0?1/mass:0,","+    I,invI:I>0?1/I:0,fric,rest,type,asleep:false,sleepT:0,shade:0,layer:0,","+    verts:[{x:0,y:0},{x:0,y:0},{x:0,y:0},{x:0,y:0}], minX:0,maxX:0,minY:0,maxY:0};","+}","+function updateVerts(b){","+  const c=Math.cos(b.a), s=Math.sin(b.a), hw=b.hw, hh=b.hh;","+  const lx=[-hw,hw,hw,-hw], ly=[-hh,-hh,hh,hh];","+  b.minX=1e9;b.maxX=-1e9;b.minY=1e9;b.maxY=-1e9;","+  for(let i=0;i<4;i++){","+    const vx=b.x+lx[i]*c-ly[i]*s, vy=b.y+lx[i]*s+ly[i]*c;","+    b.verts[i].x=vx; b.verts[i].y=vy;","+    if(vx<b.minX)b.minX=vx; if(vx>b.maxX)b.maxX=vx;","+    if(vy<b.minY)b.minY=vy; if(vy>b.maxY)b.maxY=vy;","+  }","+  b.ax=c; b.ay=s; b.bx=-s; b.by=c; // local axes in world space","+}","+function wake(b){ if(b.asleep){ b.asleep=false; b.sleepT=0; } }","+function pointInBody(b,px,py,pad){","+  const dx=px-b.x, dy=py-b.y;","+  const lx= dx*b.ax+dy*b.ay, ly=dx*b.bx+dy*b.by;","+  return Math.abs(lx)<=b.hw+pad && Math.abs(ly)<=b.hh+pad;","+}","+/* SAT test. Returns {nx,ny,pen,pts:[{x,y}..]} or null. Normal points a->b. */","+function collideOBB(a,b){","+  const axes=[[a.ax,a.ay],[a.bx,a.by],[b.ax,b.ay],[b.bx,b.by]];","+  let minPen=Infinity, mnx=0, mny=0;","+  const dx=b.x-a.x, dy=b.y-a.y;","+  for(let k=0;k<4;k++){","+    const ux=axes[k][0], uy=axes[k][1];","+    const ra=Math.abs(a.hw*(ux*a.ax+uy*a.ay))+Math.abs(a.hh*(ux*a.bx+uy*a.by));","+    const rb=Math.abs(b.hw*(ux*b.ax+uy*b.ay))+Math.abs(b.hh*(ux*b.bx+uy*b.by));","+    const dist=dx*ux+dy*uy, overlap=ra+rb-Math.abs(dist);","+    if(overlap<0) return null;","+    if(overlap<minPen){ minPen=overlap; const s=dist<0?-1:1; mnx=ux*s; mny=uy*s; }","+  }","+  // Contact points: vertices of either body inside the other.","+  const pts=[];","+  for(const v of a.verts) if(pointInBody(b,v.x,v.y,0.004)) pts.push({x:v.x,y:v.y});","+  for(const v of b.verts) if(pointInBody(a,v.x,v.y,0.004)) pts.push({x:v.x,y:v.y});","+  if(pts.length===0) pts.push({x:(a.x+b.x)/2, y:(a.y+b.y)/2});","+  // Keep at most the two most separated points (stable face contacts).","+  let use=pts;","+  if(pts.length>2){","+    let best=-1, bi=0, bj=1;","+    for(let i=0;i<pts.length;i++) for(let j=i+1;j<pts.length;j++){","+      const d=(pts[i].x-pts[j].x)**2+(pts[i].y-pts[j].y)**2;","+      if(d>best){best=d;bi=i;bj=j;}","+    }","+    use=[pts[bi],pts[bj]];","+  }","+  return {nx:mnx, ny:mny, pen:minPen, pts:use};","+}","+function relVelAt(b,px,py,out){","+  const rx=px-b.x, ry=py-b.y;","+  out.x=b.vx - b.w*ry; out.y=b.vy + b.w*rx; out.rx=rx; out.ry=ry;","+}","+const _va={x:0,y:0,rx:0,ry:0}, _vb={x:0,y:0,rx:0,ry:0};","+function applyImpulse(b,jx,jy,px,py){","+  if(b.asleep) return;","+  b.vx+=jx*b.invM; b.vy+=jy*b.invM;","+  b.w += ((px-b.x)*jy-(py-b.y)*jx)*b.invI;","+}","+/* Resolve one contact point. b may be null (ground). Returns normal impulse magnitude. */","+function resolvePoint(a,b,px,py,nx,ny,rest,mu,dt){","+  relVelAt(a,px,py,_va);","+  let rvx=-_va.x, rvy=-_va.y, invMb=0, invIb=0, rbx=0, rby=0;","+  if(b){ relVelAt(b,px,py,_vb); rvx=_vb.x-_va.x; rvy=_vb.y-_va.y;","+    invMb=b.asleep?0:b.invM; invIb=b.asleep?0:b.invI; rbx=_vb.rx; rby=_vb.ry; }","+  const invMa=a.asleep?0:a.invM, invIa=a.asleep?0:a.invI;","+  const vn=rvx*nx+rvy*ny;","+  let jn=0;","+  if(vn<0){","+    const raCn=_va.rx*ny-_va.ry*nx, rbCn=rbx*ny-rby*nx;","+    const eff=invMa+invMb+raCn*raCn*invIa+rbCn*rbCn*invIb;","+    if(eff>0){","+      const e = vn<-0.8 ? rest : 0;","+      jn=-(1+e)*vn/eff;","+      applyImpulse(a,-jn*nx,-jn*ny,px,py);","+      if(b) applyImpulse(b, jn*nx, jn*ny,px,py);","+      // Friction (recompute relative velocity after normal impulse).","+      relVelAt(a,px,py,_va);","+      if(b){ relVelAt(b,px,py,_vb); rvx=_vb.x-_va.x; rvy=_vb.y-_va.y; }","+      else { rvx=-_va.x; rvy=-_va.y; }","+      const tx=-ny, ty=nx, vt=rvx*tx+rvy*ty;","+      const raCt=_va.rx*ty-_va.ry*tx, rbCt=rbx*ty-rby*tx;","+      const effT=invMa+invMb+raCt*raCt*invIa+rbCt*rbCt*invIb;","+      if(effT>0){","+        let jt=-vt/effT; const maxF=mu*jn;","+        jt=clamp(jt,-maxF,maxF);","+        applyImpulse(a,-jt*tx,-jt*ty,px,py);","+        if(b) applyImpulse(b, jt*tx, jt*ty,px,py);","+      }","+    }","+  }","+  return jn;","+}","+function positional(a,b,nx,ny,pen){","+  const slop=0.0015, percent=0.65;","+  const invMa=a.asleep?0:a.invM, invMb=b?(b.asleep?0:b.invM):0;","+  const sum=invMa+invMb; if(sum<=0) return;","+  const corr=Math.max(pen-slop,0)*percent/sum;","+  a.x-=nx*corr*invMa; a.y-=ny*corr*invMa;","+  if(b){ b.x+=nx*corr*invMb; b.y+=ny*corr*invMb; }","+}","+</script>","+</body>","+</html>"]}]}]}