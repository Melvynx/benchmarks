{"files":[{"path":"/private/var/folders/7z/5mtgxwxx4zs9ppgzm942gbmh0000gn/T/workspace.sk3GiV/app/index.html","hunks":[{"oldStart":481,"oldLines":6,"newStart":481,"newLines":277,"lines":["     \" m into the wall line · final car speed \"+Math.hypot(car.vx,car.vy).toFixed(1)+\" m/s\";","   v.style.display=\"block\";"," }","+/* ============================================================","+   Rendering — world in meters, y=0 is the ground.","+   Render scale is capped at the mandated 80 px/m and shrinks","+   only as needed to fit the track in the window.","+   ============================================================ */","+const cv=document.getElementById(\"cv\"), ctx=cv.getContext(\"2d\");","+let viewW=0, viewH=0, dpr=1;","+function resize(){","+  const r=cv.parentElement.getBoundingClientRect();","+  dpr=Math.min(window.devicePixelRatio||1,2);","+  viewW=Math.max(320,r.width); viewH=Math.max(240,r.height);","+  cv.width=Math.round(viewW*dpr); cv.height=Math.round(viewH*dpr);","+}","+window.addEventListener(\"resize\",resize);","+function worldWidth(){","+  const wallRight=WALL_X + settings.wallCols*FIXED.brickW + settings.wallLayers*0.3 + 3.2;","+  return Math.max(24, wallRight);","+}","+function renderScale(){","+  const needH=Math.max(7.5, settings.wallRows*FIXED.brickH+3.4);","+  return Math.min(FIXED.scale, viewW/worldWidth(), viewH/needH);","+}","+function drawBackground(S,groundY){","+  const g=ctx.createLinearGradient(0,0,0,groundY);","+  g.addColorStop(0,\"#2a3342\"); g.addColorStop(0.65,\"#3d4a5e\"); g.addColorStop(1,\"#55647a\");","+  ctx.fillStyle=g; ctx.fillRect(0,0,viewW,groundY);","+  // Distant test-hall posts and horizon band.","+  ctx.fillStyle=\"rgba(20,26,36,0.35)\";","+  const span=worldWidth();","+  for(let x=0;x<span;x+=4){ ctx.fillRect(x*S-3, groundY-4.6*S, 6, 4.6*S); }","+  ctx.fillRect(0,groundY-4.6*S,viewW,5);","+  ctx.fillStyle=\"rgba(255,255,255,0.07)\";","+  ctx.fillRect(0,groundY-1.1*S,viewW,1.1*S);","+}","+function drawGround(S,groundY){","+  ctx.fillStyle=\"#3a3f47\"; ctx.fillRect(0,groundY,viewW,viewH-groundY);","+  ctx.fillStyle=\"#4a505b\"; ctx.fillRect(0,groundY,viewW,Math.max(3,0.06*S));","+  // Lane line + 1 m ruler ticks with labels every 5 m.","+  ctx.strokeStyle=\"rgba(255,255,255,0.5)\"; ctx.lineWidth=2; ctx.setLineDash([14,12]);","+  ctx.beginPath(); ctx.moveTo(0,groundY+0.55*S); ctx.lineTo(viewW,groundY+0.55*S); ctx.stroke();","+  ctx.setLineDash([]);","+  ctx.font=(0.17*S)+\"px \"+getMono(); ctx.textAlign=\"center\";","+  const span=worldWidth();","+  for(let m=0;m<=span;m++){","+    const x=m*S, tall=m%5===0;","+    ctx.strokeStyle=\"rgba(255,255,255,\"+(tall?0.55:0.25)+\")\"; ctx.lineWidth=1;","+    ctx.beginPath(); ctx.moveTo(x,groundY+2); ctx.lineTo(x,groundY+(tall?0.22:0.12)*S); ctx.stroke();","+    if(tall){ ctx.fillStyle=\"rgba(255,255,255,0.55)\"; ctx.fillText(m+\" m\",x,groundY+0.42*S); }","+  }","+  // Wall datum line.","+  ctx.strokeStyle=\"rgba(232,161,58,0.65)\"; ctx.lineWidth=2; ctx.setLineDash([6,6]);","+  ctx.beginPath(); ctx.moveTo(WALL_X*S,groundY); ctx.lineTo(WALL_X*S,groundY-(settings.wallRows*FIXED.brickH+0.7)*S); ctx.stroke();","+  ctx.setLineDash([]);","+  ctx.fillStyle=\"rgba(232,161,58,0.9)\"; ctx.font=(0.18*S)+\"px \"+getMono(); ctx.textAlign=\"left\";","+  ctx.fillText(\"wall line\",WALL_X*S+6,groundY-(settings.wallRows*FIXED.brickH+0.55)*S);","+  // Skid marks.","+  ctx.fillStyle=\"rgba(12,12,14,0.55)\";","+  for(const s of skidMarks) ctx.fillRect(s.x*S-0.09*S, groundY+1, 0.18*S, Math.max(2,0.045*S));","+}","+function getMono(){ return 'ui-monospace,Menlo,Consolas,monospace'; }","+function drawBrick(b,S,groundY){","+  const depthDim=1-b.layer*0.13;","+  const l=clamp((34+b.shade*14)*depthDim,14,52);","+  ctx.save();","+  ctx.translate(b.x*S, groundY-b.y*S); ctx.rotate(-b.a);","+  const w=b.hw*2*S, h=b.hh*2*S;","+  ctx.fillStyle=\"hsl(14,52%,\"+l+\"%)\";","+  ctx.strokeStyle=\"rgba(30,16,10,0.85)\"; ctx.lineWidth=Math.max(1,0.02*S);","+  ctx.beginPath(); ctx.rect(-w/2,-h/2,w,h); ctx.fill(); ctx.stroke();","+  ctx.fillStyle=\"rgba(255,235,210,0.13)\"; ctx.fillRect(-w/2,-h/2,w,h*0.28);","+  ctx.fillStyle=\"rgba(0,0,0,0.16)\"; ctx.fillRect(-w/2,h*0.22,w,h*0.28);","+  // Two frog holes, subtle.","+  ctx.fillStyle=\"rgba(0,0,0,0.18)\";","+  ctx.beginPath(); ctx.arc(-w*0.22,0,Math.max(1.2,0.028*S),0,7); ctx.arc(w*0.22,0,Math.max(1.2,0.028*S),0,7); ctx.fill();","+  ctx.restore();","+}","+function drawCar(S,groundY){","+  const b=car; if(!b) return;","+  ctx.save();","+  ctx.translate(b.x*S, groundY-b.y*S); ctx.rotate(-b.a);","+  const W=FIXED.carW*S, H=FIXED.carH*S, crush=carCrush*W*0.55;","+  const front=W/2-crush, rear=-W/2, base=H/2, belt=-H*0.02, roof=-H/2;","+  // Shadow of cabin/body outline: sedan silhouette, nose to the right.","+  ctx.beginPath();","+  ctx.moveTo(rear, base-0.28*S);","+  ctx.lineTo(rear+0.06*S, belt-0.10*S);","+  ctx.lineTo(-W*0.18, belt-0.10*S);","+  ctx.lineTo(-W*0.02, roof+0.10*S);          // rear glass up to roof","+  ctx.lineTo( W*0.20, roof+0.08*S);","+  ctx.lineTo( W*0.34, belt-0.06*S);          // windscreen down","+  ctx.lineTo(front-0.08*S, belt+0.02*S);     // bonnet","+  ctx.quadraticCurveTo(front, belt+0.10*S, front, base-0.30*S);","+  ctx.lineTo(front, base-0.28*S);","+  ctx.lineTo(rear, base-0.28*S);","+  ctx.closePath();","+  const paint=ctx.createLinearGradient(0,roof,0,base);","+  paint.addColorStop(0,\"#4f7fb8\"); paint.addColorStop(0.55,\"#35619c\"); paint.addColorStop(1,\"#274a7c\");","+  ctx.fillStyle=paint; ctx.fill();","+  ctx.strokeStyle=\"rgba(8,14,24,0.9)\"; ctx.lineWidth=Math.max(1.2,0.025*S); ctx.stroke();","+  // Crumple creases on the nose after impact.","+  if(carCrush>0.02){","+    ctx.strokeStyle=\"rgba(10,16,26,0.65)\"; ctx.lineWidth=Math.max(1,0.02*S);","+    for(let i=0;i<4;i++){","+      const x=front-(0.10+i*0.14)*S*(1+carCrush*2);","+      ctx.beginPath(); ctx.moveTo(x,belt+0.02*S); ctx.lineTo(x-0.06*S,base-0.32*S); ctx.stroke();","+    }","+  }","+  // Glasshouse.","+  ctx.beginPath();","+  ctx.moveTo(-W*0.15,belt-0.12*S); ctx.lineTo(-W*0.01,roof+0.16*S);","+  ctx.lineTo(W*0.18,roof+0.14*S); ctx.lineTo(W*0.30,belt-0.10*S); ctx.closePath();","+  ctx.fillStyle=\"#b9d2e8\"; ctx.fill();","+  ctx.strokeStyle=\"#20344d\"; ctx.lineWidth=Math.max(2,0.045*S);","+  ctx.beginPath(); ctx.moveTo(W*0.07,roof+0.14*S); ctx.lineTo(W*0.07,belt-0.11*S); ctx.stroke();","+  // Door shut-lines, handle, lights.","+  ctx.strokeStyle=\"rgba(10,18,30,0.55)\"; ctx.lineWidth=Math.max(1,0.018*S);","+  ctx.strokeRect(-W*0.16,belt-0.08*S,W*0.20,0.62*S);","+  ctx.fillStyle=\"#f5d67a\"; ctx.fillRect(front-0.14*S,belt+0.08*S,0.12*S,0.13*S);","+  ctx.fillStyle=\"#c23b2e\"; ctx.fillRect(rear+0.02*S,belt+0.08*S,0.09*S,0.13*S);","+  ctx.fillStyle=\"rgba(255,255,255,0.20)\"; ctx.fillRect(rear,belt-0.02*S,front-rear,0.07*S);","+  // Wheels.","+  const wr=0.33*S, wy=base-wr+0.02*S;","+  for(const wx of [-W*0.32, W*0.32-crush*0.35]){","+    ctx.fillStyle=\"#14161a\"; ctx.beginPath(); ctx.arc(wx,wy,wr,0,7); ctx.fill();","+    ctx.fillStyle=\"#9aa3ad\"; ctx.beginPath(); ctx.arc(wx,wy,wr*0.52,0,7); ctx.fill();","+    ctx.strokeStyle=\"#3c424b\"; ctx.lineWidth=Math.max(1.5,0.03*S);","+    for(let k=0;k<5;k++){","+      const a=wheelAngle+k*Math.PI*2/5;","+      ctx.beginPath(); ctx.moveTo(wx,wy);","+      ctx.lineTo(wx+Math.cos(a)*wr*0.5, wy+Math.sin(a)*wr*0.5); ctx.stroke();","+    }","+  }","+  // Motion streaks while launching.","+  if(state===\"running\" && !carHasHit && Math.abs(b.vx)>6){","+    ctx.strokeStyle=\"rgba(255,255,255,0.35)\"; ctx.lineWidth=Math.max(1,0.025*S);","+    for(const off of [-0.30,0.05,0.38]){","+      ctx.beginPath(); ctx.moveTo(rear-0.15*S, off*S);","+      ctx.lineTo(rear-(0.55+Math.abs(b.vx)*0.02)*S, off*S); ctx.stroke();","+    }","+  }","+  ctx.restore();","+}","+function draw(){","+  ctx.setTransform(dpr,0,0,dpr,0,0);","+  const S=renderScale();","+  const groundY=viewH-1.15*S;","+  ctx.save();","+  if(shake>0.004){","+    const t=performance.now()*0.09;","+    ctx.translate(Math.sin(t*1.7)*shake*S, Math.cos(t*2.3)*shake*S*0.7);","+  }","+  drawBackground(S,groundY);","+  drawGround(S,groundY);","+  // Back depth layers first so the front face reads clearly.","+  const sorted=bricks.slice().sort((p,q)=>q.layer-p.layer);","+  for(const b of sorted) drawBrick(b,S,groundY);","+  drawCar(S,groundY);","+  // Dust.","+  for(const p of particles){","+    const k=1-p.age/p.life;","+    ctx.fillStyle=\"rgba(196,178,150,\"+(0.34*k)+\")\";","+    ctx.beginPath(); ctx.arc(p.x*S,groundY-p.y*S,p.r*S*(1.6-k*0.6),0,7); ctx.fill();","+  }","+  ctx.restore();","+  // Scale caption.","+  ctx.fillStyle=\"rgba(255,255,255,0.55)\";","+  ctx.font=\"11px \"+getMono(); ctx.textAlign=\"right\";","+  ctx.fillText(S.toFixed(0)+\" px/m · \"+bodies.length+\" bodies\", viewW-10, viewH-8);","+}","+","+/* ============================================================","+   Main loop — fixed-step physics (240 Hz substeps) so fast","+   impacts cannot tunnel through a 0.50 m brick.","+   ============================================================ */","+let lastTs=0, accumulator=0;","+const STEP=1/240;","+function frame(ts){","+  requestAnimationFrame(frame);","+  if(!lastTs) lastTs=ts;","+  let dt=Math.min((ts-lastTs)/1000, 0.05); lastTs=ts;","+  if(slowMo) dt*=0.22;","+  if(state===\"running\"){","+    accumulator+=dt;","+    let n=0;","+    while(accumulator>=STEP && n<40){ stepPhysics(STEP); accumulator-=STEP; n++; }","+    if(n>=40) accumulator=0;","+    updateHud();","+  }","+  draw();","+}","+","+/* ============================================================","+   UI wiring","+   ============================================================ */","+const $=id=>document.getElementById(id);","+function setStatus(txt,cls){ const p=$(\"statusPill\"); p.textContent=txt; p.className=cls||\"\"; p.id=\"statusPill\"; }","+function movingBrickCount(){","+  let n=0; for(const b of bricks) if(!b.asleep && Math.hypot(b.vx,b.vy)>0.08) n++;","+  return n;","+}","+function updateHud(){","+  if(!car) return;","+  const sp=Math.hypot(car.vx,car.vy);","+  $(\"hudSpeed\").textContent=sp.toFixed(1)+\" m/s (\"+(sp*3.6).toFixed(0)+\" km/h)\";","+  $(\"hudTime\").textContent=simTime.toFixed(2)+\" s\";","+  $(\"hudMoving\").textContent=movingBrickCount()+\" / \"+bricks.length;","+  $(\"hudMom\").textContent=Math.round(FIXED.carMass*sp).toLocaleString(\"en-GB\")+\" kg·m/s\";","+  $(\"hudPeak\").textContent=(impactPeakN/1000).toFixed(0)+\" kN\";","+}","+const ctlRefs={};","+function buildControls(){","+  const host=$(\"controls\"); host.innerHTML=\"\";","+  for(const key of Object.keys(RANGES)){","+    const r=RANGES[key];","+    const div=document.createElement(\"div\"); div.className=\"ctl\";","+    div.innerHTML=","+      '<div class=\"row\"><label for=\"rng-'+key+'\">'+r.label+' <span class=\"unit\">'+r.unit+'</span></label>'+","+      '<output id=\"out-'+key+'\"></output></div>'+","+      '<input type=\"range\" id=\"rng-'+key+'\" min=\"'+r.min+'\" max=\"'+r.max+'\" step=\"'+r.step+'\">'+","+      '<div class=\"row\"><span class=\"range\" style=\"flex:1\"><span>'+r.min+'</span><span>'+r.max+'</span></span>'+","+      '<input type=\"number\" id=\"num-'+key+'\" min=\"'+r.min+'\" max=\"'+r.max+'\" step=\"'+r.step+'\" aria-label=\"'+r.label+' value\"></div>';","+    host.appendChild(div);","+    const rng=div.querySelector(\"#rng-\"+key), num=div.querySelector(\"#num-\"+key), out=div.querySelector(\"#out-\"+key);","+    ctlRefs[key]={rng,num,out};","+    const apply=(raw)=>{","+      let v=clamp(parseFloat(raw), r.min, r.max);","+      if(!isFinite(v)) return;","+      if(r.step>=1) v=Math.round(v);","+      settings[key]=v;","+      rng.value=v; num.value=v; out.textContent=r.fmt(v)+\" \"+r.unit.split(\" \")[0];","+      buildScene(); // rebuild preview with this change only","+    };","+    rng.addEventListener(\"input\",()=>apply(rng.value));","+    num.addEventListener(\"change\",()=>apply(num.value));","+  }","+  syncControls();","+}","+function syncControls(){","+  for(const key of Object.keys(RANGES)){","+    const r=RANGES[key], c=ctlRefs[key]; if(!c) continue;","+    c.rng.value=settings[key]; c.num.value=settings[key];","+    c.out.textContent=r.fmt(settings[key])+\" \"+r.unit.split(\" \")[0];","+  }","+}","+$(\"fixedParams\").innerHTML=","+  \"Fixed baseline parameters<br>\"+","+  \"brick size <b>0.50 × 0.24 m</b> · gravity <b>9.81 m/s²</b><br>\"+","+  \"brick friction <b>0.72</b> · restitution <b>0.18</b><br>\"+","+  \"car <b>1,250 kg</b> · <b>4.2 × 1.45 m</b><br>\"+","+  \"ground friction <b>0.85</b> · scale <b>80 px/m</b> (max)\";","+$(\"testBtn\").addEventListener(\"click\",launch);","+$(\"resetBtn\").addEventListener(\"click\",()=>buildScene());","+$(\"defaultsBtn\").addEventListener(\"click\",()=>{","+  Object.assign(settings,DEFAULTS); syncControls(); buildScene();","+});","+$(\"slowBtn\").addEventListener(\"click\",e=>{","+  slowMo=!slowMo;","+  e.currentTarget.setAttribute(\"aria-pressed\",String(slowMo));","+  e.currentTarget.textContent=slowMo?\"Normal speed\":\"Slow motion\";","+});","+window.addEventListener(\"keydown\",e=>{","+  if(e.target.tagName===\"INPUT\") return;","+  if(e.code===\"Space\"||e.code===\"Enter\"){ e.preventDefault(); launch(); }","+  if(e.key===\"r\"||e.key===\"R\") buildScene();","+});","+","+/* Boot: show the default car and wall before any test. */","+resize();","+buildControls();","+buildScene();","+requestAnimationFrame(frame);"," </script>"," </body>"," </html>"]}]}]}