{"files":[{"path":"/private/var/folders/7z/5mtgxwxx4zs9ppgzm942gbmh0000gn/T/workspace.sk3GiV/app/index.html","hunks":[{"oldStart":253,"oldLines":6,"newStart":253,"newLines":234,"lines":["   a.x-=nx*corr*invMa; a.y-=ny*corr*invMa;","   if(b){ b.x+=nx*corr*invMb; b.y+=ny*corr*invMb; }"," }","+/* ============================================================","+   Scene construction","+   ============================================================ */","+function buildScene(){","+  bodies=[]; bricks=[]; particles=[]; skidMarks=[];","+  simTime=0; impactPeakN=0; carCrush=0; carHasHit=false; settleTimer=0; shake=0; wheelAngle=0;","+  fxRng=mulberry32(1234567);","+  state=\"ready\";","+  // Car: single rigid body; wheels/suspension are visual. Rolling resistance","+  // is modelled with low ground friction until impact (then tyres skid).","+  car=makeBody(CAR_START_X, FIXED.carH/2+0.02, FIXED.carW, FIXED.carH,","+    FIXED.carMass, 0.04, 0.05, \"car\");","+  car.asleep=true;","+  bodies.push(car);","+  // Bricks: staggered courses; depth layers staggered by half a brick and","+  // nudged in +x so the wall is genuinely thicker in the impact direction.","+  const bw=FIXED.brickW, bh=FIXED.brickH, gap=0.002;","+  const cols=settings.wallCols|0, rows=settings.wallRows|0, layers=settings.wallLayers|0;","+  for(let layer=layers-1; layer>=0; layer--){","+    const layerOff=(layer%2)*(bw/2) + layer*0.055;","+    for(let r=0;r<rows;r++){","+      const rowOff=(r%2)*(bw/2);","+      for(let c=0;c<cols;c++){","+        const x=WALL_X + bw/2 + c*(bw+gap) + rowOff + layerOff;","+        const y=bh/2 + r*(bh+gap);","+        const b=makeBody(x,y,bw,bh,settings.brickMass,","+          FIXED.brickFriction, FIXED.brickRestitution, \"brick\");","+        b.layer=layer;","+        // Deterministic per-brick tint from index hash (visual only).","+        const h=Math.imul((c*73856093)^(r*19349663)^(layer*83492791),2654435761)>>>0;","+        b.shade=(h%100)/100;","+        b.asleep=true; // perfectly stacked wall starts at rest","+        bricks.push(b); bodies.push(b);","+      }","+    }","+  }","+  for(const b of bodies) updateVerts(b);","+  updateHud(); setStatus(\"READY\",\"\");","+  document.getElementById(\"verdict\").style.display=\"none\";","+}","+function launch(){","+  buildScene();","+  wake(car);","+  car.vx=settings.carSpeed; car.vy=0;","+  state=\"running\";","+  setStatus(\"RUNNING\",\"running\");","+}","+","+/* ============================================================","+   Solver step (fixed dt). Broadphase: uniform grid.","+   Sleeping bodies act as static until woken by a real impact","+   or by losing the support underneath them.","+   ============================================================ */","+const CELL=0.65;","+function buildGrid(){","+  const grid=new Map();","+  for(let i=0;i<bodies.length;i++){","+    const b=bodies[i];","+    const x0=Math.floor(b.minX/CELL), x1=Math.floor(b.maxX/CELL);","+    const y0=Math.floor(b.minY/CELL), y1=Math.floor(b.maxY/CELL);","+    for(let gx=x0;gx<=x1;gx++) for(let gy=y0;gy<=y1;gy++){","+      const key=gx*4096+gy+2048;","+      let arr=grid.get(key); if(!arr){arr=[];grid.set(key,arr);}","+      arr.push(i);","+    }","+  }","+  return grid;","+}","+function candidatePairs(grid){","+  const seen=new Set(), pairs=[];","+  for(const arr of grid.values()){","+    for(let i=0;i<arr.length;i++) for(let j=i+1;j<arr.length;j++){","+      const a=Math.min(arr[i],arr[j]), b=Math.max(arr[i],arr[j]);","+      const key=a*100000+b;","+      if(seen.has(key)) continue; seen.add(key);","+      const A=bodies[a], B=bodies[b];","+      if(A.asleep && B.asleep) continue;","+      if(A.maxX<B.minX||B.maxX<A.minX||A.maxY<B.minY||B.maxY<A.minY) continue;","+      pairs.push([A,B]);","+    }","+  }","+  return pairs;","+}","+function spawnDust(x,y,n,spread){","+  for(let i=0;i<n;i++){","+    if(particles.length>420) return;","+    const a=fxRng()*Math.PI*2, sp=(0.4+fxRng()*1.6)*spread;","+    particles.push({x,y,vx:Math.cos(a)*sp,vy:Math.abs(Math.sin(a))*sp*0.8+0.4,","+      life:0.7+fxRng()*0.9,age:0,r:0.05+fxRng()*0.13});","+  }","+}","+function stepPhysics(dt){","+  simTime+=dt;","+  // Integrate forces + positions for awake bodies.","+  for(const b of bodies){","+    if(b.asleep) continue;","+    b.vy-=FIXED.gravity*dt;","+    // Mild angular/linear damping keeps debris settling stable.","+    b.vx*=Math.max(0,1-0.02*dt); b.vy*=Math.max(0,1-0.01*dt);","+    b.w *=Math.max(0,1-(b.type===\"car\"?2.2:0.25)*dt);","+    b.x+=b.vx*dt; b.y+=b.vy*dt; b.a+=b.w*dt;","+    if(b.a>Math.PI)b.a-=2*Math.PI; if(b.a<-Math.PI)b.a+=2*Math.PI;","+  }","+  for(const b of bodies) updateVerts(b);","+  const pairs=candidatePairs(buildGrid());","+  const contacts=[];","+  for(const [A,B] of pairs){","+    const hit=collideOBB(A,B);","+    if(hit) contacts.push({A,B,hit});","+  }","+  // Sequential impulse iterations.","+  let stepImpulse=0;","+  for(let iter=0;iter<8;iter++){","+    for(const c of contacts){","+      const {A,B,hit}=c;","+      // Wake a sleeping body struck by a moving one.","+      const relSpeed=Math.hypot(B.vx-A.vx,B.vy-A.vy);","+      if((A.asleep||B.asleep) && (relSpeed>0.25 || A.type===\"car\" || B.type===\"car\")){","+        if(relSpeed>0.25 || Math.hypot(car.vx,car.vy)>0.5){ wake(A); wake(B); }","+      }","+      const mu=Math.sqrt(A.fric*B.fric);","+      const rest=Math.min(A.rest,B.rest);","+      for(const p of hit.pts){","+        const jn=resolvePoint(A,B,p.x,p.y,hit.nx,hit.ny,rest,mu,dt);","+        if(iter===0) stepImpulse+=jn;","+        if(iter===0 && jn>0 && (A.type===\"car\"||B.type===\"car\")){","+          carHasHit=true;","+          car.fric=FIXED.groundFriction; // tyres now skid against ground contact","+          const other=A.type===\"car\"?B:A;","+          wake(other);","+          if(jn>900){ spawnDust(p.x,Math.max(p.y,0.15),3,1); shake=Math.min(0.35,shake+jn/45000); }","+          carCrush=clamp(carCrush+jn/260000,0,0.42);","+        }","+      }","+    }","+    // Ground contacts (each penetrating vertex).","+    for(const b of bodies){","+      if(b.asleep) continue;","+      const mu=b.type===\"car\" && !carHasHit ? 0.04 : Math.sqrt(b.fric*FIXED.groundFriction);","+      for(const v of b.verts){","+        if(v.y<0){","+          const jn=resolvePoint(b,null,v.x,0,0,1,b.rest,mu,dt);","+          if(iter===0 && jn>2600 && b.type===\"brick\") spawnDust(v.x,0.06,1,0.5);","+        }","+      }","+    }","+  }","+  // Positional de-overlap.","+  for(const c of contacts) positional(c.A,c.B,c.hit.nx,c.hit.ny,c.hit.pen);","+  for(const b of bodies){","+    if(b.asleep) continue;","+    updateVerts(b);","+    if(b.minY<0) b.y-=b.minY; // lift out of ground plane","+    updateVerts(b);","+  }","+  // Impact force estimate for telemetry (impulse / dt).","+  if(stepImpulse>0) impactPeakN=Math.max(impactPeakN, stepImpulse/dt);","+  // Car wheel spin + skid marks after impact.","+  wheelAngle+=car.vx*dt/0.33;","+  if(carHasHit && Math.abs(car.vx)>1.2 && car.minY<0.08){","+    skidMarks.push({x:car.x-1.35,y:0},{x:car.x+1.35,y:0});","+    if(skidMarks.length>900) skidMarks.splice(0,2);","+  }","+  // Sleep bookkeeping + support check for sleeping bricks.","+  for(const b of bodies){","+    if(b.type===\"car\") continue;","+    if(!b.asleep){","+      const sp=Math.hypot(b.vx,b.vy);","+      if(sp<0.07 && Math.abs(b.w)<0.09 && b.minY<3){","+        b.sleepT+=dt;","+        if(b.sleepT>0.55){ b.asleep=true; b.vx=b.vy=b.w=0; }","+      } else b.sleepT=0;","+    }","+  }","+  supportCheckTick=(supportCheckTick+1)%6;","+  if(supportCheckTick===0) wakeUnsupported();","+  // Settled detection.","+  if(state===\"running\"){","+    let maxSp=Math.hypot(car.vx,car.vy);","+    for(const b of bricks) if(!b.asleep) maxSp=Math.max(maxSp,Math.hypot(b.vx,b.vy));","+    if(carHasHit && maxSp<0.12){ settleTimer+=dt; if(settleTimer>0.9) finish(); }","+    else settleTimer=0;","+    if(simTime>40) finish();","+  }","+  // Dust particles (visual only).","+  for(let i=particles.length-1;i>=0;i--){","+    const p=particles[i]; p.age+=dt;","+    if(p.age>p.life){ particles.splice(i,1); continue; }","+    p.vy-=1.1*dt; p.vx*=Math.max(0,1-1.6*dt);","+    p.x+=p.vx*dt; p.y=Math.max(0.03,p.y+p.vy*dt);","+  }","+  shake*=Math.max(0,1-5.5*dt);","+}","+let supportCheckTick=0;","+function wakeUnsupported(){","+  for(const b of bricks){","+    if(!b.asleep) continue;","+    if(b.minY<0.03) continue; // resting on ground","+    // Sample just below both bottom corners.","+    let supported=false;","+    const probes=[{x:b.x-b.hw*0.7,y:b.minY-0.03},{x:b.x+b.hw*0.7,y:b.minY-0.03}];","+    for(const p of probes){","+      for(const o of bodies){","+        if(o===b) continue;","+        if(p.x>o.minX-0.02&&p.x<o.maxX+0.02&&p.y>o.minY-0.02&&p.y<o.maxY+0.05){ supported=true; break; }","+      }","+      if(supported) break;","+    }","+    if(!supported) wake(b);","+  }","+}","+function finish(){","+  if(state!==\"running\") return;","+  state=\"settled\";","+  setStatus(\"SETTLED\",\"done\");","+  // Outcome summary measured from the simulation, not scripted.","+  let fallen=0;","+  for(const b of bricks){","+    const tipped=Math.abs(Math.sin(b.a))>0.35;","+    if(tipped || b.y < (FIXED.brickH/2)+0.05 && b.x>WALL_X+ (settings.wallCols*FIXED.brickW)+1.2) fallen++;","+    else if(Math.abs(b.a)>0.6) fallen++;","+  }","+  const dist=Math.max(0,car.x+car.hw-WALL_X);","+  const v=document.getElementById(\"verdict\");","+  v.textContent=\"Settled in \"+simTime.toFixed(1)+\" s · car penetrated \"+dist.toFixed(1)+","+    \" m into the wall line · final car speed \"+Math.hypot(car.vx,car.vy).toFixed(1)+\" m/s\";","+  v.style.display=\"block\";","+}"," </script>"," </body>"," </html>"]}]}]}