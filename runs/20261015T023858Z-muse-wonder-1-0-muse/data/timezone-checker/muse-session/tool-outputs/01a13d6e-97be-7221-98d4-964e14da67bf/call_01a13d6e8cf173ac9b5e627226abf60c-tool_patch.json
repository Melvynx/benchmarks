{"files":[{"path":"/private/var/folders/7z/5mtgxwxx4zs9ppgzm942gbmh0000gn/T/workspace.kOEDqU/app/src/components/OverlapSummary.tsx","hunks":[{"oldStart":1,"oldLines":0,"newStart":1,"newLines":76,"lines":["+import type { City } from '../data/cities';","+import { formatRange, toRanges, type TimeFormat } from '../lib/time';","+","+export type Mode = 'meeting' | 'base';","+","+interface Props {","+  mode: Mode;","+  cities: City[];","+  meetingFlags: boolean[];","+  baseFlags: Map<string, boolean[]>;","+  format: TimeFormat;","+}","+","+function Ranges({ flags, format }: { flags: boolean[]; format: TimeFormat }) {","+  const ranges = toRanges(flags);","+  if (ranges.length === 0) return null;","+  return (","+    <span className=\"range-badges\">","+      {ranges.map((r) => (","+        <span key={r.start} className=\"range-badge\">{formatRange(r, format)}</span>","+      ))}","+    </span>","+  );","+}","+","+export default function OverlapSummary({ mode, cities, meetingFlags, baseFlags, format }: Props) {","+  if (cities.length < 2) {","+    return (","+      <section className=\"summary\" aria-live=\"polite\">","+        <p className=\"summary-line muted-line\">Add at least one more city to see overlap.</p>","+      </section>","+    );","+  }","+  const ref = cities[0];","+","+  if (mode === 'meeting') {","+    const count = meetingFlags.filter(Boolean).length;","+    return (","+      <section className=\"summary\" aria-live=\"polite\">","+        {count > 0 ? (","+          <p className=\"summary-line\">","+            <strong className=\"summary-count\">{count}h overlap</strong>","+            <span className=\"summary-detail\">when everyone is awake, in {ref.name} time:</span>","+            <Ranges flags={meetingFlags} format={format} />","+          </p>","+        ) : (","+          <p className=\"summary-line warning\">⚠ No common awake hours across all {cities.length} cities with this sleep schedule. Try widening the awake window.</p>","+        )}","+      </section>","+    );","+  }","+","+  return (","+    <section className=\"summary\" aria-live=\"polite\">","+      <ul className=\"summary-list\">","+        {cities.slice(1).map((city) => {","+          const flags = baseFlags.get(city.id) ?? [];","+          const count = flags.filter(Boolean).length;","+          return (","+            <li key={city.id} className=\"summary-line\">","+              <strong className=\"summary-city\">{ref.name} × {city.name}</strong>","+              {count > 0 ? (","+                <>","+                  <span className=\"summary-count\">{count}h overlap</span>","+                  <Ranges flags={flags} format={format} />","+                </>","+              ) : (","+                <span className=\"warning\">⚠ No overlap with {ref.name}</span>","+              )}","+            </li>","+          );","+        })}","+      </ul>","+    </section>","+  );","+}"]}]}]}