{"files":[{"path":"/private/var/folders/7z/5mtgxwxx4zs9ppgzm942gbmh0000gn/T/workspace.cOb1ar/app/index.html","hunks":[{"oldStart":262,"oldLines":6,"newStart":262,"newLines":127,"lines":["     idx++;","   }"," }","+","+/* ---------- car: separate rigid bodies + breakable lock joints ---------- */","+function buildCar(){","+  const L=S.carL,W=S.carW,H=S.carH,M=S.carMass;","+  const cm=physMats.car, gm=physMats.glass, wm=physMats.wheel;","+  const r=Math.min(0.34,H*0.24);               // wheel radius","+  const x0=carStartX;                           // car centre x","+  const lowerH=H*0.40, lowerY=r*0.55+lowerH/2;  // lower body","+  const cabH=H*0.36, cabY=lowerY+lowerH/2+cabH/2-0.03;","+  const parts={}; const reg=(name,body,kind)=>{body._kind=kind;body._name=name;carParts.push(body);parts[name]=body;return body;};","+","+  // main chassis / cabin lower (rear 62%)","+  const mainL=L*0.62, mainX=x0-L/2+mainL/2;","+  const main=reg('main',makeBody(M*0.42,mainL,lowerH,W*0.96,mainX,lowerY,0,cm),'chassis');","+  {const g=new THREE.Group();g.add(boxMesh(mainL,lowerH,W*0.96,MAT.paint));","+   const skirt=boxMesh(mainL*0.98,lowerH*0.35,W*0.9,MAT.paintDark);skirt.position.y=-lowerH*0.3;g.add(skirt);pair(main,g);}","+  // cabin top (roof frame)","+  const cabL=L*0.46,cabX=x0-L*0.06;","+  const cab=reg('cabin',makeBody(M*0.16,cabL,cabH,W*0.8,cabX,cabY,0,cm),'chassis');","+  {const g=new THREE.Group();g.add(boxMesh(cabL,cabH*0.42,W*0.8,MAT.paint));g.children[0].position.y=cabH*0.29;","+   const inner=boxMesh(cabL*0.94,cabH*0.6,W*0.74,MAT.interior);inner.position.y=-cabH*0.12;g.add(inner);pair(cab,g);}","+  lockJoint(main,cab,9,'structure');","+","+  // front clip in 3 crumple segments (engine, mid, nose) chained to main","+  const segL=[L*0.14,L*0.12,L*0.12]; let fx=x0-L/2+mainL; let prev=main; const segs=[];","+  const segNames=['engineBay','frontMid','nose'];","+  for(let i=0;i<3;i++){","+    const h=lowerH*(1-i*0.14), y=r*0.55+h/2+0.02, cx=fx+segL[i]/2;","+    const b=reg(segNames[i],makeBody(M*(0.09-i*0.015),segL[i],h,W*(0.94-i*0.03),cx,y,0,cm),'front');","+    {const g=new THREE.Group();g.add(boxMesh(segL[i],h,W*(0.94-i*0.03),MAT.paint));","+     if(i===2){ // grille + headlights on the nose","+       const gr=boxMesh(0.05,h*0.4,W*0.5,MAT.chrome);gr.position.set(segL[i]/2,0,0);g.add(gr);","+       for(const zz of [-W*0.32,W*0.32]){const hl=boxMesh(0.06,h*0.3,W*0.2,MAT.light);hl.position.set(segL[i]/2,h*0.12,zz);g.add(hl);}}","+     pair(b,g);}","+    lockJoint(prev,b,i===0?5.0:3.6,'front'); // front folds first","+    segs.push(b);prev=b;fx+=segL[i];","+  }","+  noseBody=segs[2];","+","+  // hood (on engine+mid) and trunk lid (rear of main)","+  const hood=reg('hood',makeBody(M*0.025,L*0.24,0.05,W*0.78,x0-L/2+mainL+L*0.13,lowerY+lowerH/2+0.05,0,cm),'panel');","+  pair(hood,boxMesh(L*0.24,0.05,W*0.78,MAT.paint)); lockJoint(segs[0],hood,3.2,'panel'); lockJoint(segs[1],hood,3.2,'panel');","+  const trunk=reg('trunk',makeBody(M*0.02,L*0.2,0.05,W*0.78,x0-L/2+L*0.11,lowerY+lowerH/2+0.05,0,cm),'panel');","+  pair(trunk,boxMesh(L*0.2,0.05,W*0.78,MAT.paint)); lockJoint(main,trunk,4.2,'panel');","+","+  // bumpers","+  const bf=reg('bumperF',makeBody(M*0.02,0.16,lowerH*0.55,W*0.98,x0+L/2+0.06,r*0.55+lowerH*0.3,0,cm),'panel');","+  pair(bf,boxMesh(0.16,lowerH*0.55,W*0.98,MAT.paintDark)); lockJoint(segs[2],bf,2.6,'panel');","+  const bb=reg('bumperR',makeBody(M*0.02,0.16,lowerH*0.55,W*0.98,x0-L/2-0.06,r*0.55+lowerH*0.3,0,cm),'panel');","+  {const g=new THREE.Group();g.add(boxMesh(0.16,lowerH*0.55,W*0.98,MAT.paintDark));","+   for(const zz of [-W*0.32,W*0.32]){const tl=boxMesh(0.05,lowerH*0.25,W*0.2,MAT.tail);tl.position.set(-0.09,lowerH*0.08,zz);g.add(tl);}pair(bb,g);}","+  lockJoint(main,bb,4.5,'panel');","+","+  // doors: front L/R, rear L/R","+  const doorH=lowerH+cabH*0.35, doorY=lowerY+doorH/2-lowerH/2;","+  const doorDefs=[['doorFL',x0+L*0.04,W/2+0.02],['doorFR',x0+L*0.04,-W/2-0.02],['doorRL',x0-L*0.17,W/2+0.02],['doorRR',x0-L*0.17,-W/2-0.02]];","+  for(const [nm,dx,dz] of doorDefs){","+    const b=reg(nm,makeBody(M*0.02,L*0.19,doorH,0.05,dx,doorY,dz,cm),'door');","+    {const g=new THREE.Group();g.add(boxMesh(L*0.19,doorH,0.05,MAT.paint));","+     const handle=boxMesh(0.14,0.03,0.03,MAT.chrome);handle.position.set(-L*0.05,doorH*0.08,dz>0?0.04:-0.04);g.add(handle);pair(b,g);}","+    lockJoint(main,b,4.6,'door'); lockJoint(cab,b,5.2,'door');","+  }","+","+  // windshield: 6 shard bodies forming a slanted pane, held by weak joints","+  const slant=0.62, q=new CANNON.Quaternion(); q.setFromAxisAngle(new CANNON.Vec3(0,0,1),slant);","+  const wsX=cabX+cabL/2-0.02, wsY=cabY+0.02;","+  const shardW=W*0.8/3, shardH=cabH*0.95/2;","+  const wsBodies=[];","+  for(let row=0;row<2;row++)for(let col=0;col<3;col++){","+    const off=new CANNON.Vec3(0,(row-0.5)*(shardH+0.005),0);","+    const rot=q.vmult(off);","+    const b=reg('ws'+row+col,makeBody(1.2,0.02,shardH,shardW-0.008,wsX+rot.x,wsY+rot.y,(col-1)*(shardW+0.004),gm,{quat:q}),'glass');","+    pair(b,boxMesh(0.02,shardH,shardW-0.008,MAT.shard));","+    lockJoint(cab,b,2.2,'glass'); wsBodies.push(b);","+  }","+  // rear glass: 4 shards","+  const q2=new CANNON.Quaternion(); q2.setFromAxisAngle(new CANNON.Vec3(0,0,1),-slant);","+  for(let row=0;row<2;row++)for(let col=0;col<2;col++){","+    const off=new CANNON.Vec3(0,(row-0.5)*(shardH+0.005),0); const rot=q2.vmult(off);","+    const b=reg('rg'+row+col,makeBody(1.0,0.02,shardH,W*0.36,cabX-cabL/2+0.02+rot.x,wsY+rot.y,(col-0.5)*(W*0.38),gm,{quat:q2}),'glass');","+    pair(b,boxMesh(0.02,shardH,W*0.36,MAT.shard)); lockJoint(cab,b,2.6,'glass');","+  }","+  // side glass: 2 shards per side on the cabin","+  for(const side of [1,-1])for(let i=0;i<2;i++){","+    const b=reg('sg'+side+i,makeBody(0.9,cabL*0.42,cabH*0.55,0.02,cabX+(i-0.5)*cabL*0.44,cabY,side*(W*0.41),gm),'glass');","+    pair(b,boxMesh(cabL*0.42,cabH*0.55,0.02,MAT.glass)); lockJoint(cab,b,2.8,'glass');","+  }","+","+  // wheels: cylinder bodies, locked until a hard hit tears them off, then they roll","+  const wheelGeoT=new THREE.CylinderGeometry(r,r,0.22,22), wheelGeoR=new THREE.CylinderGeometry(r*0.55,r*0.55,0.24,16);","+  const wheelPos=[[x0+L*0.31,W/2-0.08,segs[0]],[x0+L*0.31,-(W/2-0.08),segs[0]],[x0-L*0.32,W/2-0.08,main],[x0-L*0.32,-(W/2-0.08),main]];","+  wheelPos.forEach(([wx,wz,anchor],i)=>{","+    const shape=new CANNON.Cylinder(r,r,0.22,12);","+    const b=new CANNON.Body({mass:M*0.022,material:wm,position:new CANNON.Vec3(wx,r,wz),linearDamping:0.02,angularDamping:0.08,allowSleep:false});","+    const qq=new CANNON.Quaternion(); qq.setFromAxisAngle(new CANNON.Vec3(1,0,0),Math.PI/2);","+    b.addShape(shape,new CANNON.Vec3(),qq); world.addBody(b); reg('wheel'+i,b,'wheel');","+    const g=new THREE.Group();","+    const tire=new THREE.Mesh(wheelGeoT,MAT.tire);tire.rotation.x=Math.PI/2;tire.castShadow=true;tire.receiveShadow=true;g.add(tire);","+    const rim=new THREE.Mesh(wheelGeoR,MAT.rim);rim.rotation.x=Math.PI/2;rim.castShadow=true;g.add(rim);","+    pair(b,g); lockJoint(anchor,b,5.5,'wheel');","+  });","+","+  chassisBody=main;","+  // launch: every part shares the target velocity so the assembly drives as one","+  for(const b of carParts){b.velocity.set(S.speed,0,0);b.angularVelocity.set(0,0,0);}","+","+  // breakable joints: break on hard contact impulse (not on a timer)","+  for(const b of carParts){","+    b.addEventListener('collide',e=>{","+      const iv=Math.abs(e.contact.getImpactVelocityAlongNormal());","+      const other=e.body;","+      const isBrick=other.material===physMats.brick, isGround=other.material===physMats.ground;","+      if(isBrick)registerImpact(iv,e.target.position);","+      if(isGround&&iv<3)return; // rolling / settling contact never tears parts off","+      for(const j of joints){","+        if(j.broken)continue;","+        if((j.a===b||j.b===b)&&iv>j.threshold)breakJoint(j);","+      }","+    });","+  }","+}"," </script>"," </body>"," </html>"]}]}]}