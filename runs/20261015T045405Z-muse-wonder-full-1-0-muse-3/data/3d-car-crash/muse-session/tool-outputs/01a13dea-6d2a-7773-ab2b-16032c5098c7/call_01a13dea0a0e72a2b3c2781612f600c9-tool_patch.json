{"files":[{"path":"/private/var/folders/7z/5mtgxwxx4zs9ppgzm942gbmh0000gn/T/workspace.cOb1ar/app/index.html","hunks":[{"oldStart":1,"oldLines":0,"newStart":1,"newLines":135,"lines":["+<!DOCTYPE html>","+<html lang=\"en\">","+<head>","+<meta charset=\"utf-8\">","+<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">","+<title>muse-wonder-full-1.0</title>","+<style>","+  html,body{margin:0;padding:0;height:100%;overflow:hidden;background:#0b0e13;font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;color:#e8edf4}","+  #app{position:fixed;inset:0}","+  canvas{display:block}","+  .bar{position:fixed;left:50%;transform:translateX(-50%);bottom:14px;display:flex;gap:14px;align-items:center;flex-wrap:wrap;justify-content:center;","+    background:rgba(10,14,20,.82);backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,.14);border-radius:14px;padding:8px 12px;z-index:10;max-width:96vw}","+  .brand{position:fixed;top:12px;left:14px;z-index:10;font-weight:700;letter-spacing:.04em;font-size:15px;background:rgba(10,14,20,.7);","+    border:1px solid rgba(255,255,255,.14);border-radius:10px;padding:7px 11px}","+  .hud{position:fixed;top:12px;right:14px;z-index:10;font-size:12px;line-height:1.5;text-align:right;background:rgba(10,14,20,.7);","+    border:1px solid rgba(255,255,255,.14);border-radius:10px;padding:7px 11px;min-width:150px}","+  .group{display:flex;gap:5px;align-items:center}","+  .glabel{font-size:10px;text-transform:uppercase;letter-spacing:.08em;opacity:.65;margin-right:2px}","+  button{background:#1c2635;color:#e8edf4;border:1px solid rgba(255,255,255,.18);border-radius:8px;padding:6px 11px;font-size:13px;cursor:pointer}","+  button:hover{background:#27344a}","+  button.on{background:#b3372e;border-color:#e06a60;color:#fff}","+  button.primary{background:#b3372e;border-color:#e06a60;color:#fff}","+  #settings{position:fixed;top:56px;left:14px;z-index:11;width:252px;max-height:calc(100vh - 150px);overflow:auto;background:rgba(10,14,20,.88);","+    backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,.14);border-radius:14px;padding:12px 14px;display:none}","+  #settings.open{display:block}","+  #settings h3{margin:2px 0 8px;font-size:12px;text-transform:uppercase;letter-spacing:.09em;opacity:.8}","+  #settings h3:not(:first-child){margin-top:14px}","+  .row{display:flex;justify-content:space-between;align-items:center;gap:8px;margin:4px 0;font-size:12px}","+  .row label{opacity:.9}","+  .row input{width:78px;background:#131c29;color:#e8edf4;border:1px solid rgba(255,255,255,.2);border-radius:6px;padding:4px 6px;font-size:12px}","+  .sbtns{display:flex;gap:6px;margin-top:12px}","+  .sbtns button{flex:1}","+</style>","+<script type=\"importmap\">","+{\"imports\":{","+  \"three\":\"https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js\",","+  \"three/addons/\":\"https://cdn.jsdelivr.net/npm/three@0.160.0/examples/jsm/\",","+  \"cannon-es\":\"https://cdn.jsdelivr.net/npm/cannon-es@0.20.0/dist/cannon-es.js\"","+}}","+</script>","+</head>","+<body>","+<div id=\"app\"></div>","+<div class=\"brand\">muse-wonder-full-1.0</div>","+<div class=\"hud\"><div id=\"hudSpeed\">0 km/h</div><div id=\"hudState\">driving</div><div id=\"hudParts\">parts intact</div></div>","+","+<div id=\"settings\">","+  <h3>Car</h3>","+  <div class=\"row\"><label>Impact speed (m/s)</label><input id=\"s_speed\" type=\"number\" step=\"0.5\" value=\"22\"></div>","+  <div class=\"row\"><label>Car mass (kg)</label><input id=\"s_carMass\" type=\"number\" step=\"10\" value=\"1250\"></div>","+  <div class=\"row\"><label>Car length (m)</label><input id=\"s_carL\" type=\"number\" step=\"0.1\" value=\"4.2\"></div>","+  <div class=\"row\"><label>Car width (m)</label><input id=\"s_carW\" type=\"number\" step=\"0.1\" value=\"1.8\"></div>","+  <div class=\"row\"><label>Car height (m)</label><input id=\"s_carH\" type=\"number\" step=\"0.05\" value=\"1.45\"></div>","+  <h3>Wall</h3>","+  <div class=\"row\"><label>Wall columns</label><input id=\"s_cols\" type=\"number\" step=\"1\" value=\"12\"></div>","+  <div class=\"row\"><label>Wall rows</label><input id=\"s_rows\" type=\"number\" step=\"1\" value=\"8\"></div>","+  <div class=\"row\"><label>Wall depth (bricks)</label><input id=\"s_depth\" type=\"number\" step=\"1\" value=\"2\"></div>","+  <div class=\"row\"><label>Brick mass (kg)</label><input id=\"s_brickMass\" type=\"number\" step=\"0.1\" value=\"2.5\"></div>","+  <div class=\"row\"><label>Brick width (m)</label><input id=\"s_bw\" type=\"number\" step=\"0.02\" value=\"0.50\"></div>","+  <div class=\"row\"><label>Brick height (m)</label><input id=\"s_bh\" type=\"number\" step=\"0.02\" value=\"0.24\"></div>","+  <div class=\"row\"><label>Brick depth (m)</label><input id=\"s_bd\" type=\"number\" step=\"0.02\" value=\"0.20\"></div>","+  <h3>World</h3>","+  <div class=\"row\"><label>Gravity (m/s²)</label><input id=\"s_gravity\" type=\"number\" step=\"0.1\" value=\"9.81\"></div>","+  <div class=\"row\"><label>Brick friction</label><input id=\"s_bFric\" type=\"number\" step=\"0.02\" value=\"0.72\"></div>","+  <div class=\"row\"><label>Brick restitution</label><input id=\"s_bRest\" type=\"number\" step=\"0.02\" value=\"0.18\"></div>","+  <div class=\"row\"><label>Ground friction</label><input id=\"s_gFric\" type=\"number\" step=\"0.02\" value=\"0.85\"></div>","+  <div class=\"row\"><label>Track length (m)</label><input id=\"s_track\" type=\"number\" step=\"1\" value=\"40\"></div>","+  <div class=\"sbtns\"><button id=\"btnApply\" class=\"primary\">Apply &amp; Replay</button><button id=\"btnDefaults\">Defaults</button></div>","+</div>","+","+<div class=\"bar\">","+  <div class=\"group\"><button id=\"btnPlay\">⏸ Pause</button><button id=\"btnReplay\" class=\"primary\">↻ Replay</button><button id=\"btnSettings\">⚙ Settings</button></div>","+  <div class=\"group\"><span class=\"glabel\">Speed</span>","+    <button class=\"spd\" data-v=\"0.25\">0.25×</button><button class=\"spd\" data-v=\"0.5\">0.5×</button><button class=\"spd on\" data-v=\"1\">1×</button><button class=\"spd\" data-v=\"2\">2×</button></div>","+  <div class=\"group\"><span class=\"glabel\">Camera</span>","+    <button class=\"cam on\" data-v=\"impact\">Impact</button><button class=\"cam\" data-v=\"follow\">Follow</button><button class=\"cam\" data-v=\"top\">Top</button><button class=\"cam\" data-v=\"orbit\">Orbit</button></div>","+</div>","+","+<script type=\"module\">","+import * as THREE from 'three';","+import { OrbitControls } from 'three/addons/controls/OrbitControls.js';","+import { RoomEnvironment } from 'three/addons/environments/RoomEnvironment.js';","+import * as CANNON from 'cannon-es';","+","+/* ---------- deterministic visual RNG (never touches physics setup) ---------- */","+function mulberry32(a){return function(){a|=0;a=a+0x6D2B79F5|0;let t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296;}}","+const clamp=(v,a,b)=>Math.min(b,Math.max(a,v));","+","+/* ---------- settings ---------- */","+const DEFAULTS={speed:22,carMass:1250,carL:4.2,carW:1.8,carH:1.45,cols:12,rows:8,depth:2,brickMass:2.5,bw:0.50,bh:0.24,bd:0.20,gravity:9.81,bFric:0.72,bRest:0.18,gFric:0.85,track:40};","+const $=id=>document.getElementById(id);","+function readSettings(){","+  const n=(id,d,a,b)=>{const v=parseFloat($(id).value);return clamp(isFinite(v)?v:d,a,b);};","+  const i=(id,d,a,b)=>Math.round(n(id,d,a,b));","+  return {speed:n('s_speed',22,2,45),carMass:n('s_carMass',1250,300,4000),carL:n('s_carL',4.2,2.5,6.5),carW:n('s_carW',1.8,1.2,2.6),","+    carH:n('s_carH',1.45,0.9,2.2),cols:i('s_cols',12,3,30),rows:i('s_rows',8,2,20),depth:i('s_depth',2,1,4),","+    brickMass:n('s_brickMass',2.5,0.2,30),bw:n('s_bw',0.5,0.15,1.2),bh:n('s_bh',0.24,0.08,0.6),bd:n('s_bd',0.2,0.08,0.6),","+    gravity:n('s_gravity',9.81,0.5,30),bFric:n('s_bFric',0.72,0,1.5),bRest:n('s_bRest',0.18,0,0.9),gFric:n('s_gFric',0.85,0,1.5),","+    track:n('s_track',40,25,80)};","+}","+let S={...DEFAULTS};","+","+/* ---------- renderer / scene ---------- */","+const renderer=new THREE.WebGLRenderer({antialias:true,powerPreference:'high-performance'});","+renderer.setPixelRatio(Math.min(devicePixelRatio,2));","+renderer.setSize(innerWidth,innerHeight);","+renderer.shadowMap.enabled=true;","+renderer.shadowMap.type=THREE.PCFSoftShadowMap;","+renderer.toneMapping=THREE.ACESFilmicToneMapping;","+renderer.toneMappingExposure=1.05;","+renderer.outputColorSpace=THREE.SRGBColorSpace;","+$('app').appendChild(renderer.domElement);","+","+const scene=new THREE.Scene();","+scene.background=new THREE.Color(0x8fb6d9);","+scene.fog=new THREE.Fog(0xa8c4de,60,160);","+const pmrem=new THREE.PMREMGenerator(renderer);","+scene.environment=pmrem.fromScene(new RoomEnvironment(),0.04).texture;","+","+const camera=new THREE.PerspectiveCamera(50,innerWidth/innerHeight,0.1,400);","+camera.position.set(8,5,13);","+const controls=new OrbitControls(camera,renderer.domElement);","+controls.enableDamping=true; controls.enabled=false; controls.maxPolarAngle=Math.PI*0.49;","+","+const sun=new THREE.DirectionalLight(0xfff2dd,3.2);","+sun.position.set(18,30,14); sun.castShadow=true;","+sun.shadow.mapSize.set(2048,2048);","+sun.shadow.bias=-0.0004; sun.shadow.normalBias=0.02;","+scene.add(sun,sun.target);","+scene.add(new THREE.HemisphereLight(0xbdd7f2,0x4a5548,0.55));","+","+addEventListener('resize',()=>{camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();renderer.setSize(innerWidth,innerHeight);});","+</script>","+</body>","+</html>"]}]}]}