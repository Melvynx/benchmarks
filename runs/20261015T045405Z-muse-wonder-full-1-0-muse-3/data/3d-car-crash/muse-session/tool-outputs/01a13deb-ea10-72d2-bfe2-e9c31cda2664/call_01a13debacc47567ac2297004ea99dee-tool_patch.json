{"files":[{"path":"/private/var/folders/7z/5mtgxwxx4zs9ppgzm942gbmh0000gn/T/workspace.cOb1ar/app/index.html","hunks":[{"oldStart":192,"oldLines":6,"newStart":192,"newLines":76,"lines":["   world.removeConstraint(j.c);","   j.a.wakeUp();j.b.wakeUp();"," }","+","+/* ---------- environment (static, merged-ish simple meshes) ---------- */","+function buildEnvironment(){","+  const TL=S.track, half=TL/2, TW=9; // track width (z)","+  const g=new THREE.Group();dynGroup.add(g);","+  const ground=new THREE.Mesh(new THREE.PlaneGeometry(220,140),new THREE.MeshStandardMaterial({map:grassTex,roughness:1}));","+  ground.rotation.x=-Math.PI/2;ground.position.y=-0.02;ground.receiveShadow=true;g.add(ground);","+  const road=new THREE.Mesh(new THREE.BoxGeometry(TL+16,0.06,TW),new THREE.MeshStandardMaterial({map:asphaltTex,roughness:0.94,metalness:0.02}));","+  road.position.y=0.0;road.receiveShadow=true;g.add(road);","+  const white=new THREE.MeshStandardMaterial({color:0xe8e8e2,roughness:0.7});","+  const yellow=new THREE.MeshStandardMaterial({color:0xe8c832,roughness:0.7});","+  // edge lines + centre dashes","+  for(const zz of [-TW/2+0.35,TW/2-0.35]){","+    const l=new THREE.Mesh(new THREE.BoxGeometry(TL+16,0.02,0.14),white);l.position.set(0,0.045,zz);l.receiveShadow=true;g.add(l);}","+  for(let x=-half-6;x<half+6;x+=3){","+    const d=new THREE.Mesh(new THREE.BoxGeometry(1.6,0.02,0.14),yellow);d.position.set(x,0.045,0);d.receiveShadow=true;g.add(d);}","+  // start line (checker-ish stripes)","+  for(let i=0;i<9;i++){const s=new THREE.Mesh(new THREE.BoxGeometry(0.6,0.02,TW/9),","+    new THREE.MeshStandardMaterial({color:i%2?0x111111:0xf0f0f0,roughness:0.7}));","+    s.position.set(carStartX-2.5,0.045,-TW/2+TW/18+i*TW/9);s.receiveShadow=true;g.add(s);}","+  // curbs (red/white blocks) + barriers + light poles — visual only, off the driving line","+  const red=new THREE.MeshStandardMaterial({color:0xb03030,roughness:0.8});","+  for(let x=-half-6;x<half+6;x+=2){","+    for(const zz of [-TW/2-0.35,TW/2+0.35]){","+      const c=new THREE.Mesh(new THREE.BoxGeometry(2,0.14,0.6),((x/2)|0)%2?red:white);","+      c.position.set(x+1,0.06,zz);c.castShadow=false;c.receiveShadow=true;g.add(c);}}","+  const concrete=new THREE.MeshStandardMaterial({color:0x9aa0a6,roughness:0.9});","+  for(const zz of [-TW/2-2.2,TW/2+2.2]){","+    const b=new THREE.Mesh(new THREE.BoxGeometry(TL+16,0.9,0.35),concrete);","+    b.position.set(0,0.45,zz);b.receiveShadow=true;g.add(b);}","+  const poleMat=new THREE.MeshStandardMaterial({color:0x3a3f46,roughness:0.5,metalness:0.7});","+  for(let x=-half;x<=half;x+=10){","+    for(const zz of [-TW/2-3.2,TW/2+3.2]){","+      const p=new THREE.Mesh(new THREE.CylinderGeometry(0.07,0.09,5.5,8),poleMat);p.position.set(x,2.75,zz);g.add(p);","+      const head=new THREE.Mesh(new THREE.BoxGeometry(0.7,0.14,0.3),MAT.light);head.position.set(x,5.5,zz);g.add(head);}}","+  // distant grandstand hint + horizon hills","+  const stand=new THREE.Mesh(new THREE.BoxGeometry(16,5,3),new THREE.MeshStandardMaterial({color:0x6d7c8c,roughness:0.9}));","+  stand.position.set(-6,2.5,-24);g.add(stand);","+  const hillM=new THREE.MeshStandardMaterial({color:0x5c7a55,roughness:1});","+  for(const [hx,hz,hs] of [[-40,-45,26],[25,-50,34],[5,52,30],[-45,40,22]]){","+    const h=new THREE.Mesh(new THREE.SphereGeometry(hs,12,8),hillM);h.scale.y=0.28;h.position.set(hx,0,hz);g.add(h);}","+  // skid marks (grow behind the car while driving)","+  const skidMat=new THREE.MeshBasicMaterial({color:0x0a0a0c,transparent:true,opacity:0.55});","+  skidL=new THREE.Mesh(new THREE.PlaneGeometry(1,0.22),skidMat);skidL.rotation.x=-Math.PI/2;g.add(skidL);","+  skidR=skidL.clone();g.add(skidR);","+  // cheap contact blob under the car","+  blob=new THREE.Mesh(new THREE.CircleGeometry(1,24),","+    new THREE.MeshBasicMaterial({color:0x000000,transparent:true,opacity:0.3,depthWrite:false}));","+  blob.rotation.x=-Math.PI/2;blob.position.y=0.05;g.add(blob);","+}","+","+/* ---------- wall ---------- */","+function buildWall(){","+  const {cols,rows,depth,bw,bh,bd,brickMass}=S;","+  const gap=0.012, geo=new THREE.BoxGeometry(bd,bh,bw); // x=depth, y=height, z=width (across track)","+  let idx=0;","+  for(let d=0;d<depth;d++)for(let r=0;r<rows;r++)for(let c=0;c<cols;c++){","+    const stagger=(r%2)?bw*0.5:0;","+    const z=(c-(cols-1)/2)*(bw+gap)+stagger-(r%2?bw*0.0:0);","+    const x=wallX+(d-(depth-1)/2)*(bd+gap);","+    const y=bh/2+0.03+r*(bh+gap);","+    const body=makeBody(brickMass,bd,bh,bw,x,y,z,physMats.brick,{sleep:true,ld:0.02,ad:0.08});","+    body.wakeUpAfterNarrowphase=true;","+    const mesh=new THREE.Mesh(geo,brickMats[(idx*7+r*3+c)%brickMats.length]);","+    mesh.castShadow=true;mesh.receiveShadow=true;","+    pair(body,mesh);bricks.push(body);","+    body.sleepState=0; // awake but settled by tiny y offset; solver settles it","+    idx++;","+  }","+}"," </script>"," </body>"," </html>"]}]}]}