{"files":[{"hunks":[{"lines":["   el('tlTime').textContent=tCur.toFixed(1)+'s / '+tTot.toFixed(1)+'s';"," }"," ","+/* ---------------- cameras ---------------- */","+let camMode='director', timeScale=1, paused=false;","+const camPos=new THREE.Vector3(-24,2.2,0), camTgt=new THREE.Vector3(0,6,0);","+let lastShot='';","+function shotFor(phase,t){","+  if(phase==='wait') return 'foot';","+  if(phase==='climb') return t<2.2?'foot':'wide';","+  if(phase==='hold') return 'lip';","+  if(phase==='release') return 'lip';","+  if(phase==='airborne') return 'lipTrack';","+  if(phase==='hover') return 'wideLow';","+  if(phase==='landed') return 'wideLow';","+  if(phase==='driveout') return 'wide';","+  if(phase==='done') return 'aerial';","+  return 'wide';","+}","+const _desP=new THREE.Vector3(),_desT=new THREE.Vector3();","+function desiredCam(shot,outP,outT){","+  const lipP=new THREE.Vector3(LIP.x,LIP.y,0);","+  switch(shot){","+    case 'foot': outP.set(-23.5,1.7,3.2); outT.set(-4,5.5,0); break;","+    case 'wide': outP.set(-7,9.5,44); outT.set(0,9.5,0); break;","+    case 'wideLow': outP.set(-16,3.2,30); outT.set(S.p.x,2.2,0); break;","+    case 'lip': outP.copy(lipP).add(new THREE.Vector3(-7.5,2.2,10.5)); outT.copy(lipP).add(new THREE.Vector3(-1,-1,0)); break;","+    case 'lipTrack': outP.copy(lipP).add(new THREE.Vector3(-8,3,12)); outT.copy(S.p); break;","+    case 'drone': outP.copy(lipP).add(new THREE.Vector3(-3.5,7.5,2.5)); outT.copy(S.p); break;","+    case 'aerial': outP.set(-30,36,34); outT.set(1,7,0); break;","+    case 'chase': {","+      _fwd.set(1,0,0).applyQuaternion(S.q); _fwd.y*=0.35; _fwd.normalize();","+      outP.copy(S.p).addScaledVector(_fwd,-8.5).add(new THREE.Vector3(0,2.6,0));","+      outT.copy(S.p).addScaledVector(_fwd,4); break;","+    }","+    default: outP.set(-7,9.5,44); outT.set(0,9.5,0);","+  }","+}","+function updateCamera(dt){","+  if(camMode==='orbit'){ orbit.enabled=true; orbit.update(); return; }","+  orbit.enabled=false;","+  let shot=c