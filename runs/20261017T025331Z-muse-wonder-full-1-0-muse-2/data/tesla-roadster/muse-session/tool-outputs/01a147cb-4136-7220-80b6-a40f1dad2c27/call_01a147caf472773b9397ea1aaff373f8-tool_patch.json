{"files":[{"hunks":[{"lines":["   <div class=\"setrow\"><label for=\"sGrav\">Gravity (m/s²)</label><input type=\"number\" id=\"sGrav\" value=\"9.81\" min=\"1\" max=\"25\" step=\"0.01\"><input type=\"range\" id=\"rGrav\" min=\"1\" max=\"25\" step=\"0.01\" value=\"9.81\"></div>","   <div class=\"note\">Every value feeds the rigid-body simulation. Lower fan, drive or thrust far enough and the stunt fails physically — panels, glass and wheels break off on impact impulse.</div>"," </div>","+","+<script type=\"module\">","+import * as THREE from 'three';","+import { OrbitControls } from 'three/addons/controls/OrbitControls.js';","+import { EffectComposer } from 'three/addons/postprocessing/EffectComposer.js';","+import { RenderPass } from 'three/addons/postprocessing/RenderPass.js';","+import { UnrealBloomPass } from 'three/addons/postprocessing/UnrealBloomPass.js';","+import { RoomEnvironment } from 'three/addons/environments/RoomEnvironment.js';","+","+/* ---------------- seeded RNG (visuals only) ---------------- */","+function mulberry32(a){return function(){a|=0;a=a+0x6D2B79F5|0;let t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296}}","+let rng = mulberry32(1337);","+const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));","+const lerp=(a,b,t)=>a+(b-a)*t;","+const smooth=(a,b,x)=>{const t=clamp((x-a)/(b-a),0,1);return t*t*(3-2*t)};","+","+/* ---------------- renderer / scene ---------------- */","+const app=document.getElementById('app');","+const renderer=new THREE.WebGLRenderer({antialias:true,powerPreference:'high-performance'});","+renderer.setPixelRatio(Math.min(devicePixelRatio,2));","+renderer.setSize(innerWidth,innerHeight);","+renderer.shadowMap.enabled=true;","+renderer.shadowMap.type=THREE.PCFSoftShadowMap;","+renderer.toneMapping=THREE.ACESFilmicToneMapping;","+renderer.toneMappingExposure=1.12;","+renderer.outputColorSpace=THREE.SRGBColorSpace;","+app.appendChild(renderer.domElement);","+","+const scene=new THREE.Scene();","+scene.background=new THREE.Color(0x010203);","+scene.fog=new THREE.FogExp2(0x030507,0.0052);","+const pmrem=new THREE.PMREMGenerator(renderer);","+scene.environment=pmrem.fromScene(new RoomEnvironment(),0.04).texture;","+scene.environmentIntensity=0.22;","+","+const camera=new THREE.PerspectiveCamera(46,innerWidth/innerHeight,0.1,600);","+camera.position.set(-24,2.2,0);","+const orbit=new OrbitControls(camera,renderer.domElement);","+orbit.enableDamping=true; orbit.dampingFactor=0.08; orbit.maxDistance=160; orbit.target.set(0,9,0); orbit.enabled=false;","+","+const composer=new EffectComposer(renderer);","+composer.addPass(new RenderPass(scene,camera));","+const bloom=new UnrealBloomPass(new THREE.Vector2(innerWidth,innerHeight),0.55,0.55,0.82);","+composer.addPass(bloom);","+","+/* lights */","+scene.add(new THREE.AmbientLight(0x2a3542,0.55));","+const key=new THREE.SpotLight(0xf2f6ff, 9000, 160, 0.62, 0.45, 1.6);","+key.position.set(-26,30,26); key.castShadow=true;","+key.shadow.mapSize.set(2048,2048); key.shadow.bias=-0.0004; key.shadow.camera.near=5; key.shadow.camera.far=160;","+key.target.position.set(2,8,0); scene.add(key,key.target);","+const rim=new THREE.DirectionalLight(0x8fb4d8,0.7); rim.position.set(30,24,-30); scene.add(rim);","+const footLight=new THREE.SpotLight(0xffffff,2600,70,0.7,0.6,1.6);","+footLight.position.set(-14,9,-16); footLight.target.position.set(-6,0,0); scene.add(footLight,footLight.target);","+","+/* ---------------- ramp profile (the hero geometry) ----------------","+   Flat approach, then curvature ramps in smoothly (clothoid blend) to","+   R=13 m, continuing to a 115 deg lip. Sampled every 8 cm; the same","+   samples drive the mesh AND the physics surface query. */","+const PROF=[]; // {x,y,tx,ty,nx,ny,s,th}","+(function buildProfile(){","+  const ds=0.08, R=13, lipTh=115*Math.PI/180;","+  let x=-18,y=0,th=0,s=0;","+  const push=()=>PROF.push({x,y,tx:Math.cos(th),ty:Math.sin(th),nx:-Math.sin(th),ny:Math.cos(th),s,th});","+  push();","+  const flatLen=14; // x -18 -> -4","+  while(s<flatLen){ x+=ds; s+=ds; push(); }","+  let sc=0;","+  while(th<lipTh){","+    const k=(1/R)*smooth(0,5,sc);           // continuous curvature in","+    th=Math.min(lipTh, th+k*ds); sc+=ds; s+=ds;","+    x+=Math.cos(th)*ds; y+=Math.sin(th)*ds; push();","+  }","+})();","+const PROF_LEN=PROF[PROF.length-1].s;","+const LIP=PROF[PROF.length-1];","+const RAMP_HALF_W=2.35;","+","+/* closest profile point to (x,y) — returns temp object fields */","+const _cp={x:0,y:0,nx:0,ny:1,tx:1,ty:0,s:0,th:0,dist:1e9};","+function closestProfile(px,py){","+  let best=1e18,bi=0,bt=0;","+  for(let i=0;i<PROF.length-1;i++){","+    const a=PROF[i],b=PROF[i+1];","+    const abx=b.x-a.x, aby=b.y-a.y;","+    const t=clamp(((px-a.x)*abx+(py-a.y)*aby)/(abx*abx+aby*aby||1),0,1);","+    const cx=a.x+abx*t, cy=a.y+aby*t;","+    const d=(px-cx)*(px-cx)+(py-cy)*(py-cy);","+    if(d<best){best=d;bi=i;bt=t;}","+  }","+  const a=PROF[bi],b=PROF[bi+1];","+  _cp.x=lerp(a.x,b.x,bt); _cp.y=lerp(a.y,b.y,bt);","+  _cp.nx=lerp(a.nx,b.nx,bt); _cp.ny=lerp(a.ny,b.ny,bt);","+  _cp.tx=lerp(a.tx,b.tx,bt); _cp.ty=lerp(a.ty,b.ty,bt);","+  const nl=Math.hypot(_cp.nx,_cp.ny)||1; _cp.nx/=nl; _cp.ny/=nl;","+  const tl=Math.hypot(_cp.tx,_cp.ty)||1; _cp.tx/=tl; _cp.ty/=tl;","+  _cp.s=lerp(a.s,b.s,bt); _cp.th=lerp(a.th,b.th,bt); _cp.dist=Math.sqrt(best);","+  return _cp;","+}","+/* Unified surface query: ramp ribbon (|z|<=halfW) or ground plane y=0.","+   Returns signed distance along the surface normal + normal/tangent. */","+const _sq={d:1e9,nx:0,ny:1,nz:0,tx:1,ty:0,tz:0,s:-1,th:0,cx:0,cy:0,ramp:false};","+function surfaceQuery(px,py,pz){","+  let dGround=py;","+  _sq.d=dGround; _sq.nx=0;_sq.ny=1;_sq.nz=0; _sq.tx=1;_sq.ty=0;_sq.tz=0; _sq.s=-1;_sq.th=0;_sq.cx=px;_sq.cy=0;_sq.ramp=false;","+  if(Math.abs(pz)<=RAMP_HALF_W+0.35){","+    const c=closestProfile(px,py);","+    const dx=px-c.x, dy=py-c.y;","+    const dn=dx*c.nx+dy*c.ny;                 // signed distance along ramp normal","+    // ramp wins when it is the nearer surface along its normal","+    if(dn<dGround+0.001 && dn>-2.0){","+      _sq.d=dn; _sq.nx=c.nx;_sq.ny=c.ny;_sq.nz=0; _sq.tx=c.tx;_sq.ty=c.ty;_sq.tz=0;","+      _sq.s=c.s; _sq.th=c.th; _sq.cx=c.x; _sq.cy=c.y; _sq.ramp=true;","+      // snapshot closest ( callers may call again )","+      _sq._cx=c.x; _sq._cy=c.y;","+    }","+  }","+  return _sq;","+}","+"],"newLines":123,"newStart":105,"oldLines":3,"oldStart":105}],"path":"/tmp/workspace.oOeyMl/app/index.html"}]}