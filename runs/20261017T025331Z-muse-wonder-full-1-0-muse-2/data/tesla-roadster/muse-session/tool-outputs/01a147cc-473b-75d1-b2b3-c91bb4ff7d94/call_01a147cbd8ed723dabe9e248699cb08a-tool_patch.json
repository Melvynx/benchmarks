{"files":[{"hunks":[{"lines":["   const bl=box(0.18,0.18,0.18,M.ledRed,x,h+0.3,z); bl.castShadow=false; scene.add(bl);"," }"," ","+/* ---------------- ramp mesh (ribbon with thickness) + LED edges ---------------- */","+(function buildRamp(){","+  const pts=PROF.filter((_,i)=>i%2===0||i===PROF.length-1);","+  const W=RAMP_HALF_W, TH=0.38;","+  const pos=[],nor=[],uv=[],idx=[];","+  // top surface vertices (0..n-1 pairs), then bottom surface pairs","+  pts.forEach((p,i)=>{","+    pos.push(p.x,p.y,-W, p.x,p.y,W);","+    nor.push(p.nx,p.ny,0, p.nx,p.ny,0);","+    uv.push(0,p.s/3.4, 1,p.s/3.4);","+  });","+  const nTop=pts.length*2;","+  pts.forEach((p,i)=>{","+    pos.push(p.x-p.nx*TH,p.y-p.ny*TH,-W, p.x-p.nx*TH,p.y-p.ny*TH,W);","+    nor.push(-p.nx,-p.ny,0, -p.nx,-p.ny,0);","+    uv.push(0,p.s/3.4, 1,p.s/3.4);","+  });","+  for(let i=0;i<pts.length-1;i++){","+    const a=i*2,b=i*2+1,c=i*2+2,d=i*2+3;","+    idx.push(a,c,b, b,c,d);                                  // top","+    const a2=nTop+a,b2=nTop+b,c2=nTop+c,d2=nTop+d;","+    idx.push(a2,b2,c2, b2,d2,c2);                            // bottom","+    idx.push(a,a2,c, c,a2,c2);                               // left side","+    idx.push(b,d,b2, d,d2,b2);                               // right side","+  }","+  // lip end cap","+  const li=(pts.length-1)*2;","+  idx.push(li,li+1,nTop+li, li+1,nTop+li+1,nTop+li);","+  const geo=new THREE.BufferGeometry();","+  geo.setAttribute('position',new THREE.Float32BufferAttribute(pos,3));","+  geo.setAttribute('normal',new THREE.Float32BufferAttribute(nor,3));","+  geo.setAttribute('uv',new THREE.Float32BufferAttribute(uv,2));","+  geo.setIndex(idx);","+  const rampTop=new THREE.Mesh(geo,M.concrete);","+  rampTop.castShadow=true; rampTop.receiveShadow=true; scene.add(rampTop);","+  // thin side skirts slightly wider, dark, under the edge lights","+  for(const sz of [-1,1]){","+    const curve=new THREE.CatmullRomCurve3(pts.filter((_,i)=>i%4===0).map(p=>new THREE.Vector3(p.x+p.nx*0.035,p.y+p.ny*0.035,sz*(W-0.02))));","+    const tube=new THREE.Mesh(new THREE.TubeGeometry(curve,220,0.035,6,false),M.ledRed);","+    tube.castShadow=false; scene.add(tube);","+    const curve2=new THREE.CatmullRomCurve3(pts.filter((_,i)=>i%4===0).map(p=>new THREE.Vector3(p.x-p.nx*0.10,p.y-p.ny*0.10,sz*(W+0.02))));","+    const rail=new THREE.Mesh(new THREE.TubeGeometry(curve2,160,0.05,6,false),M.steelDark);","+    rail.castShadow=true; scene.add(rail);","+  }","+  // start line on flat","+  const sl=box(0.18,0.012,W*1.8,new THREE.MeshStandardMaterial({color:0xdddddd,roughness:0.6}),-9.5,0.008,0);","+  sl.castShadow=false; scene.add(sl);","+})();","+","+/* steel truss behind the running surface */","+(function buildTruss(){","+  const g=new THREE.Group(); scene.add(g);","+  const backX=LIP.x+3.1, topY=LIP.y+0.8, H=topY;","+  const zs=[-2.0,2.0];","+  // two rear vertical towers with lattice bracing","+  for(const z of zs){","+    beam(new THREE.Vector3(backX,0,z),new THREE.Vector3(backX,H,z),0.14,M.steel,g);","+    beam(new THREE.Vector3(backX-1.5,0,z),new THREE.Vector3(backX-0.4,H,z),0.09,M.steel,g);","+    const bays=7;","+    for(let i=0;i<bays;i++){","+      const y0=i/bays*H, y1=(i+1)/bays*H;","+      const x0a=backX-1.5+ (1.1)*(y0/H), x1a=backX-1.5+(1.1)*(y1/H);","+      beam(new THREE.Vector3(x0a,y0,z),new THREE.Vector3(backX,y1,z),0.05,M.steelDark,g);","+      beam(new THREE.Vector3(backX,y0,z),new THREE.Vector3(x1a,y1,z),0.05,M.steelDark,g);","+      beam(new THREE.Vector3(backX,y0,z),new THREE.Vector3(x0a,y0,z),0.05,M.steelDark,g);","+    }","+  }","+  // cross members between towers + X brace on back face","+  for(let i=0;i<=7;i++){","+    const y=i/7*H;","+    beam(new THREE.Vector3(backX,y,-2.0),new THREE.Vector3(backX,y,2.0),0.07,M.steel,g);","+  }","+  beam(new THREE.Vector3(backX,1,-2.0),new THREE.Vector3(backX,H*0.55,2.0),0.05,M.steelDark,g);","+  beam(new THREE.Vector3(backX,1,2.0),new THREE.Vector3(backX,H*0.55,-2.0),0.05,M.steelDark,g);","+  beam(new THREE.Vector3(backX,H*0.5,-2.0),new THREE.Vector3(backX,H-1,2.0),0.05,M.steelDark,g);","+  beam(new THREE.Vector3(backX,H*0.5,2.0),new THREE.Vector3(backX,H-1,-2.0),0.05,M.steelDark,g);","+  // struts from surface back to towers, following the hook","+  const step=38;","+  for(let i=60;i<PROF.length;i+=step){","+    const p=PROF[i];","+    const bx=p.x-p.nx*0.4, by=p.y-p.ny*0.4;","+    for(const z of zs){","+      beam(new THREE.Vector3(bx,by,z*0.92),new THREE.Vector3(backX,clamp(by,0.4,H-0.3),z),0.06,M.steel,g);","+    }","+    beam(new THREE.Vector3(bx,by,-1.85),new THREE.Vector3(bx,by,1.85),0.055,M.steelDark,g);","+    // diagonal from surface point down-back to tower base area","+    if(p.y>4) for(const z of zs) beam(new THREE.Vector3(bx,by,z*0.92),new THREE.Vector3(backX,clamp(by-3.2,0.3,H),z),0.045,M.steelDark,g);","+  }","+  // top crossbeam extending past lip (visible in aerial frame 23)","+  beam(new THREE.Vector3(LIP.x-4.6,LIP.y+0.85,0),new THREE.Vector3(backX+0.4,LIP.y+0.85,0),0.09,M.steel,g);","+  for(const z of zs) beam(new THREE.Vector3(backX,H,z),new THREE.Vector3(LIP.x-1.2,LIP.y+0.85,0),0.05,M.steelDark,g);","+  // base frame + feet","+  beam(new THREE.Vector3(-5,0.18,-2.3),new THREE.Vector3(backX+0.6,0.18,-2.3),0.09,M.steelDark,g);","+  beam(new THREE.Vector3(-5,0.18,2.3),new THREE.Vector3(backX+0.6,0.18,2.3),0.09,M.steelDark,g);","+  beam(new THREE.Vector3(backX,0,0),new THREE.Vector3(backX-6.5,0.1,-3.4),0.07,M.steelDark,g);","+  beam(new THREE.Vector3(backX,0,0),new THREE.Vector3(backX-6.5,0.1,3.4),0.07,M.steelDark,g);","+  // small red marker lights on tower","+  for(let i=1;i<=5;i++){ const m=box(0.12,0.12,0.12,M.ledRed,backX+0.16,i*H/5.5,0); m.castShadow=false; g.add(m); }","+})();","+","+"," "],"newLines":105,"newStart":331,"oldLines":4,"oldStart":331}],"path":"/tmp/workspace.oOeyMl/app/index.html"}]}