{"files":[{"hunks":[{"lines":["   for(let i=1;i<=5;i++){ const m=box(0.12,0.12,0.12,M.ledRed,backX+0.16,i*H/5.5,0); m.castShadow=false; g.add(m); }"," })();"," ","+/* ---------------- the Roadster ----------------","+   Local frame: +X forward, +Y up, +Z left. 4.5 x 1.15 x 2.0 m.","+   Built from breakable parts; each part is a Group whose origin is","+   its own centre so it can become debris unchanged. */","+const carGroup=new THREE.Group(); scene.add(carGroup);","+function extrudeProfile(pts,width,mat,bevel=0.04){","+  const sh=new THREE.Shape();","+  sh.moveTo(pts[0][0],pts[0][1]);","+  for(let i=1;i<pts.length;i++) sh.lineTo(pts[i][0],pts[i][1]);","+  sh.closePath();","+  const geo=new THREE.ExtrudeGeometry(sh,{depth:width,bevelEnabled:true,bevelThickness:bevel,bevelSize:bevel,bevelSegments:2,steps:1});","+  geo.translate(0,0,-width/2);","+  const m=new THREE.Mesh(geo,mat); m.castShadow=true; m.receiveShadow=true; return m;","+}","+const parts={};   // name -> {group, threshold(impulse kNs), broken, kind}","+function regPart(name,group,threshold,kind='panel'){","+  group.userData.partName=name; carGroup.add(group);","+  parts[name]={group,threshold,broken:false,kind};","+  return group;","+}","+let fanMeshes=[], wheelGroups=[], headlightL, headlightR;","+(function buildCar(){","+  // --- core cabin / chassis (never breaks: the safety cell) ---","+  const core=new THREE.Group();","+  const floor=box(4.3,0.16,1.86,M.paintDark,0,-0.42,0); core.add(floor);","+  const tub=extrudeProfile([[-1.15,-0.38],[0.95,-0.38],[0.8,0.06],[-0.55,0.18],[-1.05,0.05]],1.7,M.paint,0.05); core.add(tub);","+  const cageT=box(1.5,0.07,1.1,M.paintDark,-0.15,0.42,0); core.add(cageT);","+  for(const sz of [-1,1]) core.add(box(1.7,0.34,0.07,M.paintDark,-0.1,0.05,sz*0.88)); // dark sills structure","+  // underside: flat floor + two downforce fans (visible inverted)","+  const under=box(3.9,0.05,1.7,M.paintDark,0,-0.52,0); core.add(under);","+  for(const fx of [-0.95,0.95]){","+    const fan=new THREE.Mesh(new THREE.CircleGeometry(0.52,28),M.fan);","+    fan.rotation.x=Math.PI/2; fan.position.set(fx,-0.55,0); core.add(fan); fanMeshes.push(fan);","+    const ring=new THREE.Mesh(new THREE.TorusGeometry(0.52,0.035,8,28),M.nozzle);","+    ring.rotation.x=Math.PI/2; ring.position.copy(fan.position); core.add(ring);","+  }","+  regPart('core',core,1e9,'core');","+","+  // --- front section: low wedge nose ---","+  const front=new THREE.Group(); front.position.set(1.55,-0.05,0);","+  const nose=extrudeProfile([[-0.75,-0.33],[0.68,-0.36],[0.72,-0.05],[0.35,0.16],[-0.55,0.22],[-0.75,0.05]],1.78,M.paint,0.06); front.add(nose);","+  const fbar=box(0.06,0.055,1.62,M.head,0.71,0.0,0); front.add(fbar);            // full-width front light bar","+  front.add(box(0.5,0.1,1.8,M.paintDark,0.45,-0.34,0));                          // dark lower intake","+  regPart('front',front,9.5);","+","+  // --- hood panel ---","+  const hood=new THREE.Group(); hood.position.set(1.35,0.2,0);","+  const hm=box(1.25,0.045,1.45,M.paint,0,0,0); hm.rotation.z=-0.07; hood.add(hm);","+  regPart('hood',hood,4.5);","+","+  // --- rear section: tail, light bar, plate, diffuser + nozzles ---","+  const rear=new THREE.Group(); rear.position.set(-1.62,-0.02,0);","+  const tailM=extrudeProfile([[-0.62,-0.36],[0.6,-0.36],[0.62,0.1],[0.3,0.26],[-0.45,0.24],[-0.62,0.05]],1.84,M.paint,0.06); rear.add(tailM);","+  rear.add(box(0.055,0.06,1.74,M.tail,-0.64,0.1,0));                              // full-width tail light","+  const plate=new THREE.Mesh(new THREE.BoxGeometry(0.03,0.17,0.34),M.plate); plate.position.set(-0.65,-0.06,0); rear.add(plate);","+  rear.add(box(0.34,0.3,1.5,M.paintDark,-0.5,-0.32,0));                          // diffuser","+  for(const nz of [-0.52,-0.18,0.18,0.52]){                                       // round diffuser nozzles","+    const nzM=new THREE.Mesh(new THREE.CylinderGeometry(0.055,0.07,0.12,12),M.nozzle);","+    nzM.rotation.z=Math.PI/2; nzM.position.set(-0.68,-0.3,nz); 