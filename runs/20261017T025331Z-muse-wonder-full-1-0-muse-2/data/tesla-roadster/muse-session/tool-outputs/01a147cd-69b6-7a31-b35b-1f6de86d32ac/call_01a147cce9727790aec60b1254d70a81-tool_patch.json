","+","+const _f=new THREE.Vector3(),_tq=new THREE.Vector3(),_r=new THREE.Vector3(),_wp=new THREE.Vector3(),_wv=new THREE.Vector3(),_v1=new THREE.Vector3(),_v2=new THREE.Vector3(),_v3=new THREE.Vector3();","+const _up=new THREE.Vector3(),_fwd=new THREE.Vector3(),_side=new THREE.Vector3();","+function addForceAt(F,worldPoint){","+  _f.add(F);","+  _r.subVectors(worldPoint,S.p);","+  _tq.x+=_r.y*F.z-_r.z*F.y; _tq.y+=_r.z*F.x-_r.x*F.z; _tq.z+=_r.x*F.y-_r.y*F.x;","+}","+function pointVel(worldPoint,out){","+  out.copy(S.v); _v3.subVectors(worldPoint,S.p);","+  out.x+=S.w.y*_v3.z-S.w.z*_v3.y; out.y+=S.w.z*_v3.x-S.w.x*_v3.z; out.z+=S.w.x*_v3.y-S.w.y*_v3.x;","+  return out;","+}","+","+/* breakage: detach every intact part whose threshold < impulse (kNs) */","+function breakParts(impulseKNs,hitPoint){","+  let brokeAny=false;","+  for(const name in parts){","+    const P=parts[name];","+    if(P.broken||P.kind==='core') continue;","+    if(impulseKNs<=P.threshold) continue;","+    P.broken=true; brokeAny=true;","+    const g=P.group;","+    const wp=new THREE.Vector3(); g.getWorldPosition(wp);","+    const pv=pointVel(wp,new THREE.Vector3());","+    pv.x+=(rng()-0.5)*2.2; pv.y+=rng()*1.6+0.4; pv.z+=(rng()-0.5)*2.2;","+    if(hitPoint){ const away=wp.clone().sub(hitPoint); away.y=Math.abs(away.y)*0.4; if(away.lengthSq()>0.01) pv.addScaledVector(away.normalize(),1.2+rng()*1.6); }","+    const av=new THREE.Vector3((rng()-0.5)*7,(rng()-0.5)*7,(rng()-0.5)*7);","+    if(P.kind==='glass'){","+      // shatter into shards","+      carGroup.remove(g);","+      for(let i=0;i<14;i++){","+        const sg=new THREE.BufferGeometry();","+        const a=0.12+rng()*0.3,b=0.1+rng()*0.26;","+        sg.setAttribute('position',new THREE.Float32BufferAttribute([0,0,0, a,0,(rng()-0.5)*0.1, a*0.3,b,(rng()-0.5)*0.1],3));","+        sg.computeVertexNormals();","+        const shard=new THREE.Mesh(sg,M.shard); shard.castShadow=true;","+        shard.position.copy(wp).add(new THREE.Vector3((rng()-0.5)*1.8,(rng()-0.5)*0.3,(rng()-0.5)*0.8));","+        scene.add(shard);","+        debris.push({mesh:shard,pos:shard.position.clone(),vel:pv.clone().add(new THREE.Vector3((rng()-0.5)*3,rng()*2,(rng()-0.5)*3)),quat:new THREE.Quaternion().setFromEuler(new THREE.Euler(rng()*3,rng()*3,rng()*3)),angVel:av.clone().multiplyScalar(1.8),half:new THREE.Vector3(0.12,0.03,0.12),radius:0.16,settled:0});","+        shard.quaternion.copy(debris[debris.length-1].quat);","+      }","+    } else if(P.kind==='wheel'){","+      makeDebris(g,pv,av,new THREE.Vector3(0.34,0.34,0.14));","+    } else {","+      const halfMap={front:new THREE.Vector3(0.75,0.3,0.9),rear:new THREE.Vector3(0.62,0.3,0.92),hood:new THREE.Vector3(0.62,0.05,0.72),doorL:new THREE.Vector3(0.92,0.25,0.05),doorR:new THREE.Vector3(0.92,0.25,0.05),bumperF:new THREE.Vector3(0.1,0.12,0.93),bumperR:new THREE.Vector3(0.1,0.13,0.93)};","+      makeDebris(g,pv,av,halfMap[name]||new THREE.Vector3(0.5,0.2,0.5));","+    }","+  }","+  if(brokeAny){ S.crashed=true; smokeBurst(S.p,3.2,16); }","+  return brokeAny;","+}","+","+"," "," "," "],"newLines":169,"newStart":563,"oldLines":6,"oldStart":563}],"path":"/tmp/workspace.oOeyMl/app/index.html"}]}