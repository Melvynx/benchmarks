{"files":[{"hunks":[{"lines":[" }"," const jetLight=new THREE.PointLight(0xbfeaff,0,16,1.6); scene.add(jetLight);"," ","+/* ---------------- smoke (seeded soft sprites) ---------------- */","+const SMOKE_N=340;","+const smokePool=[];","+for(let i=0;i<SMOKE_N;i++){","+  const sp=new THREE.Sprite(new THREE.SpriteMaterial({map:smokeTex,transparent:true,opacity:0,depthWrite:false,color:0xdfe6ec}));","+  sp.visible=false; scene.add(sp);","+  smokePool.push({sp,vel:new THREE.Vector3(),life:0,maxLife:1,size:1,grow:1,op:0.3});","+}","+let smokeIdx=0;","+function spawnSmoke(pos,vel,life,size,op,tint){","+  const p=smokePool[smokeIdx++%SMOKE_N];","+  p.sp.position.copy(pos); p.vel.copy(vel); p.life=life; p.maxLife=life; p.size=size; p.op=op;","+  p.sp.material.color.setHex(tint||0xdfe6ec); p.sp.visible=true;","+}","+function updateSmoke(dt){","+  for(const p of smokePool){","+    if(p.life<=0){ if(p.sp.visible)p.sp.visible=false; continue; }","+    p.life-=dt;","+    p.vel.multiplyScalar(1-1.6*dt); p.vel.y+=0.35*dt;","+    p.sp.position.addScaledVector(p.vel,dt);","+    if(p.sp.position.y<0.25)p.sp.position.y=0.25;","+    const f=clamp(p.life/p.maxLife,0,1);","+    const sc=p.size*(1+(1-f)*2.2);","+    p.sp.scale.set(sc,sc,1);","+    p.sp.material.opacity=p.op*Math.sin(Math.min(1,(1-f)*3)*Math.PI*0.5)*clamp(f*2.2,0,1);","+  }","+}","+function smokeBurst(center,strength,count){","+  for(let i=0;i<count;i++){","+    const a=rng()*Math.PI*2, r=(0.3+rng()*0.7)*strength;","+    const pos=new THREE.Vector3(center.x+(rng()-0.5)*3,Math.max(0.3,center.y-0.6+rng()*0.5),center.z+(rng()-0.5)*2.4);","+    const vel=new THREE.Vector3(Math.cos(a)*r,0.4+rng()*1.4,Math.sin(a)*r*0.8);","+    spawnSmoke(pos,vel,2.2+rng()*2.4,1.6+rng()*2.4,0.34, rng()<0.25?0xe8c9c6:0xdfe6ec);","+  }","+}","+","+/* ---------------- debris (detached parts as rigid bodies) ---------------- */","+const debris=[]; // {mesh,pos,vel,quat,angVel,half,radius}","+function makeDebris(mesh,vel,angVel,half){","+  mesh.update