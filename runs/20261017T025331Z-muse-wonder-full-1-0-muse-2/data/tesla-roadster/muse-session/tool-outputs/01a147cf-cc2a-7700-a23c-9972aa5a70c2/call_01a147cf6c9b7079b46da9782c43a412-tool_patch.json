{"files":[{"hunks":[{"lines":["   }"," }"," ","+/* ---------------- rigid-body step (fixed dt, semi-implicit Euler) ---------------- */","+const cornerState=new Array(8).fill(false);","+const wheelWasContact=[false,false,false,false];","+const _n=new THREE.Vector3(),_tv=new THREE.Vector3(),_lv=new THREE.Vector3(),_F=new THREE.Vector3(),_cp2=new THREE.Vector3();","+function physStep(dt){","+  controller(dt);","+  S.t+=dt;","+  _f.set(0,0,0); _tq.set(0,0,0);","+  _up.set(0,1,0).applyQuaternion(S.q); _fwd.set(1,0,0).applyQuaternion(S.q); _side.set(0,0,1).applyQuaternion(S.q);","+  const m=SET.mass;","+  _f.y-=m*SET.grav;","+  // aero drag","+  _f.addScaledVector(S.v,-0.55*S.v.length());","+  // --- fan downforce (ground effect: only near a surface) ---","+  S.fanKg=0;","+  {","+    _wp.copy(S.p).addScaledVector(_up,-0.5);","+    const sq=surfaceQuery(_wp.x,_wp.y,_wp.z);","+    const d=sq.d+0.5; // approx centre-to-surface along normal","+    if(d<1.5 && d>-0.6 && S.fan>0.001){","+      const fall=clamp((1.5-d)/1.1,0,1);","+      const Ffan=S.fan*SET.fanKgf*9.81*(0.35+0.65*fall);","+      S.fanKg=Ffan/9.81;","+      _F.copy(_up).multiplyScalar(-Ffan);","+      _f.add(_F); // at COM: no torque","+    }","+  }","+  // --- wheels: suspension + tire ---","+  let anyContact=false;","+  const REST=0.30, WR=0.34, K=98000, C=6800, MU=1.38;","+  for(let i=0;i<4;i++){","+    const W=S.wheels[i]; W.load=0; W.contact=false;","+    if(parts[WHEEL_PART[i]].broken){ W.len=REST; wheelWasContact[i]=false; continue; }","+    _wp.copy(WHEEL_LOCAL[i]).applyQuaternion(S.q).add(S.p); // hub mount world","+    const sq=surfaceQuery(_wp.x,_wp.y,_wp.z);","+    const sd=sq.d, snx=sq.nx,sny=sq.ny,snz=sq.nz, stx=sq.tx,sty=sq.ty;","+    const gap=sd-WR; // mount-to-surface minus tyre radius, along normal","+    W.len=clamp(gap,0.07,REST);","+    if(gap<REST){","+      W.contact=true; anyContact=true;","+      const comp=clamp(REST-gap,0,REST); W.comp=comp;","+      pointVel(_wp,_wv);","+      const vn=_wv.x*snx+_wv.y*sny+_wv.z*snz;","+      let Fn=K*comp - C*vn;","+      Fn=clamp(Fn,0,160000); W.load=Fn;","+      // landing impact -> breakage impulse","+      if(!wheelWasContact[i] && vn<-2.2){","+        const imp=(m/4)*Math.abs(vn)*2.1/1000;","+        if(imp>2.6) breakParts(imp,_wp.clone());","+      }","+      if(comp>=REST-0.005 && vn<-3.2){ // bottomed out hard","+        const imp=(m/4)*Math.abs(vn)*2.4/1000;","+        if(imp>3.2) breakParts(imp,_wp.clone());","+      }","+      _n.set(snx,sny,snz);","+      _F.copy(_n).multiplyScalar(Fn); addForceAt(_F,_wp);","+      // tire frame","+      _tv.set(stx,sty,0);","+      if(_tv.dot(_fwd)<0) _tv.negate();","+      _lv.crossVectors(_n,_tv).normalize();","+      const vl=_wv.dot(_tv), vs=_wv.dot(_lv);","+      W.spin+= (vl/WR)*dt;","+      // lateral centring on the ramp lane (steering toward z=0, yaw to lane)","+      let latDes=0;","+      if(sq.ramp||S.phase==='driveout'||S.phase==='climb'){","+        latDes=clamp(-S.p.z*1.1,-1.6,1.6);","+      }","+      let Flong=S.throttle*(SET.driveN/4) - vl*22;","+      // differential drive for yaw-to-lane: left/right split by z error + heading","+      const sideSign=WHEEL_LOCAL[i].z>0?1:-1;","+      Flong+= sideSign*clamp(-S.p.z*900,-2500,2500)*0.25;","+      let Flat=clamp((latDes-vs)*5200,-MU*Fn,MU*Fn);","+      // friction ellipse","+      const fmag=Math.hypot(Flong,Flat), fmax=MU*Fn;","+      if(fmag>fmax && fmag>1){ Flong*=fmax/fmag; Flat*=fmax/fmag; }","+      _F.set(0,0,0).addScaledVector(_tv,Flong).addScaledVector(_lv,Flat);","+      _cp2.copy(_wp).addScaledVector(_n,-WR*0.6);","+      addForceAt(_F,_cp2);","+      wheelWasContact[i]=true;","+    } else { W.comp=0; wheelWasContact[i]=false; }","+  }","+  // --- body corners vs surface (crash contact) ---","+  let bodyContact=false;","+  for(let ci=0;ci<8;ci++){","+    const lx=(ci&1?1:-1)*BODY_HALF.x, ly=(ci&2?1:-1)*BODY_HALF.y, lz=(ci&4?1:-1)*BODY_HALF.z;","+    _wp.set(lx,ly,lz).applyQuaternion(S.q).add(S.p);","+    const sq=surfaceQuery(_wp.x,_wp.y,_wp.z);","+    const sd=sq.d,snx=sq.nx,sny=sq.ny,snz=sq.nz;","+    if(sd<0.03){","+      bodyContact=true;","+      pointVel(_wp,_wv);","+      const vn=_wv.x*snx+_wv.y*sny+_wv.z*snz;","+      if(!cornerState[ci] && vn<-1.4){","+        const imp=m*Math.abs(vn)*0.85/1000;","+        S.impact=Math.max(S.impact,imp);","+        if(imp>2.6) breakParts(imp,_wp.clone());","+        if(Math.abs(vn)>3) smokeBurst(_wp,2.4,8);","+      }","+      cornerState[ci]=true;","+      const pen=0.03-sd;","+      let Fn=clamp(420000*pen - 11000*vn,0,500000);","+      _n.set(snx,sny,snz);","+      _F.copy(_n).multiplyScalar(Fn); addForceAt(_F,_wp);","+      // friction opposing tangential slip","+      _tv.copy(_wv).addScaledVector(_n,-vn);","+      const tsl=_tv.length();","+      if(tsl>0.01){ _F.copy(_tv).multiplyScalar(-Math.min(0.85*Fn, tsl*m*2.2)/tsl); addForceAt(_F,_wp); }","+    } else cornerState[ci]=false;","+  }","+  S.grounded=anyContact||bodyContact;","+  if(S.grounded) S.airT=0; else S.airT+=dt;","+  // touchdown / crash landing detection","+  if((S.phase==='airborne'||S.phase==='hover') && S.grounded && S.phaseT>0.25){","+    _up.set(0,1,0).applyQuaternion(S.q);","+    smokeBurst(S.p,4.2+Math.min(5,Math.abs(S.v.y)), S.crashed?46:80);","+    S.touched=true;","+    setPhase(isWreck()?'wreck':'landed');","+  }","+  // --- thrusters: force = -exhaust dir, applied at nozzle (torque!) ---","+  for(const n of NOZZLES){","+    if(!n.thrust) continue;","+    _wp.copy(n.pos).applyQuaternion(S.q).add(S.p);","+    _F.copy(n.exh).multiplyScalar(-n.thrust).applyQuaternion(S.q);","+    addForceAt(_F,_wp);","+    // ground wash dust","+    if(_wp.y<2.6 && n.thrust>n.maxF*0.25 && rng()<0.24){","+      const gp=new THREE.Vector3(_wp.x+(rng()-0.5)*1.6,0.3,_wp.z+(rng()-0.5)*1.6);","+      const gv=new THREE.Vector3(_F.x*0+ (gp.x-_wp.x)*2.4,0.3+rng()*0.5,(gp.z-_wp.z)*2.4);","+      spawnSmoke(gp,gv,0.9+rng()*0.9,0.9+rng(),0.2);","+    }","+  }","+  // --- integrate ---","+  S.v.addScaledVector(_f,dt/m);","+  S.v.multiplyScalar(1-0.015*dt);","+  S.p.addScaledVector(S.v,dt);","+  // angular: body-frame Euler equation with gyroscopic term","+  _qI.copy(S.q).invert();","+  _tauB.copy(_tq).applyQuaternion(_qI);","+  _v1.copy(S.w).applyQuaternion(_qI); // w body","+  _v2.set(_v1.x*INERTIA.x,_v1.y*INERTIA.y,_v1.z*INERTIA.z);","+  _v3.crossVectors(_v1,_v2);","+  _v1.x+=((_tauB.x-_v3.x)/INERTIA.x)*dt;","+  _v1.y+=((_tauB.y-_v3.y)/INERTIA.y)*dt;","+  _v1.z+=((_tauB.z-_v3.z)/INERTIA.z)*dt;","+  _v1.multiplyScalar(1-0.06*dt);","+  S.w.copy(_v1).applyQuaternion(S.q);","+  const wl=S.w.length();","+  if(wl>1e-6){ _dq.setFromAxisAngle(_v1.copy(S.w).divideScalar(wl),wl*dt); S.q.premultiply(_dq).normalize(); }","+  if(S.p.y<-2){ S.p.y=-2; S.v.y=Math.max(S.v.y,0); } // absolute safety net","+  stepDebris(dt,SET.grav);","+  // fan dust at the foot while climbing away","+  dustT-=dt;","+  if(S.fan>0.5 && S.grounded && S.p.y<3 && dustT<=0){","+    dustT=0.08;","+    spawnSmoke(new THREE.Vector3(S.p.x+(rng()-0.5)*3,0.3,S.p.z+(rng()-0.5)*3),new THREE.Vector3((rng()-0.5)*2,0.3,(rng()-0.5)*2),1.1,1.1,0.14);","+  }","+}","+","+"," "," "," "],"newLines":165,"newStart":879,"oldLines":6,"oldStart":879}],"path":"/tmp/workspace.oOeyMl/app/index.html"}]}