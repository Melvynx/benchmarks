{"files":[{"hunks":[{"lines":["   if(brokeAny){ S.crashed=true; smokeBurst(S.p,3.2,16); }","   return brokeAny;"," }","+function isWreck(){","+  _up.set(0,1,0).applyQuaternion(S.q);","+  const wheelsGone=WHEEL_PART.filter(n=>parts[n].broken).length;","+  return _up.y<0.45 || wheelsGone>=2 || parts.front.broken&&parts.rear.broken;","+}","+","+/* ---------------- flight controller ----------------","+   Reads state only; writes throttle / fan / per-nozzle thrust.","+   It never touches position or orientation. */","+const HOLD_S=()=>PROF_LEN-2.35;","+const _qT=new THREE.Quaternion(), _qE=new THREE.Quaternion(), _qI=new THREE.Quaternion();","+const _tauW=new THREE.Vector3(), _tauB=new THREE.Vector3(), _ax=new THREE.Vector3();","+let stallT=0, reachedSteep=false, noContactT=0, dustT=0;","+function setPhase(p){ S.phase=p; S.phaseT=0; }","+function targetQuatAirborne(){","+  const m=new THREE.Matrix4().makeBasis(new THREE.Vector3(-1,0,0),new THREE.Vector3(0,1,0),new THREE.Vector3(0,0,-1));","+  return new THREE.Quaternion().setFromRotationMatrix(m);","+}","+let qAirTarget=targetQuatAirborne();","+function nozzleById(id){ return NOZZLES.find(n=>n.id===id); }","+function zeroThrusters(){ for(const n of NOZZLES) n.thrust=0; }","+","+function airborneControl(dt,hoverMode){","+  const T=SET.thrusterN;","+  const liftMax=T*0.30, sideMax=T*0.14;","+  _up.set(0,1,0).applyQuaternion(S.q); _fwd.set(1,0,0).applyQuaternion(S.q);","+  // attitude error (world)","+  _qI.copy(S.q).invert(); _qE.copy(qAirTarget).multiply(_qI);","+  if(_qE.w<0){ _qE.x*=-1;_qE.y*=-1;_qE.z*=-1;_qE.w*=-1; }","+  const sinHalf=Math.sqrt(Math.max(0,1-_qE.w*_qE.w));","+  const ang=2*Math.acos(clamp(_qE.w,-1,1));","+  if(sinHalf>1e-4) _ax.set(_qE.x/sinHalf,_qE.y/sinHalf,_qE.z/sinHalf); else _ax.set(1,0,0);","+  const kp=hoverMode?21000:30000, kd=hoverMode?8500:9500;","+  _tauW.copy(_ax).multiplyScalar(ang*kp).addScaledVector(S.w,-kd);","+  if(_tauW.length()>52000) _tauW.setLength(52000);","+  _tauB.copy(_tauW).applyQuaternion(_qI);","+  // vertical control","+  const h=S.p.y-0.95;","+  let vyDes;","+  if(hoverMode){","+    vyDes = S.phaseT<0.75 ? clamp((2.05-S.p.y)*1.6,-1.2,1.2) : -0.55;","+  } else vyDes=-clamp(1.3+h*0.5,1.3,8.0);","+  let Fneed=SET.mass*(SET.grav+2.6*(vyDes-S.v.y));","+  Fneed=clamp(Fneed,0,T*0.98);","+  let baseF = _up.y>0.30 ? clamp(Fneed/Math.max(_up.y,0.3),0,T) : T*0.16;","+  // lift allocation: base + pitch (tau_z via x) + roll (tau_x via -z)","+  const Sx=4*1.45*1.45, Sz=4*0.82*0.82;","+  for(const n of NOZZLES){","+    if(n.kind==='lift'){","+      let f=baseF/4 + _tauB.z*n.pos.x/Sx + (_tauB.x*0.6)*(-n.pos.z)/Sz;","+      n.thrust=clamp(f,0,liftMax);","+    } else if(n.kind==='side'){","+      // torque about body X from this nozzle per newton (exact cross product)","+      const Fx=-n.exh.x, Fy=-n.exh.y, Fz=-n.exh.z;","+      const coeff=n.pos.y*Fz - n.pos.z*Fy;","+      const demand=_tauB.x*0.4;","+      let f=0;","+      if(Math.abs(coeff)>0.02 && Math.sign(coeff)===Math.sign(demand)) f=Math.abs(demand/coeff)*0.5;","+      // yaw: front/rear split on the firing side","+      const yawCoeff=-n.pos.x*Fz;","+      if(f>0 && Math.abs(_tauB.y)>800){","+        if(Math.sign(yawCoeff)===Math.sign(_tauB.y)) f*=1.5; else f*=0.45;","+      }","+      n.thrust=clamp(f,0,sideMax);","+    } else n.thrust=0;","+  }","+  return ang;","+}","+","+function controller(dt){","+  S.phaseT+=dt;","+  const c=closestProfile(S.p.x,S.p.y);","+  S.surfS=c.s; S.surfTh=c.th;","+  const _cs=c.s,_cth=c.th;","+  _fwd.set(1,0,0).applyQuaternion(S.q); _up.set(0,1,0).applyQuaternion(S.q);","+  const vf=S.v.dot(_fwd);","+  const ff=(SET.mass*SET.grav*Math.sin(_cth))/Math.max(SET.driveN,1); // slope feed-forward","+  if(S.grounded) noContactT=0; else noContactT+=dt;","+  if(_cth>1.05) reachedSteep=true;","+","+  switch(S.phase){","+    case 'wait':","+      S.throttle=0; S.fan=lerp(S.fan,0.15,dt*3); zeroThrusters();","+      if(S.phaseT>0.9) setPhase('climb');","+      break;","+    case 'climb': {","+      const fanTgt=0.3+0.7*smooth(0.12,1.15,_cth);","+      S.fan=lerp(S.fan,fanTgt,1-Math.exp(-2.2*dt));","+      const dHold=HOLD_S()-_cs;","+      const vDes=_cs<18?12.5:clamp(dHold*1.1,1.4,12.0);","+      S.throttle=clamp(0.24*(vDes-vf)+ff,-1,1);","+      zeroThrusters();","+      if(noContactT>0.45 && S.t>2){ qAirTarget=targetQuatAirborne(); setPhase('airborne'); break; }","+      if(_cs>=HOLD_S()-0.3 && Math.abs(vf)<2.2){ setPhase('hold'); break; }","+      // stalled / sliding back after getting steep: abort, brake on the flat","+      if(reachedSteep && vf<-2.5) stallT+=dt; else stallT=0;","+      if(stallT>0.5){ setPhase('abort'); }","+      break;","+    }","+    case 'abort':","+      S.fan=lerp(S.fan,0.85,dt*3);","+      S.throttle=clamp(0.3*(0-vf)+ff,-1,1); // brake the rollback","+      zeroThrusters();","+      if(noContactT>0.4){ qAirTarget=targetQuatAirborne(); setPhase('airborne'); }","+      else if(S.grounded && Math.abs(vf)<0.4 && _cth<0.2 && S.phaseT>1) setPhase('failed');","+      break;","+    case 'hold': {","+      S.fan=lerp(S.fan,1,1-Math.exp(-4*dt));","+      const vDes=clamp((HOLD_S()-_cs)*1.6,-1.2,1.2);","+      S.throttle=clamp(0.4*(vDes-vf)+ff,-1,1);","+      zeroThrusters();","+      if(noContactT>0.35){ qAirTarget=targetQuatAirborne(); setPhase('airborne'); break; }","+      if(S.phaseT>=2.0) setPhase('release');","+      break;","+    }","+    case 'release':","+      S.fan=Math.max(0,S.fan-2.6*dt);","+      S.throttle=clamp(0.3*(1.1-vf)+ff*0.4,-1,1);","+      zeroThrusters();","+      if(noContactT>0.12 || S.phaseT>1.4){ qAirTarget=targetQuatAirborne(); setPhase('airborne'); }","+      break;","+    case 'airborne': {","+      S.throttle=0; S.fan=0;","+      const ang=airborneControl(dt,false);","+      const h=S.p.y-0.95;","+      if(h<2.4 && _up.y>0.82 && ang<0.4 && S.v.y>-6) setPhase('hover');","+      break;","+    }","+    case 'hover':","+      S.throttle=0; S.fan=0;","+      airborneControl(dt,true);","+      break;","+    case 'landed':","+      zeroThrusters(); S.throttle=0; S.fan=lerp(S.fan,0.1,dt*4);","+      if(S.phaseT>0.55) setPhase(isWreck()?'wreck':'driveout');","+      break;","+    case 'driveout': {","+      zeroThrusters(); S.fan=lerp(S.fan,0.08,dt*3);","+      const vDes=S.phaseT<2.7?12.5:0;","+      S.throttle=clamp(0.26*(vDes-vf),-1,1);","+      if(S.phaseT>2.7 && Math.abs(vf)<0.35) setPhase('done');","+      if(S.phaseT>9) setPhase('done');","+      break;","+    }","+    default: // done / failed / wreck","+      zeroThrusters(); S.fan=lerp(S.fan,0,dt*3);","+      S.throttle=S.grounded?clamp(-vf*0.25,-0.6,0.6):0;","+  }","+  // per-nozzle caps from settings","+  for(const n of NOZZLES){","+    n.maxF = n.kind==='lift'?SET.thrusterN*0.30 : n.kind==='side'?SET.thrusterN*0.14 : SET.thrusterN*0.08;","+    n.thrust=clamp(n.thrust||0,0,n.maxF);","+  }","+}","+"," "," "," "],"newLines":161,"newStart":724,"oldLines":6,"oldStart":724}],"path":"/tmp/workspace.oOeyMl/app/index.html"}]}