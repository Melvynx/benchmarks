{"files":[{"hunks":[{"lines":["   } else vyDes=-clamp(1.3+h*0.5,1.3,8.0);","   let Fneed=SET.mass*(SET.grav+2.6*(vyDes-S.v.y));","   Fneed=clamp(Fneed,0,T*0.98);","-  let baseF = _up.y>0.30 ? clamp(Fneed/Math.max(_up.y,0.3),0,T) : T*0.16;","+  let baseF = _up.y>0.30 ? clamp(Fneed/Math.max(_up.y,0.3),0,T) : T*0.10;","   // lift allocation: base + pitch (tau_z via x) + roll (tau_x via -z)","   const Sx=4*1.45*1.45, Sz=4*0.82*0.82;","-  for(const n of NOZZLES){","-    if(n.kind==='lift'){","-      let f=baseF/4 + _tauB.z*n.pos.x/Sx + (_tauB.x*0.6)*(-n.pos.z)/Sz;","-      n.thrust=clamp(f,0,liftMax);","-    } else if(n.kind==='side'){","-      // torque about body X from this nozzle per newton (exact cross product)","-      const Fx=-n.exh.x, Fy=-n.exh.y, Fz=-n.exh.z;","-      const coeff=n.pos.y*Fz - n.pos.z*Fy;","-      const demand=_tauB.x*0.4;","-      let f=0;","-      if(Math.abs(coeff)>0.02 && Math.sign(coeff)===Math.sign(demand)) f=Math.abs(demand/coeff)*0.5;","-      // yaw: front/rear split on the firing side","-      const yawCoeff=-n.pos.x*Fz;","-      if(f>0 && Math.abs(_tauB.y)>800){","-        if(Math.sign(yawCoeff)===Math.sign(_tauB.y)) f*=1.5; else f*=0.45;","-      }","-      n.thrust=clamp(f,0,sideMax);","-    } else n.thrust=0;","+  for(const n of NOZZLES) if(n.kind==='lift'){","+    let f=baseF/4 + _tauB.z*n.pos.x/Sx + (_tauB.x*0.55)*(-n.pos.z)/Sz;","+    n.thrust=clamp(f,0,liftMax);","+  }","+  /* side nozzles work in couples so attitude torque does not shove","+     the car sideways; a same-side top+low group gives pure lateral","+     force for station-keeping over the landing spot. */","+  const sideN=NOZZLES.filter(n=>n.kind==='side');","+  for(const n of sideN) n.thrust=0;","+  const tauXper=n=>{ const Fz=-n.exh.z, Fy=-n.exh.y; return n.pos.y*Fz - n.pos.z*Fy; };","+  const tauYper=n=>{ const Fz=-n.exh.z; return -n.pos.x*Fz; };","+  const grp=ids=>ids.map(id=>nozzleById(id));","+  const fireGroup=(g,perN)=>{ for(const n of g) n.thrust=clamp(n.thrust+perN,0,sideMax); };","+  // roll couple: top of one flank + low of the other (net force ~0)","+  {","+    const demand=_tauB.x*0.45;","+    const cplA=grp(['sideFL','sideRL','lowFR','lowRR']);","+    const cplB=grp(['sideFR','sideRR','lowFL','lowRL']);","+    const cA=cplA.reduce((s,n)=>s+tauXper(n),0), cB=cplB.reduce((s,n)=>s+tauXper(n),0);","+    if(Math.abs(demand)>250){","+      if(Math.sign(cA)===Math.sign(demand)) fireGroup(cplA,Math.abs(demand/cA));","+      else if(Math.sign(cB)===Math.sign(demand)) fireGroup(cplB,Math.abs(demand/cB));","+    }","+    // yaw couple: diagonal top pair (net force ~0, net roll ~0)","+    const yawA=grp(['sideFL','sideRR']), yawB=grp(['sideFR','sideRL']);","+    const yA=yawA.reduce((s,n)=>s+tauYper(n),0), yB=yawB.reduce((s,n)=>s+tauYper(n),0);","+    const yDem=_tauB.y*0.85;","+    if(Math.abs(yDem)>250){","+      if(Math.sign(yA)===Math.sign(yDem)) fireGroup(yawA,Math.abs(yDem/yA));","+      else if(Math.sign(yB)===Math.sign(yDem)) fireGroup(yawB,Math.abs(yDem/yB));","+    }","+    // lateral station-keeping: same-side top+low = pure sideways force","+    const vzDes=clamp(-S.p.z*1.1,-2.2,2.2);","+    const FzNeed=clamp(SET.mass*1.9*(vzDes-S.v.z),-15000,15000);","+    if(Math.abs(FzNeed)>500){","+      const side = FzNeed>0 ? grp(['sideFR','sideRR','lowFR','lowRR']) : grp(['sideFL','sideRL','lowFL','lowRL']);","+      fireGroup(side,Math.abs(FzNeed)/4);","+    }","+  }","+  /* rear nozzles: translate toward the landing spot at the foot of","+     the ramp and clear the ramp face below the lip. */","+  {","+    const xTgt=-8;","+    const vxDes=clamp((xTgt-S.p.x)*0.5,-8.5,1.5);","+    const axNeed=1.9*(vxDes-S.v.x);","+    let fTot=0;","+    if(_fwd.x<-0.12 && axNeed<0) fTot=clamp(SET.mass*axNeed/_fwd.x,0,SET.thrusterN*0.16);","+    if(_fwd.x>0.12 && axNeed>0) fTot=clamp(SET.mass*axNeed/_fwd.x,0,SET.thrusterN*0.16);","+    nozzleById('rearL').thrust=fTot/2; nozzleById('rearR').thrust=fTot/2;","   }","   return ang;"," }"]