{"files":[{"hunks":[{"lines":[" function nozzleById(id){ return NOZZLES.find(n=>n.id===id); }"," function zeroThrusters(){ for(const n of NOZZLES) n.thrust=0; }"," ","+const _upT=new THREE.Vector3(),_xT=new THREE.Vector3(),_zT=new THREE.Vector3(),_m4=new THREE.Matrix4();"," function airborneControl(dt,hoverMode){","   const T=SET.thrusterN;","   const liftMax=T*0.30, sideMax=T*0.14;","-  _up.set(0,1,0).applyQuaternion(S.q); _fwd.set(1,0,0).applyQuaternion(S.q);","+  _up.set(0,1,0).applyQuaternion(S.q); _fwd.set(1,0,0).applyQuaternion(S.q); _side.set(0,0,1).applyQuaternion(S.q);","+  /* horizontal guidance: desired velocity over the landing spot,","+     turned into a small tilt of the lift vector (that is how the","+     jets translate the car without a sideways shove). */","+  const vxDes=clamp((-8-S.p.x)*0.5,-7.0,1.5);","+  const vzDes=clamp(-S.p.z*1.1,-2.2,2.2);","+  const axDes=clamp(1.7*(vxDes-S.v.x),-4.5,4.5);","+  const azDes=clamp(1.7*(vzDes-S.v.z),-4.0,4.0);","+  _upT.set(axDes/SET.grav,1,azDes/SET.grav).normalize();","+  _xT.crossVectors(_upT,_zT.set(0,0,-1)).normalize();","+  _zT.crossVectors(_xT,_upT);","+  _qT.setFromRotationMatrix(_m4.makeBasis(_xT,_upT,_zT));","   // attitude error (world)","-  _qI.copy(S.q).invert(); _qE.copy(qAirTarget).multiply(_qI);","+  _qI.copy(S.q).invert(); _qE.copy(_qT).multiply(_qI);","   if(_qE.w<0){ _qE.x*=-1;_qE.y*=-1;_qE.z*=-1;_qE.w*=-1; }","   const sinHalf=Math.sqrt(Math.max(0,1-_qE.w*_qE.w));","   const ang=2*Math.acos(clamp(_qE.w,-1,1));"],"newLines":24,"newStart":750,"oldLines":12,"oldStart":750}],"path":"/tmp/workspace.oOeyMl/app/index.html"}]}