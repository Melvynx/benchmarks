
/* lights */
scene.add(new THREE.AmbientLight(0x1c2634,0.22));
const key=new THREE.SpotLight(0xf2f6ff, 1900, 160, 0.5, 0.5, 1.75);
key.position.set(-26,30,26); key.castShadow=true;
key.shadow.mapSize.set(2048,2048); key.shadow.bias=-0.002; key.shadow.normalBias=0.06; key.shadow.camera.near=5; key.shadow.camera.far=160;
key.target.position.set(2,8,0); scene.add(key,key.target);
const rim=new THREE.DirectionalLight(0x8fb4d8,0.45); rim.position.set(30,24,-30); scene.add(rim);
const footLight=new THREE.SpotLight(0xffffff,900,70,0.55,0.6,1.7);
footLight.position.set(-14,9,-16); footLight.target.position.set(-6,0,0); scene.add(footLight,footLight.target);
// dedicated wash on the running surface so the ramp reads from every side camera
const faceLight=new THREE.SpotLight(0xeef2f7,3000,120,0.5,0.9,1.9);
faceLight.position.set(-19,13,17); faceLight.target.position.set(4,10,0); scene.add(faceLight,faceLight.target);

