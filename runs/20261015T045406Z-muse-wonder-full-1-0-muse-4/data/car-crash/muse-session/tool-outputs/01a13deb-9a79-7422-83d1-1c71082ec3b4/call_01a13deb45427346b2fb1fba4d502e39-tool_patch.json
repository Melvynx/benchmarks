{"files":[{"path":"/private/var/folders/7z/5mtgxwxx4zs9ppgzm942gbmh0000gn/T/workspace.aiZgiG/app/index.html","hunks":[{"oldStart":210,"oldLines":3,"newStart":210,"newLines":114,"lines":["     }","   }"," }","+","+/* ================= Scene ================= */","+const WALL_LEFT = 17.0, CAR_START_X = 3.4;","+const state = {bricks:[], car:null, launched:false, braking:false, time:0, settledFor:0, wheelAngle:0, shake:0, particles:[], skids:[]};","+function buildScene(){","+  seed = 1234567;","+  state.bricks.length=0; state.particles.length=0; state.skids.length=0;","+  state.launched=false; state.braking=false; state.time=0; state.settledFor=0; state.wheelAngle=0; state.shake=0;","+  const bw=FIXED.brickW, bh=FIXED.brickH, gap=0.004;","+  const cols=Math.round(settings.cols), rows=Math.round(settings.rows), depth=Math.round(settings.depth);","+  for(let L=0;L<depth;L++){","+    for(let r=0;r<rows;r++){","+      const stagger=(r%2===1)? bw/2:0;","+      for(let c=0;c<cols;c++){","+        const b=makeBody({x:WALL_LEFT + c*bw + bw/2 + stagger + L*0.02, y:bh/2 + r*bh,","+          w:bw-gap, h:bh-gap, mass:settings.brickMass, kind:\"brick\", layer:L,","+          friction:FIXED.brickFriction, rest:FIXED.restitution});","+        b.idx = state.bricks.length;","+        state.bricks.push(b);","+      }","+    }","+  }","+  state.car = makeBody({x:CAR_START_X, y:FIXED.carH/2+0.02, w:FIXED.carW, h:FIXED.carH*0.72,","+    mass:FIXED.carMass, kind:\"car\", layer:-1, friction:0.6, rest:0.08});","+  // car gets extra rotational inertia so it pitches/recoils but does not flip unrealistically","+  state.car.inertia*=2.2; state.car.invI=1/state.car.inertia;","+  updateStatus(\"Ready — press Test to launch.\");","+}","+function launch(){","+  buildScene();","+  state.car.vx = settings.speed;","+  state.launched = true;","+  updateStatus(\"Running… car launched at \"+settings.speed.toFixed(1)+\" m/s.\");","+}","+/* Spatial-hash broadphase (cell = brick width) */","+function candidatePairs(){","+  const cell=0.55, map=new Map(), pairs=[], all=state.bricks;","+  const key=(cx,cy)=>cx*100000+cy;","+  for(const b of all){","+    const r=0.45; // approx half-diagonal bound for a brick","+    const x0=Math.floor((b.x-r)/cell), x1=Math.floor((b.x+r)/cell);","+    const y0=Math.floor((b.y-r)/cell), y1=Math.floor((b.y+r)/cell);","+    for(let cx=x0;cx<=x1;cx++)for(let cy=y0;cy<=y1;cy++){","+      const k=key(cx,cy); if(!map.has(k))map.set(k,[]); map.get(k).push(b);","+    }","+  }","+  const seen=new Set();","+  for(const list of map.values()){","+    for(let i=0;i<list.length;i++)for(let j=i+1;j<list.length;j++){","+      const A=list[i],B=list[j];","+      if(A.layer!==B.layer) continue; // parallel depth planes","+      const id=A.idx< B.idx? A.idx*100000+B.idx : B.idx*100000+A.idx;","+      if(seen.has(id))continue; seen.add(id);","+      if(Math.abs(A.x-B.x)<0.75 && Math.abs(A.y-B.y)<0.55) pairs.push([A,B]);","+    }","+  }","+  return pairs;","+}","+function stepPhysics(dt){","+  impactEnergy=0;","+  const bodies=[state.car,...state.bricks];","+  for(const b of bodies){","+    b.vy -= FIXED.gravity*dt;","+    // mild air/angular damping + extra damping for near-rest bricks (stability)","+    b.vx*=0.9995; b.vy*=0.9995; b.av*=0.995;","+    const sp2=b.vx*b.vx+b.vy*b.vy;","+    if(b.kind===\"brick\" && sp2<0.006 && Math.abs(b.av)<0.15){ b.vx*=0.88; b.vy*=0.88; b.av*=0.8; }","+    // clamp for numerical safety","+    const sp=Math.hypot(b.vx,b.vy); if(sp>60){b.vx*=60/sp;b.vy*=60/sp;}","+    b.av=Math.max(-28,Math.min(28,b.av));","+    b.x+=b.vx*dt; b.y+=b.vy*dt; b.a+=b.av*dt;","+    if(b.a>Math.PI)b.a-=2*Math.PI; if(b.a<-Math.PI)b.a+=2*Math.PI;","+    if(b.x<-4){b.x=-4;b.vx=Math.abs(b.vx)*0.3;}","+  }","+  state.wheelAngle += (state.car.vx/0.33)*dt;","+  if(state.braking && Math.abs(state.car.vx)>2) state.skids.push({x:state.car.x-1.2,y:0.02});","+  if(state.skids.length>600) state.skids.splice(0, state.skids.length-600);","+  for(let iter=0;iter<5;iter++){","+    // car vs bricks (AABB pre-check, all layers)","+    const car=state.car;","+    for(const br of state.bricks){","+      if(Math.abs(br.x-car.x) < (car.w+br.w)/2+0.35 && Math.abs(br.y-car.y) < (car.h+br.h)/2+0.35){","+        const c=collideOBB(car,br);","+        if(c){","+          if(!state.braking){ state.braking=true; car.crumple=Math.min(0.4,Math.abs(car.vx)*0.012); spawnDust(c.px,c.py,26); state.shake=Math.min(14,4+Math.abs(car.vx)*0.35); }","+          solveContact(car,br,c,dt);","+        }","+      }","+    }","+    for(const [A,B] of candidatePairs()){","+      const c=collideOBB(A,B); if(c) solveContact(A,B,c,dt);","+    }","+    for(const b of bodies) solveGround(b,dt);","+  }","+  if(impactEnergy>4000){ state.shake=Math.min(12,state.shake+impactEnergy/60000); spawnDust(state.car.x+state.car.w/2,0.7,4); }","+  if(state.launched) state.time+=dt;","+  stepParticles(dt);","+}","+function spawnDust(x,y,n){","+  for(let i=0;i<n;i++){","+    state.particles.push({x:x+(srand()-0.5)*0.4,y:y+(srand()-0.5)*0.4,","+      vx:(srand()-0.3)*2.4,vy:srand()*2.2,life:0.7+srand()*0.8,t:0,r:0.08+srand()*0.22});","+  }","+  if(state.particles.length>320) state.particles.splice(0,state.particles.length-320);","+}","+function stepParticles(dt){","+  for(const p of state.particles){ p.t+=dt; p.x+=p.vx*dt; p.y+=p.vy*dt; p.vy-=1.2*dt; p.vx*=0.98; }","+  state.particles=state.particles.filter(p=>p.t<p.life);","+  state.shake*=0.90; if(state.shake<0.05)state.shake=0;","+  if(state.car) state.car.crumple*=0.999;","+}"]}]}]}