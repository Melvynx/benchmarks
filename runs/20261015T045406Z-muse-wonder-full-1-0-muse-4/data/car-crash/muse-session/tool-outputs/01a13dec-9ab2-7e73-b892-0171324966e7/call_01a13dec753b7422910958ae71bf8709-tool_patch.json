{"files":[{"path":"/private/var/folders/7z/5mtgxwxx4zs9ppgzm942gbmh0000gn/T/workspace.aiZgiG/app/index.html","hunks":[{"oldStart":444,"oldLines":3,"newStart":444,"newLines":67,"lines":["   }","   ctx.restore();"," }","+","+/* ================= UI ================= */","+const $=id=>document.getElementById(id);","+function updateStatus(t){ const el=$(\"status\"); if(el) el.textContent=t; }","+function fmt(p,v){ return (p.step<1? Number(v).toFixed(1): Math.round(v))+\" \"+p.unit; }","+function buildControls(){","+  const host=$(\"controls\"); host.innerHTML=\"\";","+  for(const p of PARAMS){","+    const div=document.createElement(\"div\"); div.className=\"ctl\";","+    div.innerHTML=`<label>${p.label} <output id=\"out-${p.key}\">${fmt(p,settings[p.key])}</output></label>","+      <div class=\"row\"><input type=\"range\" id=\"rng-${p.key}\" min=\"${p.min}\" max=\"${p.max}\" step=\"${p.step}\" value=\"${settings[p.key]}\">","+      <input type=\"number\" id=\"num-${p.key}\" min=\"${p.min}\" max=\"${p.max}\" step=\"${p.step}\" value=\"${settings[p.key]}\"></div>","+      <div class=\"hint\">Range ${p.min} – ${p.max} ${p.unit} · default ${fmt(p,p.def)}</div>`;","+    host.appendChild(div);","+    const rng=div.querySelector(`#rng-${p.key}`), num=div.querySelector(`#num-${p.key}`), out=div.querySelector(`#out-${p.key}`);","+    const apply=v=>{","+      v=Math.max(p.min,Math.min(p.max,Number(v)||p.def));","+      if(p.step>=1)v=Math.round(v);","+      settings[p.key]=v; rng.value=v; num.value=v; out.textContent=fmt(p,v);","+      camX=-1.2; buildScene(); // preview new wall/car, nothing else changes","+    };","+    rng.addEventListener(\"input\",()=>apply(rng.value));","+    num.addEventListener(\"change\",()=>apply(num.value));","+  }","+}","+$(\"btnTest\").addEventListener(\"click\",()=>{ camX=-1.2; launch(); });","+$(\"btnReset\").addEventListener(\"click\",()=>{ camX=-1.2; buildScene(); });","+window.addEventListener(\"keydown\",e=>{","+  if(e.key===\" \"||e.key===\"Enter\"){ if(document.activeElement.tagName!==\"INPUT\"){ e.preventDefault(); camX=-1.2; launch(); } }","+  if(e.key.toLowerCase()===\"r\" && document.activeElement.tagName!==\"INPUT\"){ camX=-1.2; buildScene(); }","+});","+function updateTelemetry(){","+  const car=state.car; if(!car)return;","+  $(\"tSpeed\").textContent=Math.abs(car.vx).toFixed(1);","+  $(\"tTime\").textContent=state.time.toFixed(2);","+  let moving=0; for(const b of state.bricks){ if(b.vx*b.vx+b.vy*b.vy>0.04||Math.abs(b.av)>0.4) moving++; }","+  $(\"tMoving\").textContent=moving;","+  $(\"tBricks\").textContent=state.bricks.length;","+  $(\"tKe\").textContent=(0.5*car.mass*car.vx*car.vx/1000).toFixed(0);","+  $(\"tMom\").textContent=(car.mass*Math.abs(car.vx)/1000).toFixed(1);","+  if(state.launched){","+    if(Math.abs(car.vx)<0.15 && moving===0){","+      state.settledFor+=1/60;","+      if(state.settledFor>0.8) updateStatus(\"Settled — press Test to run it again.\");","+    } else state.settledFor=0;","+  }","+}","+/* ================= Main loop (fixed-step, deterministic) ================= */","+buildControls(); buildScene(); resize();","+const DT=1/180; let acc=0,last=performance.now();","+function frame(now){","+  requestAnimationFrame(frame);","+  let elapsed=(now-last)/1000; last=now;","+  if(elapsed>0.06)elapsed=0.06;","+  acc+=elapsed;","+  let n=0;","+  while(acc>=DT && n<14){ stepPhysics(DT); acc-=DT; n++; }","+  if(n===14)acc=0;","+  draw(); updateTelemetry();","+}","+requestAnimationFrame(frame);","+</script>","+</body>","+</html>"]}]}]}