{"files":[{"path":"/private/var/folders/7z/5mtgxwxx4zs9ppgzm942gbmh0000gn/T/workspace.aiZgiG/app/index.html","hunks":[{"oldStart":321,"oldLines":3,"newStart":321,"newLines":126,"lines":["   state.shake*=0.90; if(state.shake<0.05)state.shake=0;","   if(state.car) state.car.crumple*=0.999;"," }","+","+/* ================= Rendering ================= */","+const cv=document.getElementById(\"cv\"), ctx=cv.getContext(\"2d\");","+let viewW=27, camX=-1.2;","+function resize(){","+  const r=document.getElementById(\"stage\").getBoundingClientRect();","+  const dpr=Math.min(window.devicePixelRatio||1,2);","+  cv.width=Math.max(320,Math.round(r.width*dpr)); cv.height=Math.max(240,Math.round(r.height*dpr));","+}","+window.addEventListener(\"resize\",resize);","+function brickColor(b){","+  // deterministic variation by index (no RNG in physics/render state)","+  const h=((b.idx*2654435761)>>>0)%100/100;","+  const lBack=b.layer*7;","+  const R=Math.round(168+h*34-lBack), G=Math.round(72+h*20-lBack*0.6), B=Math.round(48+h*12-lBack*0.4);","+  return `rgb(${R},${G},${B})`;","+}","+function draw(){","+  const W=cv.width,H=cv.height; if(!W||!H)return;","+  const wallRight=WALL_LEFT+Math.round(settings.cols)*FIXED.brickW+1;","+  viewW=Math.max(26, wallRight+5);","+  // camera: stay wide enough to show start+wall, gently follow car past mid-view","+  const desired=Math.max(-1.2, Math.min(state.car.x-viewW*0.32, wallRight-viewW+4));","+  camX+= (desired-camX)*0.06; if(Math.abs(desired-camX)<0.001)camX=desired;","+  const scale=Math.min(FIXED.nominalScale*(window.devicePixelRatio||1), W/viewW, H/8.5);","+  const groundY=H*0.80;","+  const shx=state.shake? (srand()-0.5)*state.shake*2:0, shy=state.shake? (srand()-0.5)*state.shake:0;","+  const X=x=>(x-camX)*scale+shx, Y=y=>groundY-y*scale+shy;","+  // sky","+  const sky=ctx.createLinearGradient(0,0,0,groundY);","+  sky.addColorStop(0,\"#6fa8cf\"); sky.addColorStop(0.7,\"#a8cbe4\"); sky.addColorStop(1,\"#d9e8f2\");","+  ctx.fillStyle=sky; ctx.fillRect(0,0,W,H);","+  // sun + deterministic clouds","+  ctx.fillStyle=\"rgba(255,236,170,.95)\"; ctx.beginPath(); ctx.arc(W*0.88,H*0.13,26*(W/1100+0.4),0,7); ctx.fill();","+  ctx.fillStyle=\"rgba(255,255,255,.82)\";","+  const clouds=[[3,5.6,1.6],[9,6.3,2.1],[15,5.8,1.4],[21,6.5,1.9],[26,5.5,1.5]];","+  for(const [cx,cy,cw] of clouds){ const px=X(cx),py=Y(cy); if(px<-200||px>W+200)continue;","+    ctx.beginPath(); ctx.ellipse(px,py,cw*scale*0.5,scale*0.22,0,0,7); ctx.ellipse(px+cw*scale*0.3,py+4,cw*scale*0.38,scale*0.17,0,0,7); ctx.fill(); }","+  // distant hills/buildings","+  ctx.fillStyle=\"rgba(90,120,140,.35)\";","+  for(let i=0;i<14;i++){ const bx=X(i*2.4-1), bh=(0.7+((i*37)%10)/10*0.9)*scale; if(bx>-80&&bx<W+80) ctx.fillRect(bx,groundY-bh,scale*1.1,bh); }","+  // ground / track","+  ctx.fillStyle=\"#5d6b5a\"; ctx.fillRect(0,groundY,W,H-groundY);","+  ctx.fillStyle=\"#3c434b\"; ctx.fillRect(0,groundY,W,scale*0.55);","+  ctx.fillStyle=\"#4a525c\"; ctx.fillRect(0,groundY,W,3);","+  ctx.fillStyle=\"rgba(255,255,255,.75)\";","+  const m0=Math.floor(camX)-1, m1=m0+Math.ceil(viewW)+3;","+  for(let m=m0;m<m1;m++){ if(m%2===0) ctx.fillRect(X(m),groundY+scale*0.24,scale*0.55,3); }","+  ctx.fillStyle=\"rgba(255,255,255,.55)\"; ctx.font=`${Math.max(9,scale*0.16)}px system-ui`; ctx.textAlign=\"center\";","+  for(let m=m0;m<m1;m++){ if(m>=0&&m%5===0) ctx.fillText(m+\" m\",X(m),groundY+scale*0.78); }","+  // skid marks","+  ctx.fillStyle=\"rgba(15,15,15,.5)\";","+  for(const s of state.skids) ctx.fillRect(X(s.x),Y(0.06),scale*0.3,3);","+  // start marker + wall zone label","+  ctx.fillStyle=\"rgba(20,40,60,.75)\"; ctx.font=`700 ${Math.max(10,scale*0.2)}px system-ui`;","+  ctx.fillText(\"START\",X(CAR_START_X),Y(3.4)); ctx.fillText(\"BRICK WALL\",X(WALL_LEFT+Math.round(settings.cols)*FIXED.brickW/2),Y(Math.round(settings.rows)*FIXED.brickH+0.55));","+  // bricks: back layers first, with small pseudo-depth screen offset","+  const sorted=[...state.bricks].sort((a,b)=>b.layer-a.layer);","+  for(const b of sorted){","+    const offx=b.layer*scale*0.07, offy=-b.layer*scale*0.05;","+    ctx.save(); ctx.translate(X(b.x)+offx,Y(b.y)+offy); ctx.rotate(-b.a);","+    const w=b.w*scale,h=b.h*scale;","+    ctx.fillStyle=\"rgba(0,0,0,.18)\"; ctx.fillRect(-w/2+2,-h/2+3,w,h);","+    ctx.fillStyle=brickColor(b); ctx.fillRect(-w/2,-h/2,w,h);","+    ctx.strokeStyle=\"rgba(60,25,15,.85)\"; ctx.lineWidth=Math.max(1,scale*0.02); ctx.strokeRect(-w/2,-h/2,w,h);","+    ctx.fillStyle=\"rgba(255,255,255,.16)\"; ctx.fillRect(-w/2,-h/2,w,Math.max(2,h*0.18));","+    ctx.fillStyle=\"rgba(0,0,0,.14)\"; ctx.fillRect(-w/2,h/2-Math.max(2,h*0.16),w,Math.max(2,h*0.16));","+    ctx.restore();","+  }","+  drawCar(X,Y,scale);","+  // dust","+  for(const p of state.particles){","+    ctx.fillStyle=`rgba(195,170,140,${0.35*(1-p.t/p.life)})`;","+    ctx.beginPath(); ctx.arc(X(p.x),Y(p.y),p.r*scale*(1+p.t),0,7); ctx.fill();","+  }","+  // HUD overlay on canvas","+  ctx.fillStyle=\"rgba(10,22,36,.72)\"; const hudW=Math.min(430,W-16);","+  roundRect(8,8,hudW,54,10); ctx.fill();","+  ctx.fillStyle=\"#fff\"; ctx.textAlign=\"left\"; ctx.font=`700 ${Math.max(12,scale*0.22)}px system-ui`;","+  ctx.fillText(`Speed ${Math.abs(state.car.vx).toFixed(1)} m/s   ·   ${(Math.abs(state.car.vx)*3.6).toFixed(0)} km/h   ·   t = ${state.time.toFixed(2)} s`,18,32);","+  ctx.font=`${Math.max(10,scale*0.17)}px system-ui`; ctx.fillStyle=\"#cfe0ef\";","+  ctx.fillText(state.launched?(state.braking?\"Impact — momentum transferring to bricks\":\"Approaching wall…\"):\"Press Test to launch\",18,52);","+}","+function roundRect(x,y,w,h,r){ ctx.beginPath(); ctx.moveTo(x+r,y); ctx.arcTo(x+w,y,x+w,y+h,r); ctx.arcTo(x+w,y+h,x,y+h,r); ctx.arcTo(x,y+h,x,y,r); ctx.arcTo(x,y,x+w,y,r); ctx.closePath(); }","+function drawCar(X,Y,scale){","+  const car=state.car, cr=car.crumple||0;","+  ctx.save(); ctx.translate(X(car.x),Y(car.y)); ctx.rotate(-car.a);","+  const w=FIXED.carW*scale, bodyH=FIXED.carH*scale;","+  const nose=(0.5-cr*0.35)*w, tail=-0.5*w, base=bodyH*0.36, roof=-bodyH*0.14;","+  // shadow","+  ctx.fillStyle=\"rgba(0,0,0,.25)\"; ctx.beginPath(); ctx.ellipse(0,bodyH*0.5,w*0.48,scale*0.09,0,0,7); ctx.fill();","+  // body","+  const grad=ctx.createLinearGradient(0,roof,0,base); grad.addColorStop(0,\"#e8452c\"); grad.addColorStop(0.55,\"#c92f1d\"); grad.addColorStop(1,\"#8f1f12\");","+  ctx.fillStyle=grad; ctx.beginPath();","+  ctx.moveTo(tail,base); ctx.lineTo(tail,-bodyH*0.05); ctx.lineTo(-w*0.28,-bodyH*0.08);","+  ctx.lineTo(-w*0.12,roof-bodyH*0.18); ctx.lineTo(w*0.16,roof-bodyH*0.18); ctx.lineTo(w*0.30,-bodyH*0.06);","+  ctx.lineTo(nose,-bodyH*0.02+cr*scale*0.2); ctx.lineTo(nose-cr*scale*0.3,base); ctx.closePath(); ctx.fill();","+  ctx.strokeStyle=\"rgba(70,10,5,.7)\"; ctx.lineWidth=Math.max(1,scale*0.02); ctx.stroke();","+  // crumple lines","+  if(cr>0.03){ ctx.strokeStyle=\"rgba(60,10,5,.8)\"; for(let i=0;i<3;i++){ ctx.beginPath(); ctx.moveTo(nose-scale*(0.12+i*0.13),-bodyH*0.02); ctx.lineTo(nose-scale*(0.2+i*0.13),base*0.8); ctx.stroke(); } }","+  // cabin windows","+  ctx.fillStyle=\"#bfe3f5\"; ctx.beginPath();","+  ctx.moveTo(-w*0.20,-bodyH*0.10); ctx.lineTo(-w*0.10,roof-bodyH*0.13); ctx.lineTo(-w*0.01,roof-bodyH*0.13); ctx.lineTo(-w*0.01,-bodyH*0.10); ctx.closePath(); ctx.fill();","+  ctx.beginPath(); ctx.moveTo(w*0.02,-bodyH*0.10); ctx.lineTo(w*0.02,roof-bodyH*0.13); ctx.lineTo(w*0.14,roof-bodyH*0.13); ctx.lineTo(w*0.24,-bodyH*0.10); ctx.closePath(); ctx.fill();","+  // trim, door, headlight, bumper","+  ctx.fillStyle=\"rgba(255,255,255,.2)\"; ctx.fillRect(tail+4,-bodyH*0.02,w*0.9,Math.max(2,scale*0.05));","+  ctx.strokeStyle=\"rgba(0,0,0,.35)\"; ctx.strokeRect(-w*0.05,-bodyH*0.08,w*0.2,bodyH*0.34);","+  ctx.fillStyle=\"#ffe9a8\"; ctx.fillRect(nose-scale*0.16,-bodyH*0.0,scale*0.13,scale*0.11);","+  ctx.fillStyle=\"#2b2b2b\"; ctx.fillRect(nose-scale*0.1,base-scale*0.13,scale*0.12,scale*0.13);","+  ctx.fillStyle=\"#7a1710\"; ctx.fillRect(tail,0,scale*0.1,scale*0.1);","+  // wheels","+  for(const wx of [-w*0.32,w*0.30]){","+    ctx.save(); ctx.translate(wx,bodyH*0.36);","+    ctx.fillStyle=\"#15181c\"; ctx.beginPath(); ctx.arc(0,0,scale*0.33,0,7); ctx.fill();","+    ctx.fillStyle=\"#39424e\"; ctx.beginPath(); ctx.arc(0,0,scale*0.32,0,7); ctx.fill();","+    ctx.fillStyle=\"#15181c\"; ctx.beginPath(); ctx.arc(0,0,scale*0.27,0,7); ctx.fill();","+    ctx.rotate(-state.wheelAngle); ctx.fillStyle=\"#c7d2dd\";","+    for(let s=0;s<5;s++){ ctx.rotate(Math.PI*2/5); ctx.fillRect(-scale*0.03,-scale*0.2,scale*0.06,scale*0.2); }","+    ctx.beginPath(); ctx.arc(0,0,scale*0.07,0,7); ctx.fillStyle=\"#e8eef5\"; ctx.fill();","+    ctx.restore();","+  }","+  ctx.restore();","+}"]}]}]}