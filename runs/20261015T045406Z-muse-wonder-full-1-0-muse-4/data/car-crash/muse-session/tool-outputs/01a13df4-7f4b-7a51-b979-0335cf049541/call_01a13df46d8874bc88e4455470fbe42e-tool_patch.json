{"files":[{"path":"/private/var/folders/7z/5mtgxwxx4zs9ppgzm942gbmh0000gn/T/workspace.aiZgiG/app/index.html","hunks":[{"oldStart":158,"oldLines":8,"newStart":158,"newLines":13,"lines":["   b.av+=(rx*jy-ry*jx)*b.invI;"," }"," function solveContact(A,B,c,dt){","-  // A or B may be null meaning static ground handled separately.","-  const va=velAt(A,c.px,c.py), vb=velAt(B,c.px,c.py);","+  for(const [px,py] of c.pts) solvePoint(A,B,c,px,py,dt);","+  const corr=Math.max(c.pen-0.001,0)*0.6/(A.invM+B.invM);","+  A.x-=c.nx*corr*A.invM; A.y-=c.ny*corr*A.invM;","+  B.x+=c.nx*corr*B.invM; B.y+=c.ny*corr*B.invM;","+}","+function solvePoint(A,B,c,px,py,dt){","+  const va=velAt(A,px,py), vb=velAt(B,px,py);","   const rvx=vb.x-va.x, rvy=vb.y-va.y;","   const vn=rvx*c.nx+rvy*c.ny;","   const raCn=va.rx*c.ny-va.ry*c.nx, rbCn=vb.rx*c.ny-vb.ry*c.nx;"]}]}]}