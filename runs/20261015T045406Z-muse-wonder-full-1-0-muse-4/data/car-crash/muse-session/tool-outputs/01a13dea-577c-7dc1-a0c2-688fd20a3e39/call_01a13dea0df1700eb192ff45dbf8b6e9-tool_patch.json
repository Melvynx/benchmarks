{"files":[{"path":"/private/var/folders/7z/5mtgxwxx4zs9ppgzm942gbmh0000gn/T/workspace.aiZgiG/app/index.html","hunks":[{"oldStart":1,"oldLines":0,"newStart":1,"newLines":95,"lines":["+<!DOCTYPE html>","+<html lang=\"en\">","+<head>","+<meta charset=\"UTF-8\">","+<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">","+<title>muse-wonder-full-1.0</title>","+<style>","+*{box-sizing:border-box;margin:0;padding:0}","+:root{--bg:#0e141b;--panel:#16202c;--panel2:#1c2a3a;--line:#2a3d52;--txt:#e8eef5;--mut:#93a5b8;--acc:#ffb020;--acc2:#ff7847;--ok:#39d98a}","+html,body{height:100%}","+body{background:var(--bg);color:var(--txt);font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;overflow:hidden;display:flex;flex-direction:column}","+header{display:flex;align-items:center;gap:14px;padding:10px 16px;background:linear-gradient(90deg,#131e2b,#182838);border-bottom:1px solid var(--line);flex-wrap:wrap;z-index:5}","+.brand{font-size:20px;font-weight:800;letter-spacing:.2px;white-space:nowrap}","+.brand span{color:var(--acc)}","+.sub{font-size:12px;color:var(--mut);white-space:nowrap}","+.spacer{flex:1}","+.btn{border:0;border-radius:10px;padding:10px 18px;font-weight:800;font-size:14px;cursor:pointer;letter-spacing:.3px}","+.btn-test{background:linear-gradient(180deg,#ffc53d,#ff9f1a);color:#231600;box-shadow:0 4px 18px rgba(255,176,32,.35);min-width:110px}","+.btn-test:hover{filter:brightness(1.07)} .btn-test:active{transform:translateY(1px)}","+.btn-reset{background:#24364c;color:var(--txt);border:1px solid var(--line)}","+.btn-reset:hover{background:#2c425e}","+main{flex:1;display:flex;min-height:0}","+#stage{flex:1;position:relative;min-width:0;background:#87b7d9}","+canvas{display:block;width:100%;height:100%}","+aside{width:300px;flex:0 0 300px;background:var(--panel);border-left:1px solid var(--line);padding:14px;overflow-y:auto}","+aside h2{font-size:13px;text-transform:uppercase;letter-spacing:1.2px;color:var(--mut);margin:4px 0 12px}","+.ctl{background:var(--panel2);border:1px solid var(--line);border-radius:12px;padding:10px 12px;margin-bottom:10px}","+.ctl label{display:flex;justify-content:space-between;font-size:13px;font-weight:700;margin-bottom:8px}","+.ctl label output{color:var(--acc);font-variant-numeric:tabular-nums}","+.ctl .row{display:flex;gap:8px;align-items:center}","+input[type=range]{flex:1;accent-color:var(--acc);height:22px}","+input[type=number]{width:74px;background:#0f1924;color:var(--txt);border:1px solid var(--line);border-radius:8px;padding:6px 7px;font-size:13px}","+.hint{font-size:11px;color:var(--mut);margin-top:5px;line-height:1.45}","+.tele{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:12px 0}","+.stat{background:#0f1924;border:1px solid var(--line);border-radius:10px;padding:9px 10px}","+.stat b{display:block;font-size:18px;font-variant-numeric:tabular-nums}","+.stat span{font-size:10px;text-transform:uppercase;letter-spacing:.8px;color:var(--mut)}","+.defaults{font-size:11.5px;color:var(--mut);line-height:1.65;background:#0f1924;border:1px solid var(--line);border-radius:10px;padding:10px 12px}","+.defaults b{color:var(--txt)}","+#status{font-size:12px;color:var(--ok);font-weight:700;margin:8px 2px;min-height:16px}","+@media(max-width:820px){aside{width:250px;flex-basis:250px}.sub{display:none}}","+@media(max-width:640px){main{flex-direction:column}aside{width:100%;flex:0 0 auto;max-height:42%;border-left:0;border-top:1px solid var(--line)}}","+</style>","+</head>","+<body>","+<header>","+  <div>","+    <div class=\"brand\">muse-wonder-full-1.0 <span>· Crash Lab</span></div>","+    <div class=\"sub\">2D rigid-body crash experiment — car vs. freestanding brick wall</div>","+  </div>","+  <div class=\"spacer\"></div>","+  <button class=\"btn btn-test\" id=\"btnTest\" title=\"Reset to current settings and launch the car\">▶ Test</button>","+  <button class=\"btn btn-reset\" id=\"btnReset\" title=\"Rebuild the scene without launching\">↺ Reset</button>","+</header>","+<main>","+  <section id=\"stage\"><canvas id=\"cv\"></canvas></section>","+  <aside>","+    <h2>Settings</h2>","+    <div id=\"controls\"></div>","+    <div id=\"status\">Ready — press Test to launch.</div>","+    <h2>Telemetry</h2>","+    <div class=\"tele\">","+      <div class=\"stat\"><b id=\"tSpeed\">0.0</b><span>Car speed m/s</span></div>","+      <div class=\"stat\"><b id=\"tTime\">0.00</b><span>Elapsed s</span></div>","+      <div class=\"stat\"><b id=\"tMoving\">0</b><span>Moving bricks</span></div>","+      <div class=\"stat\"><b id=\"tBricks\">0</b><span>Total bricks</span></div>","+      <div class=\"stat\"><b id=\"tKe\">0</b><span>Car KE kJ</span></div>","+      <div class=\"stat\"><b id=\"tMom\">0</b><span>Car momentum k·kg·m/s</span></div>","+    </div>","+    <h2>Fixed physics constants</h2>","+    <div class=\"defaults\">","+      Brick size <b>0.50 × 0.24 m</b> · Gravity <b>9.81 m/s²</b><br>","+      Brick friction <b>0.72</b> · Restitution <b>0.18</b><br>","+      Car mass <b>1,250 kg</b> · Car <b>4.2 × 1.45 m</b><br>","+      Ground friction <b>0.85</b> · Nominal scale <b>80 px/m</b> (auto-fit)<br>","+      Depth layers are parallel wall planes (pseudo-depth offset); bricks collide within their plane, all planes collide with car &amp; ground.","+    </div>","+    <p class=\"hint\" style=\"margin-top:10px\">Tip: lower the speed or raise brick mass / depth and the wall may only topple or partially survive. Press <b>Test</b> again to repeat the exact same run — the simulation is deterministic.</p>","+  </aside>","+</main>","+<script>","+\"use strict\";","+/* ================= Config (mandatory defaults) ================= */","+const FIXED = {","+  brickW:0.50, brickH:0.24, gravity:9.81, brickFriction:0.72, restitution:0.18,","+  carMass:1250, carW:4.2, carH:1.45, groundFriction:0.85, nominalScale:80","+};","+const PARAMS = [","+  {key:\"speed\", label:\"Car speed\", unit:\"m/s\", min:5,  max:45, step:0.5, def:22},","+  {key:\"cols\",  label:\"Wall columns\", unit:\"bricks\", min:4, max:24, step:1, def:12},","+  {key:\"rows\",  label:\"Wall rows\", unit:\"bricks\", min:3, max:16, step:1, def:8},","+  {key:\"depth\", label:\"Wall depth layers\", unit:\"layers\", min:1, max:5, step:1, def:2},","+  {key:\"brickMass\", label:\"Brick mass\", unit:\"kg\", min:0.5, max:12, step:0.1, def:2.5},","+];","+const settings = {}; PARAMS.forEach(p=>settings[p.key]=p.def);"]}]}]}