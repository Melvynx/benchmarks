{"files":[{"path":"/private/var/folders/7z/5mtgxwxx4zs9ppgzm942gbmh0000gn/T/workspace.aiZgiG/app/index.html","hunks":[{"oldStart":93,"oldLines":3,"newStart":93,"newLines":120,"lines":["   {key:\"brickMass\", label:\"Brick mass\", unit:\"kg\", min:0.5, max:12, step:0.1, def:2.5},"," ];"," const settings = {}; PARAMS.forEach(p=>settings[p.key]=p.def);","+","+/* ================= Seeded RNG (visual effects only) ================= */","+let seed = 1234567;","+function srand(){ seed=(seed*1664525+1013904223)>>>0; return seed/4294967296; }","+","+/* ================= Rigid-body engine (OBB, impulse + friction) =================","+   World units: metres, x right, y up, ground plane y=0. Angles in radians. */","+function makeBody(o){","+  const m=o.mass, w=o.w, h=o.h;","+  const inertia = m*(w*w+h*h)/12;","+  return {x:o.x,y:o.y,vx:0,vy:0,a:o.a||0,av:0,w,h,mass:m,invM:1/m,","+    inertia,invI:1/inertia,kind:o.kind,layer:o.layer||0,","+    friction:o.friction,rest:o.rest,sleep:0,crumple:0};","+}","+function corners(b){","+  const c=Math.cos(b.a),s=Math.sin(b.a),hw=b.w/2,hh=b.h/2,out=[];","+  const pts=[[-hw,-hh],[hw,-hh],[hw,hh],[-hw,hh]];","+  for(const [lx,ly] of pts) out.push({x:b.x+lx*c-ly*s, y:b.y+lx*s+ly*c});","+  return out;","+}","+function axesOf(b){ const c=Math.cos(b.a),s=Math.sin(b.a); return [{x:c,y:s},{x:-s,y:c}]; }","+function project(pts,ax){ let mn=Infinity,mx=-Infinity; for(const p of pts){const d=p.x*ax.x+p.y*ax.y; if(d<mn)mn=d; if(d>mx)mx=d;} return [mn,mx]; }","+function pointInOBB(p,b){","+  const c=Math.cos(-b.a),s=Math.sin(-b.a),dx=p.x-b.x,dy=p.y-b.y;","+  const lx=dx*c-dy*s, ly=dx*s+dy*c;","+  return Math.abs(lx)<=b.w/2+1e-9 && Math.abs(ly)<=b.h/2+1e-9;","+}","+/* SAT OBB vs OBB. Returns {nx,ny,pen,px,py} with normal pointing A->B, or null. */","+function collideOBB(A,B){","+  const pa=corners(A), pb=corners(B);","+  const axes=[...axesOf(A),...axesOf(B)];","+  let bestPen=Infinity,bestAx=null;","+  for(const ax of axes){","+    const [a0,a1]=project(pa,ax),[b0,b1]=project(pb,ax);","+    const pen=Math.min(a1,b1)-Math.max(a0,b0);","+    if(pen<=0) return null;","+    if(pen<bestPen){bestPen=pen;bestAx=ax;}","+  }","+  let nx=bestAx.x,ny=bestAx.y;","+  if((B.x-A.x)*nx+(B.y-A.y)*ny<0){nx=-nx;ny=-ny;}","+  // contact point: average of vertices inside the other body (fallback: midpoint)","+  let sx=0,sy=0,n=0;","+  for(const p of pa) if(pointInOBB(p,B)){sx+=p.x;sy+=p.y;n++;}","+  for(const p of pb) if(pointInOBB(p,A)){sx+=p.x;sy+=p.y;n++;}","+  const px=n?sx/n:(A.x+B.x)/2, py=n?sy/n:(A.y+B.y)/2;","+  return {nx,ny,pen:bestPen,px,py};","+}","+function velAt(b,px,py){ const rx=px-b.x, ry=py-b.y; return {x:b.vx-b.av*ry, y:b.vy+b.av*rx, rx, ry}; }","+let impactEnergy=0; // accumulated per-frame, drives shake/dust (visual only)","+function applyImpulse(b,jx,jy,px,py){","+  b.vx+=jx*b.invM; b.vy+=jy*b.invM;","+  const rx=px-b.x, ry=py-b.y;","+  b.av+=(rx*jy-ry*jx)*b.invI;","+}","+function solveContact(A,B,c,dt){","+  // A or B may be null meaning static ground handled separately.","+  const va=velAt(A,c.px,c.py), vb=velAt(B,c.px,c.py);","+  const rvx=vb.x-va.x, rvy=vb.y-va.y;","+  const vn=rvx*c.nx+rvy*c.ny;","+  const raCn=va.rx*c.ny-va.ry*c.nx, rbCn=vb.rx*c.ny-vb.ry*c.nx;","+  const massN=1/(A.invM+B.invM + raCn*raCn*A.invI + rbCn*rbCn*B.invI);","+  const e=(vn<-1.0)? Math.min(A.rest,B.rest):0;","+  let jn=-(1+e)*vn*massN;","+  // Baumgarte-style bias to resolve penetration steadily without popping","+  jn+=Math.max(c.pen-0.002,0)*0.35/dt*massN*0.02;","+  if(jn<0)jn=0;","+  if(jn>0){","+    applyImpulse(A,-jn*c.nx,-jn*c.ny,c.px,c.py);","+    applyImpulse(B, jn*c.nx, jn*c.ny,c.px,c.py);","+    if(vn<-2) impactEnergy+=jn*Math.abs(vn);","+    // friction","+    const va2=velAt(A,c.px,c.py), vb2=velAt(B,c.px,c.py);","+    let tx=(vb2.x-va2.x), ty=(vb2.y-va2.y);","+    const tVn=tx*c.nx+ty*c.ny; tx-=tVn*c.nx; ty-=tVn*c.ny;","+    const tl=Math.hypot(tx,ty);","+    if(tl>1e-6){","+      tx/=tl; ty/=tl;","+      const vt=(vb2.x-va2.x)*tx+(vb2.y-va2.y)*ty;","+      const raCt=va.rx*ty-va.ry*tx, rbCt=vb.rx*ty-vb.ry*tx;","+      const massT=1/(A.invM+B.invM + raCt*raCt*A.invI + rbCt*rbCt*B.invI);","+      const mu=Math.sqrt(A.friction*B.friction);","+      let jt=-vt*massT; const maxF=mu*jn;","+      jt=Math.max(-maxF,Math.min(maxF,jt));","+      applyImpulse(A,-jt*tx,-jt*ty,c.px,c.py);","+      applyImpulse(B, jt*tx, jt*ty,c.px,c.py);","+    }","+  }","+  // positional correction (linear split by inverse mass)","+  const corr=Math.max(c.pen-0.001,0)*0.6/(A.invM+B.invM);","+  A.x-=c.nx*corr*A.invM; A.y-=c.ny*corr*A.invM;","+  B.x+=c.nx*corr*B.invM; B.y+=c.ny*corr*B.invM;","+}","+function solveGround(b,dt){","+  const pts=corners(b);","+  for(const p of pts){","+    if(p.y<0){","+      const v=velAt(b,p.x,p.y);","+      const rCn=v.rx*1-v.ry*0; // cross(r, n=(0,1)) = rx*1 - ry*0 ... z = rx*ny-ry*nx","+      const massN=1/(b.invM + rCn*rCn*b.invI);","+      const e=(v.y<-1.0)? b.rest:0;","+      let jn=-(1+e)*v.y*massN + Math.max(-p.y-0.001,0)*0.4/dt*massN*0.02;","+      if(jn<0)jn=0;","+      if(jn>0){","+        applyImpulse(b,0,jn,p.x,p.y);","+        if(v.y<-2) impactEnergy+=jn*Math.abs(v.y)*0.3;","+        const v2=velAt(b,p.x,p.y);","+        const mu=Math.sqrt(b.friction*FIXED.groundFriction);","+        const rCt=v.rx*0-v.ry*1; // cross(r, t=(1,0)) z = rx*0-ry*1","+        const massT=1/(b.invM + rCt*rCt*b.invI);","+        let jt=-v2.x*massT; const maxF=mu*jn;","+        jt=Math.max(-maxF,Math.min(maxF,jt));","+        applyImpulse(b,jt,0,p.x,p.y);","+      }","+      b.y+=(-p.y)*0.85; // lift out of ground (recomputed next corner from stale pts is ok, small)","+    }","+  }","+}"]}]}]}