{"files":[{"path":"/private/var/folders/7z/5mtgxwxx4zs9ppgzm942gbmh0000gn/T/workspace.aiZgiG/app/index.html","hunks":[{"oldStart":115,"oldLines":30,"newStart":115,"newLines":39,"lines":[" }"," function axesOf(b){ const c=Math.cos(b.a),s=Math.sin(b.a); return [{x:c,y:s},{x:-s,y:c}]; }"," function project(pts,ax){ let mn=Infinity,mx=-Infinity; for(const p of pts){const d=p.x*ax.x+p.y*ax.y; if(d<mn)mn=d; if(d>mx)mx=d;} return [mn,mx]; }","-function pointInOBB(p,b){","-  const c=Math.cos(-b.a),s=Math.sin(-b.a),dx=p.x-b.x,dy=p.y-b.y;","-  const lx=dx*c-dy*s, ly=dx*s+dy*c;","+function flatCorners(b,out){","+  const c=Math.cos(b.a),s=Math.sin(b.a),hw=b.w/2,hh=b.h/2;","+  const lx=[-hw,hw,hw,-hw], ly=[-hh,-hh,hh,hh];","+  for(let i=0;i<4;i++){ out[i*2]=b.x+lx[i]*c-ly[i]*s; out[i*2+1]=b.y+lx[i]*s+ly[i]*c; }","+  return out;","+}","+function inOBB(px,py,b){","+  const c=Math.cos(b.a),s=Math.sin(b.a),dx=px-b.x,dy=py-b.y;","+  const lx=dx*c+dy*s, ly=-dx*s+dy*c;","   return Math.abs(lx)<=b.w/2+1e-9 && Math.abs(ly)<=b.h/2+1e-9;"," }","+const _pa=new Array(8), _pb=new Array(8);"," /* SAT OBB vs OBB. Returns {nx,ny,pen,px,py} with normal pointing A->B, or null. */"," function collideOBB(A,B){","-  const pa=corners(A), pb=corners(B);","-  const axes=[...axesOf(A),...axesOf(B)];","-  let bestPen=Infinity,bestAx=null;","-  for(const ax of axes){","-    const [a0,a1]=project(pa,ax),[b0,b1]=project(pb,ax);","+  const pa=flatCorners(A,_pa.slice()), pb=flatCorners(B,_pb.slice());","+  const ca=Math.cos(A.a),sa=Math.sin(A.a),cb=Math.cos(B.a),sb=Math.sin(B.a);","+  const axx=[ca,-sa,cb,-sb], axy=[sa,ca,sb,cb];","+  let bestPen=Infinity,bnx=1,bny=0;","+  for(let k=0;k<4;k++){","+    const ax=axx[k],ay=axy[k];","+    let a0=Infinity,a1=-Infinity,b0=Infinity,b1=-Infinity;","+    for(let i=0;i<4;i++){ const d=pa[i*2]*ax+pa[i*2+1]*ay; if(d<a0)a0=d; if(d>a1)a1=d; }","+    for(let i=0;i<4;i++){ const d=pb[i*2]*ax+pb[i*2+1]*ay; if(d<b0)b0=d; if(d>b1)b1=d; }","     const pen=Math.min(a1,b1)-Math.max