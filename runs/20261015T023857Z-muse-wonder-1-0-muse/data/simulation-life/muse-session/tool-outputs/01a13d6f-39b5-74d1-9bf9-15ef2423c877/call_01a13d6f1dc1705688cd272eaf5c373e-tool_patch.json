{"files":[{"path":"/private/var/folders/7z/5mtgxwxx4zs9ppgzm942gbmh0000gn/T/workspace.cGH8PG/app/src/main.js","hunks":[{"oldStart":1,"oldLines":0,"newStart":1,"newLines":70,"lines":["+// Living Garden — energy-driven predator/prey/fruit simulation. All chart data is recorded from this sim.","+const $ = s => document.querySelector(s);","+function mulberry32(a){return function(){a|=0;a=a+0x6D2B79F5|0;let t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296}}","+let rng = mulberry32(7);","+const rand=(a,b)=>a+rng()*(b-a);","+const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));","+const dist=(a,b)=>Math.hypot(a.x-b.x,a.y-b.y);","+","+const DEFAULTS = {","+  fruitGrowth:1.0, fruitLimit:6, fruitDelay:3.5,","+  blueUse:1.0, blueSpeed:26, blueVision:95, blueCopy:72, blueEat:0.9,","+  redUse:0.85, redSpeed:24, redVision:105, redContact:20, redCopy:78, redPause:1.3,","+  startTrees:9, startBlue:16, startRed:6, worldSize:150, seed:7, simSpeed:1","+};","+let P = {...DEFAULTS};","+","+const CTRL_GROUPS = [","+  [\"🌿 Fruit\", [","+    [\"fruitGrowth\",\"Fruit growth speed\",0.1,3,0.05], [\"fruitLimit\",\"Fruit limit per tree\",1,12,1], [\"fruitDelay\",\"Fruit return delay (s)\",0,10,0.25],","+  ]],","+  [\"🔵 Blue blobs\", [","+    [\"blueUse\",\"Energy use\",0.2,2.5,0.05], [\"blueSpeed\",\"Speed\",8,55,1], [\"blueVision\",\"Vision range\",30,180,5],","+    [\"blueCopy\",\"Copy threshold (energy)\",45,95,1], [\"blueEat\",\"Eating time (s)\",0.2,2.5,0.1],","+  ]],","+  [\"🔴 Red blobs\", [","+    [\"redUse\",\"Energy use\",0.2,2.5,0.05], [\"redSpeed\",\"Speed\",8,55,1], [\"redVision\",\"Vision range\",30,190,5],","+    [\"redContact\",\"Contact strength\",5,40,1], [\"redCopy\",\"Copy threshold (energy)\",45,98,1], [\"redPause\",\"Pause after contact (s)\",0.2,3,0.1],","+  ]],","+  [\"🌍 World & start\", [","+    [\"startTrees\",\"Starting fruit trees\",1,20,1], [\"startBlue\",\"Starting blue blobs\",0,40,1], [\"startRed\",\"Starting red blobs\",0,30,1],","+    [\"worldSize\",\"World size\",90,210,5], [\"simSpeed\",\"Simulation speed\",0.25,3.5,0.25],","+  ]],","+];","+const PRESETS = {","+  balanced:{label:\"Balanced garden\",desc:\"Classic out-of-phase waves\",v:{}},","+  rich:{label:\"Fruit-rich garden\",desc:\"Fast fruit, blues boom first\",v:{fruitGrowth:2.2,fruitLimit:10,fruitDelay:1.2,startTrees:13,startBlue:14,startRed:5}},","+  redheavy:{label:\"Red-heavy garden\",desc:\"Blues dip, then reds fade\",v:{startRed:16,startBlue:20,redContact:26,redVision:125}},","+  fragile:{label:\"Fragile balance\",desc:\"Tight energy, big swings\",v:{fruitGrowth:0.65,fruitLimit:4,fruitDelay:5,blueUse:1.25,redUse:1.05,startBlue:14,startRed:7}},","+  lowfruit:{label:\"Low-fruit garden\",desc:\"Sparse fruit keeps it small\",v:{fruitGrowth:0.4,fruitLimit:3,fruitDelay:7,startTrees:5,startBlue:10,startRed:3}},","+};","+","+// ---------- state ----------","+let trees=[], blobs=[], particles=[], history=[], simTime=0, playing=true, selected=null, nextId=1, births={blue:0,red:0}, deaths={blue:0,red:0}, eaten=0, contacts=0, histTimer=0, peakBlue=0, peakRed=0;","+let rot=0.6, rotVel=0.02, zoom=1, dragging=false, lastX=0;","+","+function spawnTree(x,y){ return {x,y,fruit:Math.floor(rand(2,P.fruitLimit+1)), timer:rand(0,2), sway:rand(0,6.28), id:nextId++}; }","+function spawnBlob(kind,x,y,parent){","+  const isB=kind==='blue';","+  const baseSpeed=isB?P.blueSpeed:P.redSpeed, baseVis=isB?P.blueVision:P.redVision;","+  const mutate=v=>parent? clamp(v*rand(0.88,1.12),6,220) : v*rand(0.9,1.1);","+  return { id:nextId++, kind, x,y, vx:rand(-8,8), vy:rand(-8,8),","+    energy: parent? P[isB?'blueCopy':'redCopy']*0.42 : rand(55,85),","+    age:0, born:simTime, parentId:parent?parent.id:null, gen:parent?parent.gen+1:0,","+    speed:mutate(parent?parent.speed:baseSpeed), vision:mutate(parent?parent.vision:baseVis),","+    state:'wander', stateT:0, target:null, wanderA:rand(0,6.28), blink:rand(1,4), bounce:rand(0,6.28),","+    chew:0, flash:0, lean:0 };","+}","+function randomPos(margin=18){ const a=rand(0,Math.PI*2), r=Math.sqrt(rng())*(P.worldSize-margin); return {x:Math.cos(a)*r, y:Math.sin(a)*r}; }","+","+function reset(randomizeSeed=false){","+  if(randomizeSeed) P.seed = Math.floor(Math.random()*99999);","+  rng = mulberry32(P.seed|0);","+  trees=[]; blobs=[]; particles=[]; history=[]; simTime=0; selected=null; nextId=1;","+  births={blue:0,red:0}; deaths={blue:0,red:0}; eaten=0; contacts=0; histTimer=0; peakBlue=0; peakRed=0;","+  for(let i=0;i<P.startTrees;i++){ const p=randomPos(30); trees.push(spawnTree(p.x,p.y)); }","+  for(let i=0;i<P.startBlue;i++){ const p=randomPos(); blobs.push(spawnBlob('blue',p.x,p.y,null)); }","+  for(let i=0;i<P.startRed;i++){ const p=randomPos(); blobs.push(spawnBlob('red',p.x,p.y,null)); }","+  recordHistory(); syncControlValues(); updateInspector(); drawCharts();","+  toast(`Seed ${P.seed} · ${trees.length} trees, ${P.startBlue} blue, ${P.startRed} red`);","+}"]}]}]}