{"files":[{"path":"/private/var/folders/7z/5mtgxwxx4zs9ppgzm942gbmh0000gn/T/workspace.cGH8PG/app/src/main.js","hunks":[{"oldStart":169,"oldLines":3,"newStart":169,"newLines":76,"lines":["   if(history.length>900) history.shift();"," }"," ","+// ---------- rendering ----------","+const cv = $('#world'), ctx = cv.getContext('2d');","+let viewW=0, viewH=0;","+function resize(){ const r=cv.getBoundingClientRect(), dpr=Math.min(2,devicePixelRatio||1); viewW=r.width; viewH=r.height; cv.width=r.width*dpr; cv.height=r.height*dpr; ctx.setTransform(dpr,0,0,dpr,0,0); }","+addEventListener('resize', resize);","+function project(x,y){ const c=Math.cos(rot), s=Math.sin(rot); const rx=x*c-y*s, ry=x*s+y*c; const scale=(Math.min(viewW,viewH*1.55)/2-26)/P.worldSize*zoom; return { x: viewW/2+rx*scale, y: viewH/2+ry*scale*0.60, scale, depth: ry }; }","+","+function drawWorld(){","+  ctx.clearRect(0,0,viewW,viewH);","+  const cx=viewW/2, cy=viewH/2, R=(Math.min(viewW,viewH*1.55)/2-26)*zoom, Ry=R*0.60;","+  // dish shadow + rim","+  ctx.fillStyle='rgba(60,90,50,.18)'; ctx.beginPath(); ctx.ellipse(cx,cy+16,R+16,Ry+14,0,0,7); ctx.fill();","+  ctx.fillStyle='#8a6844'; ctx.beginPath(); ctx.ellipse(cx,cy+7,R+10,Ry+10,0,0,7); ctx.fill();","+  ctx.fillStyle='#9ed07e'; ctx.beginPath(); ctx.ellipse(cx,cy,R,Ry,0,0,7); ctx.fill();","+  ctx.fillStyle='#aede8d'; ctx.beginPath(); ctx.ellipse(cx,cy-4,R*0.86,Ry*0.84,0,0,7); ctx.fill();","+  // speckles","+  ctx.fillStyle='rgba(255,255,255,.25)';","+  for(let i=0;i<26;i++){ const a=i*2.399, r=((i*53)%80)/100*R; const p=project(Math.cos(a)*r*0.9,Math.sin(a)*r*0.9); ctx.beginPath(); ctx.arc(p.x,p.y,2,0,7); ctx.fill(); }","+  // draw trees + blobs sorted by depth","+  const items=[];","+  for(const t of trees) items.push({d:project(t.x,t.y).depth, t});","+  for(const b of blobs) items.push({d:project(b.x,b.y).depth+1, b});","+  items.sort((a,b)=>a.d-b.d);","+  for(const it of items){ if(it.t) drawTree(it.t); else drawBlob(it.b); }","+  for(const p of particles){ const s=project(p.x,p.y); ctx.globalAlpha=1-p.t/p.life; ctx.fillStyle=p.color; ctx.beginPath(); ctx.arc(s.x,s.y-8,p.r,0,7); ctx.fill(); ctx.globalAlpha=1; }","+  if(!dragging) rot += rotVel*0.016; rotVel*=0.995; if(Math.abs(rotVel)<0.02) rotVel=0.02;","+}","+function drawTree(t){","+  const p=project(t.x,t.y), s=p.scale;","+  ctx.fillStyle='rgba(50,80,40,.22)'; ctx.beginPath(); ctx.ellipse(p.x,p.y+3,20*s,6*s,0,0,7); ctx.fill();","+  ctx.strokeStyle='#7a4f2a'; ctx.lineWidth=Math.max(2,5*s); ctx.beginPath(); ctx.moveTo(p.x,p.y); ctx.quadraticCurveTo(p.x+2*s,p.y-12*s,p.x,p.y-20*s); ctx.stroke();","+  const sway=Math.sin(t.sway*1.4)*2*s;","+  for(const [ox,oy,r] of [[-11,-26,13],[10,-29,14],[0,-36,16]]){","+    ctx.fillStyle='#3f9e4d'; ctx.beginPath(); ctx.arc(p.x+(ox*s)+sway,p.y+oy*s,r*s,0,7); ctx.fill();","+    ctx.fillStyle='rgba(255,255,255,.18)'; ctx.beginPath(); ctx.arc(p.x+(ox-4)*s+sway,p.y+(oy-5)*s,r*s*0.45,0,7); ctx.fill();","+  }","+  // fruit attached to canopy — count is the real t.fruit","+  const spots=[[-14,-30],[-4,-40],[7,-33],[14,-24],[-8,-22],[3,-27],[11,-40],[-16,-37],[0,-32],[6,-22],[-12,-27],[15,-32]];","+  for(let i=0;i<t.fruit && i<spots.length;i++){","+    ctx.fillStyle='#ffe14d'; ctx.strokeStyle='#d9a400'; ctx.lineWidth=1;","+    ctx.beginPath(); ctx.arc(p.x+spots[i][0]*s+sway,p.y+spots[i][1]*s,Math.max(2,3.4*s),0,7); ctx.fill(); ctx.stroke();","+  }","+  if(t.fruit===0){ ctx.fillStyle='rgba(60,80,50,.65)'; ctx.font=`${Math.max(9,10*s)}px sans-serif`; ctx.textAlign='center'; ctx.fillText('regrowing…',p.x,p.y-48*s); }","+}","+function drawBlob(b){","+  const p=project(b.x,b.y), s=p.scale, isB=b.kind==='blue';","+  const squash = 1+Math.sin(b.bounce)*0.07 + (b.state==='eating'? Math.sin(b.bounce*2)*0.08:0);","+  const w=13*s*squash, h=16*s/squash;","+  const bob = Math.abs(Math.sin(b.bounce))*2.2*s;","+  const x=p.x, y=p.y-bob;","+  ctx.fillStyle='rgba(50,80,40,.25)'; ctx.beginPath(); ctx.ellipse(p.x,p.y+3,13*s,4.5*s,0,0,7); ctx.fill();","+  if(selected===b){ ctx.strokeStyle='#20301f'; ctx.lineWidth=2; ctx.setLineDash([5,4]); ctx.beginPath(); ctx.ellipse(p.x,p.y+2,20*s,8*s,0,0,7); ctx.stroke(); ctx.setLineDash([]); }","+  if(b.flash>0){ ctx.fillStyle=isB?'rgba(120,190,255,.35)':'rgba(255,150,140,.35)'; ctx.beginPath(); ctx.arc(x,y-h*0.5,24*s*b.flash,0,7); ctx.fill(); }","+  ctx.save(); ctx.translate(x,y); ctx.rotate(b.lean);","+  const grad=ctx.createLinearGradient(0,-h,0,0); if(isB){grad.addColorStop(0,'#7ec3ff');grad.addColorStop(1,'#2470d8');}else{grad.addColorStop(0,'#ff9a8f');grad.addColorStop(1,'#d92f24');}","+  ctx.fillStyle=grad; ctx.beginPath(); ctx.ellipse(0,-h/2,w,h/2,0,0,7); ctx.fill();","+  ctx.fillStyle='rgba(255,255,255,.5)'; ctx.beginPath(); ctx.ellipse(-w*0.32,-h*0.68,w*0.28,h*0.2,-0.4,0,7); ctx.fill();","+  // face","+  const blinking=b.blink<0, chew=b.state==='eating'? Math.sin(b.bounce*2)*1.6:0;","+  ctx.fillStyle='#16233a';","+  if(blinking){ ctx.fillRect(-6*s,-h*0.58,4*s,1.4*s); ctx.fillRect(2*s,-h*0.58,4*s,1.4*s); }","+  else { ctx.beginPath(); ctx.arc(-4*s,-h*0.58,1.9*s,0,7); ctx.arc(4*s,-h*0.58,1.9*s,0,7); ctx.fill(); }","+  ctx.strokeStyle='#16233a'; ctx.lineWidth=1.3*s; ctx.beginPath();","+  if(b.energy<28) ctx.arc(0,-h*0.32+chew,3.4*s,1.15*Math.PI,1.85*Math.PI);","+  else ctx.arc(0,-h*0.44+chew,3.6*s,0.15*Math.PI,0.85*Math.PI);","+  ctx.stroke();","+  // energy pip","+  ctx.restore();","+  ctx.fillStyle='rgba(255,255,255,.85)'; ctx.fillRect(x-11*s,y-h-8*s,22*s,4*s);","+  ctx.fillStyle=b.energy>45?'#57c84a':b.energy>22?'#ffb020':'#e5483f'; ctx.fillRect(x-11*s,y-h-8*s,22*s*clamp(b.energy/100,0,1),4*s);","+}","+","+"]}]}]}