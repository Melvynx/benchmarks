function nodeLocalMatrix(
  node: Pick<SceneNode, "x" | "y" | "width" | "height" | "rotation">,
): AffineMatrix {
  const radians = node.rotation * DEGREES_TO_RADIANS;
  const cosine = Math.cos(radians);
  const sine = Math.sin(radians);
  const centerX = node.width / 2;
  const centerY = node.height / 2;
  return {
    a: cosine,
    b: sine,
    c: -sine,
    d: cosine,
    e: node.x + centerX - cosine * centerX + sine * centerY,
    f: node.y + centerY - sine * centerX - cosine * centerY,
